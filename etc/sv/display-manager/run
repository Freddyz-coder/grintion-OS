#!/bin/sh
# Grintion-OS runit service: display-manager
# Supervises graphical display managers (LightDM, SDDM, GDM).
#
# The daemon is exec'd so runit tracks a live process; launching it without
# exec let the run script exit while the DM kept running, so a restart could
# race the old instance for the display.
mkdir -p /var/log
exec >> /var/log/display-manager.log 2>&1

# Every supported display manager needs the D-Bus system bus and exits
# immediately without it, which looked like "sv start" timing out. Both services
# start together, so give the bus a few seconds before complaining.
if [ -x /usr/bin/dbus-daemon ] && [ ! -S /run/dbus/system_bus_socket ]; then
    i=0
    while [ "$i" -lt 10 ] && [ ! -S /run/dbus/system_bus_socket ]; do
        sleep 1
        i=$((i + 1))
    done
fi
if [ ! -S /run/dbus/system_bus_socket ]; then
    echo "display-manager: no D-Bus system bus; enable it with 'ln -sfn /etc/sv/dbus /var/service/dbus'"
fi

# QEMU/libvirt/VirtualBox often expose both a relative PS/2 mouse and an
# absolute USB tablet. Feeding both to libinput makes the guest cursor drift
# away from the host cursor. Mark the relative duplicate as ignored before the
# display manager starts; this is honoured by libinput and KWin.
if [ -x /usr/bin/grintion-pointer-sync ]; then
    /usr/bin/grintion-pointer-sync || true
fi

# Xorg drivers that use libudev need the database the udev service builds.
# Describe the kernel's event devices explicitly as an evdev fallback, so the
# keyboard and mouse still work if that database is not ready yet.
if [ -x /usr/bin/grintion-xorg-input ]; then
    /usr/bin/grintion-xorg-input
fi

# grintion-desktop records the chosen display manager here.
if [ -r /etc/grintion/display-manager ]; then
    configured="/usr/bin/$(cat /etc/grintion/display-manager)"
    if [ -x "$configured" ]; then
        echo "display-manager: starting $configured"
        exec "$configured"
    fi
    echo "display-manager: configured display manager is not installed: $configured"
fi

for dm in /usr/bin/lightdm /usr/bin/greetd /usr/bin/sddm /usr/bin/gdm; do
    if [ -x "$dm" ]; then
        echo "display-manager: starting $dm"
        exec "$dm"
    fi
done

echo "display-manager: no display manager found; install with grintion-desktop"
exec sleep 3600
