#!/bin/sh
# Grintion-OS runit service: apparmor
#
# Loads every tracked profile at boot, then verifies with the kernel that the
# profiles are actually attached and enforcing. A profile that fails to parse is
# logged and makes the service exit nonzero (runsv shows it as down) instead of
# silently reporting a confined system.

mkdir -p /var/log /run
exec >> /var/log/apparmor.log 2>&1

if [ "$(cat /sys/module/apparmor/parameters/enabled 2>/dev/null || echo N)" != "Y" ]; then
    echo "apparmor: kernel support is not enabled"
    echo "apparmor: boot with 'security=apparmor apparmor=1' and check CONFIG_SECURITY_APPARMOR"
    exec sleep 3600
fi

parser=""
for candidate in /usr/bin/apparmor_parser /usr/sbin/apparmor_parser /sbin/apparmor_parser; do
    if [ -x "$candidate" ]; then
        parser="$candidate"
        break
    fi
done
if [ -z "$parser" ]; then
    echo "apparmor: apparmor_parser is missing; no profiles can be loaded"
    exec sleep 60
fi

loaded=0
failed=0
for profile in /etc/apparmor.d/*; do
    [ -f "$profile" ] || continue
    case "${profile##*/}" in
        *~|*.dpkg-*|*.rpmnew|*.rpmsave|*.pacnew|*.pacsave) continue ;;
    esac
    if "$parser" -r "$profile"; then
        echo "apparmor: loaded ${profile##*/}"
        loaded=$((loaded + 1))
    else
        echo "apparmor: failed to load ${profile##*/}"
        failed=$((failed + 1))
    fi
done

# The parser can succeed while a profile is not attached (for example because
# the binary path does not exist yet). Ask the kernel, not the exit status.
if command -v grintion-apparmor >/dev/null 2>&1; then
    grintion-apparmor verify --json > /run/grintion-apparmor-status.json 2>/dev/null || {
        echo "apparmor: kernel verification failed"
        grintion-apparmor verify >&2 || true
        exec sleep 60
    }
    echo "apparmor: kernel verification passed"
else
    echo "apparmor: grintion-apparmor is missing; cannot verify kernel state"
fi

echo "apparmor: $loaded profile(s) loaded, $failed failure(s)"
if [ "$failed" -ne 0 ]; then
    exec sleep 60
fi
exec sleep 3600
