#!/bin/sh
# Grintion-OS runit service: seatd
# Provides a seat-management socket for Wayland compositors without logind.
# The socket is owned by root:seat; human users are added to that group by
# grintion-desktop when a Wayland profile is installed.
exec 2>&1

mkdir -p /run
rm -f /run/seatd.sock

if ! command -v seatd >/dev/null 2>&1; then
    echo "seatd: binary is missing; install seatd before enabling this service"
    exec sleep 3600
fi

exec seatd -g seat -l info
