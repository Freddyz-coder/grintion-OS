#!/bin/sh
# Grintion-OS runit service: udev
# The image boots from devtmpfs + mdev. Wayland's libinput backend enumerates
# devices through libudev, so run the udev daemon and populate its database
# without adopting systemd as PID 1.
#
# systemd-udevd writes interface-name and rule diagnostics to stderr. Without a
# log service those lines land on tty1 and interleave with the login prompt; keep
# them in a file instead so the prompt stays readable.
mkdir -p /run/udev /var/log
exec >>/var/log/udev.log 2>&1
if [ ! -x /usr/lib/systemd/systemd-udevd ] || [ ! -x /usr/bin/udevadm ]; then
    echo "udev: systemd-udevd/udevadm are missing"
    exec sleep 3600
fi

/usr/lib/systemd/systemd-udevd &
udevd_pid=$!
i=0
while [ ! -S /run/udev/control ] && [ "$i" -lt 50 ]; do
    sleep 0.1
    i=$((i + 1))
done
timeout 20 udevadm trigger --action=add --type=subsystems 2>/dev/null || true
timeout 20 udevadm trigger --action=add --type=devices 2>/dev/null || true
timeout 20 udevadm settle 2>/dev/null || true
wait "$udevd_pid"
