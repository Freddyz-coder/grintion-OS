#!/bin/sh
# Grintion-OS runit service: network
# Runs dhcpcd on wired interfaces only. Wi-Fi is configured manually (see
# docs/INSTALL.md); handing wlan* to dhcpcd produced carrier timeouts/churn.
exec >>/var/log/dhcpcd.log 2>&1

i=0
WIRED=""
while [ "$i" -lt 10 ]; do
    WIRED=""
    for path in /sys/class/net/*; do
        [ -e "$path" ] || continue
        iface=${path##*/}
        [ "$iface" = lo ] && continue
        # /sys/class/net/<iface>/wireless and phy80211 identify wireless NICs.
        [ -e "$path/wireless" ] && continue
        [ -e "$path/phy80211" ] && continue
        WIRED="$WIRED $iface"
    done
    [ -n "$WIRED" ] && break
    sleep 1
    i=$((i + 1))
done

if [ -z "$WIRED" ]; then
    echo "network: no wired interface present; not starting DHCP"
    exec sleep 300
fi

echo "network: starting dhcpcd on$WIRED"
# WIRED is intentionally unquoted: dhcpcd takes one interface name per argument.
exec dhcpcd --nobackground --waitip=4 --timeout=30 $WIRED
