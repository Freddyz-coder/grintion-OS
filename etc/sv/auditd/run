#!/bin/sh
# Grintion-OS runit service: auditd
#
# The kernel has CONFIG_AUDIT=y and CONFIG_AUDITSYSCALL=y. The build copies the
# audit userspace (auditd, auditctl, ausearch, aureport) and this service fails
# visibly if it is ever missing, instead of pretending to run.

# auditd.log can receive kernel records that predate the daemon. Keep the
# file and directory root-only instead of relying on the inherited umask.
umask 0077

mkdir -p /var/log/audit
chmod 0750 /var/log/audit

# runsv sends a service's stdout to the console when it has no log service.
# auditd's diagnostics and any pre-daemon kernel records used to interleave
# with the login prompt; keep this service's output in a file.
exec >>/var/log/audit/auditd.log 2>&1

if ! command -v auditd >/dev/null 2>&1; then
    echo "auditd: binary is missing from the image; refusing to fake the service"
    exec sleep 60
fi
if ! command -v auditctl >/dev/null 2>&1; then
    echo "auditd: auditctl is missing from the image; rules cannot be loaded"
    exec sleep 60
fi

# A watch on a path that does not exist makes auditctl fail the whole file.
# The live image has no /etc/ssh/sshd_config and no ESP config, so build a
# filtered copy and load that.
filtered=/run/audit/audit.rules
mkdir -p /run/audit
: > "$filtered"
if [ -f /etc/audit/audit.rules ]; then
    while IFS= read -r line; do
        case "$line" in
            -w\ *)
                target=$(printf '%s\n' "$line" | awk '{print $2}')
                [ -e "$target" ] || continue
                ;;
        esac
        printf '%s\n' "$line" >> "$filtered"
    done < /etc/audit/audit.rules
    if ! auditctl -R "$filtered"; then
        # A single incompatible rule must not hide every rule after it. Keep
        # the daemon running, but reload the file one rule at a time so the
        # compatible watches are still active and the rejected line is named.
        echo "auditd: bulk rule load failed; retrying rules individually"
        auditctl -D >/dev/null 2>&1 || true
        while IFS= read -r line; do
            case "$line" in
                ''|'#'*) continue ;;
                -D) auditctl -D >/dev/null 2>&1 || true; continue ;;
            esac
            # Rules are simple argument lists split by the shell, not shell code.
            # shellcheck disable=SC2086
            if ! auditctl $line; then
                echo "auditd: kernel rejected audit rule: $line"
            fi
        done < "$filtered"
    fi
fi

# Loading rules is not enough: verify the kernel audit subsystem is actually
# enabled. A daemon running against a disabled audit subsystem would look
# healthy while retaining nothing.
if ! auditctl -s > /run/audit/status 2>&1; then
    echo "auditd: cannot query kernel audit state; refusing to report healthy"
    exec sleep 60
fi
if ! grep -qE '^enabled[[:space:]]+[12]$' /run/audit/status; then
    echo "auditd: kernel audit is not enabled; refusing to report healthy"
    cat /run/audit/status >&2 || true
    exec sleep 60
fi

echo "auditd: starting"
exec auditd -f
