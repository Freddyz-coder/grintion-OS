#!/bin/sh
# Grintion-OS runit service: auditd
#
# The kernel has CONFIG_AUDIT=y and CONFIG_AUDITSYSCALL=y. The build copies the
# audit userspace (auditd, auditctl, ausearch, aureport) and this service fails
# visibly if it is ever missing, instead of pretending to run.

mkdir -p /var/log/audit
chmod 0750 /var/log/audit

# runsv sends a service's stdout to the console when it has no log service.
# auditd's diagnostics and any pre-daemon kernel records used to interleave
# with the login prompt; keep this service's output in a file.
exec >>/var/log/audit/auditd.log 2>&1

if ! command -v auditd >/dev/null 2>&1; then
    echo "auditd: binary is missing from the image; refusing to fake the service"
    exec sleep 60
fi
if ! command -v auditctl >/dev/null 2>&1; then
    echo "auditd: auditctl is missing from the image; rules cannot be loaded"
    exec sleep 60
fi

# A watch on a path that does not exist makes auditctl fail the whole file.
# The live image has no /etc/ssh/sshd_config and no ESP config, so build a
# filtered copy and load that.
filtered=/run/audit/audit.rules
mkdir -p /run/audit
: > "$filtered"
if [ -f /etc/audit/audit.rules ]; then
    while IFS= read -r line; do
        case "$line" in
            -w\ *)
                target=$(printf '%s\n' "$line" | awk '{print $2}')
                [ -e "$target" ] || continue
                ;;
        esac
        printf '%s\n' "$line" >> "$filtered"
    done < /etc/audit/audit.rules
    if ! auditctl -R "$filtered"; then
        # Keep the daemon running even if one rule is rejected: stopping it
        # sends every audit record back to the kernel console instead of the
        # audit log, which is both noisy and worse for accountability.
        echo "auditd: failed to load $filtered; continuing without those rules"
    fi
fi

echo "auditd: starting"
exec auditd -f
