#!/bin/sh
# Grintion-OS runit stage 2: service supervision.
# runsvdir takes over PID 1's child process and supervises /var/service.

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

mkdir -p /var/service

if [ -x /usr/sbin/runsvdir ]; then
    exec env - PATH="$PATH" /usr/sbin/runsvdir -P /var/service
fi

echo "[-] runsvdir is missing; starting a rescue shell" >&2
exec /bin/bash --login
