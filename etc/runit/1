#!/bin/sh
# Grintion-OS runit stage 1: one-time system initialization.
# This script runs both in the live overlay and on an installed disk.

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 022

mountpoint -q /proc || mount -t proc proc /proc -o nosuid,noexec,nodev

# Loopback is not optional: D-Bus, X11, and local package repositories all use
# 127.0.0.1. The live image used to boot with lo DOWN because nothing brought
# it up before the services started.
if command -v ip >/dev/null 2>&1; then
    ip link set lo up 2>/dev/null || true
fi

mountpoint -q /sys || mount -t sysfs sys /sys -o nosuid,noexec,nodev

# AppArmor exposes its policy and loaded-profile state through securityfs.
# Without this mount the kernel can enforce nothing and apparmor_parser fails
# with "Unable to open /sys/kernel/security/apparmor".
mkdir -p /sys/kernel/security
mountpoint -q /sys/kernel/security || mount -t securityfs securityfs /sys/kernel/security 2>/dev/null || true

if ! mountpoint -q /dev; then
    mount -t devtmpfs dev /dev -o mode=0755,nosuid
fi
mkdir -p /dev/pts /dev/shm
mountpoint -q /dev/pts || mount -t devpts devpts /dev/pts -o mode=0620,gid=5,nosuid,noexec
mountpoint -q /dev/shm || mount -t tmpfs shm /dev/shm -o mode=1777,nosuid,nodev,noexec

mkdir -p /sys/fs/cgroup
mountpoint -q /sys/fs/cgroup || mount -t cgroup2 none /sys/fs/cgroup -o nsdelegate 2>/dev/null || true

if [ -d /sys/firmware/efi ] && [ ! -d /sys/firmware/efi/efivars ]; then
    mount -t efivarfs efivarfs /sys/firmware/efi/efivars 2>/dev/null || true
fi

mkdir -p /run /var/log /var/spool/mail /var/lib/dhcpcd /var/lib/garb /run/dhcpcd /run/wpa_supplicant
chmod 0755 /run /var/log /var/spool/mail /var/lib/dhcpcd /run/dhcpcd /run/wpa_supplicant
chmod 0700 /var/lib/garb
chown dhcpcd:dhcpcd /var/lib/dhcpcd /run/dhcpcd 2>/dev/null || true

if ! mountpoint -q /run; then
    mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run
fi
if ! mountpoint -q /tmp; then
    mount -t tmpfs -o mode=1777,nosuid,nodev,noexec tmpfs /tmp
fi
# /var/tmp is a separate noexec tmpfs so dropped files cannot be executed and
# do not grow the root filesystem.
mkdir -p /var/tmp
if ! mountpoint -q /var/tmp; then
    mount -t tmpfs -o mode=1777,nosuid,nodev,noexec tmpfs /var/tmp
fi
chmod 1777 /tmp /var/tmp

# Standard X11 and ICE sockets directories: must exist with mode 1777 owned by root:root
# so rootless Xorg and display managers do not fail or warn about ownership.
mkdir -p /tmp/.X11-unix /tmp/.ICE-unix
chmod 1777 /tmp/.X11-unix /tmp/.ICE-unix
chown root:root /tmp/.X11-unix /tmp/.ICE-unix 2>/dev/null || true

# pam_faillock needs a writable root-owned directory before the gettys start.
mkdir -p /run/faillock
chmod 0700 /run/faillock

if [ -s /etc/hostname ]; then
    cat /etc/hostname > /proc/sys/kernel/hostname 2>/dev/null || true
fi

if [ -d /etc/sysctl.d ]; then
    for file in /etc/sysctl.d/*.conf; do
        [ -f "$file" ] || continue
        sysctl -p "$file" >/dev/null 2>&1 || true
    done
fi

if [ ! -s /etc/machine-id ]; then
    tr -d '-' < /proc/sys/kernel/random/uuid > /etc/machine-id 2>/dev/null || true
    chmod 0444 /etc/machine-id 2>/dev/null || true
fi

if [ -s /var/lib/random-seed ]; then
    cat /var/lib/random-seed > /dev/urandom 2>/dev/null || true
fi

# devtmpfs creates the nodes; mdev applies /etc/mdev.conf and is the early
# hotplug helper. The standalone udev service starts later and populates the
# database libinput and desktop tools use.
if [ -x /usr/bin/mdev ]; then
    /usr/bin/mdev -s 2>/dev/null || true
    if [ -w /proc/sys/kernel/hotplug ]; then
        echo /usr/bin/mdev > /proc/sys/kernel/hotplug 2>/dev/null || true
    fi
fi

# The kernel only sets the system clock from the RTC at boot when
# CONFIG_RTC_HCTOSYS succeeds. Read it again here so a failed early read does
# not leave the clock in 1970; the timesync service keeps it correct afterwards.
/usr/bin/hwclock --hctosys >/dev/null 2>&1 || true

# The virtual console translates UTF-8 to the built-in 8x16 font only in UTF-8
# mode. Without ESC % G, block and box-drawing output (fastfetch's logo, htop's
# meters) is interpreted as Latin-1 and rendered as mojibake. The built-in font
# plus its CP437 mapping already cover U+2500 and U+2580-U+2593, so no console
# font file is needed for the default gettys.
for vt in /dev/tty1 /dev/tty2; do
    [ -c "$vt" ] || continue
    printf '\033%%G' > "$vt" 2>/dev/null || true
done

exit 0
