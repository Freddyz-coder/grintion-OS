#!/bin/sh
# Grintion-OS runit stage 3: controlled shutdown.

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

echo "[*] stopping supervised services"
for service in /var/service/*; do
    [ -d "$service" ] || continue
    sv -w 5 force-stop "$service" >/dev/null 2>&1 || true
done

mkdir -p /var/lib
umask 077
dd if=/dev/urandom of=/var/lib/random-seed bs=512 count=1 2>/dev/null || true
chmod 0600 /var/lib/random-seed 2>/dev/null || true

sync
exit 0
