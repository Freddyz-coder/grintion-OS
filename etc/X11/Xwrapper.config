# Xwrapper.config for Grintion-OS
#
# allowed_users=console is deliberately restrictive: only the user logged in
# on the local console may start Xorg. This image has no logind/systemd session
# manager, so needs_root_rights=yes is required for Xorg to open the DRM and
# input devices. Xorg therefore runs as root; this is an accepted limitation
# documented in SECURITY.md, not a property that can be removed without a
# logind-compatible seat manager.
allowed_users = console
needs_root_rights = yes

