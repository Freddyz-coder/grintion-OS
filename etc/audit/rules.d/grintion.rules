## Grintion-OS audit rules.
##
## The kernel audit subsystem is built in (CONFIG_AUDIT=y, CONFIG_AUDITSYSCALL=y).
## These rules focus on identity, privilege, boot, module and MAC changes, which
## are the events a workstation or server actually needs to retain. They avoid
## logging every execve, which would flood storage without adding much signal.

-D
-b 8192
--backlog_wait_time 60000
-f 1

-w /etc/passwd -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/sudoers -p wa -k privilege
-w /etc/sudoers.d -p wa -k privilege
-w /etc/ssh/sshd_config -p wa -k sshd
-w /etc/apparmor.d -p wa -k mac-policy
-w /etc/grintion -p wa -k grintion-config
-w /etc/audit -p wa -k audit-config
-w /etc/audit/rules.d -p wa -k audit-config
-w /etc/pam.d -p wa -k pam-config
-w /etc/security -p wa -k security-config
-w /etc/sysctl.d -p wa -k sysctl-config
-w /etc/nftables.conf -p wa -k firewall-config
-w /etc/usbguard -p wa -k usbguard-config
-w /etc/ssh -p wa -k sshd
-w /etc/pacman.d/gnupg -p wa -k package-trust
-w /var/lib/garb -p wa -k package-db
-w /var/lib/pacman/local -p wa -k package-db
-w /boot -p wa -k boot
-w /boot/efi/limine.conf -p wa -k boot-config

-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k modules
-a always,exit -F arch=b32 -S init_module,finit_module,delete_module -k modules
-a always,exit -F arch=b64 -S sethostname,setdomainname -k system-locale
-a always,exit -F arch=b32 -S sethostname,setdomainname -k system-locale
-a always,exit -F arch=b64 -S setuid,setgid,setreuid,setregid -F auid>=1000 -F auid!=4294967295 -k privilege
-a always,exit -F arch=b32 -S setuid,setgid,setreuid,setregid -F auid>=1000 -F auid!=4294967295 -k privilege
-a always,exit -F arch=b64 -S mount,umount2 -k mount
-a always,exit -F arch=b32 -S mount,umount2 -k mount
-a always,exit -F arch=b64 -S ptrace -k ptrace
-a always,exit -F arch=b32 -S ptrace -k ptrace
-a always,exit -F arch=b64 -S bpf -k bpf
-a always,exit -F arch=b32 -S bpf -k bpf
-a always,exit -F arch=b64 -S open_by_handle_at,name_to_handle_at -k file-handle
-a always,exit -F arch=b32 -S open_by_handle_at,name_to_handle_at -k file-handle
-a always,exit -F arch=b64 -S setns,unshare -k namespace
-a always,exit -F arch=b32 -S setns,unshare -k namespace
