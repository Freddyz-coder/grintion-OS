[package]
name = "wayland"
version = "1.23.0"
release = 1
description = "Wayland display protocol libraries"
license = "MIT"
arch = ["x86_64", "aarch64"]

[build]
configure = "meson setup build -Dprefix=/usr -Ddocumentation=false"
compile = "ninja -C build"
install = "DESTDIR=$PKGDIR ninja -C build install"
