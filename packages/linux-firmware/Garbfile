[package]
name = "linux-firmware"
version = "20241201"
release = 1
description = "Linux firmware blobs for GPU, WiFi, audio, and NIC hardware"
license = "Mixed"
arch = ["x86_64", "aarch64"]

[security]
hardened = false

[build]
source = "https://git.kernel.org/pub/scm/linux/kernel/git/firmware/linux-firmware.git"
install = "make DESTDIR=$PKGDIR FIRMWAREDIR=/lib/firmware install"
