[package]
name = "mesa"
version = "24.3.0"
release = 1
description = "Mesa 3D graphics library (OpenGL, Vulkan, DRI drivers)"
license = "MIT"
arch = ["x86_64", "aarch64"]

[dependencies]
runtime = ["linux-firmware"]

[build]
configure = "meson setup build -Dprefix=/usr -Dgallium-drivers=radeonsi,iris,nouveau,swrast -Dvulkan-drivers=amd,intel"
compile = "ninja -C build"
install = "DESTDIR=$PKGDIR ninja -C build install"
