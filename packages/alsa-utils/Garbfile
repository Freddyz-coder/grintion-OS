[package]
name = "alsa-utils"
version = "1.2.12"
release = 1
description = "ALSA sound card utilities (alsamixer, aplay, arecord)"
license = "GPL-2.0"
arch = ["x86_64", "aarch64"]

[dependencies]
runtime = ["alsa-lib"]

[build]
configure = "./configure --prefix=/usr --disable-alsatest"
compile = "make -j$(nproc)"
install = "make DESTDIR=$PKGDIR install"
