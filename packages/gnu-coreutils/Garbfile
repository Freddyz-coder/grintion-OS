[package]
name = "gnu-coreutils"
version = "9.5"
release = 1
description = "The basic file, shell and text manipulation utilities of the GNU operating system"
license = "GPL-3.0-or-later"
arch = ["x86_64", "aarch64"]

[security]
sha256 = "cd328edeac92f6a665de9f323c93b712af18c6342876b41a9c6d5f88e63f4f48"
hardened = true

[build]
configure = "./configure --prefix=/usr --enable-install-program=hostname"
compile = "make -j$(nproc)"
install = "make DESTDIR=$PKGDIR install"
