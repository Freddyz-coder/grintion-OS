[package]
name = "linux-hardened"
version = "6.12.8"
release = 1
description = "Vanilla Linux kernel compiled with security hardening for paranoid users"
license = "GPL-2.0"
arch = ["x86_64", "aarch64"]

[security]
sha256 = "b728b7e22a488a7c2e3fbbe3cfaeefd79f045239a5ad5611481e3a4e9b98bce1"
hardened = true
features = ["page_table_isolation", "aslr", "init_on_alloc", "init_on_free", "cgroups_v2", "user_namespaces"]

[build]
configure = "make defconfig && ./scripts/kconfig/merge_config.sh .config arch/x86/configs/grintion_hardened.config"
compile = "make -j$(nproc) bzImage modules"
install = "install -D -m 644 arch/x86/boot/bzImage $PKGDIR/boot/vmlinuz-grintion"
