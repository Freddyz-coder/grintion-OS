#!/bin/sh
# /init - Grintion-OS live environment
#
# The initramfs carries the complete read-only live root. It is used as the
# lower layer of an overlayfs: a tmpfs upper layer by default, or the ext4
# GRINTION_PERSIST partition when one is present. The overlay is made the real
# root with pivot_root, so PID 1 runs with the overlay as / and the initramfs
# remains available as the lower layer.

set -eu

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

[ -r /recovery.sh ] || { echo "[-] /recovery.sh is missing from the initramfs; halting" >&2; sleep 3; poweroff -f 2>/dev/null || reboot -f 2>/dev/null || exec /bin/sh; }
. /recovery.sh
trap 'rescue "fatal error during early boot (line $LINENO)"' EXIT


mkdir -p /proc /sys /dev /run /sys/fs/cgroup
mountpoint -q /proc || mount -t proc proc /proc -o nosuid,noexec,nodev

# The console is for operator-visible output. Kernel audit records generated
# before auditd connects are printed at KERN_NOTICE; /etc/sysctl.d raises the
# threshold later, but early udev and AppArmor events would already be on the
# boot screen. Apply the same value here, before any userspace starts.
printf '3 3 3 3' > /proc/sys/kernel/printk 2>/dev/null || true
mountpoint -q /sys || mount -t sysfs sys /sys -o nosuid,noexec,nodev
if ! mountpoint -q /dev; then
    mount -t devtmpfs dev /dev -o mode=0755,nosuid
fi
mkdir -p /dev/pts /dev/shm
mountpoint -q /dev/pts || mount -t devpts devpts /dev/pts -o mode=0620,gid=5,nosuid,noexec
mountpoint -q /dev/shm || mount -t tmpfs shm /dev/shm -o mode=1777,nosuid,nodev,noexec,size=25%
mountpoint -q /run || mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run
mountpoint -q /sys/fs/cgroup || mount -t cgroup2 none /sys/fs/cgroup -o nsdelegate 2>/dev/null || true

if [ -d /sys/firmware/efi ] && [ ! -d /sys/firmware/efi/efivars ]; then
    mount -t efivarfs efivarfs /sys/firmware/efi/efivars 2>/dev/null || true
fi

mkdir -p /run/overlay /run/persist /lower /newroot

# The persistence partition can be plain ext4 (legacy) or a LUKS2 container
# with the GRINTION_PERSIST label. blkid does not return LUKS2 labels through
# `blkid -L`, so inspect crypto_LUKS devices when the plain lookup misses.
PERSIST_DEV="$(blkid -L GRINTION_PERSIST 2>/dev/null || true)"
if [ -z "$PERSIST_DEV" ]; then
    PERSIST_DEV=$(for candidate in $(blkid -t TYPE=crypto_LUKS -o device 2>/dev/null || true); do
        if cryptsetup luksDump "$candidate" 2>/dev/null | grep -q -E '^Label:[[:space:]]*GRINTION_PERSIST[[:space:]]*$'; then
            printf '%s\n' "$candidate"
            break
        fi
    done)
fi

CRYPT_CONSOLE=""
SERIAL_CONSOLE=0
for arg in $(cat /proc/cmdline); do
    case "$arg" in
        grintion.cryptconsole=*) CRYPT_CONSOLE=${arg#*=} ;;
        grintion.serial=1)       SERIAL_CONSOLE=1 ;;
    esac
done

if [ -n "$PERSIST_DEV" ] && [ "$(blkid -o value -s TYPE "$PERSIST_DEV" 2>/dev/null || true)" = "crypto_LUKS" ]; then
    # devtmpfs does not create the device-mapper control node; cryptsetup
    # needs it before the first ioctl.
    mkdir -p /dev/mapper /run/cryptsetup /run/lock
    if [ ! -e /dev/mapper/control ]; then
        mknod /dev/mapper/control c 10 236 || true
    fi

    CONSOLE=${CRYPT_CONSOLE:-/dev/console}
    if [ -n "$CRYPT_CONSOLE" ] && [ -c "$CONSOLE" ]; then
        :
    elif [ "$SERIAL_CONSOLE" -eq 1 ] && [ -c /dev/ttyS0 ]; then
        CONSOLE=/dev/ttyS0
    elif [ ! -c "$CONSOLE" ]; then
        CONSOLE=/dev/console
    fi

    msg "persistence device $PERSIST_DEV is LUKS2-encrypted"
    PERSIST_UNLOCKED=0
    tries=3
    while [ "$tries" -gt 0 ]; do
        stty -echo <"$CONSOLE" 2>/dev/null || true
        printf 'Enter persistence passphrase: ' >"$CONSOLE"
        if IFS= read -r passphrase <"$CONSOLE"; then
            stty echo <"$CONSOLE" 2>/dev/null || true
            printf '\n' >"$CONSOLE"
            if printf '%s' "$passphrase" | cryptsetup luksOpen --key-file - \
                "$PERSIST_DEV" grintion-persist >"$CONSOLE" 2>&1; then
                passphrase=""
                PERSIST_UNLOCKED=1
                break
            fi
            passphrase=""
            msg "the persistence passphrase was not accepted ($tries attempts left)"
        else
            stty echo <"$CONSOLE" 2>/dev/null || true
            msg "could not read the persistence passphrase"
            break
        fi
        tries=$((tries - 1))
    done
    if [ "$PERSIST_UNLOCKED" -eq 1 ]; then
        PERSIST_DEV=/dev/mapper/grintion-persist
        msg "encrypted persistence unlocked"
    else
        msg "encrypted persistence could not be unlocked; using RAM"
        PERSIST_DEV=""
    fi
fi

UPPER=""
WORK=""
if [ -n "$PERSIST_DEV" ]; then
    mkdir -p /run/persist
    # The persistence partition is an overlay upper layer. It must never be
    # able to inject setuid binaries or device nodes into the booted system.
    if mount -o rw,noatime,nosuid,nodev "$PERSIST_DEV" /run/persist 2>/dev/null; then
        mkdir -p /run/persist/upper /run/persist/work
        chmod 0700 /run/persist/upper /run/persist/work
        UPPER=/run/persist/upper
        WORK=/run/persist/work
        msg "persistence enabled on $PERSIST_DEV"
    else
        msg "persistence partition could not be mounted; using RAM"
    fi
fi

if [ -z "$UPPER" ]; then
    # The overlay upper layer is RAM. Cap it at half of physical memory so a
    # package install can fail cleanly instead of triggering the OOM killer,
    # and let zram absorb the pressure once the zram service starts.
    mount -t tmpfs -o mode=0755,size=50% tmpfs /run/overlay
    mkdir -p /run/overlay/upper /run/overlay/work
    chmod 0700 /run/overlay/upper /run/overlay/work
    UPPER=/run/overlay/upper
    WORK=/run/overlay/work
    msg "RAM overlay active; changes are lost on poweroff"
fi

mount --bind / /lower || rescue "cannot bind the live root"
mount -t overlay overlay -o "lowerdir=/lower,upperdir=$UPPER,workdir=$WORK" /newroot \
    || rescue "cannot mount the overlay root"
chmod 0755 /newroot

# Nothing may propagate back into the initramfs while the root is replaced.
mount --make-rprivate / 2>/dev/null || true

for dir in proc sys dev run; do
    mkdir -p "/newroot/$dir"
    mount --move "/$dir" "/newroot/$dir" || rescue "cannot move /$dir"
done

# chroot(8) keeps the overlay's lower bind mount valid; switch_root would
# delete the initramfs that is the lower layer. exec keeps the chroot process
# as PID 1, which runit requires. The old root stays hidden behind the new
# process root and is never written to.
[ -x /newroot/sbin/init ] || rescue "the overlay has no /sbin/init"
exec chroot /newroot /sbin/init || rescue "failed to execute /sbin/init"

