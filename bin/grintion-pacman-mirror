#!/usr/bin/env python3
"""Select the fastest reachable official Arch Linux Archive mirror.

The image is pinned to a dated ALA snapshot because the base userland is linked
against OpenSSL 3.  Arch publishes a dedicated archive mirror in addition to
the primary host; from many networks the primary is dramatically slower.  This
tool probes a small range of core.db on each endpoint, then rewrites the three
dated Server lines in pacman.conf so every package operation uses the faster
one while keeping the snapshot date and package signatures unchanged.
"""
from __future__ import annotations

import argparse
import os
import re
import sys
import tempfile
import time
import urllib.error
import urllib.request
from concurrent.futures import ThreadPoolExecutor, as_completed
from pathlib import Path

PRIMARY = "https://archive.archlinux.org"
DEFAULT_MIRRORS = (PRIMARY, "https://umea.archive.pkgbuild.com")
PROBE_BYTES = 128 * 1024
DATE_RE = re.compile(r"\d{4}/\d{2}/\d{2}")
SNAPSHOT_RE = re.compile(r"/repos/(\d{4}/\d{2}/\d{2})/")
SERVER_RE = re.compile(r"^\s*Server\s*=\s*(https?://\S+)\s*$")
REPOSITORY_RE = re.compile(r"^\s*\[[^\]]+\]\s*$")


def read_snapshot(root: Path) -> str:
    candidates = (
        root / "etc/grintion/arch-snapshot",
        root / "etc/pacman.d/grintion-mirror",
        root / "etc/pacman.conf",
    )
    for path in candidates:
        try:
            text = path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        match = SNAPSHOT_RE.search(text)
        if match is not None:
            return match.group(1)
    raise ValueError(
        "cannot find the Arch snapshot date; expected /etc/pacman.conf "
        "or /etc/grintion/arch-snapshot"
    )


def configured_mirrors() -> list[str]:
    raw = os.environ.get("GRINTION_ALA_MIRRORS", "")
    values = raw.split(",") if raw else list(DEFAULT_MIRRORS)
    mirrors: list[str] = []
    for value in values:
        base = value.strip().rstrip("/")
        if not re.match(r"^https?://[^/]+", base) or any(ch.isspace() for ch in base):
            raise ValueError(f"invalid ALA mirror URL: {value!r}")
        if base not in mirrors:
            mirrors.append(base)
    if not mirrors:
        raise ValueError("no ALA mirrors configured")
    return mirrors


def probe(base: str, snapshot: str, timeout: float) -> tuple[str, float]:
    url = f"{base}/repos/{snapshot}/core/os/x86_64/core.db"
    request = urllib.request.Request(
        url,
        headers={
            "Range": f"bytes=0-{PROBE_BYTES - 1}",
            "User-Agent": "grintion-pacman-mirror/1",
        },
    )
    started = time.monotonic()
    with urllib.request.urlopen(request, timeout=timeout) as response:
        status = getattr(response, "status", 200)
        data = response.read(PROBE_BYTES)
    elapsed = max(time.monotonic() - started, 0.001)
    if status not in (200, 206) or not data:
        raise OSError(f"unexpected HTTP status {status}")
    return base, len(data) / elapsed


def choose_mirror(
    mirrors: list[str], snapshot: str, timeout: float
) -> tuple[str | None, float]:
    results: list[tuple[str, float]] = []
    with ThreadPoolExecutor(max_workers=min(4, len(mirrors))) as pool:
        futures = {
            pool.submit(probe, mirror, snapshot, timeout): mirror
            for mirror in mirrors
        }
        for future in as_completed(futures):
            try:
                results.append(future.result())
            except (OSError, urllib.error.URLError, TimeoutError):
                continue
    if not results:
        return None, 0.0
    return max(results, key=lambda item: item[1])


def rewrite_config(path: Path, snapshot: str, mirrors: list[str]) -> bool:
    original = path.read_text(encoding="utf-8")
    output: list[str] = []
    replaced = 0
    section_has_servers = False
    for line in original.splitlines():
        if REPOSITORY_RE.match(line):
            section_has_servers = False
            output.append(line)
            continue
        match = SERVER_RE.match(line)
        if match is None:
            output.append(line)
            continue
        dated = SNAPSHOT_RE.search(match.group(1))
        if dated is None or dated.group(1) != snapshot:
            output.append(line)
            continue
        if section_has_servers:
            continue
        section_has_servers = True
        for mirror in mirrors:
            output.append(f"Server = {mirror}/repos/{snapshot}/$repo/os/$arch")
        replaced += 1
    if replaced == 0:
        raise ValueError(f"{path} has no dated Server line for {snapshot}")
    updated = "\n".join(output) + "\n"
    if updated == original:
        return False
    mode = path.stat().st_mode & 0o777
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary_path = Path(temporary)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(updated)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary_path, mode)
        os.replace(temporary_path, path)
    except BaseException:
        temporary_path.unlink(missing_ok=True)
        raise
    return True


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="grintion-pacman-mirror",
        description="Use the fastest official Arch Linux Archive mirror for pacman.",
    )
    parser.add_argument("--root", type=Path, default=Path("/"))
    parser.add_argument("--snapshot", help="snapshot date in YYYY/MM/DD form")
    parser.add_argument("--timeout", type=float, default=6.0)
    parser.add_argument("--quiet", action="store_true")
    args = parser.parse_args()

    root = args.root.resolve()
    try:
        snapshot = args.snapshot or read_snapshot(root)
        if not DATE_RE.fullmatch(snapshot):
            raise ValueError(f"invalid snapshot date: {snapshot!r}")
        mirrors = configured_mirrors()
        selected, speed = choose_mirror(mirrors, snapshot, max(args.timeout, 1.0))
        if selected is None:
            if not args.quiet:
                print(
                    "[!] no Arch Linux Archive mirror responded; keeping the "
                    "configured mirror",
                    file=sys.stderr,
                )
            return 1
        ordered = [selected] + [mirror for mirror in mirrors if mirror != selected]
        rewrite_config(root / "etc/pacman.conf", snapshot, ordered)
    except (OSError, ValueError) as exc:
        if not args.quiet:
            print(f"[-] cannot select an Arch mirror: {exc}", file=sys.stderr)
        return 1

    if not args.quiet:
        print(
            f"[+] Arch Linux Archive mirror: {selected} "
            f"({speed / 1024:.0f} KiB/s)",
            file=sys.stderr,
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
