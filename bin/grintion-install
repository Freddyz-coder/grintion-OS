#!/usr/bin/env bash
# grintion-install - install Grintion-OS from the live image to a disk.
#
# The installer is deliberately explicit: every privileged step is checked,
# every generated identifier is derived from blkid, and every failure path
# unmounts the target. It never bootstraps the OS with garb; the live root is
# the source of truth and is copied once.

set -Eeuo pipefail
export LC_ALL=C

VERSION="$(cat /etc/grintion/version 2>/dev/null || echo unknown)"
TARGET=/mnt
DISK=""
HOSTNAME="grintion"
USER_NAME=""
USER_PASSWORD=""
ROOT_PASSWORD=""
PASSWORD_STDIN=0
ROOT_PASSWORD_STDIN=0
DESKTOP=""
DESKTOP_READY=1
KERNEL_FLAVOR="lts"
KERNEL_READY=1
UNATTENDED=0
DRY_RUN=0
NO_BOOTLOADER=0
FORCE=0
ENCRYPT=0
PASSPHRASE_STDIN=0
LUKS_PASSPHRASE=""
FILESYSTEM="ext4"
SECURITY_PROFILE="workstation"
SEPARATE_HOME=0
HOME_SIZE_MIB=0
CONFIG_FILE=""
DRY_RUN_JSON=0
SKIP_SMART=0
SKIP_SELF_TEST=0
SERIAL_CONSOLE=0
SELF_TEST_OK=1
AUTO_DRIVERS=1
DRIVERS_READY=1
COMPAT32=0
COMPAT32_READY=1
MICROCODE_MODULE=""
CRYPT_NAME="grintion"
SWAP_CRYPT_NAME="grintion-swap"
HOME_CRYPT_NAME="grintion-home"
LUKS_UUID=""
SWAP_CRYPT_UUID=""
HOME_CRYPT_UUID=""
SWAP_KEY_FILE=""
HOME_KEY_FILE=""
BTRFS_STAGE=""
ESP_SIZE_MIB=512
SWAP_SIZE_MIB=0
SWAP_FILE_MIB=0
CUSTOM_PARTITIONS=0
ROOT_PART_SPEC=""
ESP_PART_SPEC=""
SWAP_PART_SPEC=""
HOME_PART_SPEC=""
HOME_PART=""
ENCRYPT_HOME=0
SECURE_ERASE=0
KEEP_HOME=0
REMOVABLE=0
RECOVERY_PARTITION=0
RECOVERY_SIZE_MIB=1024
TUI_MODE=0
# DUAL_BOOT_ENTRIES is populated later; this sentinel is intentionally unused.

usage() {
    cat <<'EOF'
Usage: grintion-install [OPTIONS]

Install Grintion-OS onto a disk or pre-existing partitions.

Options:
  --disk DEV            Target block device (e.g. /dev/vda, /dev/nvme0n1)
  --custom              Manual / custom partition assignment mode
  --root-part DEV       Target root partition (used with --custom)
  --esp-part DEV        Target EFI system partition (used with --custom)
  --swap-part DEV       Target swap partition (used with --custom)
  --home-part DEV       Target home partition (used with --custom)
  --hostname NAME       Installed hostname (default: grintion)
  --user NAME           Create an administrative user in the wheel group
  --password-stdin      Read the user password from standard input
  --root-password-stdin Read the root password from standard input
  --desktop ENV         Pre-install GUI desktop (xfce, gnome, kde, lxqt, sway, i3, none)
  --kernel FLAVOR       Kernel flavor: lts (default), hwe, or dkms
                        hwe/dkms install Arch's current kernel and a separate
                        Limine entry; LTS remains available as a fallback
  --security-profile PROF Security profile: workstation (default), server, kiosk, air-gapped
  --swap-size MIB       Add a linux-swap partition at the end of the disk (default: 0)
  --swap-file MIB       Create a swapfile on root of the given size in MiB
  --encrypt             Encrypt the root partition with LUKS2
  --encrypt-home        Encrypt the /home partition/volume with LUKS2
  --passphrase-stdin    Read the LUKS passphrase from standard input
  --filesystem FS       Root filesystem: ext4 (default), btrfs, xfs, f2fs
  --separate-home       Put /home on its own subvolume or partition
  --home-size MIB       Separate /home partition size in MiB (for ext4/xfs/btrfs)
  --keep-home           Preserve existing /home data across reinstallation
  --secure-erase        Perform a secure wipe of the target disk before partitioning
  --removable           Install for removable/USB drive (fallback EFI binary, no efibootmgr)
  --recovery-partition  Create a dedicated recovery partition
  --recovery-size MIB   Size of recovery partition in MiB (default: 1024)
  --tui, --interactive  Launch guided installation wizard
  --config FILE         JSON answer file; command-line flags override it
  --json                With --dry-run, print a machine-readable plan
  --skip-smart          Skip the SMART health preflight
  --skip-self-test      Skip the post-install self-test
  --serial              Put ttyS0 last so LUKS prompts appear on serial
  --compat32            Install 32-bit glibc/gcc runtime on a 64-bit system
  --no-auto-drivers     Do not auto-install firmware/microcode for this hardware
  --unattended          Never prompt; requires --disk/--custom, --user and password
  --dry-run             Validate the plan and exit without changing anything
  --no-bootloader       Skip Limine installation
  --force               Allow running from an installed system; also bypass the
                        Secure Boot refusal when you provide your own signed bootloader
  -h, --help            Show this help

Environment:
  GRINTION_USER_PASSWORD    Password for --user on an unattended install
  GRINTION_ROOT_PASSWORD    Root password; root stays locked when unset
  GRINTION_LUKS_PASSPHRASE  LUKS passphrase; prefer --passphrase-stdin

Passwords are never accepted as command-line arguments: they would be visible
in the process list and in shell history. Use the interactive prompt,
--password-stdin/--root-password-stdin, or the environment variables above.

Examples:
  grintion-install --disk /dev/vda
  grintion-install --disk /dev/vda --user grintion --desktop xfce
  grintion-install --disk /dev/vda --desktop kde --kernel hwe
  printf '%s\n' 'secret' | grintion-install --unattended --disk /dev/vda \
      --hostname box --user grintion --password-stdin
EOF
}

log()  { printf '\033[1;32m[*]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[!]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[-]\033[0m %s\n' "$*" >&2; exit 1; }

config_value() {
    python3 - "$CONFIG_FILE" "$1" <<'PY'
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as handle:
        data = json.load(handle)
except (OSError, json.JSONDecodeError):
    raise SystemExit(2)
if not isinstance(data, dict):
    raise SystemExit(2)
value = data.get(sys.argv[2], "")
if isinstance(value, bool):
    print("1" if value else "0")
elif value is None:
    print("")
else:
    print(value)
PY
}

secure_boot_enabled() {
    [ -d /sys/firmware/efi ] || return 1
    local var value
    for var in /sys/firmware/efi/efivars/SecureBoot-*; do
        [ -f "$var" ] || continue
        value=$(od -An -t u1 -j 4 -N 1 "$var" 2>/dev/null | tr -d ' \n')
        [ "$value" = "1" ] && return 0
        return 1
    done
    return 1
}

# Read the answer file before the option loop so CLI flags always win.
CONFIG_FILE=""
_previous=""
for _arg in "$@"; do
    if [ "$_previous" = "--config" ]; then CONFIG_FILE=$_arg; fi
    _previous=$_arg
done
unset _previous _arg
if [ -n "$CONFIG_FILE" ]; then
    [ -r "$CONFIG_FILE" ] || die "answer file is not readable: $CONFIG_FILE"
    python3 - "$CONFIG_FILE" >/dev/null 2>&1 <<'PY' || die "invalid JSON answer file: $CONFIG_FILE"
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    data = json.load(handle)
if not isinstance(data, dict):
    raise SystemExit(2)
PY
    _value=$(config_value disk);            [ -n "$_value" ] && DISK=$_value
    _value=$(config_value custom);          case "$_value" in 1|true|True|yes) CUSTOM_PARTITIONS=1 ;; esac
    _value=$(config_value root_part);       [ -n "$_value" ] && ROOT_PART_SPEC=$_value
    _value=$(config_value esp_part);        [ -n "$_value" ] && ESP_PART_SPEC=$_value
    _value=$(config_value swap_part);       [ -n "$_value" ] && SWAP_PART_SPEC=$_value
    _value=$(config_value home_part);       [ -n "$_value" ] && HOME_PART_SPEC=$_value; [ -n "$_value" ] && SEPARATE_HOME=1
    _value=$(config_value encrypt_home);    case "$_value" in 1|true|True|yes) ENCRYPT_HOME=1 ;; esac
    _value=$(config_value home_size);       [ -n "$_value" ] && HOME_SIZE_MIB=$_value; [ -n "$_value" ] && SEPARATE_HOME=1
    _value=$(config_value swap_file);       [ -n "$_value" ] && SWAP_FILE_MIB=$_value
    _value=$(config_value secure_erase);    case "$_value" in 1|true|True|yes) SECURE_ERASE=1 ;; esac
    _value=$(config_value keep_home);       case "$_value" in 1|true|True|yes) KEEP_HOME=1 ;; esac
    _value=$(config_value removable);       case "$_value" in 1|true|True|yes) REMOVABLE=1 ;; esac
    _value=$(config_value recovery_partition); case "$_value" in 1|true|True|yes) RECOVERY_PARTITION=1 ;; esac
    _value=$(config_value recovery_size);   [ -n "$_value" ] && RECOVERY_SIZE_MIB=$_value
    _value=$(config_value hostname);        [ -n "$_value" ] && HOSTNAME=$_value
    _value=$(config_value user);            [ -n "$_value" ] && USER_NAME=$_value
    _value=$(config_value desktop);         [ -n "$_value" ] && DESKTOP=$_value
    _value=$(config_value kernel);          [ -n "$_value" ] && KERNEL_FLAVOR=$_value
    _value=$(config_value security_profile); [ -n "$_value" ] && SECURITY_PROFILE=$_value
    _value=$(config_value filesystem);      [ -n "$_value" ] && FILESYSTEM=$_value
    _value=$(config_value swap_size);       [ -n "$_value" ] && SWAP_SIZE_MIB=$_value
    _value=$(config_value encrypt);          case "$_value" in 1|true|True|yes) ENCRYPT=1 ;; *) ENCRYPT=0 ;; esac
    _value=$(config_value separate_home);    case "$_value" in 1|true|True|yes) SEPARATE_HOME=1 ;; esac
    _value=$(config_value serial_console);   case "$_value" in 1|true|True|yes) SERIAL_CONSOLE=1 ;; *) SERIAL_CONSOLE=0 ;; esac
    _value=$(config_value compat32);         case "$_value" in 1|true|True|yes) COMPAT32=1 ;; esac
    _value=$(config_value auto_drivers);     case "$_value" in 0|false|False|no) AUTO_DRIVERS=0 ;; esac
    unset _value
fi

while [ $# -gt 0 ]; do
    case "$1" in
        --disk)          DISK=${2:-}; shift 2 ;;
        --custom|--custom-partitions) CUSTOM_PARTITIONS=1; shift ;;
        --root-part)     ROOT_PART_SPEC=${2:-}; shift 2 ;;
        --esp-part)      ESP_PART_SPEC=${2:-}; shift 2 ;;
        --swap-part)     SWAP_PART_SPEC=${2:-}; shift 2 ;;
        --home-part)     HOME_PART_SPEC=${2:-}; SEPARATE_HOME=1; shift 2 ;;
        --home-size)     HOME_SIZE_MIB=${2:-}; SEPARATE_HOME=1; shift 2 ;;
        --encrypt-home)  ENCRYPT_HOME=1; shift ;;
        --swap-file)     SWAP_FILE_MIB=${2:-}; shift 2 ;;
        --secure-erase)  SECURE_ERASE=1; shift ;;
        --keep-home)     KEEP_HOME=1; shift ;;
        --removable|--usb) REMOVABLE=1; shift ;;
        --recovery-partition) RECOVERY_PARTITION=1; shift ;;
        --recovery-size) RECOVERY_SIZE_MIB=${2:-}; RECOVERY_PARTITION=1; shift 2 ;;
        --tui|--interactive) TUI_MODE=1; shift ;;
        --hostname)      HOSTNAME=${2:-}; shift 2 ;;
        --user)          USER_NAME=${2:-}; shift 2 ;;
        --password|--root-password)
                         die "$1 was removed because the password is visible in 'ps' and shell history; use --password-stdin, --root-password-stdin or GRINTION_USER_PASSWORD/GRINTION_ROOT_PASSWORD" ;;
        --password-stdin) PASSWORD_STDIN=1; shift ;;
        --root-password-stdin) ROOT_PASSWORD_STDIN=1; shift ;;
        --desktop)       DESKTOP=${2:-}; shift 2 ;;
        --kernel)        KERNEL_FLAVOR=${2:-}; shift 2 ;;
        --security-profile) SECURITY_PROFILE=${2:-}; shift 2 ;;
        --swap-size)     SWAP_SIZE_MIB=${2:-}; shift 2 ;;
        --encrypt)       ENCRYPT=1; shift ;;
        --passphrase-stdin) PASSPHRASE_STDIN=1; shift ;;
        --filesystem)    FILESYSTEM=${2:-}; shift 2 ;;
        --separate-home) SEPARATE_HOME=1; shift ;;
        --config)        CONFIG_FILE=${2:-}; shift 2 ;;
        --json)          DRY_RUN_JSON=1; shift ;;
        --skip-smart)    SKIP_SMART=1; shift ;;
        --skip-self-test) SKIP_SELF_TEST=1; shift ;;
        --serial)        SERIAL_CONSOLE=1; shift ;;
        --compat32)      COMPAT32=1; shift ;;
        --auto-drivers)  AUTO_DRIVERS=1; shift ;;
        --no-auto-drivers) AUTO_DRIVERS=0; shift ;;
        --unattended)    UNATTENDED=1; shift ;;
        --dry-run)       DRY_RUN=1; shift ;;
        --no-bootloader) NO_BOOTLOADER=1; shift ;;
        --force)         FORCE=1; shift ;;
        -h|--help)       usage; exit 0 ;;
        *)               die "unknown option: $1 (see --help)" ;;
    esac
done

run_guided_tui() {
    echo "=============================================================="
    echo "Grintion-OS $VERSION - Guided Installation Wizard"
    echo "=============================================================="
    echo "1. Partitioning Mode:"
    echo "   [1] Entire disk (automatic layout)"
    echo "   [2] Custom / manual partition assignment"
    printf "Choose mode [1]: "
    read -r mode_choice
    mode_choice=${mode_choice:-1}
    if [ "$mode_choice" = "2" ]; then
        CUSTOM_PARTITIONS=1
        echo "Available partitions:"
        lsblk -lnpo NAME,SIZE,FSTYPE,MOUNTPOINT | grep -v 'loop' || true
        printf "ESP partition (e.g. /dev/vda1): "
        read -r ESP_PART_SPEC
        printf "Root partition (e.g. /dev/vda2): "
        read -r ROOT_PART_SPEC
        printf "Swap partition (optional, e.g. /dev/vda3, or enter for none): "
        read -r SWAP_PART_SPEC
        printf "Home partition (optional, e.g. /dev/vda4, or enter for none): "
        read -r HOME_PART_SPEC
        [ -n "$HOME_PART_SPEC" ] && SEPARATE_HOME=1
    else
        echo "Available disks:"
        lsblk -d -o NAME,SIZE,MODEL,TYPE | grep -E 'disk|nvme' || true
        printf "Target disk (e.g. /dev/vda): "
        read -r DISK
    fi

    echo
    echo "2. Root Filesystem:"
    echo "   [1] ext4 (Traditional, robust)"
    echo "   [2] btrfs (Modern, snapshots, subvolumes)"
    printf "Choose filesystem [1]: "
    read -r fs_choice
    case "${fs_choice:-1}" in
        2|btrfs) FILESYSTEM="btrfs" ;;
        *) FILESYSTEM="ext4" ;;
    esac

    echo
    echo "3. Disk Encryption:"
    echo "   [1] None"
    echo "   [2] LUKS2 root encryption"
    printf "Choose encryption [1]: "
    read -r enc_choice
    case "${enc_choice:-1}" in
        2|yes|y) ENCRYPT=1 ;;
        *) ENCRYPT=0 ;;
    esac

    echo
    echo "4. Swap Configuration:"
    echo "   [1] No swap"
    echo "   [2] Swap partition (e.g. 2048 MiB)"
    echo "   [3] Swap file on root (e.g. 2048 MiB)"
    printf "Choose swap option [1]: "
    read -r swap_choice
    case "${swap_choice:-1}" in
        2)
            printf "Swap partition size in MiB [2048]: "
            read -r sz
            SWAP_SIZE_MIB=${sz:-2048}
            ;;
        3)
            printf "Swap file size in MiB [2048]: "
            read -r sz
            SWAP_FILE_MIB=${sz:-2048}
            ;;
        *) SWAP_SIZE_MIB=0; SWAP_FILE_MIB=0 ;;
    esac

    echo
    echo "5. Desktop Environment:"
    echo "   [1] None (Console-only base system)"
    echo "   [2] XFCE 4 (Lightweight X11 desktop)"
    echo "   [3] i3 (Tiling window manager)"
    echo "   [4] Sway (Wayland tiling compositor)"
    echo "   [5] GNOME (Modern desktop)"
    echo "   [6] KDE Plasma (Feature-rich desktop)"
    printf "Choose desktop [1]: "
    read -r dt_choice
    case "${dt_choice:-1}" in
        2) DESKTOP="xfce" ;;
        3) DESKTOP="i3" ;;
        4) DESKTOP="sway" ;;
        5) DESKTOP="gnome" ;;
        6) DESKTOP="kde" ;;
        *) DESKTOP="none" ;;
    esac

    echo
    echo "6. Kernel flavor:"
    echo "   [1] LTS  (source-built 6.12 kernel, no extra download) [default]"
    echo "   [2] HWE  (Arch current kernel + headers for newer hardware)"
    echo "   [3] DKMS (HWE kernel + headers + dynamic module builds)"
    printf "Choose kernel flavor [1]: "
    read -r kernel_choice
    case "${kernel_choice:-1}" in
        2|hwe) KERNEL_FLAVOR="hwe" ;;
        3|dkms) KERNEL_FLAVOR="dkms" ;;
        *) KERNEL_FLAVOR="lts" ;;
    esac

    echo
    printf "Hostname [grintion]: "
    read -r HOSTNAME
    HOSTNAME=${HOSTNAME:-grintion}

    printf "Administrative username [grintion]: "
    read -r USER_NAME
    USER_NAME=${USER_NAME:-grintion}
}

if [ "$TUI_MODE" -eq 1 ] || { [ "$UNATTENDED" -ne 1 ] && [ -z "$DISK" ] && [ "$CUSTOM_PARTITIONS" -eq 0 ] && [ -t 0 ]; }; then
    if [ "$TUI_MODE" -eq 1 ]; then
        run_guided_tui
    fi
fi

[ "$(id -u)" -eq 0 ] || [ "$DRY_RUN" -eq 1 ] || die "grintion-install must run as root"
if [ ! -f /etc/grintion/live ] && [ "$FORCE" -ne 1 ] && [ "$DRY_RUN" -ne 1 ]; then
    die "this does not look like the live image; use --force to override"
fi

if secure_boot_enabled && [ "$FORCE" -ne 1 ]; then
    die "Secure Boot is enabled. Grintion-OS does not ship a signed boot chain, so the installed system would not boot. Disable Secure Boot in firmware, or rerun with --force only if you will provide your own signed bootloader."
fi

# Architecture policy: the release image is x86_64. A CPU without long mode
# cannot execute its kernel, so refuse before partitioning rather than leaving
# an unbootable disk. On a 64-bit machine, 32-bit software is allowed through
# CONFIG_IA32_EMULATION; --compat32 installs the 32-bit runtime libraries.
if command -v grintion-arch >/dev/null 2>&1; then
    if ! grintion-arch check --require install; then
        [ "$DRY_RUN" -eq 1 ] || die "this machine cannot run the x86_64 Grintion-OS image"
    fi
else
    warn "grintion-arch is missing; architecture compatibility was not checked"
fi

case "$FILESYSTEM" in
    ext4|btrfs|xfs|f2fs) ;;
    *) die "unsupported --filesystem: $FILESYSTEM (use ext4, btrfs, xfs, or f2fs)" ;;
esac
if [ "$DRY_RUN_JSON" -eq 1 ] && [ "$DRY_RUN" -ne 1 ]; then
    die "--json is only valid with --dry-run"
fi

for tool in parted partprobe mkfs.vfat blkid rsync openssl python3 od; do
    command -v "$tool" >/dev/null 2>&1 || die "required installer tool is missing: $tool"
done
case "$FILESYSTEM" in
    btrfs)
        for tool in mkfs.btrfs btrfs; do
            command -v "$tool" >/dev/null 2>&1 || die "required Btrfs tool is missing: $tool"
        done
        ;;
    xfs)
        command -v mkfs.xfs >/dev/null 2>&1 || die "required XFS tool is missing: mkfs.xfs"
        ;;
    f2fs)
        command -v mkfs.f2fs >/dev/null 2>&1 || die "required F2FS tool is missing: mkfs.f2fs"
        ;;
    ext4)
        command -v mkfs.ext4 >/dev/null 2>&1 || die "required installer tool is missing: mkfs.ext4"
        ;;
esac
if [ "$ENCRYPT" -eq 1 ] || [ "$ENCRYPT_HOME" -eq 1 ]; then
    command -v cryptsetup >/dev/null 2>&1 || die "encryption requires cryptsetup"
fi

if [ "$CUSTOM_PARTITIONS" -eq 1 ]; then
    [ -n "$ROOT_PART_SPEC" ] || die "--root-part is required with --custom"
    [ -n "$ESP_PART_SPEC" ]  || die "--esp-part is required with --custom"
    if [ "$DRY_RUN" -ne 1 ]; then
        [ -b "$ROOT_PART_SPEC" ] || die "not a block device: $ROOT_PART_SPEC"
        [ -b "$ESP_PART_SPEC" ]  || die "not a block device: $ESP_PART_SPEC"
    fi
    if [ -z "$DISK" ]; then
        DISK="$(lsblk -no PKNAME "$ROOT_PART_SPEC" 2>/dev/null | head -1 || true)"
        if [ -n "$DISK" ] && [ -b "/dev/$DISK" ]; then
            DISK="/dev/$DISK"
        else
            DISK="$ROOT_PART_SPEC"
        fi
    fi
    DISK_SIZE="$(blockdev --getsize64 "$ROOT_PART_SPEC" 2>/dev/null || echo 10737418240)"
else
    if [ -z "$DISK" ]; then
        if [ "$UNATTENDED" -eq 1 ]; then
            die "--disk is required with --unattended"
        fi
        echo "Available disks:"
        lsblk -d -o NAME,SIZE,MODEL,TYPE | grep -E 'disk|nvme' || true
        printf "Target disk (e.g. /dev/vda): "
        read -r DISK
    fi
    [ -b "$DISK" ] || [ "$DRY_RUN" -eq 1 ] || die "not a block device: $DISK"
    DISK_SIZE="$(blockdev --getsize64 "$DISK" 2>/dev/null || echo 10737418240)"
    [ "$DISK_SIZE" -ge 4294967296 ] || [ "$DRY_RUN" -eq 1 ] || die "target disk must be at least 4 GiB"
fi

case "$SWAP_SIZE_MIB" in
    ''|*[!0-9]*) die "invalid --swap-size: $SWAP_SIZE_MIB" ;;
esac
case "$SWAP_FILE_MIB" in
    ''|*[!0-9]*) die "invalid --swap-file: $SWAP_FILE_MIB" ;;
esac
case "$HOME_SIZE_MIB" in
    ''|*[!0-9]*) die "invalid --home-size: $HOME_SIZE_MIB" ;;
esac
DISK_MIB=$((DISK_SIZE / 1048576))
if [ "$SWAP_SIZE_MIB" -gt 0 ] && [ "$SWAP_SIZE_MIB" -gt "$((DISK_MIB - 1024))" ]; then
    die "--swap-size must leave at least 1 GiB for the ESP and root"
fi

if [ "$SKIP_SMART" -eq 0 ] && [ "$DRY_RUN" -eq 0 ] && command -v smartctl >/dev/null 2>&1; then
    SMART_LOG="/tmp/grintion-smart.$$"
    if smartctl -H "$DISK" >"$SMART_LOG" 2>&1; then
        if grep -q 'FAILED' "$SMART_LOG"; then
            rm -f "$SMART_LOG"
            die "SMART reports a failing disk: $DISK"
        elif grep -q 'PASSED' "$SMART_LOG"; then
            log "SMART health check passed"
        else
            warn "SMART health could not be interpreted; continuing"
        fi
    else
        warn "SMART health could not be read (virtual or USB disk?); continuing"
    fi
    rm -f "$SMART_LOG"
fi

# Refuse to overwrite a mounted disk.
if findmnt -rn -S "$DISK" >/dev/null 2>&1 || findmnt -rn -S "${DISK}1" >/dev/null 2>&1; then
    die "a partition of $DISK is mounted; unmount it first"
fi

if [ -z "$USER_NAME" ]; then
    if [ "$UNATTENDED" -eq 1 ]; then
        die "--user is required with --unattended"
    fi
    printf "Administrative username [grintion]: "
    read -r USER_NAME
    USER_NAME=${USER_NAME:-grintion}
fi
case "$USER_NAME" in
    root|""|*[!a-z0-9_-]*) die "invalid username: $USER_NAME" ;;
esac

if [ -n "${GRINTION_USER_PASSWORD-}" ] && [ -z "$USER_PASSWORD" ]; then
    USER_PASSWORD=$GRINTION_USER_PASSWORD
fi
if [ "$PASSWORD_STDIN" -eq 1 ]; then
    IFS= read -r USER_PASSWORD || die "no password was provided on standard input"
fi
if [ "$DRY_RUN" -eq 1 ] && [ -z "$USER_PASSWORD" ]; then
    USER_PASSWORD="dry-run-placeholder"
fi
if [ -z "$USER_PASSWORD" ]; then
    if [ "$UNATTENDED" -eq 1 ]; then
        die "--password-stdin or GRINTION_USER_PASSWORD is required with --unattended"
    fi
    local_pwd_tries=0
    while :; do
        local_pwd_tries=$((local_pwd_tries + 1))
        printf "Password for %s: " "$USER_NAME"
        read -rs USER_PASSWORD
        echo
        printf "Repeat password: "
        read -rs USER_PASSWORD2
        echo
        if [ "$USER_PASSWORD" = "$USER_PASSWORD2" ]; then
            if [ -n "$USER_PASSWORD" ]; then
                break
            fi
            warn "the administrative password cannot be empty"
        else
            warn "passwords do not match"
        fi
        if [ "$local_pwd_tries" -ge 3 ]; then
            die "passwords do not match after 3 attempts"
        fi
    done
fi
[ -n "$USER_PASSWORD" ] || die "the administrative password cannot be empty"

if [ "$UNATTENDED" -ne 1 ] && [ -z "$HOSTNAME" ]; then
    printf "Hostname [grintion]: "
    read -r HOSTNAME
    HOSTNAME=${HOSTNAME:-grintion}
fi
case "$HOSTNAME" in
    ""|*[!a-zA-Z0-9.-]*) die "invalid hostname: $HOSTNAME" ;;
esac

case "$SECURITY_PROFILE" in
    workstation|server|kiosk|air-gapped) ;;
    *) die "invalid security profile: $SECURITY_PROFILE (must be workstation, server, kiosk, or air-gapped)" ;;
esac

case "$KERNEL_FLAVOR" in
    lts|hwe|dkms) ;;
    *) die "invalid kernel flavor: $KERNEL_FLAVOR (must be lts, hwe, or dkms)" ;;
esac
if [ "$KERNEL_FLAVOR" != "lts" ] && [ "$NO_BOOTLOADER" -eq 1 ]; then
    die "--kernel $KERNEL_FLAVOR requires the Limine bootloader; remove --no-bootloader or use --kernel lts"
fi

if [ "$UNATTENDED" -ne 1 ] && [ -z "$DESKTOP" ]; then
    printf "Pre-install Desktop Environment (none/xfce/gnome/kde/lxqt/sway) [none]: "
    read -r DESKTOP
    DESKTOP=${DESKTOP:-none}
fi

# Reject a typo before partitioning or formatting anything. Previously an
# unknown profile was discovered only after the base system had been written,
# leaving a console-only disk and a failed install.
if [ -n "$DESKTOP" ] && [ "$DESKTOP" != "none" ]; then
    desktop_profile="$DESKTOP"
    if [ "$desktop_profile" = "plasma" ]; then
        desktop_profile=kde
    fi
    case "$desktop_profile" in
        xfce|gnome|kde|lxqt|sway|i3) ;;
        *) die "unknown desktop environment: $DESKTOP (use none, xfce, gnome, kde, lxqt, sway, or i3)" ;;
    esac
    [ -f "/etc/grintion/desktops.d/$desktop_profile.conf" ] \
        || die "desktop profile is missing: /etc/grintion/desktops.d/$desktop_profile.conf"
fi

if [ "$ROOT_PASSWORD_STDIN" -eq 1 ]; then
    IFS= read -r ROOT_PASSWORD || die "no root password was provided on standard input"
elif [ -n "${GRINTION_ROOT_PASSWORD-}" ] && [ -z "$ROOT_PASSWORD" ]; then
    ROOT_PASSWORD=$GRINTION_ROOT_PASSWORD
fi
ROOT_SET=0
if [ -n "$ROOT_PASSWORD" ]; then
    ROOT_SET=1
fi

if [ "$ENCRYPT" -eq 1 ] && [ "$DRY_RUN" -ne 1 ]; then
    if [ -n "${GRINTION_LUKS_PASSPHRASE-}" ] && [ -z "$LUKS_PASSPHRASE" ]; then
        LUKS_PASSPHRASE=$GRINTION_LUKS_PASSPHRASE
    fi
    if [ "$PASSPHRASE_STDIN" -eq 1 ]; then
        IFS= read -r LUKS_PASSPHRASE || die "no LUKS passphrase was provided on standard input"
    fi
    if [ -z "$LUKS_PASSPHRASE" ]; then
        if [ "$UNATTENDED" -eq 1 ]; then
            die "--passphrase-stdin or GRINTION_LUKS_PASSPHRASE is required with --encrypt --unattended"
        fi
        local_luks_tries=0
        while :; do
            local_luks_tries=$((local_luks_tries + 1))
            printf "LUKS passphrase: "
            read -rs LUKS_PASSPHRASE
            echo
            printf "Repeat LUKS passphrase: "
            read -rs LUKS_PASSPHRASE2
            echo
            if [ "$LUKS_PASSPHRASE" = "$LUKS_PASSPHRASE2" ]; then
                if [ -n "$LUKS_PASSPHRASE" ]; then
                    break
                fi
                warn "the LUKS passphrase cannot be empty"
            else
                warn "LUKS passphrases do not match"
            fi
            if [ "$local_luks_tries" -ge 3 ]; then
                die "LUKS passphrases do not match after 3 attempts"
            fi
        done
    fi
    [ -n "$LUKS_PASSPHRASE" ] || die "the LUKS passphrase cannot be empty"
fi

if [ "$UNATTENDED" -ne 1 ] && [ "$DRY_RUN" -ne 1 ]; then
    echo
    warn "ALL DATA ON $DISK WILL BE DESTROYED"
    printf "Type YES to install Grintion-OS %s: " "$VERSION"
    read -r CONFIRM
    [ "$CONFIRM" = "YES" ] || { echo "aborted"; exit 0; }
fi

if [ "$DRY_RUN" -eq 1 ]; then
    if [ "$DRY_RUN_JSON" -eq 1 ]; then
        python3 - "$DISK" "$DISK_SIZE" "$ESP_SIZE_MIB" "$SWAP_SIZE_MIB" \
            "$FILESYSTEM" "$ENCRYPT" "$SEPARATE_HOME" "$HOSTNAME" \
            "$USER_NAME" "$DESKTOP" "$NO_BOOTLOADER" "$SERIAL_CONSOLE" "$TARGET" \
            "$CUSTOM_PARTITIONS" "${ROOT_PART_SPEC:-}" "${ESP_PART_SPEC:-}" "${SWAP_PART_SPEC:-}" \
            "${HOME_PART_SPEC:-}" "$ENCRYPT_HOME" "$HOME_SIZE_MIB" "$SWAP_FILE_MIB" \
            "$SECURE_ERASE" "$KEEP_HOME" "$REMOVABLE" "$RECOVERY_PARTITION" "$RECOVERY_SIZE_MIB" \
            "$SECURITY_PROFILE" "$KERNEL_FLAVOR" "$COMPAT32" "$AUTO_DRIVERS" <<'PY'
import json
import sys

(disk, size, esp, swap, filesystem, encrypt, separate_home, hostname,
 user, desktop, no_bootloader, serial, target,
 custom, root_part, esp_part, swap_part, home_part, encrypt_home,
 home_size, swap_file, secure_erase, keep_home, removable,
 recovery_partition, recovery_size, security_profile, kernel_flavor,
 compat32, auto_drivers) = sys.argv[1:]

plan = {
    "schema": 2,
    "disk": disk,
    "disk_bytes": int(size) if size else 0,
    "security_profile": security_profile,
    "custom_partitions": custom == "1",
    "esp_part": esp_part if custom == "1" else None,
    "esp_mib": int(esp),
    "root": {
        "device": root_part if custom == "1" else None,
        "filesystem": filesystem,
        "encrypted": encrypt == "1",
        "separate_home": separate_home == "1",
        "home_part": home_part if custom == "1" else None,
        "home_size_mib": int(home_size) if home_size else 0,
        "home_encrypted": encrypt_home == "1",
        "btrfs_subvolumes": (["@", "@snapshots"] + (["@home"] if separate_home == "1" else [])) if filesystem == "btrfs" else [],
    },
    "swap": {
        "partition_mib": int(swap),
        "partition_dev": swap_part if custom == "1" else None,
        "partition_encrypted": encrypt == "1" and int(swap) > 0,
        "file_mib": int(swap_file) if swap_file else 0,
    },
    "recovery": {
        "enabled": recovery_partition == "1",
        "size_mib": int(recovery_size) if recovery_partition == "1" else 0,
    },
    "removable": removable == "1",
    "secure_erase": secure_erase == "1",
    "keep_home": keep_home == "1",
    "hostname": hostname,
    "user": user,
    "desktop": desktop or "none",
    "kernel": kernel_flavor,
    "compat32": compat32 == "1",
    "auto_drivers": auto_drivers == "1",
    "bootloader": "skipped" if no_bootloader == "1" else "limine-bios-uefi",
    "serial_console": serial == "1",
    "target": target,
}
print(json.dumps(plan, indent=2, sort_keys=True))
PY
    else
        cat <<EOF
Plan:
  mode:       $([ "$CUSTOM_PARTITIONS" -eq 1 ] && echo "custom partitions (ESP: $ESP_PART_SPEC, Root: $ROOT_PART_SPEC)" || echo "automatic disk layout on $DISK ($(numfmt --to=iec "$DISK_SIZE" 2>/dev/null || echo "$DISK_SIZE bytes"))")
  ESP:        $([ "$CUSTOM_PARTITIONS" -eq 1 ] && echo "$ESP_PART_SPEC" || echo "first partition (${ESP_SIZE_MIB} MiB, vfat, LABEL=GRINTIONESP)")
  root:       $([ "$CUSTOM_PARTITIONS" -eq 1 ] && echo "$ROOT_PART_SPEC ($FILESYSTEM)" || echo "second partition ($FILESYSTEM, LABEL=GRINTION_ROOT)")
  encryption: $([ "$ENCRYPT" -eq 1 ] && echo 'LUKS2 (aes-xts-plain64, argon2id)' || echo none)
  /home:      $([ "$SEPARATE_HOME" -eq 1 ] && echo "separate $([ "$FILESYSTEM" = "btrfs" ] && echo 'Btrfs subvolume @home' || echo "partition ${HOME_SIZE_MIB:-2048} MiB")$([ "$ENCRYPT_HOME" -eq 1 ] && echo ' [encrypted]')" || echo 'inside the root')
  swap:       $([ "$SWAP_SIZE_MIB" -gt 0 ] && echo "${SWAP_SIZE_MIB} MiB partition$([ "$ENCRYPT" -eq 1 ] && echo ', LUKS2')" || ([ "$SWAP_FILE_MIB" -gt 0 ] && echo "${SWAP_FILE_MIB} MiB swapfile" || echo none))
  recovery:   $([ "$RECOVERY_PARTITION" -eq 1 ] && echo "${RECOVERY_SIZE_MIB} MiB recovery partition" || echo none)
  secure-wipe: $([ "$SECURE_ERASE" -eq 1 ] && echo enabled || echo disabled)
  removable:  $([ "$REMOVABLE" -eq 1 ] && echo 'yes (USB/removable EFI fallback)' || echo no)
  hostname:   $HOSTNAME
  user:       $USER_NAME (wheel)
  kernel:     $KERNEL_FLAVOR$([ "$KERNEL_FLAVOR" != "lts" ] && echo ' (downloads Arch kernel + headers, keeps LTS fallback)')
  compat32:   $([ "$COMPAT32" -eq 1 ] && echo '32-bit runtime libraries (64-bit machine only)' || echo 'not requested')
  drivers:    $([ "$AUTO_DRIVERS" -eq 1 ] && echo 'auto-select firmware, microcode and modules' || echo 'manual')
  bootloader: $([ "$NO_BOOTLOADER" -eq 1 ] && echo skipped || echo Limine BIOS+UEFI)
  target:     $TARGET
Dry run complete; nothing was changed.
EOF
    fi
    exit 0
fi

CLEANUP_DONE=0
cleanup() {
    [ "$CLEANUP_DONE" -eq 1 ] && return 0
    CLEANUP_DONE=1
    set +e
    sync
    for path in home .snapshots run dev/pts dev sys proc boot/efi; do
        if mountpoint -q "$TARGET/$path" 2>/dev/null; then
            umount -l "$TARGET/$path" 2>/dev/null || umount "$TARGET/$path" 2>/dev/null || true
        fi
    done
    if [ -n "$BTRFS_STAGE" ] && mountpoint -q "$BTRFS_STAGE" 2>/dev/null; then
        umount -l "$BTRFS_STAGE" 2>/dev/null || true
    fi
    [ -n "$BTRFS_STAGE" ] && rmdir "$BTRFS_STAGE" 2>/dev/null || true
    if mountpoint -q "$TARGET" 2>/dev/null; then umount -l "$TARGET" 2>/dev/null || umount "$TARGET" 2>/dev/null || true; fi
    if command -v cryptsetup >/dev/null 2>&1; then
        [ -e "/dev/mapper/$HOME_CRYPT_NAME" ] && cryptsetup luksClose "$HOME_CRYPT_NAME" 2>/dev/null || true
        [ -e "/dev/mapper/$SWAP_CRYPT_NAME" ] && cryptsetup luksClose "$SWAP_CRYPT_NAME" 2>/dev/null || true
        [ -e "/dev/mapper/$CRYPT_NAME" ] && cryptsetup luksClose "$CRYPT_NAME" 2>/dev/null || true
    fi
    [ -n "$SWAP_KEY_FILE" ] && rm -f "$SWAP_KEY_FILE" 2>/dev/null || true
    [ -n "$HOME_KEY_FILE" ] && rm -f "$HOME_KEY_FILE" 2>/dev/null || true
    rm -f "/run/grintion-smart.$$" 2>/dev/null || true
}
trap cleanup EXIT

if [ "$SECURE_ERASE" -eq 1 ]; then
    log "secure-erasing $DISK"
    if blkdiscard -f "$DISK" 2>/dev/null; then
        log "blkdiscard completed on $DISK"
    else
        dd if=/dev/zero of="$DISK" bs=4M count=64 conv=fsync status=none 2>/dev/null || true
        log "initial block zeroing completed on $DISK"
    fi
fi

if [ "$CUSTOM_PARTITIONS" -eq 1 ]; then
    log "using custom partition assignment"
    ESP="$ESP_PART_SPEC"
    ROOT_PART="$ROOT_PART_SPEC"
    [ -n "$SWAP_PART_SPEC" ] && SWAP_PART="$SWAP_PART_SPEC"
    [ -n "$HOME_PART_SPEC" ] && HOME_PART="$HOME_PART_SPEC"
else
    log "partitioning $DISK"
    RESERVED_MIB=0
    [ "$SWAP_SIZE_MIB" -gt 0 ] && RESERVED_MIB=$((RESERVED_MIB + SWAP_SIZE_MIB))
    [ "$RECOVERY_PARTITION" -eq 1 ] && RESERVED_MIB=$((RESERVED_MIB + RECOVERY_SIZE_MIB))
    if [ "$SEPARATE_HOME" -eq 1 ] && [ "$FILESYSTEM" != "btrfs" ]; then
        H_SIZE=${HOME_SIZE_MIB:-2048}
        RESERVED_MIB=$((RESERVED_MIB + H_SIZE))
    fi

    ROOT_END="$((DISK_MIB - RESERVED_MIB))MiB"
    [ "$RESERVED_MIB" -eq 0 ] && ROOT_END="100%"

    ROOT_PART_NAME=GRINTION_ROOT
    if [ "$ENCRYPT" -eq 1 ]; then ROOT_PART_NAME=GRINTION_CRYPT; fi

    parted -s "$DISK" mklabel gpt
    parted -s "$DISK" mkpart ESP fat32 1MiB "$((1 + ESP_SIZE_MIB))MiB"
    parted -s "$DISK" set 1 esp on
    parted -s "$DISK" mkpart "$ROOT_PART_NAME" ext4 "$((1 + ESP_SIZE_MIB))MiB" "$ROOT_END"

    CURR_OFFSET=$((DISK_MIB - RESERVED_MIB))

    if [ "$SEPARATE_HOME" -eq 1 ] && [ "$FILESYSTEM" != "btrfs" ]; then
        H_SIZE=${HOME_SIZE_MIB:-2048}
        NEXT_OFFSET=$((CURR_OFFSET + H_SIZE))
        parted -s "$DISK" mkpart GRINTION_HOME ext4 "${CURR_OFFSET}MiB" "${NEXT_OFFSET}MiB"
        CURR_OFFSET=$NEXT_OFFSET
    fi

    if [ "$RECOVERY_PARTITION" -eq 1 ]; then
        NEXT_OFFSET=$((CURR_OFFSET + RECOVERY_SIZE_MIB))
        parted -s "$DISK" mkpart GRINTION_RECOVERY ext4 "${CURR_OFFSET}MiB" "${NEXT_OFFSET}MiB"
        CURR_OFFSET=$NEXT_OFFSET
    fi

    if [ "$SWAP_SIZE_MIB" -gt 0 ]; then
        parted -s "$DISK" mkpart GRINTION_SWAP linux-swap "${CURR_OFFSET}MiB" 100%
    fi

    partprobe "$DISK" 2>/dev/null || true
    sleep 1

    PARTITIONS="$(lsblk -lnpo NAME,TYPE "$DISK" | awk '$2 == "part" {print $1}')"
    ESP="$(printf '%s\n' "$PARTITIONS" | sed -n '1p')"
    ROOT_PART="$(printf '%s\n' "$PARTITIONS" | sed -n '2p')"
    p_idx=3
    if [ "$SEPARATE_HOME" -eq 1 ] && [ "$FILESYSTEM" != "btrfs" ]; then
        HOME_PART="$(printf '%s\n' "$PARTITIONS" | sed -n "${p_idx}p")"
        p_idx=$((p_idx + 1))
    fi
    if [ "$RECOVERY_PARTITION" -eq 1 ]; then
        # RECOVERY_PART is reserved for future mkfs/mount use; advance index now
        : "$(printf '%s\n' "$PARTITIONS" | sed -n "${p_idx}p")"
        p_idx=$((p_idx + 1))
    fi
    if [ "$SWAP_SIZE_MIB" -gt 0 ]; then
        SWAP_PART="$(printf '%s\n' "$PARTITIONS" | sed -n "${p_idx}p")"
    fi
fi

[ -b "$ESP" ] || die "ESP did not appear: ${ESP:-<none>}"
[ -b "$ROOT_PART" ] || die "root partition did not appear: ${ROOT_PART:-<none>}"
if [ "$SWAP_SIZE_MIB" -gt 0 ]; then
    [ -b "$SWAP_PART" ] || die "swap partition did not appear: ${SWAP_PART:-<none>}"
fi

if [ "$CUSTOM_PARTITIONS" -eq 1 ] && [ "$(blkid -s TYPE -o value "$ESP" 2>/dev/null || true)" = "vfat" ]; then
    log "reusing existing FAT32 ESP: $ESP"
else
    log "formatting $ESP"
    mkfs.vfat -F32 -n GRINTIONESP "$ESP" >/dev/null
fi

ROOT_DEV="$ROOT_PART"
if [ "$ENCRYPT" -eq 1 ]; then
    log "creating the LUKS2 container on $ROOT_PART"
    printf '%s' "$LUKS_PASSPHRASE" | cryptsetup luksFormat --batch-mode \
        --type luks2 --cipher aes-xts-plain64 --key-size 512 \
        --hash sha256 --pbkdf argon2id --pbkdf-memory 65536 \
        --pbkdf-parallel 2 --label GRINTION_CRYPT --key-file - \
        "$ROOT_PART" >/dev/null
    printf '%s' "$LUKS_PASSPHRASE" | cryptsetup luksOpen \
        --key-file - "$ROOT_PART" "$CRYPT_NAME" >/dev/null
    ROOT_DEV="/dev/mapper/$CRYPT_NAME"
    LUKS_UUID="$(cryptsetup luksUUID "$ROOT_PART")"
    [ -n "$LUKS_UUID" ] || die "could not read the LUKS UUID"
    [ -b "$ROOT_DEV" ] || die "LUKS mapper did not appear: $ROOT_DEV"
    unset LUKS_PASSPHRASE
fi

if [ "$FILESYSTEM" = "btrfs" ]; then
    log "formatting Btrfs root on $ROOT_DEV"
    mkfs.btrfs -f -L GRINTION_ROOT "$ROOT_DEV" >/dev/null
    BTRFS_STAGE="$(mktemp -d /run/grintion-btrfs.XXXXXX)"
    mount "$ROOT_DEV" "$BTRFS_STAGE"
    btrfs subvolume create "$BTRFS_STAGE/@" >/dev/null
    btrfs subvolume create "$BTRFS_STAGE/@snapshots" >/dev/null
    if [ "$SEPARATE_HOME" -eq 1 ]; then
        btrfs subvolume create "$BTRFS_STAGE/@home" >/dev/null
    fi
    umount "$BTRFS_STAGE"
    rmdir "$BTRFS_STAGE"
    BTRFS_STAGE=""
elif [ "$FILESYSTEM" = "xfs" ]; then
    log "formatting XFS root on $ROOT_DEV"
    mkfs.xfs -f -L GRINTION_ROOT "$ROOT_DEV" >/dev/null
elif [ "$FILESYSTEM" = "f2fs" ]; then
    log "formatting F2FS root on $ROOT_DEV"
    mkfs.f2fs -f -l GRINTION_ROOT "$ROOT_DEV" >/dev/null
else
    log "formatting ext4 root on $ROOT_DEV"
    mkfs.ext4 -F -L GRINTION_ROOT -m 0 "$ROOT_DEV" >/dev/null
fi

HOME_DEV=""
HOME_UUID=""
HOME_CRYPT_UUID=""
if [ -n "${HOME_PART:-}" ] && [ -b "$HOME_PART" ]; then
    if [ "$ENCRYPT_HOME" -eq 1 ]; then
        log "creating encrypted container for /home on $HOME_PART"
        HOME_KEY_FILE="$(mktemp /run/grintion-home-key.XXXXXX)"
        chmod 0600 "$HOME_KEY_FILE"
        openssl rand -out "$HOME_KEY_FILE" 64
        cryptsetup luksFormat --batch-mode --type luks2 \
            --key-file "$HOME_KEY_FILE" --label GRINTION_HOME_CRYPT \
            "$HOME_PART" >/dev/null
        cryptsetup luksOpen --key-file "$HOME_KEY_FILE" "$HOME_PART" \
            "$HOME_CRYPT_NAME" >/dev/null
        HOME_DEV="/dev/mapper/$HOME_CRYPT_NAME"
        HOME_CRYPT_UUID="$(cryptsetup luksUUID "$HOME_PART")"
    else
        HOME_DEV="$HOME_PART"
    fi
    if [ "$KEEP_HOME" -eq 0 ]; then
        log "formatting /home filesystem on $HOME_DEV"
        case "$FILESYSTEM" in
            btrfs) mkfs.btrfs -f -L GRINTION_HOME "$HOME_DEV" >/dev/null ;;
            xfs)   mkfs.xfs -f -L GRINTION_HOME "$HOME_DEV" >/dev/null ;;
            f2fs)  mkfs.f2fs -f -l GRINTION_HOME "$HOME_DEV" >/dev/null ;;
            *)     mkfs.ext4 -F -L GRINTION_HOME -m 0 "$HOME_DEV" >/dev/null ;;
        esac
    else
        log "preserving existing contents on $HOME_DEV"
    fi
    HOME_UUID="$(blkid -s UUID -o value "$HOME_DEV")"
fi

SWAP_UUID=""
SWAP_CRYPT_UUID=""
if [ "$SWAP_SIZE_MIB" -gt 0 ]; then
    if [ "$ENCRYPT" -eq 1 ]; then
        log "creating encrypted swap on $SWAP_PART"
        SWAP_KEY_FILE="$(mktemp /run/grintion-swap-key.XXXXXX)"
        chmod 0600 "$SWAP_KEY_FILE"
        openssl rand -out "$SWAP_KEY_FILE" 64
        cryptsetup luksFormat --batch-mode --type luks2 \
            --key-file "$SWAP_KEY_FILE" --label GRINTION_SWAP_CRYPT \
            "$SWAP_PART" >/dev/null
        cryptsetup luksOpen --key-file "$SWAP_KEY_FILE" "$SWAP_PART" \
            "$SWAP_CRYPT_NAME" >/dev/null
        mkswap "/dev/mapper/$SWAP_CRYPT_NAME" >/dev/null
        SWAP_CRYPT_UUID="$(cryptsetup luksUUID "$SWAP_PART")"
        [ -n "$SWAP_CRYPT_UUID" ] || die "could not read the encrypted swap UUID"
    else
        log "formatting swap partition $SWAP_PART"
        mkswap -L GRINTION_SWAP "$SWAP_PART" >/dev/null
        SWAP_UUID="$(blkid -s UUID -o value "$SWAP_PART")"
        [ -n "$SWAP_UUID" ] || die "could not read the swap filesystem UUID"
    fi
fi

ROOT_UUID="$(blkid -s UUID -o value "$ROOT_DEV")"
ESP_UUID="$(blkid -s UUID -o value "$ESP")"
[ -n "$ROOT_UUID" ] || die "could not read the root filesystem UUID"
[ -n "$ESP_UUID" ] || die "could not read the ESP UUID"

log "mounting the target"
mkdir -p "$TARGET"
if [ "$FILESYSTEM" = "btrfs" ]; then
    mount -o noatime,compress=zstd:1,subvol=@ "$ROOT_DEV" "$TARGET"
else
    mount -o noatime "$ROOT_DEV" "$TARGET"
fi
mkdir -p "$TARGET/boot/efi"
mount "$ESP" "$TARGET/boot/efi"
if [ -n "$HOME_DEV" ]; then
    mkdir -p "$TARGET/home"
    mount -o noatime "$HOME_DEV" "$TARGET/home"
elif [ "$FILESYSTEM" = "btrfs" ] && [ "$SEPARATE_HOME" -eq 1 ]; then
    mkdir -p "$TARGET/home"
    mount -o noatime,subvol=@home "$ROOT_DEV" "$TARGET/home"
fi
if [ "$FILESYSTEM" = "btrfs" ]; then
    mkdir -p "$TARGET/.snapshots"
    mount -o noatime,subvol=@snapshots "$ROOT_DEV" "$TARGET/.snapshots"
fi

log "copying the live root filesystem"
# --whole-file skips rsync's delta algorithm: this is a local copy from RAM to
# disk, where computing block checksums costs more than it saves. The live
# overlay is read-only below the upper layer, so this is a straight copy.
rsync -aHAX --whole-file --numeric-ids --one-file-system \
    --exclude=/proc/'*' --exclude=/sys/'*' --exclude=/dev/'*' \
    --exclude=/run/'*' --exclude=/tmp/'*' --exclude=/mnt/'*' \
    --exclude=/media/'*' --exclude=/lost+found \
    --exclude=/etc/grintion/live \
    --exclude=/var/log/'*' \
    --exclude=/usr/lib/grintion \
    / "$TARGET/"

mkdir -p "$TARGET"/{proc,sys,dev,run,tmp,root,home,mnt,media,boot/efi}
# chroot chpasswd needs /dev and /proc; cleanup() unmounts both on every path.
mountpoint -q "$TARGET/dev"  || mount --bind /dev "$TARGET/dev"
mountpoint -q "$TARGET/proc" || mount -t proc proc "$TARGET/proc"
# rsync preserves the source root mode; the live overlay root is root-only.
# An installed root must be traversable by ordinary users.
chmod 0755 "$TARGET"
# Replace the live-only banner with the installed-system banner.
if [ -f "$TARGET/etc/issue.installed" ]; then
    install -m 0644 "$TARGET/etc/issue.installed" "$TARGET/etc/issue"
fi
if [ -f "$TARGET/etc/motd.installed" ]; then
    install -m 0644 "$TARGET/etc/motd.installed" "$TARGET/etc/motd"
fi
chmod 1777 "$TARGET/tmp"
chmod 0700 "$TARGET/root"

# The live marker must never survive on a disk.
rm -f "$TARGET/etc/grintion/live"
: > "$TARGET/etc/machine-id"
tr -d '-' < /proc/sys/kernel/random/uuid > "$TARGET/etc/machine-id"
chmod 0444 "$TARGET/etc/machine-id"

mkdir -p "$TARGET/etc/grintion"
printf '%s\n' "$SECURITY_PROFILE" > "$TARGET/etc/grintion/security-profile"
printf 'PROFILE=%s\n' "$SECURITY_PROFILE" > "$TARGET/etc/grintion/security.conf"

printf '%s\n' "$HOSTNAME" > "$TARGET/etc/hostname"
cat > "$TARGET/etc/hosts" <<EOF
127.0.0.1   localhost
::1         localhost ip6-localhost ip6-loopback
127.0.1.1   $HOSTNAME
EOF

ROOT_FS_OPTS="defaults,noatime"
ROOT_PASS=1
if [ "$FILESYSTEM" = "btrfs" ]; then
    ROOT_FS_OPTS="defaults,noatime,compress=zstd:1,subvol=@"
    ROOT_PASS=0
fi
cat > "$TARGET/etc/fstab" <<EOF
# /etc/fstab - generated by grintion-install
UUID=$ROOT_UUID  /          $FILESYSTEM  $ROOT_FS_OPTS  0 $ROOT_PASS
UUID=$ESP_UUID   /boot/efi  vfat  umask=0077,noatime  0 2
EOF
if [ -n "$HOME_UUID" ]; then
    printf 'UUID=%s  /home  %s  defaults,noatime  0 2\n' "$HOME_UUID" "$FILESYSTEM" >> "$TARGET/etc/fstab"
elif [ "$FILESYSTEM" = "btrfs" ] && [ "$SEPARATE_HOME" -eq 1 ]; then
    printf 'UUID=%s  /home  btrfs  defaults,noatime,subvol=@home  0 0\n' "$ROOT_UUID" >> "$TARGET/etc/fstab"
fi
if [ "$FILESYSTEM" = "btrfs" ]; then
    printf 'UUID=%s  /.snapshots  btrfs  defaults,noatime,subvol=@snapshots  0 0\n' "$ROOT_UUID" >> "$TARGET/etc/fstab"
fi
if [ -n "$SWAP_UUID" ]; then
    printf 'UUID=%s  none  swap  defaults  0 0\n' "$SWAP_UUID" >> "$TARGET/etc/fstab"
fi

# The installed system keeps the same RAM policy as the live image: compressed
# zram swap, self-healing, and functional audit. The service directory is copied
# by rsync; these links are explicit so a partial copy cannot silently disable
# them.
for service in zram selfheal auditd; do
    if [ -d "$TARGET/etc/sv/$service" ]; then
        ln -sfn "/etc/sv/$service" "$TARGET/var/service/$service"
    fi
done

if [ "$COMPAT32" -eq 1 ]; then
    log "installing 32-bit compatibility libraries"
    mkdir -p "$TARGET/proc" "$TARGET/sys" "$TARGET/dev" "$TARGET/dev/pts" "$TARGET/run"
    mountpoint -q "$TARGET/proc"    || mount -t proc proc "$TARGET/proc"
    mountpoint -q "$TARGET/sys"     || mount -t sysfs sys "$TARGET/sys"
    mountpoint -q "$TARGET/dev"     || mount --bind /dev "$TARGET/dev"
    mountpoint -q "$TARGET/dev/pts" || mount --bind /dev/pts "$TARGET/dev/pts"
    mountpoint -q "$TARGET/run"     || mount -t tmpfs tmpfs "$TARGET/run"
    [ -f /etc/resolv.conf ] && cp -L /etc/resolv.conf "$TARGET/etc/resolv.conf"
    if chroot "$TARGET" /usr/bin/pacman -S --needed --noconfirm lib32-glibc lib32-gcc-libs; then
        log "32-bit compatibility libraries installed"
    else
        COMPAT32_READY=0
        warn "32-bit compatibility libraries were not installed; enable [multilib] and rerun pacman -S lib32-glibc lib32-gcc-libs"
    fi
    for path in run dev/pts dev sys proc; do
        if mountpoint -q "$TARGET/$path" 2>/dev/null; then
            umount -l "$TARGET/$path" 2>/dev/null || true
        fi
    done
fi

if [ "$SWAP_FILE_MIB" -gt 0 ]; then
    log "creating ${SWAP_FILE_MIB} MiB swapfile at $TARGET/swapfile"
    if [ "$FILESYSTEM" = "btrfs" ]; then
        if command -v btrfs >/dev/null 2>&1 && btrfs filesystem --help 2>&1 | grep -q mkswapfile; then
            btrfs filesystem mkswapfile --size "${SWAP_FILE_MIB}m" "$TARGET/swapfile" >/dev/null 2>&1 || {
                truncate -s 0 "$TARGET/swapfile"
                chattr +C "$TARGET/swapfile" 2>/dev/null || true
                dd if=/dev/zero of="$TARGET/swapfile" bs=1M count="$SWAP_FILE_MIB" status=none
            }
        else
            truncate -s 0 "$TARGET/swapfile"
            chattr +C "$TARGET/swapfile" 2>/dev/null || true
            dd if=/dev/zero of="$TARGET/swapfile" bs=1M count="$SWAP_FILE_MIB" status=none
        fi
    else
        fallocate -l "${SWAP_FILE_MIB}M" "$TARGET/swapfile" 2>/dev/null || \
            dd if=/dev/zero of="$TARGET/swapfile" bs=1M count="$SWAP_FILE_MIB" status=none
    fi
    chmod 0600 "$TARGET/swapfile"
    mkswap "$TARGET/swapfile" >/dev/null
    printf '/swapfile  none  swap  defaults  0 0\n' >> "$TARGET/etc/fstab"
fi

if [ -n "$HOME_CRYPT_UUID" ]; then
    install -m 0600 "$HOME_KEY_FILE" "$TARGET/etc/grintion/home.key"
    cat > "$TARGET/etc/grintion/home.conf" <<EOF
LUKS_UUID=$HOME_CRYPT_UUID
NAME=$HOME_CRYPT_NAME
KEY=/etc/grintion/home.key
EOF
    chmod 0600 "$TARGET/etc/grintion/home.conf" "$TARGET/etc/grintion/home.key"
    rm -f "$HOME_KEY_FILE"
    HOME_KEY_FILE=""
fi

if [ -n "$SWAP_CRYPT_UUID" ]; then
    install -m 0600 "$SWAP_KEY_FILE" "$TARGET/etc/grintion/swap.key"
    cat > "$TARGET/etc/grintion/swap.conf" <<EOF
LUKS_UUID=$SWAP_CRYPT_UUID
NAME=$SWAP_CRYPT_NAME
KEY=/etc/grintion/swap.key
EOF
    chmod 0600 "$TARGET/etc/grintion/swap.conf" "$TARGET/etc/grintion/swap.key"
    ln -sfn /etc/sv/cryptswap "$TARGET/var/service/cryptswap"
    rm -f "$SWAP_KEY_FILE"
    SWAP_KEY_FILE=""
fi

log "creating the administrative account"

# Account creation is written directly into the target databases. This avoids
# depending on chroot plus useradd/chpasswd, which need /dev and PAM inside the
# target and are the least reliable part of a fresh installation.
UID_NUM="$(awk -F: '$3 >= 1000 && $3 < 60000 {print $3}' "$TARGET/etc/passwd" | sort -n | tail -1)"
UID_NUM=$(( ${UID_NUM:-999} + 1 ))
GID_NUM="$(awk -F: '$3 >= 1000 && $3 < 60000 {print $3}' "$TARGET/etc/group" | sort -n | tail -1)"
GID_NUM=$(( ${GID_NUM:-999} + 1 ))

python3 - "$TARGET" "$USER_NAME" "$UID_NUM" "$GID_NUM" <<'PY'
import pathlib
import sys
import time

root = pathlib.Path(sys.argv[1])
user, uid, gid = sys.argv[2:5]
home = f"/home/{user}"
day = int(time.time() // 86400)

def read_lines(rel):
    return (root / rel).read_text().splitlines()

def write_lines(rel, lines):
    (root / rel).write_text("\n".join(lines) + "\n")

def drop_user(rel):
    write_lines(rel, [line for line in read_lines(rel) if line.split(":")[0] != user])

def append(rel, line):
    lines = read_lines(rel)
    lines.append(line)
    write_lines(rel, lines)

for rel in ("etc/passwd", "etc/group", "etc/shadow", "etc/gshadow"):
    drop_user(rel)

append("etc/group", f"{user}:x:{gid}:")
append("etc/gshadow", f"{user}:!::")
append("etc/passwd", f"{user}:x:{uid}:{gid}::{home}:/bin/bash")
append("etc/shadow", f"{user}:!:{day}:0:99999:7:::")

lines = []
for line in read_lines("etc/group"):
    fields = line.split(":")
    if fields[0] == "wheel":
        members = [m for m in (fields[3].split(",") if len(fields) > 3 and fields[3] else []) if m]
        if user not in members:
            members.append(user)
        fields[3] = ",".join(members)
        line = ":".join(fields)
    lines.append(line)
write_lines("etc/group", lines)

PY

install -d -m 0700 -o "$UID_NUM" -g "$GID_NUM" "$TARGET/home/$USER_NAME"
for skel in .bashrc .bash_profile .bash_logout; do
    if [ -f "$TARGET/etc/skel/$skel" ]; then
        install -m 0644 -o "$UID_NUM" -g "$GID_NUM" \
            "$TARGET/etc/skel/$skel" "$TARGET/home/$USER_NAME/$skel"
    fi
done

# Set the passwords after the account entries exist. chpasswd inside the
# target applies /etc/login.defs (yescrypt); the fallback hashes through stdin
# so the secret never appears in a child process's argument list.
set_target_password() {
    local account="$1" secret="$2" hash
    if [ -x "$TARGET/usr/bin/chpasswd" ]; then
        if printf '%s:%s\n' "$account" "$secret" | chroot "$TARGET" /usr/bin/chpasswd 2>/dev/null; then
            return 0
        fi
        warn "chpasswd failed in the target; using a SHA-512 hash instead"
    fi
    hash="$(printf '%s\n' "$secret" | openssl passwd -6 -stdin)" || return 1
    python3 - "$TARGET" "$account" "$hash" <<'PY'
import pathlib
import sys

root = pathlib.Path(sys.argv[1])
account, hashed = sys.argv[2], sys.argv[3]
path = root / "etc/shadow"
lines = path.read_text().splitlines()
for index, line in enumerate(lines):
    fields = line.split(":")
    if fields[0] == account:
        fields[1] = hashed
        lines[index] = ":".join(fields)
        break
path.write_text("\n".join(lines) + "\n")
PY
}

set_target_password "$USER_NAME" "$USER_PASSWORD" \
    || die "could not set the password for $USER_NAME"
if [ "$ROOT_SET" -eq 1 ]; then
    set_target_password root "$ROOT_PASSWORD" \
        || die "could not set the root password"
fi
unset USER_PASSWORD ROOT_PASSWORD

if [ -n "$DESKTOP" ] && [ "$DESKTOP" != "none" ]; then
    log "pre-installing graphical desktop environment: $DESKTOP"
    mkdir -p "$TARGET/proc" "$TARGET/sys" "$TARGET/dev" "$TARGET/dev/pts" "$TARGET/run"
    mountpoint -q "$TARGET/proc"    || mount -t proc proc "$TARGET/proc"
    mountpoint -q "$TARGET/sys"     || mount -t sysfs sys "$TARGET/sys"
    mountpoint -q "$TARGET/dev"     || mount --bind /dev "$TARGET/dev"
    mountpoint -q "$TARGET/dev/pts" || mount --bind /dev/pts "$TARGET/dev/pts"
    mountpoint -q "$TARGET/run"     || mount -t tmpfs tmpfs "$TARGET/run"
    if [ -f /etc/resolv.conf ]; then
        cp -L /etc/resolv.conf "$TARGET/etc/resolv.conf"
    fi

    # A desktop failure must not be reported as a successful desktop install.
    # A mirror timeout used to leave a console-only system while the summary
    # said "ready on boot" and the installer exited 0.
    if [ -x "$TARGET/usr/bin/grintion-desktop" ]; then
        if ! chroot "$TARGET" /usr/bin/grintion-desktop -y install "$DESKTOP"; then
            DESKTOP_READY=0
            warn "pre-installation of $DESKTOP did not complete"
        fi
    elif command -v grintion-desktop >/dev/null 2>&1; then
        if ! grintion-desktop --root "$TARGET" -y install "$DESKTOP"; then
            DESKTOP_READY=0
            warn "pre-installation of $DESKTOP did not complete"
        fi
    else
        DESKTOP_READY=0
        warn "grintion-desktop is missing from the target and the live image"
    fi

    for path in run dev/pts dev sys proc; do
        if mountpoint -q "$TARGET/$path" 2>/dev/null; then
            umount -l "$TARGET/$path" 2>/dev/null || true
        fi
    done
fi

if [ "$NO_BOOTLOADER" -eq 0 ]; then
    for asset in limine limine-bios.sys BOOTX64.EFI; do
        [ -f "/usr/share/limine/$asset" ] || die "missing bootloader asset: $asset"
    done
    [ -f /usr/lib/grintion/boot/vmlinuz-grintion ] || die "kernel asset is missing from the live image"
    [ -f /usr/lib/grintion/boot/initramfs-install.img ] || die "installed initramfs is missing from the live image"

    log "installing kernel and Limine"
    mkdir -p "$TARGET/boot/efi/EFI/grintion" "$TARGET/boot/efi/EFI/BOOT"
    install -D -m 0644 /usr/lib/grintion/boot/vmlinuz-grintion \
        "$TARGET/boot/efi/EFI/grintion/vmlinuz-grintion"
    install -D -m 0644 /usr/lib/grintion/boot/initramfs-install.img \
        "$TARGET/boot/efi/EFI/grintion/initramfs-install.img"
    install -D -m 0644 /usr/share/limine/limine-bios.sys \
        "$TARGET/boot/efi/limine-bios.sys"
    install -D -m 0644 /usr/share/limine/BOOTX64.EFI \
        "$TARGET/boot/efi/EFI/BOOT/BOOTX64.EFI"

    ROOT_CMDLINE="root=UUID=$ROOT_UUID rw quiet security=apparmor apparmor=1"
    if [ "$FILESYSTEM" = "btrfs" ]; then
        ROOT_CMDLINE="$ROOT_CMDLINE rootflags=subvol=@"
    fi
    if [ "$ENCRYPT" -eq 1 ]; then
        ROOT_CMDLINE="cryptdevice=UUID=$LUKS_UUID:$CRYPT_NAME $ROOT_CMDLINE"
    fi
    CONSOLE_ARGS="console=ttyS0,115200 console=tty0"
    if [ "$SERIAL_CONSOLE" -eq 1 ]; then
        CONSOLE_ARGS="console=tty0 console=ttyS0,115200"
        ROOT_CMDLINE="$ROOT_CMDLINE grintion.cryptconsole=/dev/ttyS0"
    fi
    cat > "$TARGET/boot/efi/limine.conf" <<EOF
timeout: 5
interface_branding: Grintion-OS $VERSION

/Grintion-OS $VERSION
    protocol: linux
    kernel_path: boot():/EFI/grintion/vmlinuz-grintion
    cmdline: $ROOT_CMDLINE $CONSOLE_ARGS grintion.serial=1
    module_path: boot():/EFI/grintion/initramfs-install.img

/Grintion-OS $VERSION (recovery)
    protocol: linux
    kernel_path: boot():/EFI/grintion/vmlinuz-grintion
    cmdline: $ROOT_CMDLINE single $CONSOLE_ARGS grintion.serial=1
    module_path: boot():/EFI/grintion/initramfs-install.img
EOF

    if [ "$RECOVERY_PARTITION" -eq 1 ]; then
        cat >> "$TARGET/boot/efi/limine.conf" <<EOF

/Grintion-OS $VERSION (recovery environment)
    protocol: linux
    kernel_path: boot():/EFI/grintion/vmlinuz-grintion
    cmdline: $ROOT_CMDLINE single grintion.recovery=1 $CONSOLE_ARGS grintion.serial=1
    module_path: boot():/EFI/grintion/initramfs-install.img
EOF
    fi

    # Probe other partitions for dual-boot OSes
    DUAL_BOOT_ENTRIES=()
    if [ -f "$TARGET/boot/efi/EFI/Microsoft/Boot/bootmgfw.efi" ]; then
        DUAL_BOOT_ENTRIES+=("Windows Boot Manager:boot():/EFI/Microsoft/Boot/bootmgfw.efi")
    else
        for probe_part in $(lsblk -lnpo NAME,FSTYPE 2>/dev/null | awk '$2 ~ /vfat|fat/ {print $1}'); do
            [ -b "$probe_part" ] || continue
            [ "$probe_part" = "$ESP" ] && continue
            probe_mnt="$(mktemp -d /run/grintion-probe.XXXXXX)"
            if mount -o ro "$probe_part" "$probe_mnt" 2>/dev/null; then
                if [ -f "$probe_mnt/EFI/Microsoft/Boot/bootmgfw.efi" ]; then
                    mkdir -p "$TARGET/boot/efi/EFI/Microsoft/Boot"
                    cp -a "$probe_mnt/EFI/Microsoft/Boot"/* "$TARGET/boot/efi/EFI/Microsoft/Boot/" 2>/dev/null || true
                    DUAL_BOOT_ENTRIES+=("Windows Boot Manager:boot():/EFI/Microsoft/Boot/bootmgfw.efi")
                fi
                umount "$probe_mnt" 2>/dev/null || true
            fi
            rmdir "$probe_mnt" 2>/dev/null || true
        done
    fi
    for dual_entry in "${DUAL_BOOT_ENTRIES[@]}"; do
        d_title="${dual_entry%%:*}"
        d_path="${dual_entry#*:}"
        cat >> "$TARGET/boot/efi/limine.conf" <<EOF

/$d_title
    protocol: efi_chainload
    image_path: $d_path
EOF
    done

    cp "$TARGET/boot/efi/limine.conf" "$TARGET/boot/efi/EFI/BOOT/limine.conf"

    if [ -x /usr/share/limine/limine ]; then
        log "writing the Limine BIOS boot record"
        /usr/share/limine/limine bios-install "$DISK" || warn "BIOS boot record was not written; UEFI boot is still installed"
    fi

    if [ "$REMOVABLE" -eq 0 ] && [ -d /sys/firmware/efi ] && command -v efibootmgr >/dev/null 2>&1; then
        efibootmgr -c -d "$DISK" -p 1 -L "Grintion-OS" \
            -l '\EFI\BOOT\BOOTX64.EFI' >/dev/null 2>&1 || true
    fi
fi

# Select firmware, CPU microcode and modules from the hardware this machine
# actually has. The base image intentionally carries no vendor firmware. This
# runs after the bootloader so the microcode image can be placed next to the
# kernel, and it is best-effort: an offline install still produces a bootable
# system and records exactly what to install later.
if [ "$AUTO_DRIVERS" -eq 1 ] && [ "$NO_BOOTLOADER" -eq 0 ]; then
    log "selecting drivers, firmware and microcode for this hardware"
    mkdir -p "$TARGET/proc" "$TARGET/sys" "$TARGET/dev" "$TARGET/dev/pts" "$TARGET/run"
    mountpoint -q "$TARGET/proc"    || mount -t proc proc "$TARGET/proc"
    mountpoint -q "$TARGET/sys"     || mount -t sysfs sys "$TARGET/sys"
    mountpoint -q "$TARGET/dev"     || mount --bind /dev "$TARGET/dev"
    mountpoint -q "$TARGET/dev/pts" || mount --bind /dev/pts "$TARGET/dev/pts"
    mountpoint -q "$TARGET/run"     || mount -t tmpfs tmpfs "$TARGET/run"
    [ -f /etc/resolv.conf ] && cp -L /etc/resolv.conf "$TARGET/etc/resolv.conf"
    if command -v grintion-driver-select >/dev/null 2>&1; then
        if grintion-driver-select --root "$TARGET" --apply > /tmp/grintion-drivers.$$ 2>&1; then
            log "driver/firmware selection completed"
        else
            DRIVERS_READY=0
            warn "driver/firmware packages were not fully installed; the manifest is in $TARGET/etc/grintion/hardware-profile.json"
        fi
        sed -n '1,20p' /tmp/grintion-drivers.$$ || true
        rm -f /tmp/grintion-drivers.$$
    else
        DRIVERS_READY=0
        warn "grintion-driver-select is missing from the live image"
    fi
    for path in run dev/pts dev sys proc; do
        if mountpoint -q "$TARGET/$path" 2>/dev/null; then
            umount -l "$TARGET/$path" 2>/dev/null || true
        fi
    done

    # Limine passes modules in order. Microcode must precede the initramfs so
    # the kernel applies it before userspace starts.
    MICROCODE_MODULE=$(find "$TARGET/boot/efi/EFI/grintion" -maxdepth 1 -name '*-ucode.img' -print -quit 2>/dev/null || true)
    if [ -n "$MICROCODE_MODULE" ] && [ -f "$TARGET/boot/efi/limine.conf" ]; then
        mc_name=$(basename "$MICROCODE_MODULE")
        for conf in "$TARGET/boot/efi/limine.conf" "$TARGET/boot/efi/EFI/BOOT/limine.conf"; do
            [ -f "$conf" ] || continue
            awk -v mc="$mc_name" '
                BEGIN { done=0 }
                /^[[:space:]]*module_path:/ && !done {
                    printf "    module_path: boot():/EFI/grintion/%s\n", mc
                    done=1
                }
                { print }
            ' "$conf" > "$conf.tmp" && mv "$conf.tmp" "$conf"
        done
        log "CPU microcode early-load image added: $mc_name"
    fi
fi

if [ "$KERNEL_FLAVOR" != "lts" ]; then
    log "installing optional kernel flavor: $KERNEL_FLAVOR"
    mkdir -p "$TARGET/proc" "$TARGET/sys" "$TARGET/dev" "$TARGET/dev/pts" "$TARGET/run"
    mountpoint -q "$TARGET/proc"    || mount -t proc proc "$TARGET/proc"
    mountpoint -q "$TARGET/sys"     || mount -t sysfs sys "$TARGET/sys"
    mountpoint -q "$TARGET/dev"     || mount --bind /dev "$TARGET/dev"
    mountpoint -q "$TARGET/dev/pts" || mount --bind /dev/pts "$TARGET/dev/pts"
    mountpoint -q "$TARGET/run"     || mount -t tmpfs tmpfs "$TARGET/run"
    if [ -f /etc/resolv.conf ]; then
        cp -L /etc/resolv.conf "$TARGET/etc/resolv.conf"
    fi
    if [ ! -x "$TARGET/usr/bin/grintion-kernel" ]; then
        KERNEL_READY=0
        warn "grintion-kernel is missing from the target; $KERNEL_FLAVOR was not installed"
    elif ! chroot "$TARGET" /usr/bin/grintion-kernel install "$KERNEL_FLAVOR" --yes; then
        KERNEL_READY=0
        warn "$KERNEL_FLAVOR kernel setup did not complete; the LTS entry remains bootable"
    fi
    if [ -f "$TARGET/boot/efi/limine.conf" ] && [ -d "$TARGET/boot/efi/EFI/BOOT" ]; then
        cp "$TARGET/boot/efi/limine.conf" "$TARGET/boot/efi/EFI/BOOT/limine.conf"
    fi
    for path in run dev/pts dev sys proc; do
        if mountpoint -q "$TARGET/$path" 2>/dev/null; then
            umount -l "$TARGET/$path" 2>/dev/null || true
        fi
    done
fi

SELF_TEST_OK=1
if [ "$SKIP_SELF_TEST" -eq 0 ]; then
    if command -v grintion-verify-install >/dev/null 2>&1; then
        VERIFY_ARGS=(--root "$TARGET" --user "$USER_NAME" --filesystem "$FILESYSTEM")
        [ "$ENCRYPT" -eq 1 ] && VERIFY_ARGS+=(--encrypted)
        [ -n "$SWAP_CRYPT_UUID" ] && VERIFY_ARGS+=(--encrypted-swap)
        if ! grintion-verify-install "${VERIFY_ARGS[@]}"; then
            SELF_TEST_OK=0
            warn "post-install self-test failed; the installed system may not boot"
        fi
    else
        warn "grintion-verify-install is missing; skipping the post-install self-test"
    fi
fi

sync
cleanup
trap - EXIT

echo
echo "=============================================================="
if [ "$DESKTOP_READY" -eq 1 ] && [ "$KERNEL_READY" -eq 1 ] && [ "$SELF_TEST_OK" -eq 1 ]; then
    echo "[+] Grintion-OS $VERSION installed"
else
    echo "[!] Grintion-OS $VERSION installation incomplete"
fi
echo "=============================================================="
echo "disk:      $DISK"
echo "root UUID: $ROOT_UUID"
echo "ESP UUID:  $ESP_UUID"
echo "filesystem: $FILESYSTEM"
echo "encryption: $([ "$ENCRYPT" -eq 1 ] && echo 'LUKS2 root' || echo none)"
if [ -n "$SWAP_UUID" ]; then
    echo "swap:      ${SWAP_SIZE_MIB} MiB (plain, UUID $SWAP_UUID)"
elif [ -n "$SWAP_CRYPT_UUID" ]; then
    echo "swap:      ${SWAP_SIZE_MIB} MiB (LUKS2, key /etc/grintion/swap.key)"
fi
if [ "$FILESYSTEM" = "btrfs" ]; then
    echo "snapshots: /.snapshots (subvol @snapshots)"
fi
echo "self-test: $([ "$SELF_TEST_OK" -eq 1 ] && echo passed || echo FAILED)"
echo "hostname:  $HOSTNAME"
echo "user:      $USER_NAME (wheel)"
echo "kernel:    $KERNEL_FLAVOR$([ "$KERNEL_READY" -eq 1 ] || echo ' (NOT installed; LTS remains available)')"
if [ "$COMPAT32" -eq 1 ]; then
    echo "compat32:  $([ "$COMPAT32_READY" -eq 1 ] && echo 'installed (32-bit programs can run)' || echo 'NOT installed; install lib32-glibc lib32-gcc-libs')"
fi
if [ "$AUTO_DRIVERS" -eq 1 ]; then
    echo "drivers:   $([ "$DRIVERS_READY" -eq 1 ] && echo 'auto-selected; firmware manifest in /etc/grintion/hardware-profile.json' || echo 'incomplete; see /etc/grintion/hardware-profile.json')"
else
    echo "drivers:   manual (auto-selection disabled)"
fi
if [ -n "$DESKTOP" ] && [ "$DESKTOP" != "none" ]; then
    if [ "$DESKTOP_READY" -eq 1 ]; then
        echo "desktop:   $DESKTOP (ready on boot)"
    else
        echo "desktop:   $DESKTOP (NOT installed; run 'grintion-desktop install $DESKTOP' after boot)"
        warn "the base system is installed, but the requested desktop is not ready"
    fi
else
    echo "desktop:   console base (install graphical desktop anytime with 'grintion-desktop')"
fi
echo "boot:      $([ "$NO_BOOTLOADER" -eq 1 ] && echo 'bootloader skipped' || echo 'Limine BIOS + UEFI')"
echo
echo "Remove the installation media and reboot."
echo "=============================================================="

if [ "$DESKTOP_READY" -ne 1 ] || [ "$KERNEL_READY" -ne 1 ] || [ "$SELF_TEST_OK" -ne 1 ]; then
    exit 1
fi
