#!/bin/sh
# grintion-install - Interactive DIY installer for Grintion-OS
# Adheres strictly to the MISS philosophy

set -e

cat << 'EOF'
        █
       █▓█
      █▓▒▓█
     █▓▒@▒▓█
    █▓▒@@▒▓█
   █▓▒@+-+@▒▓█
  █▓▒@+-----+@▒▓█
 █▓▒@+---/-\--+@▒▓█
█▓▒@+---/     \--+@▒▓█
     ▓▒@   @▒▓         
    ▓▒@       @▒▓
   ▓▒@           @▒▓
  ▓▒@               @▒▓
 █@█           █@█

==============================================================
           Grintion-OS Guided DIY Installer (MISS)
==============================================================
EOF

echo ""
echo "Available storage devices:"
lsblk -d -o NAME,SIZE,MODEL,TYPE | grep -E "disk|nvme"
echo ""

printf "Enter target disk device to install on (e.g. /dev/sda or /dev/nvme0n1): "
read -r TARGET_DISK

if [ ! -b "$TARGET_DISK" ]; then
    echo "[-] Error: '$TARGET_DISK' is not a valid block device." >&2
    exit 1
fi

echo ""
echo "WARNING: All data on $TARGET_DISK will be destroyed!"
printf "Are you sure you wish to continue? (type 'YES' to proceed): "
read -r CONFIRM
if [ "$CONFIRM" != "YES" ]; then
    echo "[*] Installation aborted by user."
    exit 0
fi

echo ""
echo "[1/6] Partitioning $TARGET_DISK with GPT layout..."
# Create 512MB EFI partition and root partition
parted -s "$TARGET_DISK" mklabel gpt
parted -s "$TARGET_DISK" mkpart "ESP" fat32 1MiB 513MiB
parted -s "$TARGET_DISK" set 1 esp on
parted -s "$TARGET_DISK" mkpart "GRINTION_ROOT" ext4 513MiB 100%

# Determine partition names (e.g. sda1 vs nvme0n1p1)
if echo "$TARGET_DISK" | grep -q "nvme"; then
    EFI_PART="${TARGET_DISK}p1"
    ROOT_PART="${TARGET_DISK}p2"
else
    EFI_PART="${TARGET_DISK}1"
    ROOT_PART="${TARGET_DISK}2"
fi

echo "[2/6] Formatting filesystems..."
mkfs.vfat -F32 "$EFI_PART"
mkfs.ext4 -F -L GRINTION_ROOT "$ROOT_PART"

echo "[3/6] Mounting filesystems to /mnt..."
mkdir -p /mnt
mount "$ROOT_PART" /mnt
mkdir -p /mnt/boot/efi
mount "$EFI_PART" /mnt/boot/efi

echo "[4/6] Bootstrapping Grintion-OS base system with garb..."
garb bootstrap /mnt

echo "[5/6] Generating system configuration..."
cat << 'FSTAB' > /mnt/etc/fstab
# /etc/fstab: static file system information
LABEL=GRINTION_ROOT   /           ext4    defaults,noatime    0  1
FSTAB

printf "Enter new system hostname [grintion-box]: "
read -r NEW_HOSTNAME
NEW_HOSTNAME="${NEW_HOSTNAME:-grintion-box}"
echo "$NEW_HOSTNAME" > /mnt/etc/hostname

echo "[6/6] Base installation completed successfully!"
echo ""
echo "=============================================================="
echo "Next Steps:"
echo "1. Run 'grintion-chroot /mnt' to set your root password & users"
echo "2. Run 'limine-deploy --efi /mnt/boot/efi --disk $TARGET_DISK'"
echo "3. Unmount with 'umount -R /mnt' and type 'reboot'"
echo "4. REMOVE USB OR ISO MEDIA upon reboot!"
echo "=============================================================="
