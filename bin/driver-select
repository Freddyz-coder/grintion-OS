#!/usr/bin/env python3
"""grintion-driver-select - select drivers, firmware, microcode and initramfs modules.

The base image deliberately ships no vendor firmware. This tool reads the
machine's DMI, PCI and USB identities, resolves the PCI/USB modalias values
against modules.alias, asks modinfo which firmware each module needs, checks
whether that firmware exists under /usr/lib/firmware, and maps missing files to
the smallest Arch firmware package set. On laptops it also matches the DMI
vendor and product family against /etc/grintion/laptop-support.json, loads the
vendor platform modules (ThinkPad ACPI, HP WMI, Dell SMBIOS, Acer WMI, ASUS
WMI, MSI EC, Samsung laptop), and installs the audio UCM/SOF packages.

No network access is required for the report. --apply is best effort: a missing
repository or offline machine leaves the manifest in place and tells the user
exactly which packages to install later.
"""
from __future__ import annotations

import argparse
import fnmatch
import json
import os
import platform
import shutil
import subprocess
import sys
from pathlib import Path

SYSFS = Path(os.environ.get("GRINTION_SYSFS", "/sys"))
FIRMWARE_DIRS = [
    Path(p) for p in os.environ.get(
        "GRINTION_FIRMWARE_DIRS", "/usr/lib/firmware:/lib/firmware"
    ).split(":")
]
MODULES_DIR = Path(
    os.environ.get("GRINTION_MODULES_DIR", "/lib/modules/" + platform.release())
)
OUTPUT_DIR = Path(os.environ.get("GRINTION_ETC", "/etc/grintion"))
MODINFO = os.environ.get("GRINTION_MODINFO", "modinfo")
LAPTOP_DB = Path(
    os.environ.get("GRINTION_LAPTOP_DB", "/etc/grintion/laptop-support.json")
)
LAPTOP_CHASSIS = {8, 9, 10, 14, 30, 31, 32}
_MODULE_STATE: dict[str, str] = {}


def read(path: Path, default: str = "") -> str:
    try:
        return path.read_text(encoding="utf-8", errors="replace").strip()
    except OSError:
        return default


def rooted(path: Path, root: Path) -> Path:
    """Resolve an absolute image path inside an alternate target root."""
    if root == Path("/"):
        return path
    try:
        if path.is_relative_to(root):
            return path
    except AttributeError:  # pragma: no cover - Python < 3.9
        pass
    return root / path.relative_to("/")


def check_firmware(name: str, root: Path = Path("/")) -> bool:
    if not name:
        return True
    for directory in FIRMWARE_DIRS:
        base = rooted(directory, root)
        for suffix in ("", ".zst", ".xz", ".gz"):
            if (base / (name + suffix)).is_file():
                return True
    return False


def _pattern_prefix(pattern: str) -> str:
    positions = [pattern.find(char) for char in "*?[" if char in pattern]
    return pattern[:min(positions)] if positions else pattern


def modules_alias(modules_dir: Path = MODULES_DIR) -> list[tuple[str, str, str]]:
    alias_file = modules_dir / "modules.alias"
    aliases: list[tuple[str, str, str]] = []
    try:
        for line in alias_file.read_text(encoding="utf-8", errors="replace").splitlines():
            if not line.startswith("alias "):
                continue
            parts = line.split()
            if len(parts) >= 3:
                aliases.append((parts[1], _pattern_prefix(parts[1]), parts[2]))
    except OSError:
        pass
    return aliases


def builtin_modules(modules_dir: Path = MODULES_DIR) -> set[str]:
    names: set[str] = set()
    try:
        for line in (modules_dir / "modules.builtin").read_text(
            encoding="utf-8", errors="replace"
        ).splitlines():
            if line.strip():
                names.add(Path(line.strip()).stem)
    except OSError:
        pass
    return names


def resolve_modalias(modalias: str, aliases: list[tuple[str, str, str]]) -> list[str]:
    # modules.alias patterns use shell globs, including * and ?. Compare the
    # literal prefix before the first wildcard first; on a full host module
    # database this avoids millions of fnmatch calls per boot.
    found = [
        module for pattern, prefix, module in aliases
        if modalias.startswith(prefix) and fnmatch.fnmatchcase(modalias, pattern)
    ]
    # Prefer a single exact-ish match; multiple matches are all useful.
    return list(dict.fromkeys(found))


_FIRMWARE_CACHE: dict[str, list[str]] = {}


def module_firmware(module: str) -> list[str]:
    if not module:
        return []
    if module in _FIRMWARE_CACHE:
        return _FIRMWARE_CACHE[module]
    try:
        result = subprocess.run(
            [MODINFO, "-F", "firmware", module],
            capture_output=True, text=True, check=False, timeout=10,
        )
    except (OSError, subprocess.TimeoutExpired):
        _FIRMWARE_CACHE[module] = []
        return []
    if result.returncode != 0:
        files: list[str] = []
    else:
        files = [line.strip() for line in result.stdout.splitlines() if line.strip()]
    _FIRMWARE_CACHE[module] = files
    return files


def firmware_packages(files: list[str]) -> list[str]:
    """Map firmware paths to the smallest Arch linux-firmware package set."""
    packages: set[str] = set()
    for name in files:
        path = name.lower().replace("\\", "/")
        base = path.rsplit("/", 1)[-1]
        if "intel/sof" in path or base.startswith("sof-"):
            packages.add("sof-firmware")
        elif (
            base.startswith(("iwlwifi", "i915", "xe", "btintel", "ibt"))
            or "intel/" in path
        ):
            packages.add("linux-firmware-intel")
        elif base.startswith("rtw88"):
            packages.add("linux-firmware-rtw88")
        elif base.startswith("rtw89"):
            packages.add("linux-firmware-rtw89")
        elif base.startswith(("rtl", "rtw", "btrtl")):
            packages.add("linux-firmware-realtek")
        elif path.startswith("ath") or base.startswith(("ath", "qca")):
            packages.add("linux-firmware-atheros")
        elif base.startswith(("amdgpu", "radeon")):
            packages.add("linux-firmware-amdgpu")
        elif base.startswith(("nvidia", "nouveau")):
            packages.add("linux-firmware-nvidia")
        elif base.startswith(("brcm", "bcm")):
            packages.add("linux-firmware-broadcom")
        elif base.startswith(("mt76", "mt79", "mt7", "mediatek")):
            packages.add("linux-firmware-mediatek")
        elif path.startswith("cirrus/") or base.startswith("cirrus"):
            packages.add("linux-firmware-cirrus")
        else:
            packages.add("linux-firmware")
    return sorted(packages)


def cpu_vendor() -> str:
    text = read(Path("/proc/cpuinfo"))
    for line in text.splitlines():
        if line.lower().startswith("vendor_id"):
            return line.split(":", 1)[1].strip()
    return ""


def microcode_package() -> str | None:
    vendor = cpu_vendor().lower()
    if vendor == "genuineintel":
        return "intel-ucode"
    if vendor == "authenticamd":
        return "amd-ucode"
    return None


def devices() -> list[dict]:
    items: list[dict] = []
    pci_root = SYSFS / "bus" / "pci" / "devices"
    for device in sorted(pci_root.glob("*")):
        modalias = read(device / "modalias")
        if not modalias:
            continue
        class_code = read(device / "class")
        normalized = class_code[2:6] if class_code.startswith("0x") else class_code[:4]
        driver = ""
        try:
            if (device / "driver").is_symlink():
                driver = (device / "driver").resolve().name
        except OSError:
            pass
        items.append({
            "bus": "pci",
            "slot": device.name,
            "class": normalized,
            "wireless": normalized == "0280",
            "vendor": read(device / "vendor"),
            "device": read(device / "device"),
            "modalias": modalias,
            "driver": driver,
        })
    usb_root = SYSFS / "bus" / "usb" / "devices"
    for device in sorted(usb_root.glob("*")):
        modalias = read(device / "modalias")
        if not modalias:
            continue
        items.append({
            "bus": "usb",
            "slot": device.name,
            "class": "",
            "wireless": False,
            "vendor": read(device / "idVendor"),
            "device": read(device / "idProduct"),
            "modalias": modalias,
            "driver": "",
        })
    return items


def dmi_info() -> dict:
    dmi_dir = SYSFS / "class" / "dmi" / "id"
    return {
        "sys_vendor": read(dmi_dir / "sys_vendor"),
        "product_name": read(dmi_dir / "product_name"),
        "product_version": read(dmi_dir / "product_version"),
        "board_vendor": read(dmi_dir / "board_vendor"),
        "board_name": read(dmi_dir / "board_name"),
        "bios_version": read(dmi_dir / "bios_version"),
        "chassis_type": read(dmi_dir / "chassis_type"),
    }


def laptop_database_paths() -> list[Path]:
    paths: list[Path] = []
    if os.environ.get("GRINTION_LAPTOP_DB"):
        paths.append(Path(os.environ["GRINTION_LAPTOP_DB"]))
    paths.extend([
        LAPTOP_DB,
        Path("/etc/grintion/laptop-support.json"),
        Path("/usr/share/grintion/laptop-support.json"),
        Path(__file__).resolve().parent.parent / "etc" / "grintion" / "laptop-support.json",
    ])
    unique: list[Path] = []
    seen: set[str] = set()
    for path in paths:
        key = str(path)
        if key not in seen:
            seen.add(key)
            unique.append(path)
    return unique


def load_laptop_database() -> dict:
    for path in laptop_database_paths():
        if not path.is_file():
            continue
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        if isinstance(data, dict):
            data.setdefault("vendors", [])
            data.setdefault("default_packages", [])
            return data
    return {"schema": 0, "vendors": [], "default_packages": []}


def _vendor_matches(profile: dict, vendor_text: str) -> bool:
    vendor = vendor_text.strip().lower()
    if not vendor:
        return False
    aliases = [profile.get("vendor", "")] + list(profile.get("aliases", []))
    for alias in aliases:
        value = str(alias).strip().lower()
        if value and (value in vendor or vendor in value):
            return True
    return False


def _family(profile: dict, product_text: str) -> str:
    product = product_text.strip().lower()
    for family in profile.get("families", []):
        for pattern in family.get("patterns", []):
            if product and fnmatch.fnmatchcase(product, str(pattern).lower()):
                return str(family.get("name", pattern))
    return ""


def detect_platform(db: dict, dmi: dict) -> dict:
    vendor = dmi.get("sys_vendor", "")
    product = dmi.get("product_name", "")
    chassis_raw = dmi.get("chassis_type", "")
    chassis: int | None
    try:
        chassis = int(str(chassis_raw).split(".")[0])
    except (TypeError, ValueError):
        chassis = None

    profile: dict | None = None
    family = ""
    for entry in db.get("vendors", []):
        if isinstance(entry, dict) and _vendor_matches(entry, vendor):
            profile = entry
            family = _family(entry, product)
            break

    laptop = chassis in LAPTOP_CHASSIS or bool(family)
    platform_info = {
        "detected": laptop,
        "laptop": laptop,
        "vendor": vendor,
        "product": product,
        "chassis_type": chassis_raw,
        "profile": str(profile.get("id", "")) if profile else "",
        "profile_vendor": str(profile.get("vendor", "")) if profile else "",
        "family": family,
        "supported": bool(profile),
        "status": str(profile.get("status", "")) if profile else "",
        "features": dict(profile.get("features", {})) if profile else {},
        "notes": (
            str(profile.get("notes", "")) if profile else
            "no vendor profile matched; generic laptop drivers, firmware and audio selection still apply"
        ),
        "expected_modules": [],
        "modules": [],
        "builtin_modules": [],
        "missing_modules": [],
        "packages": [],
    }
    if not laptop:
        platform_info.update({
            "profile": "",
            "profile_vendor": "",
            "family": "",
            "supported": False,
            "status": "",
            "features": {},
            "notes": "not a laptop chassis; vendor laptop profile not applied",
            "expected_modules": [],
            "modules": [],
            "builtin_modules": [],
            "missing_modules": [],
            "packages": [],
        })
        return platform_info

    expected: list[str] = []
    if profile:
        expected.extend(str(module) for module in profile.get("platform_modules", []))
    expected.extend(str(module) for module in db.get("common_modules", []))
    platform_info["expected_modules"] = list(dict.fromkeys(expected))

    packages: list[str] = []
    if profile:
        packages.extend(str(pkg) for pkg in profile.get("packages", []))
    if not packages:
        packages.extend(str(pkg) for pkg in db.get("default_packages", []))
    platform_info["packages"] = list(dict.fromkeys(packages))
    return platform_info


def module_state(module: str, builtins: set[str]) -> str:
    if module in builtins:
        return "builtin"
    if module in _MODULE_STATE:
        return _MODULE_STATE[module]
    try:
        result = subprocess.run(
            [MODINFO, module],
            capture_output=True, text=True, check=False, timeout=10,
        )
    except (OSError, subprocess.TimeoutExpired):
        state = "missing"
    else:
        state = "module" if result.returncode == 0 else "missing"
    _MODULE_STATE[module] = state
    return state


def _pci_vendor(value: str) -> str:
    return str(value).lower().removeprefix("0x").zfill(4)


def firmware_tree_present(root: Path) -> bool:
    return any(rooted(directory, root).is_dir() for directory in FIRMWARE_DIRS)


def collect(root: Path = Path("/")) -> dict:
    aliases = modules_alias()
    builtins = builtin_modules()
    selected: list[dict] = []
    device_modules: set[str] = set()
    all_packages: set[str] = set()
    for item in devices():
        modules = resolve_modalias(item["modalias"], aliases)
        if not modules and item["driver"]:
            modules = [item["driver"]]
        firmware: list[str] = []
        for module in modules:
            firmware.extend(module_firmware(module))
        firmware = list(dict.fromkeys(firmware))
        missing = [name for name in firmware if not check_firmware(name, root)]
        packages = firmware_packages(missing)
        if missing:
            all_packages.update(packages)
        loadable = [m for m in modules if m not in builtins]
        device_modules.update(loadable)
        if not modules and not firmware:
            continue
        selected.append({
            **item,
            "modules": modules,
            "builtin": [m for m in modules if m in builtins],
            "firmware": firmware,
            "missing_firmware": missing,
            "packages": packages,
            "works_on_base": not missing,
            "message": (
                f"this {'Wi-Fi card' if item['wireless'] else 'device'} needs "
                f"{', '.join(packages) or 'no extra package'}"
                + (f" + {', '.join(missing)}" if missing else "")
                + "; it will not work on the base image until that firmware is installed."
                if missing else "firmware present"
            ),
        })

    db = load_laptop_database()
    platform_info = detect_platform(db, dmi_info())
    if platform_info.get("laptop"):
        available: list[str] = []
        builtin_platform: list[str] = []
        missing_platform: list[str] = []
        for module in platform_info["expected_modules"]:
            state = module_state(module, builtins)
            if state == "module":
                available.append(module)
            elif state == "builtin":
                builtin_platform.append(module)
            else:
                missing_platform.append(module)
        platform_info["modules"] = sorted(dict.fromkeys(available))
        platform_info["builtin_modules"] = sorted(dict.fromkeys(builtin_platform))
        platform_info["missing_modules"] = sorted(dict.fromkeys(missing_platform))

        # Audio devices need UCM profiles even when no separate firmware file
        # is requested. Intel HDA/SOF machines also need the SOF firmware
        # package; the base image intentionally does not ship it.
        audio = [d for d in selected if d["class"] in {"0401", "0403"}]
        if audio:
            platform_info["packages"].append("alsa-ucm-conf")
            if any(_pci_vendor(d["vendor"]) == "8086" for d in audio):
                platform_info["packages"].append("sof-firmware")
        platform_info["packages"] = sorted(dict.fromkeys(platform_info["packages"]))
        all_packages.update(platform_info["packages"])

    microcode = microcode_package()
    if microcode:
        all_packages.add(microcode)
    boot_dir = root / "boot"
    microcode_file = None
    for candidate in ("intel-ucode.img", "amd-ucode.img"):
        if (boot_dir / candidate).is_file():
            microcode_file = str(boot_dir / candidate)
            break

    all_modules = set(device_modules)
    if platform_info.get("laptop"):
        all_modules.update(platform_info.get("modules", []))
    return {
        "schema": 2,
        "kernel": platform.release(),
        "base_image_has_firmware": firmware_tree_present(root),
        "devices": selected,
        "platform": platform_info,
        "packages": sorted(all_packages),
        "modules": sorted(all_modules),
        "initramfs_modules": sorted(device_modules),
        "microcode_package": microcode,
        "microcode_file": microcode_file,
        "missing_firmware_count": sum(len(d["missing_firmware"]) for d in selected),
    }


def write_manifest(data: dict, root: Path) -> None:
    try:
        etc = rooted(OUTPUT_DIR, root)
        etc.mkdir(parents=True, exist_ok=True)
        (etc / "hardware-profile.json").write_text(
            json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8"
        )
        # modules-load.d is a system directory, not a file under /etc/grintion.
        # udev/module-init-tools read /etc/modules-load.d, so writing inside the
        # Grintion config directory would silently autoload nothing.
        modules_dir = root / "etc/modules-load.d"
        modules_dir.mkdir(parents=True, exist_ok=True)
        (modules_dir / "grintion-hardware.conf").write_text(
            "# Generated by grintion-driver-select from detected hardware.\n"
            + "\n".join(data["modules"]) + ("\n" if data["modules"] else ""),
            encoding="utf-8",
        )
        (etc / "initramfs-modules").write_text(
            "# Modules with firmware for detected hardware (early-load candidates).\n"
            + "\n".join(data["initramfs_modules"]) + ("\n" if data["initramfs_modules"] else ""),
            encoding="utf-8",
        )
    except OSError:
        # A non-root report is still useful; only the manifest is skipped.
        pass


def _pacman_command(root: Path) -> tuple[list[str] | None, list[str] | None, str]:
    if root != Path("/"):
        pacman = root / "usr/bin/pacman"
        if not pacman.exists():
            return None, None, f"pacman is not installed in {root}"
        command = ["chroot", str(root), "/usr/bin/pacman", "-S", "--needed", "--noconfirm"]
        mirror = root / "usr/bin/grintion-pacman-mirror"
        mirror_command = (
            ["chroot", str(root), "/usr/bin/grintion-pacman-mirror", "--quiet"]
            if mirror.exists()
            else None
        )
    else:
        if not shutil.which("pacman"):
            return None, None, "pacman is not installed"
        command = ["pacman", "-S", "--needed", "--noconfirm"]
        host_mirror = shutil.which("grintion-pacman-mirror")
        mirror_command = [host_mirror, "--quiet"] if host_mirror else None
    return command, mirror_command, ""


def _pacman_run(command: list[str], packages: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        command + packages, capture_output=True, text=True, check=False
    )


def install_packages(packages: list[str], root: Path) -> tuple[bool, str]:
    packages = sorted(dict.fromkeys(packages))
    if not packages:
        return True, "no packages needed"
    command, mirror_command, error = _pacman_command(root)
    if command is None:
        return False, error
    if mirror_command:
        try:
            subprocess.run(
                mirror_command,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=20,
                check=False,
            )
        except (OSError, subprocess.SubprocessError):
            pass
    try:
        result = _pacman_run(command, packages)
    except OSError as exc:
        return False, str(exc)
    if result.returncode == 0:
        return True, "installed"

    # One unavailable optional package (for example sof-firmware from an
    # incomplete mirror) must not stop the required Wi-Fi firmware from being
    # installed. Retry each package separately and report exactly what failed.
    failed: list[str] = []
    last_error = ""
    for package in packages:
        try:
            single = _pacman_run(command, [package])
        except OSError as exc:
            failed.append(package)
            last_error = str(exc)
            continue
        if single.returncode != 0:
            failed.append(package)
            detail = (single.stderr or single.stdout).strip().splitlines()
            last_error = detail[-1] if detail else f"pacman exited {single.returncode}"
    if failed:
        return False, f"could not install {', '.join(failed)}: {last_error}"
    return True, "installed individually after a combined transaction failed"


def print_report(data: dict) -> None:
    print("Grintion-OS driver/firmware selection")
    print(f"kernel: {data['kernel']}")
    platform_info = data.get("platform", {})
    if platform_info:
        machine = " ".join(
            part for part in (platform_info.get("vendor"), platform_info.get("product")) if part
        ) or "unknown machine"
        kind = "laptop" if platform_info.get("laptop") else "desktop/unknown"
        print(f"machine: {machine} ({kind})")
        if platform_info.get("laptop"):
            support = platform_info.get("profile") or "generic"
            family = platform_info.get("family")
            print(f"vendor support: {support}" + (f" / {family}" if family else ""))
            if platform_info.get("modules"):
                print(f"platform modules: {', '.join(platform_info['modules'])}")
            if platform_info.get("missing_modules"):
                print(
                    "platform modules absent from this kernel: "
                    + ", ".join(platform_info["missing_modules"])
                )
            if platform_info.get("packages"):
                print(f"laptop packages: {', '.join(platform_info['packages'])}")
            families = platform_info.get("features", {})
            for key in ("wifi", "storage", "firmware", "audio", "ports"):
                if families.get(key):
                    print(f"  {key}: {families[key]}")
    print(f"base firmware tree: {'present' if data['base_image_has_firmware'] else 'ABSENT (/usr/lib/firmware)'}")
    print(f"missing firmware files: {data['missing_firmware_count']}")
    for device in data["devices"]:
        modules = ", ".join(device["modules"]) or "(no module matched)"
        print(f"  {device['bus']} {device['slot']} [{device['vendor']}:{device['device']}] driver={modules}")
        if device["missing_firmware"]:
            print(f"    {device['message']}")
    print(f"packages: {', '.join(data['packages']) or 'none'}")
    print(f"microcode: {data['microcode_package'] or 'not detected'}")
    if data["modules"]:
        print(f"autoload modules: {', '.join(data['modules'])}")


def main() -> int:
    prog_name = Path(sys.argv[0]).name if sys.argv and sys.argv[0] else "driver-select"
    parser = argparse.ArgumentParser(prog=prog_name)
    parser.add_argument("--json", action="store_true", help="machine-readable report")
    parser.add_argument("--apply", action="store_true", help="install required packages and write the manifest")
    parser.add_argument("--offline", action="store_true", help="write the manifest without installing")
    parser.add_argument("--root", default="/", help="target root for an installed system")
    parser.add_argument("--initramfs-modules", action="store_true", help="print only module names for an initramfs")
    args = parser.parse_args()

    root = Path(args.root).resolve()
    data = collect(root)
    write_manifest(data, root)

    if args.initramfs_modules:
        print("\n".join(data["initramfs_modules"]))
        return 0

    if args.json:
        print(json.dumps(data, indent=2, sort_keys=True))
    else:
        print_report(data)

    if args.offline:
        print(f"offline: install with pacman -S {' '.join(data['packages']) or '(nothing)'}")
        return 0
    if not args.apply:
        return 0

    ok, message = install_packages(data["packages"], root)
    data["apply"] = {"ok": ok, "message": message}
    write_manifest(data, root)
    if not ok:
        print(f"[!] driver packages were not installed: {message}", file=sys.stderr)
        print(f"[!] run later: pacman -S {' '.join(data['packages'])}", file=sys.stderr)
        return 1
    # Copy a CPU microcode image next to the installed kernel when available.
    for candidate in ("intel-ucode.img", "amd-ucode.img"):
        source = root / "boot" / candidate
        if source.is_file():
            esp = root / "boot" / "efi" / "EFI" / "grintion"
            if esp.is_dir():
                shutil.copy2(source, esp / candidate)
    print(f"[ ok ] {message}: {', '.join(data['packages']) or 'nothing to install'}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
