#!/usr/bin/env bash
# grintion-audio - start the per-user PipeWire stack without systemd.
#
# This image has no systemd user manager, so pipewire.socket,
# pipewire-pulse.socket and wireplumber.service are never activated. Start the
# three processes explicitly and unmute every detected ALSA card before
# PipeWire opens a PCM. The helper is used by the X11 session hook and by the
# XDG autostart entry, which covers GNOME, KDE, LXQt and XFCE without relying
# on a particular desktop's own audio integration.
set -Eeuo pipefail

QUIET=0
while [ $# -gt 0 ]; do
    case "$1" in
        --session) shift ;;
        --quiet) QUIET=1; shift ;;
        -h|--help)
            prog=$(basename "$0")
            cat <<EOF
Usage: $prog [--session] [--quiet]

Start PipeWire, WirePlumber and pipewire-pulse for the current user, start a
private D-Bus session bus if the caller did not provide one, and unmute every
ALSA card plus the default PipeWire sink.
EOF
            exit 0
            ;;
        *)
            prog=$(basename "$0")
            printf '%s: unknown option: %s\n' "$prog" "$1" >&2
            exit 2
            ;;
    esac
done

log() {
    [ "$QUIET" -eq 1 ] || printf '[*] %s\n' "$*" >&2
}
warn() {
    [ "$QUIET" -eq 1 ] || printf '[!] %s\n' "$*" >&2
}

uid="$(id -u)"
runtime="${XDG_RUNTIME_DIR:-}"
if [ -z "$runtime" ] || [ ! -d "$runtime" ] \
    || [ "$(stat -c %u "$runtime" 2>/dev/null || echo -1)" != "$uid" ]; then
    runtime="/tmp/grintion-runtime-$uid"
    mkdir -p "$runtime"
fi
chmod 700 "$runtime" 2>/dev/null || true
export XDG_RUNTIME_DIR="$runtime"

logfile="$runtime/grintion-audio.log"
bus_state="$runtime/grintion-session-bus"

# WirePlumber needs a D-Bus session bus. XFCE/LightDM and grintion-session
# provide one, but Sway started directly from a console and bare startx do not.
# Reuse a bus recorded by an earlier invocation, or start one and keep it alive
# for the daemons. The address is private to this user's runtime directory.
ensure_session_bus() {
    [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] && return 0

    local address="" bus_pid=""
    if [ -r "$bus_state" ]; then
        address="$(sed -n '1p' "$bus_state")"
        bus_pid="$(sed -n '2p' "$bus_state")"
        if [ -n "$address" ] && [ -n "$bus_pid" ] \
            && kill -0 "$bus_pid" 2>/dev/null; then
            DBUS_SESSION_BUS_ADDRESS="$address"
            DBUS_SESSION_BUS_PID="$bus_pid"
            export DBUS_SESSION_BUS_ADDRESS DBUS_SESSION_BUS_PID
            return 0
        fi
    fi

    if ! command -v dbus-daemon >/dev/null 2>&1; then
        warn "no D-Bus session bus and dbus-daemon is not installed; WirePlumber cannot start"
        return 0
    fi

    local info
    info="$(dbus-daemon --session --fork --print-address=1 --print-pid=1 2>/dev/null || true)"
    address="$(printf '%s\n' "$info" | sed -n '1p')"
    bus_pid="$(printf '%s\n' "$info" | sed -n '2p')"
    if [ -z "$address" ] || [ -z "$bus_pid" ]; then
        warn "could not start a D-Bus session bus; WirePlumber cannot start"
        return 0
    fi

    printf '%s\n%s\n' "$address" "$bus_pid" > "$bus_state"
    chmod 600 "$bus_state" 2>/dev/null || true
    DBUS_SESSION_BUS_ADDRESS="$address"
    DBUS_SESSION_BUS_PID="$bus_pid"
    export DBUS_SESSION_BUS_ADDRESS DBUS_SESSION_BUS_PID
    log "Started a private D-Bus session bus for uid $uid"
}
ensure_session_bus

# Card numbering is not stable across machines. In particular, HDMI can be
# card 0 while the analog speakers are card 1, so only touching card 0 leaves
# real laptops silent. Unmute the common controls on every card; controls that
# do not exist are ignored.
unmute_alsa_cards() {
    command -v amixer >/dev/null 2>&1 || return 0
    for card in /proc/asound/card[0-9]*; do
        [ -d "$card" ] || continue
        index="${card##*card}"
        for control in Master PCM Headphone Speaker Front Surround; do
            amixer -c "$index" sset "$control" unmute 100% >/dev/null 2>&1 || true
        done
    done
}
unmute_alsa_cards

start_daemon() {
    local name="$1" marker="${2:-}"
    if [ -n "$marker" ] && [ -S "$marker" ] \
        && pgrep -u "$uid" -x "$name" >/dev/null 2>&1; then
        return 0
    fi
    if ! command -v "$name" >/dev/null 2>&1; then
        warn "$name is not installed"
        return 1
    fi
    # A process without the expected socket belongs to another session; start
    # a fresh instance in the current XDG_RUNTIME_DIR instead of trusting it.
    if [ -z "$marker" ] && pgrep -u "$uid" -x "$name" >/dev/null 2>&1; then
        return 0
    fi
    "$name" >>"$logfile" 2>&1 &
}

wait_for_socket() {
    local socket="$1" attempts="${2:-50}" i=0
    while [ ! -S "$socket" ] && [ "$i" -lt "$attempts" ]; do
        sleep 0.1
        i=$((i + 1))
    done
    [ -S "$socket" ]
}

wait_for_process() {
    local name="$1" attempts="${2:-50}" i=0
    while ! pgrep -u "$uid" -x "$name" >/dev/null 2>&1 \
        && [ "$i" -lt "$attempts" ]; do
        sleep 0.1
        i=$((i + 1))
    done
    pgrep -u "$uid" -x "$name" >/dev/null 2>&1
}

start_daemon pipewire "$runtime/pipewire-0" || true
if ! wait_for_socket "$runtime/pipewire-0" \
    || ! wait_for_process pipewire 1; then
    warn "PipeWire did not create $runtime/pipewire-0; see $logfile"
    exit 1
fi

start_daemon wireplumber || true
wait_for_process wireplumber 30 \
    || warn "WirePlumber did not start; see $logfile"
start_daemon pipewire-pulse "$runtime/pulse/native" || true
wait_for_process pipewire-pulse 30 \
    || warn "pipewire-pulse is not running; see $logfile"
wait_for_socket "$runtime/pulse/native" \
    || warn "pipewire-pulse did not create $runtime/pulse/native; PulseAudio clients will not connect"

# WirePlumber can create the sink at its default volume but leave it muted.
# Unmute it explicitly once WirePlumber has published the default sink.
unmute_default_sink() {
    local i=0
    while [ "$i" -lt 50 ]; do
        if command -v wpctl >/dev/null 2>&1 \
            && wpctl set-mute @DEFAULT_AUDIO_SINK@ 0 >/dev/null 2>&1; then
            return 0
        fi
        if command -v pactl >/dev/null 2>&1 \
            && pactl set-sink-mute @DEFAULT_SINK@ 0 >/dev/null 2>&1; then
            return 0
        fi
        sleep 0.1
        i=$((i + 1))
    done
    return 1
}

card_present=0
for card in /proc/asound/card[0-9]*; do
    [ -d "$card" ] && card_present=1
done

if [ "$card_present" -eq 1 ]; then
    if unmute_default_sink; then
        log "Default audio sink is unmuted"
    else
        warn "no default audio sink became ready; see $logfile and run 'wpctl status'"
    fi
else
    warn "no ALSA card detected; in a VM add an HDA or USB audio device to the guest"
fi

log "PipeWire audio started for uid $uid (runtime: $runtime)"
