#!/bin/sh
# grintion-xorg-input - describe kernel input devices to Xorg as an evdev fallback.
#
# Grintion-OS starts standalone udev for libinput, but Xorg can launch before
# that database has settled. The evdev driver can open /dev/input/eventN
# directly, so write an xorg.conf.d snippet for the devices the kernel already
# knows about. This keeps the real mouse and keyboard working even when the
# libinput/udev path is unavailable.
#
# The display-manager service runs this before starting Xorg. Hot-plugged
# devices need a display-manager restart.

set -eu

OUT="${1:-/etc/X11/xorg.conf.d/20-grintion-input.conf}"
DEVICES=/proc/bus/input/devices

[ -r "$DEVICES" ] || exit 0
mkdir -p "$(dirname "$OUT")"

TMP="$(mktemp "${OUT}.XXXXXX")" || exit 0
trap 'rm -f "$TMP"' 0

awk '
    function emit() {
        if (event == "" || (!keyboard && !pointer)) return
        if (name ~ /^(Power Button|Sleep Button|Video Bus|PC Speaker|ACPI Virtual Keyboard)/) return
        printf "Section \"InputDevice\"\n"
        printf "    Identifier \"grintion-%s\"\n", event
        printf "    Driver \"evdev\"\n"
        # A generated InputDevice section stays inactive unless a ServerLayout
        # references it. AutoServerLayout adds the device to the implied layout
        # without inventing a Screen.
        printf "    Option \"AutoServerLayout\" \"true\"\n"
        printf "    Option \"Device\" \"/dev/input/%s\"\n", event
        printf "EndSection\n\n"
    }
    function reset() {
        event = ""; name = ""; keyboard = 0; pointer = 0
    }
    /^I: / { emit(); reset() }
    /^N: Name=/ {
        name = $0
        sub(/^N: Name="/, "", name)
        sub(/"$/, "", name)
    }
    /^H: Handlers=/ {
        handlers = $0
        sub(/^H: Handlers=/, "", handlers)
        count = split(handlers, parts, /[ \t]+/)
        for (i = 1; i <= count; i++) {
            if (parts[i] ~ /^event[0-9]+$/) event = parts[i]
        }
    }
    /^B: KEY=/ { if ($0 !~ /=0*$/) keyboard = 1 }
    /^B: REL=/ { if ($0 !~ /=0*$/) pointer = 1 }
    /^B: ABS=/ { if ($0 !~ /=0*$/) pointer = 1 }
    END { emit() }
' "$DEVICES" > "$TMP"

if [ -s "$TMP" ]; then
    chmod 0644 "$TMP"
    mv "$TMP" "$OUT"
else
    rm -f "$TMP"
fi
trap - 0
