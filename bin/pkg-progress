#!/usr/bin/env python3
"""grintion-pkg-progress - run pacman with Grintion's package progress UI.

This is the shell-facing entry point used by grintion-install and
grintion-desktop. garb imports the same renderer directly.

Examples:
    grintion-pkg-progress --root /mnt --log /var/log/desktop.log -- \
        pacman --root /mnt -S --noconfirm firefox
"""
from __future__ import annotations

import argparse
import sys
from pathlib import Path

_SCRIPT_DIR = Path(__file__).resolve().parent
if not (_SCRIPT_DIR / "garblib").is_dir():
    sys.path.insert(0, "/usr/lib/garb")

from garblib.progress import run_transaction


def main() -> int:
    parser = argparse.ArgumentParser(
        prog=Path(sys.argv[0]).name,
        description="Run a package transaction with Grintion's progress UI.",
    )
    parser.add_argument("--root", default="/", help="target root for package metadata and cache")
    parser.add_argument("--cache-dir", help="override the package cache directory")
    parser.add_argument("--log", help="write the complete raw transaction transcript here")
    parser.add_argument(
        "--stall-seconds",
        type=float,
        default=None,
        help="stop the transaction after this many seconds without progress (0 disables)",
    )
    parser.add_argument(
        "--interval",
        type=float,
        default=None,
        help="seconds between status lines when output is not a terminal",
    )
    parser.add_argument("--quiet", action="store_true", help="only print errors and the final result")
    parser.add_argument("--verbose", action="store_true", help="also print raw package manager lines")
    parser.add_argument(
        "command",
        nargs=argparse.REMAINDER,
        help="command to run, preferably after --",
    )
    args = parser.parse_args()

    command = list(args.command)
    if command and command[0] == "--":
        command = command[1:]
    if not command:
        parser.error("a command is required after --")

    try:
        status, _ = run_transaction(
            command,
            root=args.root,
            log_path=args.log,
            cache_dir=args.cache_dir,
            stall_seconds=args.stall_seconds,
            interval=args.interval,
            quiet=args.quiet or None,
            verbose=args.verbose or None,
        )
    except KeyboardInterrupt:
        print("\n[!] interrupted", file=sys.stderr)
        return 130
    return status


if __name__ == "__main__":
    raise SystemExit(main())
