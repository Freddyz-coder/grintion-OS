#!/usr/bin/env python3
"""grintion-release-verify - check a release artifact and its detached signature.

The tool verifies the SHA-256 in a checksum file and, when a public key is
supplied, an Ed25519 signature over that checksum file. It does not download
anything and does not trust a key implicitly: the caller names the key.
"""
from __future__ import annotations

import argparse
import hashlib
import hmac
import json
import re
import subprocess
import sys
from pathlib import Path

DIGEST_RE = re.compile(r"^[0-9a-fA-F]{64}$")


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def digest_from_sums(sums: Path, artifact_name: str) -> str | None:
    fallback = None
    text = sums.read_text(encoding="utf-8", errors="replace")
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split()
        if not parts or not DIGEST_RE.match(parts[0]):
            continue
        digest = parts[0].lower()
        if len(parts) == 1:
            fallback = digest
            continue
        names = [part.lstrip("*") for part in parts[1:]]
        if artifact_name in names or any(Path(name).name == artifact_name for name in names):
            return digest
    return fallback


def verify_signature(data: Path, signature: Path, key: Path) -> None:
    if not signature.is_file():
        raise RuntimeError(f"signature file is missing: {signature}")
    result = subprocess.run(
        [
            "openssl", "pkeyutl", "-verify", "-pubin", "-inkey", str(key),
            "-rawin", "-in", str(data), "-sigfile", str(signature),
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or "signature verification failed"
        raise RuntimeError(detail)


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="grintion-release-verify",
        description="Verify a Grintion-OS artifact against a SHA-256 file and an optional Ed25519 signature.",
    )
    parser.add_argument("artifact", help="ISO or other release artifact to verify")
    parser.add_argument(
        "--sha256-file",
        help="checksum file (default: <artifact>.sha256)",
    )
    parser.add_argument(
        "--signature",
        help="detached signature over the checksum file (default: <sha256-file>.sig)",
    )
    parser.add_argument("--key", help="trusted Ed25519 public key (PEM)")
    parser.add_argument("--require-signature", action="store_true",
                        help="fail when no signature/key is supplied")
    parser.add_argument("--json", action="store_true", help="machine-readable output")
    args = parser.parse_args()

    artifact = Path(args.artifact)
    if not artifact.is_file():
        print(f"[-] artifact not found: {artifact}", file=sys.stderr)
        return 1
    sums = Path(args.sha256_file) if args.sha256_file else Path(str(artifact) + ".sha256")
    if not sums.is_file():
        print(f"[-] checksum file not found: {sums}", file=sys.stderr)
        return 1
    if args.signature and not args.key:
        print("[-] --signature requires --key so the signature has a trust root", file=sys.stderr)
        return 1

    expected = digest_from_sums(sums, artifact.name)
    if expected is None:
        print(f"[-] no SHA-256 entry for {artifact.name} in {sums}", file=sys.stderr)
        return 1
    actual = sha256_file(artifact)
    checksum_ok = hmac.compare_digest(actual, expected)

    signature_state = "absent"
    signature_error = ""
    if args.key:
        key = Path(args.key)
        if not key.is_file():
            signature_state = "failed"
            signature_error = f"public key not found: {key}"
        else:
            signature = Path(args.signature) if args.signature else Path(str(sums) + ".sig")
            try:
                verify_signature(sums, signature, key)
                signature_state = "verified"
            except (OSError, RuntimeError, subprocess.SubprocessError) as exc:
                signature_state = "failed"
                signature_error = str(exc)

    signature_required = args.require_signature
    signature_ok = signature_state == "verified" or not signature_required
    ok = checksum_ok and signature_state != "failed" and signature_ok

    payload = {
        "schema": 1,
        "artifact": str(artifact),
        "sha256_file": str(sums),
        "expected_sha256": expected,
        "actual_sha256": actual,
        "checksum_ok": checksum_ok,
        "signature": signature_state,
        "signature_error": signature_error,
        "ok": ok,
    }
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        print(f"artifact:  {artifact}")
        print(f"sha256:    {actual}")
        if checksum_ok:
            print("[ ok ] checksum matches the checksum file")
        else:
            print(f"[FAIL] checksum mismatch: expected {expected}", file=sys.stderr)
        if signature_state == "verified":
            print("[ ok ] Ed25519 signature verified")
        elif signature_state == "failed":
            print(f"[FAIL] signature verification failed: {signature_error}", file=sys.stderr)
        else:
            print("[WARN] no signature supplied; a checksum proves transport integrity, not authorship",
                  file=sys.stderr)
            if signature_required:
                print("[-] --require-signature was requested but no key/signature was supplied",
                      file=sys.stderr)
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(main())
