#!/bin/sh
# diy-guide - Step-by-Step DIY Installation Guide for Grintion-OS
# Philosophy: MISS (Minimalist, Independent, Secure, Stable)

clear
cat << 'EOF'
        █
       █▓█
      █▓▒▓█
     █▓▒@▒▓█
    █▓▒@@▒▓█
   █▓▒@+-+@▒▓█
  █▓▒@+-----+@▒▓█
 █▓▒@+---/-\--+@▒▓█
█▓▒@+---/     \--+@▒▓█
     ▓▒@   @▒▓         
    ▓▒@       @▒▓
   ▓▒@           @▒▓
  ▓▒@               @▒▓
 █@█           █@█

===============================================================
       Grintion-OS DIY Installation Manual (MISS)
===============================================================

You are currently running in the RAM Live environment. None of your
disks have been touched. Follow these DIY steps to install Grintion-OS:

[STEP 1]: NETWORKING
---------------------------------------------------------------
1. Check network interfaces:
     ip link
2. Bring up interface (e.g. eth0 or wlan0):
     ip link set eth0 up
3. Obtain DHCP lease or set static IP:
     dhcpcd eth0
     # or static:
     ip addr add 192.168.1.100/24 dev eth0
     ip route add default via 192.168.1.1
     echo "nameserver 1.1.1.1" > /etc/resolv.conf
4. Verify connectivity:
     ping -c 3 1.1.1.1

[STEP 2]: DISK PARTITIONING & FORMATTING
---------------------------------------------------------------
1. List available storage devices:
     lsblk
2. Partition the target drive (e.g. /dev/sda or /dev/nvme0n1):
     fdisk /dev/nvme0n1
   Recommended layout:
     - Partition 1: 512MB (Type: EFI System, for UEFI boot)
     - Partition 2: Remainder (Type: Linux Root)
3. Format filesystems:
     mkfs.vfat -F32 /dev/nvme0n1p1
     mkfs.ext4 -L GRINTION_ROOT /dev/nvme0n1p2

[STEP 3]: MOUNTING TARGET ROOT
---------------------------------------------------------------
     mount /dev/nvme0n1p2 /mnt
     mkdir -p /mnt/boot/efi
     mount /dev/nvme0n1p1 /mnt/boot/efi

[STEP 4]: BOOTSTRAP BASE SYSTEM WITH GARB
---------------------------------------------------------------
     garb bootstrap /mnt

[STEP 5]: CHROOT & USER CONFIGURATION
---------------------------------------------------------------
1. Enter the newly bootstrapped system:
     grintion-chroot /mnt
2. Set root password:
     passwd
3. Add an everyday unprivileged user:
     useradd -m -s /bin/bash user
     passwd user
4. Set hostname:
     echo "my-paranoid-box" > /etc/hostname
5. Configure runit services:
     ln -s /etc/sv/agetty-tty1 /var/service/
     ln -s /etc/sv/network /var/service/

[STEP 6]: BOOTLOADER DEPLOYMENT
---------------------------------------------------------------
     limine-deploy --efi /mnt/boot/efi --disk /dev/nvme0n1

[STEP 7]: REBOOT & REMOVE USB / ISO
---------------------------------------------------------------
     exit
     umount -R /mnt
     reboot
     # Safely unplug USB / eject ISO when screen turns black.

===============================================================
Tip: You can also run 'grintion-install' for an interactive prompt!
===============================================================
EOF
