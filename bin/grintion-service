#!/usr/bin/env python3
"""grintion-service - inspect and control runit services without memorising sv.

Subcommands:
  list      every service directory with enablement and supervise state
  status    detailed state for one service
  start     bring an enabled service up
  stop      take a service down (it stays enabled)
  restart   restart a service
  reload    send SIGHUP through sv reload
  enable    link /var/service/<name> so runit supervises it at boot
  disable   remove that link (runit stops the service)
  logs      tail the service log, following it with --follow
  cat       print the run script
  health    nonzero when an enabled service is not running

Read-only commands work without runit installed and report
"available": false instead of guessing.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

SERVICE_PID = re.compile(r"\(pid (\d+)\)")
SERVICE_UPTIME = re.compile(r"\)\s+(\d+)s")
LOG_PATH = re.compile(r"(/var/log/[A-Za-z0-9._/-]+)")


def root_path(path: str) -> Path:
    prefix = os.environ.get("GRINTION_ROOT", "").rstrip("/")
    if prefix:
        return Path(f"{prefix}/{path.lstrip('/')}")
    return Path(path)


def service_dir() -> Path:
    override = os.environ.get("GRINTION_SV_DIR")
    return Path(override) if override else root_path("/etc/sv")


def enabled_dir() -> Path:
    override = os.environ.get("GRINTION_SERVICE_DIR")
    return Path(override) if override else root_path("/var/service")


def sv_available() -> bool:
    return shutil.which("sv") is not None


def run(cmd: list[str], timeout: int = 30) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, check=False)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return subprocess.CompletedProcess(cmd, 127, "", str(exc))


def require_root(action: str, dry_run: bool) -> bool:
    if dry_run or os.environ.get("GRINTION_ROOT") or os.environ.get("GRINTION_SERVICE_DIR"):
        return True
    if hasattr(os, "geteuid") and os.geteuid() == 0:
        return True
    print(f"grintion-service: {action} requires root; rerun with sudo", file=sys.stderr)
    return False


def parse_status(name: str) -> dict:
    if not sv_available():
        return {"state": "unknown", "pid": None, "uptime_seconds": None, "detail": ""}
    result = run(["sv", "status", name])
    output = (result.stdout or result.stderr).strip()
    info = {"state": "unknown", "pid": None, "uptime_seconds": None, "detail": output}
    if not output:
        return info
    first = output.splitlines()[0]
    state = first.split(":", 1)[0].strip()
    if state in {"run", "down", "fail", "finish", "timeout", "want"}:
        info["state"] = state
    pid = SERVICE_PID.search(first)
    if pid:
        info["pid"] = int(pid.group(1))
    uptime = SERVICE_UPTIME.search(first)
    if uptime:
        info["uptime_seconds"] = int(uptime.group(1))
    log = SERVICE_PID.search(first, pid.end()) if pid else None
    if "run: log:" in first and log:
        info["log_pid"] = int(log.group(1))
    return info


def is_enabled(name: str) -> bool:
    return (enabled_dir() / name).exists() or (enabled_dir() / name).is_symlink()


def service_names(include_all: bool = True) -> list[str]:
    directory = service_dir()
    if not directory.is_dir():
        return []
    names = sorted(
        entry.name for entry in directory.iterdir()
        if entry.is_dir() and not entry.name.startswith(".")
    )
    if include_all:
        return names
    return [name for name in names if is_enabled(name)]


def build_entry(name: str) -> dict:
    directory = service_dir() / name
    enabled = is_enabled(name)
    status = parse_status(name) if enabled else {
        "state": "disabled", "pid": None, "uptime_seconds": None, "detail": "",
    }
    return {
        "name": name,
        "enabled": enabled,
        "state": status["state"],
        "pid": status.get("pid"),
        "uptime_seconds": status.get("uptime_seconds"),
        "log_pid": status.get("log_pid"),
        "run_script": str(directory / "run"),
        "has_log_service": (directory / "log" / "run").is_file(),
        "down_file": (directory / "down").is_file(),
    }


def cmd_list(args: argparse.Namespace) -> int:
    names = service_names(False if args.enabled else True)
    entries = [build_entry(name) for name in names]
    if not sv_available():
        for entry in entries:
            if entry["enabled"]:
                entry["state"] = "unknown"
    if args.json:
        print(json.dumps({"schema": 1, "sv_available": sv_available(),
                          "services": entries}, indent=2))
        return 0
    print(f"runit: {'available' if sv_available() else 'NOT available (sv missing)'}")
    print(f"{'SERVICE':<24} {'ENABLED':<8} {'STATE':<10} {'PID':>7} {'UPTIME':>9}")
    for entry in entries:
        pid = str(entry["pid"]) if entry["pid"] is not None else "-"
        uptime = (f"{entry['uptime_seconds']}s"
                  if entry["uptime_seconds"] is not None else "-")
        enabled = "yes" if entry["enabled"] else "no"
        print(f"{entry['name']:<24} {enabled:<8} {entry['state']:<10} {pid:>7} {uptime:>9}")
    if not entries:
        print("no services found under", service_dir())
    return 0


def resolve_name(name: str) -> Path | None:
    directory = service_dir() / name
    if not directory.is_dir() or name.startswith("."):
        print(f"grintion-service: no such service: {name}", file=sys.stderr)
        return None
    return directory


def cmd_status(args: argparse.Namespace) -> int:
    if resolve_name(args.name) is None:
        return 2
    entry = build_entry(args.name)
    if args.json:
        print(json.dumps({"schema": 1, "service": entry}, indent=2))
        return 0
    print(f"service:  {entry['name']}")
    print(f"enabled:  {'yes' if entry['enabled'] else 'no'}")
    print(f"state:    {entry['state']}")
    print(f"pid:      {entry['pid'] if entry['pid'] is not None else '-'}")
    print(f"uptime:   {entry['uptime_seconds'] if entry['uptime_seconds'] is not None else '-'}")
    print(f"run:      {entry['run_script']}")
    print(f"logging:  {'dedicated log service' if entry['has_log_service'] else 'console only'}")
    if entry["down_file"]:
        print("note:     a 'down' file exists, so runit does not autostart it")
    return 0


def control(args: argparse.Namespace, action: str) -> int:
    if resolve_name(args.name) is None:
        return 2
    if not require_root(f"{action} {args.name}", args.dry_run):
        return 2
    if action not in ("stop", "reload") and not is_enabled(args.name):
        print(f"grintion-service: {args.name} is not enabled; run "
              f"'grintion-service enable {args.name}' first", file=sys.stderr)
        return 1
    if not sv_available():
        print("grintion-service: sv is not available in this image", file=sys.stderr)
        return 2
    command = {"start": "up", "stop": "down", "restart": "restart", "reload": "reload"}[action]
    if args.dry_run:
        print(f"would run: sv {command} {args.name}")
        return 0
    result = run(["sv", command, args.name], timeout=60)
    output = (result.stdout + result.stderr).strip()
    if args.json:
        print(json.dumps({"schema": 1, "action": action, "service": args.name,
                          "returncode": result.returncode, "output": output}, indent=2))
    else:
        print(output or f"sv {command} {args.name}: ok")
    return 0 if result.returncode == 0 else 1


def cmd_enable(args: argparse.Namespace) -> int:
    directory = resolve_name(args.name)
    if directory is None:
        return 2
    if not (directory / "run").is_file():
        print(f"grintion-service: {args.name} has no run script", file=sys.stderr)
        return 2
    if not require_root(f"enabling {args.name}", args.dry_run):
        return 2
    link = enabled_dir() / args.name
    if link.exists() or link.is_symlink():
        if not args.force:
            print(f"grintion-service: {args.name} is already enabled", file=sys.stderr)
            return 1
        if not args.dry_run:
            link.unlink()
    if args.dry_run:
        print(f"would link {link} -> {directory.resolve()}")
        return 0
    enabled_dir().mkdir(parents=True, exist_ok=True)
    link.symlink_to(directory.resolve())
    if args.json:
        print(json.dumps({"schema": 1, "service": args.name, "enabled": True}, indent=2))
    else:
        print(f"enabled {args.name}; runit starts it now and at every boot")
    return 0


def cmd_disable(args: argparse.Namespace) -> int:
    if resolve_name(args.name) is None:
        return 2
    if not require_root(f"disabling {args.name}", args.dry_run):
        return 2
    link = enabled_dir() / args.name
    if not link.exists() and not link.is_symlink():
        print(f"grintion-service: {args.name} is not enabled", file=sys.stderr)
        return 1
    if args.dry_run:
        print(f"would remove {link}")
        return 0
    link.unlink()
    if args.json:
        print(json.dumps({"schema": 1, "service": args.name, "enabled": False}, indent=2))
    else:
        print(f"disabled {args.name}; runit stopped it")
    return 0


def log_candidates(name: str) -> list[Path]:
    candidates = [
        root_path(f"/var/log/{name}.log"),
        root_path(f"/var/log/{name}/current"),
        root_path(f"/var/log/{name}.log.1"),
    ]
    for script in (service_dir() / name / "log" / "run", service_dir() / name / "run"):
        try:
            text = script.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        for match in LOG_PATH.findall(text):
            candidates.append(root_path(match))
    unique: list[Path] = []
    for candidate in candidates:
        if candidate not in unique:
            unique.append(candidate)
    return unique


def cmd_logs(args: argparse.Namespace) -> int:
    if resolve_name(args.name) is None:
        return 2
    existing = [path for path in log_candidates(args.name) if path.is_file()]
    if args.list:
        payload = {
            "schema": 1,
            "service": args.name,
            "candidates": [
                {"path": str(path), "exists": path.is_file()} for path in log_candidates(args.name)
            ],
        }
        if args.json:
            print(json.dumps(payload, indent=2))
        else:
            for entry in payload["candidates"]:
                print(f"{'file' if entry['exists'] else 'missing':<8} {entry['path']}")
        return 0
    if not existing:
        print(f"grintion-service: no log file found for {args.name}; "
              "try 'grintion-logs list'", file=sys.stderr)
        return 1
    path = max(existing, key=lambda item: item.stat().st_mtime)
    if args.follow:
        os.execvp("tail", ["tail", "-n", str(args.lines), "-f", str(path)])
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError as exc:
        print(f"grintion-service: cannot read {path}: {exc}", file=sys.stderr)
        return 2
    tail = lines[-args.lines:]
    if args.json:
        print(json.dumps({"schema": 1, "service": args.name, "path": str(path),
                          "lines": tail}, indent=2))
    else:
        print(f"==> {path} <==")
        for line in tail:
            print(line)
    return 0


def cmd_cat(args: argparse.Namespace) -> int:
    directory = resolve_name(args.name)
    if directory is None:
        return 2
    script = directory / ("log/run" if args.log else "run")
    try:
        text = script.read_text(encoding="utf-8")
    except OSError as exc:
        print(f"grintion-service: cannot read {script}: {exc}", file=sys.stderr)
        return 2
    if args.json:
        print(json.dumps({"schema": 1, "path": str(script), "content": text}, indent=2))
    else:
        sys.stdout.write(text)
    return 0


def cmd_health(args: argparse.Namespace) -> int:
    names = service_names(True)
    failures = []
    entries = []
    for name in names:
        entry = build_entry(name)
        if not entry["enabled"]:
            continue
        entries.append(entry)
        if not sv_available():
            continue
        if entry["state"] not in ("run",) and not entry["down_file"]:
            failures.append(entry)
    payload = {
        "schema": 1,
        "sv_available": sv_available(),
        "checked": len(entries),
        "failures": failures,
        "services": entries,
    }
    if args.json:
        print(json.dumps(payload, indent=2))
        return 0 if not failures else 1
    if not sv_available():
        print("sv is not available; cannot determine service health")
        return 0
    print(f"checked {len(entries)} enabled services, {len(failures)} not running")
    for entry in failures:
        print(f"  FAIL {entry['name']}: {entry['state']}")
    return 0 if not failures else 1


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="grintion-service",
        description="Inspect and control runit services.",
    )
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", help="machine-readable output")
    common.add_argument("--dry-run", action="store_true", help="print the action only")
    sub = parser.add_subparsers(dest="command")

    p_list = sub.add_parser("list", parents=[common], help="list services")
    p_list.add_argument("--enabled", action="store_true",
                        help="only services enabled under /var/service")
    p_list.set_defaults(func=cmd_list)

    p_status = sub.add_parser("status", parents=[common], help="one service")
    p_status.add_argument("name")
    p_status.set_defaults(func=cmd_status)

    for name, help_text in (
        ("start", "bring a service up"),
        ("stop", "take a service down"),
        ("restart", "restart a service"),
        ("reload", "send SIGHUP to a service"),
    ):
        probe = sub.add_parser(name, parents=[common], help=help_text)
        probe.add_argument("name")
        probe.set_defaults(func=lambda a, action=name: control(a, action))

    p_enable = sub.add_parser("enable", parents=[common], help="enable at boot")
    p_enable.add_argument("name")
    p_enable.set_defaults(func=cmd_enable)

    p_disable = sub.add_parser("disable", parents=[common], help="stop and disable")
    p_disable.add_argument("name")
    p_disable.set_defaults(func=cmd_disable)

    p_logs = sub.add_parser("logs", parents=[common], help="tail a service log")
    p_logs.add_argument("name")
    p_logs.add_argument("--lines", type=int, default=40)
    p_logs.add_argument("--follow", action="store_true", help="follow like tail -f")
    p_logs.add_argument("--list", action="store_true", help="show candidate log paths")
    p_logs.set_defaults(func=cmd_logs)

    p_cat = sub.add_parser("cat", parents=[common], help="print the run script")
    p_cat.add_argument("name")
    p_cat.add_argument("--log", action="store_true", help="print the log run script")
    p_cat.set_defaults(func=cmd_cat)

    sub.add_parser("health", parents=[common], help="report services that are down"
                   ).set_defaults(func=cmd_health)

    args = parser.parse_args()
    if not getattr(args, "command", None):
        parser.print_help()
        return 2
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
