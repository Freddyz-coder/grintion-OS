#!/bin/sh
# hwreport - hardware report with an explicit firmware verdict.
# Thin wrapper around hwinfo (formerly grintion-hwinfo).
set -eu

SELF_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
for cmd in hwinfo grintion-hwinfo; do
    if [ -x "$SELF_DIR/$cmd" ]; then
        exec "$SELF_DIR/$cmd" "$@"
    fi
    if command -v "$cmd" >/dev/null 2>&1; then
        exec "$cmd" "$@"
    fi
done
echo "[-] hwinfo not found" >&2
exit 1
