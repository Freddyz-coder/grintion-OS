#!/usr/bin/env bash
# grintion-desktop - Graphical Desktop Environment & Display Manager Manager
# Grintion-OS: Minimalist - Independent - Secure - Stable
#
# Provides seamless installation, driver detection, and runit service
# configuration for modern desktop environments (XFCE, GNOME, KDE Plasma,
# LXQt, Sway, i3) on Grintion-OS.

set -Eeuo pipefail
export LC_ALL=C

TARGET_ROOT="/"
NO_CONFIRM=0
SKIP_DRIVERS=0
CHOSEN_DM=""
PROFILE_DIR="${GRINTION_DESKTOP_PROFILE_DIR:-/etc/grintion/desktops.d}"
LIST_JSON=0

log()  { printf '\033[1;32m[*]\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33m[!]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[-]\033[0m %s\n' "$*" >&2; exit 1; }

json_escape() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

profile_directory() {
    if [ -d "$TARGET_ROOT/etc/grintion/desktops.d" ]; then
        printf '%s\n' "$TARGET_ROOT/etc/grintion/desktops.d"
    else
        printf '%s\n' "$PROFILE_DIR"
    fi
}

load_profile() {
    local name="$1" dir="$2" file
    case "$name" in
        1) name=xfce ;;
        2) name=gnome ;;
        3|plasma) name=kde ;;
        4) name=lxqt ;;
        5) name=sway ;;
        6) name=i3 ;;
    esac
    file="$dir/$name.conf"
    [ -f "$file" ] || die "Unknown desktop environment: '$1'. Run 'grintion-desktop list' for options."
    unset NAME DESCRIPTION PACKAGES DM DM_BIN XINITRC DISPLAY_SERVER REQUIRES_SYSTEMD
    # shellcheck disable=SC1090
    . "$file"
    [ -n "${NAME:-}" ] || die "profile has no NAME: $file"
    [ -n "${PACKAGES:-}" ] || die "profile has no PACKAGES: $file"
}

usage() {
    cat <<'EOF'
Usage: grintion-desktop [COMMAND] [OPTIONS]

Install and configure desktop environments, display managers, and GPU drivers.

Commands:
  list [--json]         List profile data (JSON is machine-readable)
  install <desktop>     Install a desktop environment and configure display manager
  uninstall <desktop>   Remove a desktop's packages and display-manager service
  drivers               Detect GPU hardware and install graphics drivers
  status                Show installed desktop environments, display managers & drivers

Supported Desktops:
  xfce                  XFCE 4 (Lightweight, fast, full-featured desktop) [Recommended]
  kde | plasma          KDE Plasma (Feature-rich, customizable Qt desktop, verified Wayland)
  gnome                 GNOME (NOT SUPPORTED: requires the systemd user session manager)
  lxqt                  LXQt (Ultra-lightweight Qt desktop)
  sway                  Sway (Modern Wayland tiling compositor, i3-compatible)
  i3                    i3 Window Manager (Classic lightweight X11 tiling WM)

Options:
  --dm, --display-manager <sddm|lightdm|gdm>  Specify display manager
  --root <path>                               Target root directory (e.g. /mnt)
  --no-drivers                                Skip GPU driver detection/installation
  -y, --noconfirm                             Non-interactive; do not prompt
  -h, --help                                  Show this help message

Examples:
  grintion-desktop install xfce
  grintion-desktop install gnome --dm gdm
  grintion-desktop install kde --root /mnt
  grintion-desktop uninstall xfce
  grintion-desktop list --json
EOF
}

detect_gpu_drivers() {
    local drivers=("mesa" "linux-firmware" "wireless-regdb")
    local lspci_out=""
    if command -v lspci >/dev/null 2>&1; then
        lspci_out="$(lspci 2>/dev/null || true)"
    fi

    local conf="${GRINTION_DRIVERS_CONF:-/etc/grintion/drivers.conf}"
    [ -r "$conf" ] || conf="$TARGET_ROOT/etc/grintion/drivers.conf"
    [ -r "$conf" ] || conf="$(dirname "$0")/../etc/grintion/drivers.conf"
    [ -r "$conf" ] || die "GPU driver matrix is missing: $conf"

    local pattern packages fallback=""
    while IFS=$'\t' read -r pattern packages; do
        case "$pattern" in ''|'#'*) continue ;; esac
        if [ "$pattern" = "default" ]; then
            fallback="$packages"
            continue
        fi
        if printf '%s\n' "$lspci_out" | grep -qiE "$pattern"; then
            log "GPU profile: $pattern"
            local extra=()
            read -r -a extra <<< "$packages"
            drivers+=("${extra[@]}")
            printf '%s\n' "${drivers[*]}"
            return 0
        fi
    done < "$conf"

    log "Generic / VESA display detected"
    if [ -n "$fallback" ]; then
        local extra=()
        read -r -a extra <<< "$fallback"
        drivers+=("${extra[@]}")
    fi
    printf '%s\n' "${drivers[*]}"
}

pkg_install() {
    local pkgs=("$@")
    if [ ${#pkgs[@]} -eq 0 ]; then
        return 0
    fi

    local root_flag=()
    if [ "$TARGET_ROOT" != "/" ]; then
        root_flag=("--root" "$TARGET_ROOT")
    fi

    local manager=()
    if command -v pacman >/dev/null 2>&1; then
        local noconfirm=()
        if [ "$NO_CONFIRM" -eq 1 ]; then
            noconfirm=("--noconfirm")
        fi
        # No --needed: the image ships a seeded pacman database, and a seeded
        # package can be recorded as installed while some of its data files
        # were not copied (dbus had no /usr/bin/dbus-daemon before the seed was
        # pruned). Reinstalling every listed package is what completes it. With
        # --needed pacman skipped those packages, their dependencies stayed
        # missing, and scriptlets failed while the desktop still looked
        # installed (ProblemsWhenInstalling.txt #9). Since 0.10.1 the pruned
        # seed also means the reinstall no longer logs bogus missing-file
        # warnings for paths that were never in the image.
        manager=(pacman "${root_flag[@]}" -Sy --disable-download-timeout "${noconfirm[@]}")
    elif command -v garb >/dev/null 2>&1; then
        manager=(garb "${root_flag[@]}" install "${pkgs[@]}")
    else
        die "Neither pacman nor garb package manager found"
    fi

    # Stream the package manager output instead of capturing it. The old
    # $(...) capture showed nothing for the entire download+install, so a
    # working 7-10 minute XFCE install looked like a hang and users pressed
    # Ctrl+C (ProblemsWhenInstalling.txt #3, #4 and #9).
    local logfile="$TARGET_ROOT/var/log/grintion-desktop.log"
    mkdir -p "$(dirname "$logfile")"
    : > "$logfile"

    log "This downloads from Arch mirrors and can take several minutes. Package manager output follows (also saved to $logfile)."
    # A single slow mirror used to abort the whole desktop install, and the
    # seeded pacman database can contain files that the first transaction
    # reports as conflicts. Retry up to three times: pacman keeps completed
    # downloads in its cache and a failed transaction rolls back, so each
    # attempt only fetches what is missing. Conflicts are re-read after every
    # failure, because the next attempt can expose a different set (the old
    # code stopped after one retry and left e.g. gtk4 conflicts unresolved).
    local rc=0 attempt
    local overwrite=() seen_conflicts=" " conflict_total=0
    for attempt in 1 2 3; do
        : > "$logfile"
        log "Installing packages (attempt $attempt/3): ${pkgs[*]}"
        set +e
        "${manager[@]}" "${overwrite[@]}" "${pkgs[@]}" 2>&1 | tee -a "$logfile"
        rc=${PIPESTATUS[0]}
        set -e
        if [ "$rc" -eq 0 ]; then
            break
        fi
        if [ "$attempt" -eq 3 ]; then
            break
        fi

        # Never retry with a blanket overwrite. It would let an upstream
        # package replace /etc/shadow, sudoers, SSH host keys or boot files.
        # Retry only the exact paths pacman reported, and refuse the
        # security-sensitive ones outright.
        # /dev/fd is not present in the minimal live image, so do not use a
        # process substitution here. pacman 7 prefixes each line with the
        # package name ("libxdmcp: /usr/lib/..."), pacman 6 does not; take the
        # token immediately before "exists in filesystem" in both forms.
        local conflicts=() path normalized sensitive=""
        local conflict_file new_conflicts=0
        conflict_file=$(mktemp /tmp/grintion-conflicts.XXXXXX)
        awk '/exists in filesystem/ {
                 for (i = 1; i <= NF; i++) {
                     if ($i == "exists" && $(i + 1) == "in") {
                         p = $(i - 1); sub(/:$/, "", p); print p; break
                     }
                 }
             }' "$logfile" | sort -u > "$conflict_file"
        while IFS= read -r path; do
            [ -n "$path" ] || continue
            normalized="/${path#/}"
            case "$normalized" in
                /etc/passwd|/etc/passwd-|/etc/shadow|/etc/shadow-|/etc/group|/etc/group-|/etc/gshadow|/etc/gshadow-|/etc/sudoers|/etc/sudoers.d/*|/etc/ssh/ssh_host_*|/boot/*|/usr/lib/modules/*)
                    sensitive="$normalized"; break ;;
            esac
            # Do not pass the same path to a later attempt again; it was
            # already authorized and re-adding it only hides a no-progress
            # failure behind an identical overwrite list.
            case "$seen_conflicts" in
                *" $normalized "*) continue ;;
            esac
            seen_conflicts+="$normalized "
            new_conflicts=$((new_conflicts + 1))
            conflicts+=("--overwrite" "$path")
        done < "$conflict_file"
        rm -f "$conflict_file"
        [ -z "$sensitive" ] || die "refusing to overwrite security-sensitive path: $sensitive"

        if [ ${#conflicts[@]} -gt 0 ]; then
            conflict_total=$((conflict_total + new_conflicts))
            if [ "$conflict_total" -gt 1024 ]; then
                die "package installation reported more than 1024 file conflicts; refusing a blanket overwrite"
            fi
            overwrite+=("${conflicts[@]}")
            warn "package installation failed (exit $rc); retrying with overwrite limited to $new_conflicts newly reported conflict path(s)"
            continue
        fi
        warn "package installation failed (exit $rc); retrying with the packages already downloaded"
        sleep 5
    done
    [ "$rc" -eq 0 ] || die "package installation failed (exit $rc); full log: $logfile"

    # pacman returns 0 even when a package's .INSTALL script fails, so a
    # desktop environment can look "installed" while its binaries are missing.
    # Arch scriptlets call systemd-sysusers/systemd-tmpfiles, which do not exist
    # here; say so instead of leaving unexplained 'error:' lines behind
    # (ProblemsWhenInstalling.txt #9).
    local errors=0
    errors=$(grep -c '^error:' "$logfile" 2>/dev/null) || errors=0
    if [ "${errors:-0}" -gt 0 ]; then
        warn "the package manager printed $errors error line(s) above"
        warn "package scriptlets assume systemd and a full desktop library stack; the commands below are verified separately"
    fi
}

# Fail loudly when the package manager claimed success but the commands the
# desktop needs are not there.
verify_binaries() {
    local missing=() bin
    for bin in "$@"; do
        [ -n "$bin" ] || continue
        [ -x "$TARGET_ROOT$bin" ] || missing+=("$bin")
    done
    if [ ${#missing[@]} -gt 0 ]; then
        die "installation did not provide: ${missing[*]}"$'\n'"        run 'sudo garb update' to refresh the databases, then retry; the package manager errors are above"
    fi
    for bin in "$@"; do
        [ -n "$bin" ] || continue
        if [ -f "$TARGET_ROOT$bin" ]; then
            local missing_so
            missing_so=$(LD_LIBRARY_PATH="$TARGET_ROOT/usr/lib:$TARGET_ROOT/lib" ldd "$TARGET_ROOT$bin" 2>/dev/null | grep 'not found' || true)
            if [ -n "$missing_so" ]; then
                warn "binary $bin has missing shared libraries:"
                printf '%s\n' "$missing_so" >&2
            fi
        fi
    done
}

# Accounts that packages normally create with systemd-sysusers. Without them
# the service daemon refuses to start, which is why the display manager never
# came up (ProblemsWhenInstalling.txt #10).
ensure_service_account() {
    local user="$1" home="$2" shell=/usr/bin/nologin
    [ "$TARGET_ROOT" = "/" ] || return 0
    if id -u "$user" >/dev/null 2>&1; then
        # The base image declares some service accounts in /etc/passwd without
        # a /etc/shadow entry. useradd then refuses with "user already exists"
        # and PAM has no credentials to establish for the account.
        if ! getent shadow "$user" >/dev/null 2>&1; then
            printf '%s:!:19000:0:99999:7:::\n' "$user" >> "$TARGET_ROOT/etc/shadow"
            chmod 0600 "$TARGET_ROOT/etc/shadow"
        fi
        return 0
    fi
    [ -x "$shell" ] || shell=/bin/false
    groupadd -r "$user" 2>/dev/null || true
    useradd -r -g "$user" -d "$home" -s "$shell" "$user" 2>/dev/null || true
}

# LightDM's packaged greeter PAM stack uses pam_unix for session credentials.
# The greeter runs as the locked lightdm service account, so pam_setcred aborts
# before the greeter can draw ("Failed to establish PAM credentials"). The
# greeter is intentionally unauthenticated; replace only its session stack.
fix_lightdm_greeter_pam() {
    local pam="$TARGET_ROOT/etc/pam.d/lightdm-greeter"
    local conf_dir="$TARGET_ROOT/etc/lightdm/lightdm.conf.d"
    [ -d "$TARGET_ROOT/etc/pam.d" ] || return 0
    cat > "$pam" <<'EOF'
#%PAM-1.0
# Grintion-OS greeter stack: the greeter runs as the locked lightdm service
# account and is intentionally unauthenticated. pam_unix session credential
# setup aborts for that account, so use pam_permit for the greeter session.
auth required pam_permit.so
account required pam_permit.so
password required pam_deny.so
session required pam_permit.so
EOF
    chmod 0644 "$pam"

    # LightDM's compiled default greeter session is "default", but Arch's
    # lightdm-gtk-greeter package installs "lightdm-gtk-greeter.desktop".
    # Without this explicit drop-in LightDM exits before drawing anything.
    # logind is absent here, so do not make the seat depend on its graphical
    # seat list either; logind-check-graphical is a [LightDM] option.
    mkdir -p "$conf_dir"
    cat > "$conf_dir/50-grintion.conf" <<'EOF'
[LightDM]
logind-check-graphical=false

[Seat:*]
greeter-session=lightdm-gtk-greeter
session-wrapper=/etc/lightdm/Xsession-grintion
xserver-command=X -nolisten tcp -nolisten local
EOF
    chmod 0644 "$conf_dir/50-grintion.conf"
    if [ ! -x "$TARGET_ROOT/etc/lightdm/Xsession-grintion" ]; then
        warn "missing session wrapper: $TARGET_ROOT/etc/lightdm/Xsession-grintion"
    fi
}

# dbus-daemon drops privileges to the <user> in system.conf. Arch names it
# "dbus"; older configurations use "messagebus" (ProblemsWhenInstalling.txt #10).
dbus_service_user() {
    local conf="$TARGET_ROOT/usr/share/dbus-1/system.conf" name=""
    if [ -r "$conf" ]; then
        name="$(sed -n 's:.*<user>\(.*\)</user>.*:\1:p' "$conf" | head -n 1)"
    fi
    printf '%s\n' "${name:-dbus}"
}

# D-Bus policy files name service accounts (polkitd, colord, avahi) and groups
# (network). Upstream creates them with systemd-sysusers, which does not exist
# here, so dbus-daemon printed "Unknown username ..." on every boot and the
# services could not drop privileges (ProblemsWhenInstalling.txt #7).
provision_dbus_accounts() {
    local conf user group
    [ "$TARGET_ROOT" = "/" ] || return 0
    for conf in /usr/share/dbus-1/system.d/*.conf /etc/dbus-1/system.d/*.conf; do
        [ -r "$conf" ] || continue
        # Plain pipelines, not <(...): the installed image has no /dev/fd, so
        # process substitution fails with "No such file or directory".
        sed -n 's/.*<policy[^>]* user="\([^"]*\)".*/\1/p' "$conf" |
        while IFS= read -r user; do
            case "$user" in ""|root) continue ;; esac
            ensure_service_account "$user" "/var/lib/$user"
        done
        sed -n 's/.*<policy[^>]* group="\([^"]*\)".*/\1/p' "$conf" |
        while IFS= read -r group; do
            case "$group" in ""|root) continue ;; esac
            getent group "$group" >/dev/null 2>&1 && continue
            groupadd -r "$group" 2>/dev/null || warn "could not create group: $group"
        done
    done
}

enable_dm_service() {
    local dm="$1"
    local sv_dir="$TARGET_ROOT/etc/sv/display-manager"
    local var_sv="$TARGET_ROOT/var/service/display-manager"

    # Only provision the account on the running system. With --root the lightdm
    # package's own scriptlets own target-side account creation; creating the
    # user on the host would be wrong (F4 review note).
    if [ "$TARGET_ROOT" = "/" ]; then
        if [ "$dm" = "/usr/bin/lightdm" ]; then
            ensure_service_account lightdm /var/lib/lightdm
            fix_lightdm_greeter_pam
            mkdir -p "$TARGET_ROOT/var/lib/lightdm" "$TARGET_ROOT/var/log/lightdm"
            chown -R lightdm:lightdm "$TARGET_ROOT/var/lib/lightdm" "$TARGET_ROOT/var/log/lightdm" 2>/dev/null || true
            if [ -f "$TARGET_ROOT/etc/lightdm/lightdm.conf" ]; then
                sed -i 's/^#\?greeter-session=.*/greeter-session=lightdm-gtk-greeter/' "$TARGET_ROOT/etc/lightdm/lightdm.conf"
                sed -i 's|^#\?session-wrapper=.*|session-wrapper=/etc/lightdm/Xsession-grintion|' "$TARGET_ROOT/etc/lightdm/lightdm.conf"
                sed -i 's|^#\?xserver-command=.*|xserver-command=X -nolisten tcp -nolisten local|' "$TARGET_ROOT/etc/lightdm/lightdm.conf"
            fi
        elif [ "$dm" = "/usr/bin/sddm" ]; then
            ensure_service_account sddm /var/lib/sddm
            mkdir -p "$TARGET_ROOT/var/lib/sddm" "$TARGET_ROOT/var/log/sddm"
            chown -R sddm:sddm "$TARGET_ROOT/var/lib/sddm" "$TARGET_ROOT/var/log/sddm" 2>/dev/null || true
        elif [ "$dm" = "/usr/bin/gdm" ]; then
            ensure_service_account gdm /var/lib/gdm
            mkdir -p "$TARGET_ROOT/var/lib/gdm" "$TARGET_ROOT/var/log/gdm"
            chown -R gdm:gdm "$TARGET_ROOT/var/lib/gdm" "$TARGET_ROOT/var/log/gdm" 2>/dev/null || true
        elif [ "$dm" = "/usr/bin/greetd" ]; then
            ensure_service_account greeter /var/lib/greeter
            mkdir -p "$TARGET_ROOT/var/lib/greeter" "$TARGET_ROOT/var/log/greetd" "$TARGET_ROOT/etc/greetd"
            chown -R greeter:greeter "$TARGET_ROOT/var/lib/greeter" "$TARGET_ROOT/var/log/greetd" 2>/dev/null || true
        fi
    fi

    mkdir -p "$TARGET_ROOT/etc/grintion"
    printf '%s\n' "$(basename "$dm")" > "$TARGET_ROOT/etc/grintion/display-manager"

    # Use the tracked service script instead of regenerating it here, so the
    # deployed copy cannot drift from etc/sv/display-manager/run (handoff L7).
    [ -f "$sv_dir/run" ] || die "tracked display-manager service is missing: $sv_dir/run"
    chmod 0755 "$sv_dir/run"

    # Every supported display manager needs the D-Bus system bus and the account
    # that the dbus package normally creates with systemd-sysusers.
    local dbus_user
    dbus_user="$(dbus_service_user)"
    ensure_service_account "$dbus_user" /run/dbus
    mkdir -p "$TARGET_ROOT/run/dbus"
    chown "$dbus_user:$dbus_user" "$TARGET_ROOT/run/dbus" 2>/dev/null || true
    local dbus_dir="$TARGET_ROOT/etc/sv/dbus"
    if [ -f "$dbus_dir/run" ]; then
        chmod 0755 "$dbus_dir/run"
        mkdir -p "$(dirname "$TARGET_ROOT/var/service/dbus")"
        ln -sfn "/etc/sv/dbus" "$TARGET_ROOT/var/service/dbus"
    else
        warn "tracked dbus service is missing: $dbus_dir/run"
    fi

    mkdir -p "$(dirname "$var_sv")"
    ln -sfn "/etc/sv/display-manager" "$var_sv"
    log "Enabled $dm as runit display-manager service"
}

# Without logind there is no udev/pam ACL pass that grants the logged-in user
# access to graphics, sound and input nodes. /dev/dri/card0 is root:video,
# /dev/input/* is root:input and /dev/snd/* is root:audio, so a human account
# that is only in "wheel" cannot start a Wayland compositor. Add every human
# account to those groups, and to "seat" only for Wayland profiles so seatd
# can hand out DRM/input descriptors.
#
# Older images shipped duplicate "render" and "input" group lines; usermod
# then refused with "Multiple entries named 'render'" and the session could
# never open the DRM device. Collapse duplicates first.
grant_session_groups() {
    local with_seat="${1:-0}"
    local group_file="$TARGET_ROOT/etc/group"
    local passwd_file="$TARGET_ROOT/etc/passwd"
    [ -f "$group_file" ] && [ -f "$passwd_file" ] || return 0

    python3 - "$group_file" "$passwd_file" "$with_seat" <<'PY'
import pathlib
import sys

group_path = pathlib.Path(sys.argv[1])
passwd_path = pathlib.Path(sys.argv[2])
with_seat = sys.argv[3] == "1"

lines = []
seen = set()
for line in group_path.read_text().splitlines():
    name = line.split(":", 1)[0]
    if not line.strip() or name in seen:
        continue
    seen.add(name)
    lines.append(line)

used_gids = set()
for line in lines:
    fields = line.split(":")
    if len(fields) >= 3 and fields[2].isdigit():
        used_gids.add(int(fields[2]))

wanted = ["video", "audio", "input", "render"]
if with_seat:
    wanted.append("seat")
next_gid = 985
for name in wanted:
    if name in seen:
        continue
    while next_gid in used_gids:
        next_gid += 1
    lines.append(f"{name}:x:{next_gid}:")
    used_gids.add(next_gid)
    seen.add(name)

humans = []
for line in passwd_path.read_text().splitlines():
    fields = line.split(":")
    if len(fields) < 4 or not fields[2].isdigit():
        continue
    if 1000 <= int(fields[2]) < 60000:
        humans.append(fields[0])

for index, line in enumerate(lines):
    fields = line.split(":")
    if not fields or fields[0] not in wanted:
        continue
    members = [m for m in (fields[3].split(",") if len(fields) > 3 and fields[3] else []) if m]
    for user in humans:
        if user not in members:
            members.append(user)
    fields[3] = ",".join(members)
    lines[index] = ":".join(fields)

group_path.write_text("\n".join(lines) + "\n")
PY
}

# SDDM's Wayland sessions expect logind/pam_systemd to have created
# XDG_RUNTIME_DIR. Without it KWin exits with "Could not create wayland
# socket". Point SDDM at the tracked wrapper instead of its packaged script.
configure_sddm_wayland() {
    local wrapper="$TARGET_ROOT/etc/sddm/wayland-session-grintion"
    [ -f "$wrapper" ] || die "tracked SDDM Wayland session wrapper is missing: $wrapper"
    chmod 0755 "$wrapper"
    mkdir -p "$TARGET_ROOT/etc/sddm.conf.d"
    cat > "$TARGET_ROOT/etc/sddm.conf.d/20-grintion-wayland.conf" <<'EOF'
# Grintion-OS has no logind/pam_systemd to create the per-user runtime
# directory, so SDDM's default Wayland session script left KWin without a
# writable XDG_RUNTIME_DIR. This wrapper provides it before exec'ing the
# packaged session script.
[Wayland]
SessionCommand=/etc/sddm/wayland-session-grintion
EOF
    chmod 0644 "$TARGET_ROOT/etc/sddm.conf.d/20-grintion-wayland.conf"
    log "Configured SDDM Wayland session runtime wrapper"
}

configure_x11_security() {
    # Xorg is only present for X11-capable profiles. Write these files after
    # package installation because pacman may have installed its own
    # xserverrc, and point every supported display manager at the safe flags.
    if [ ! -x "$TARGET_ROOT/usr/bin/Xorg" ] && [ ! -x "$TARGET_ROOT/usr/bin/X" ]; then
        return 0
    fi

    local xinit_dir="$TARGET_ROOT/etc/X11/xinit"
    mkdir -p "$xinit_dir" "$TARGET_ROOT/etc/X11/xorg.conf.d"
    cat > "$xinit_dir/xserverrc" <<'EOF'
#!/bin/sh
# Disable the TCP and abstract-namespace X11 transports. Clients must use the
# local filesystem socket and present the per-session MIT-MAGIC-COOKIE.
server=/usr/bin/X
[ -x "$server" ] || server=/usr/bin/Xorg
exec "$server" -nolisten tcp -nolisten local "$@"
EOF
    chmod 0755 "$xinit_dir/xserverrc"

    if [ -d "$TARGET_ROOT/etc/lightdm" ]; then
        local lightdm_conf="$TARGET_ROOT/etc/lightdm/lightdm.conf"
        if [ -f "$lightdm_conf" ] && grep -q '^#\?xserver-command=' "$lightdm_conf"; then
            sed -i 's|^#\?xserver-command=.*|xserver-command=X -nolisten tcp -nolisten local|' "$lightdm_conf"
        fi
        mkdir -p "$TARGET_ROOT/etc/lightdm/lightdm.conf.d"
        cat > "$TARGET_ROOT/etc/lightdm/lightdm.conf.d/60-grintion-x11.conf" <<'EOF'
[Seat:*]
xserver-command=X -nolisten tcp -nolisten local
EOF
        chmod 0644 "$TARGET_ROOT/etc/lightdm/lightdm.conf.d/60-grintion-x11.conf"
    fi

    if [ -x "$TARGET_ROOT/usr/bin/sddm" ]; then
        mkdir -p "$TARGET_ROOT/etc/sddm.conf.d"
        cat > "$TARGET_ROOT/etc/sddm.conf.d/10-grintion-security.conf" <<'EOF'
[X11]
ServerArguments=-nolisten tcp -nolisten local
EOF
        chmod 0644 "$TARGET_ROOT/etc/sddm.conf.d/10-grintion-security.conf"
    fi

    log "Configured X11 without TCP/abstract listeners and with cookie access control"
}

# Session files are what a greeter lists. Most desktops ship their own, but
# lxqt does not, so LightDM had nothing to launch and the login looped back to
# the greeter. Install the tracked entries when the package does not provide
# one; never overwrite a package-owned file.
install_session_desktop() {
    local key="$1" name dest
    case "$key" in
        kde) name=plasma.desktop ;;
        *) name="$key.desktop" ;;
    esac
    dest="$TARGET_ROOT/usr/share/xsessions"
    case "${DISPLAY_SERVER:-}" in
        *wayland*) dest="$TARGET_ROOT/usr/share/wayland-sessions" ;;
    esac
    if [ ! -f "$TARGET_ROOT/etc/grintion/sessions/$name" ]; then
        return 0
    fi
    mkdir -p "$dest"
    if [ ! -f "$dest/$name" ]; then
        install -m 0644 "$TARGET_ROOT/etc/grintion/sessions/$name" "$dest/$name"
        log "Installed session entry /usr/share/${dest##*/}/$name"
    fi
}

# Sway reads one user config file; the package's /etc/sway/config is only a
# template. Give each human a copy (with the Grintion drop-in included) so
# 'sway' starts a usable session instead of the first-run wizard.
configure_sway_config() {
    local src="$TARGET_ROOT/etc/sway/config" home owner created=0
    [ -f "$src" ] || return 0
    for home in "$TARGET_ROOT"/home/*; do
        [ -d "$home" ] || continue
        owner=$(stat -c '%u:%g' "$home" 2>/dev/null || echo 0:0)
        mkdir -p "$home/.config/sway"
        chown "$owner" "$home/.config/sway" 2>/dev/null || true
        if [ -f "$home/.config/sway/config" ]; then
            continue
        fi
        install -m 0644 "$src" "$home/.config/sway/config"
        if ! grep -q '^include /etc/sway/config.d/\*' "$home/.config/sway/config"; then
            printf '\n# Grintion-OS session defaults (audio, seat helpers).\ninclude /etc/sway/config.d/*\n' \
                >> "$home/.config/sway/config"
        fi
        chown "$owner" "$home/.config/sway/config" 2>/dev/null || true
        created=$((created + 1))
    done
    log "Installed the default Sway config for $created account(s)"
}

# Wayland compositors use libseat to obtain DRM/input access. There is no
# logind in this image, so seatd is the seat provider. Human users need to be
# in the socket's group; service accounts must not be added.
enable_wayland_seat() {
    local group_file="$TARGET_ROOT/etc/group"
    local passwd_file="$TARGET_ROOT/etc/passwd"
    local service_dir="$TARGET_ROOT/etc/sv/seatd"
    [ -f "$group_file" ] || die "target group database is missing: $group_file"
    [ -f "$passwd_file" ] || die "target account database is missing: $passwd_file"

    if ! grep -q '^seat:' "$group_file"; then
        local gid=985
        while awk -F: -v g="$gid" '$3 == g { found = 1 } END { exit !found }' "$group_file"; do
            gid=$((gid + 1))
        done
        printf 'seat:x:%s:\n' "$gid" >> "$group_file"
    fi

    python3 - "$group_file" "$passwd_file" <<'PY'
import pathlib
import sys

group_path = pathlib.Path(sys.argv[1])
passwd_path = pathlib.Path(sys.argv[2])
humans = []
for line in passwd_path.read_text().splitlines():
    fields = line.split(":")
    if len(fields) < 4:
        continue
    try:
        uid = int(fields[2])
    except ValueError:
        continue
    if 1000 <= uid < 60000:
        humans.append(fields[0])
lines = group_path.read_text().splitlines()
for index, line in enumerate(lines):
    fields = line.split(":")
    if fields and fields[0] == "seat":
        members = [m for m in (fields[3].split(",") if len(fields) > 3 else []) if m]
        for user in humans:
            if user not in members:
                members.append(user)
        fields[3] = ",".join(members)
        lines[index] = ":".join(fields)
        break
group_path.write_text("\n".join(lines) + "\n")
PY

    # seatd ships libseat.so.1; it is the seat library every wlroots
    # compositor (sway, wayfire, river, ...) links against. The base image
    # contains the seeded seatd binary, so pacman can treat the package as
    # installed while the library is absent. Keep the profile's seatd entry
    # (it forces a reinstall) and fail here instead of leaving a compositor
    # that aborts with "libseat.so.1: cannot open shared object file".
    if ! compgen -G "$TARGET_ROOT/usr/lib/libseat.so*" >/dev/null; then
        die "seatd is installed but libseat.so is missing from $TARGET_ROOT/usr/lib"$'\n'"        remove the incomplete package or reinstall it: pacman -S seatd"
    fi

    [ -f "$service_dir/run" ] || die "tracked seatd service is missing: $service_dir/run"
    chmod 0755 "$service_dir/run"
    mkdir -p "$(dirname "$TARGET_ROOT/var/service/seatd")"
    ln -sfn "/etc/sv/seatd" "$TARGET_ROOT/var/service/seatd"
    log "Enabled seatd and verified the libseat library for Wayland seat management"
}

cmd_list() {
    if [ "$LIST_JSON" -eq 1 ]; then
        local dir profile first=1
        dir="$(profile_directory)"
        printf '[\n'
        for profile in "$dir"/*.conf; do
            [ -f "$profile" ] || continue
            unset NAME DESCRIPTION PACKAGES DM DM_BIN XINITRC DISPLAY_SERVER
            # shellcheck disable=SC1090
            . "$profile"
            [ -n "${NAME:-}" ] || continue
            [ "$first" -eq 1 ] || printf ',\n'
            first=0
            printf '  {"name":"%s","description":"%s","packages":[' \
                "$(json_escape "$NAME")" "$(json_escape "${DESCRIPTION:-}")"
            local sep="" pkg
            for pkg in ${PACKAGES:-}; do
                printf '%s"%s"' "$sep" "$(json_escape "$pkg")"
                sep=","
            done
            printf '],"display_manager":"%s","dm_bin":"%s","display_server":"%s","xinitrc":"%s"}' \
                "$(json_escape "${DM:-}")" "$(json_escape "${DM_BIN:-}")" \
                "$(json_escape "${DISPLAY_SERVER:-}")" "$(json_escape "${XINITRC:-}")"
        done
        printf '\n]\n'
        return 0
    fi
    cat <<'EOF'
Supported Desktop Environments and Window Managers in Grintion-OS:

  [1] XFCE (xfce)
      Type: Desktop Environment (X11)
      Default Display Manager: LightDM
      Description: Fast, lightweight, user-friendly traditional desktop.
      Recommended for: General desktop use, older hardware, lightweight setups.

  [2] GNOME (gnome) - NOT SUPPORTED
      Type: Desktop Environment (Wayland)
      Default Display Manager: GDM
      Description: gnome-session 51 requires the systemd user session manager
      (org.freedesktop.systemd1). Grintion-OS runs runit without systemd or
      logind, so the session aborts before drawing. Installation is refused.

  [3] KDE Plasma (kde, plasma)
      Type: Desktop Environment (Wayland)
      Default Display Manager: SDDM
      Description: Gorgeous, highly customizable, modular desktop environment.
      Recommended for: Power users who want customization and sleek aesthetics.

  [4] LXQt (lxqt)
      Type: Desktop Environment (X11)
      Default Display Manager: LightDM
      Description: Extremely lightweight Qt-based desktop.
      Recommended for: Minimum resource usage.

  [5] Sway (sway)
      Type: Tiling Window Manager (Wayland)
      Default Display Manager: None (starts from console or LightDM)
      Description: Modern, fast i3-compatible Wayland compositor.
      Recommended for: Keyboard-driven workflow and minimalists.

  [6] i3 (i3)
      Type: Tiling Window Manager (X11)
      Default Display Manager: LightDM
      Description: Robust, manual tiling window manager.
      Recommended for: Keyboard-focused productivity.
EOF
}

cmd_status() {
    echo "=== Grintion-OS Desktop & GUI Status ==="
    echo "Target root: $TARGET_ROOT"
    
    echo -n "Display server: "
    local servers=()
    if [ -f "$TARGET_ROOT/usr/bin/Xorg" ]; then servers+=("Xorg"); fi
    if [ -f "$TARGET_ROOT/usr/bin/Xwayland" ]; then servers+=("Wayland/Xwayland"); fi
    if [ ${#servers[@]} -gt 0 ]; then
        echo "${servers[*]}"
    else
        echo "None"
    fi

    echo -n "Installed Desktops: "
    local desktops=()
    if [ -f "$TARGET_ROOT/usr/bin/startxfce4" ]; then desktops+=("XFCE"); fi
    if [ -f "$TARGET_ROOT/usr/bin/gnome-shell" ]; then desktops+=("GNOME"); fi
    if [ -f "$TARGET_ROOT/usr/bin/startplasma-x11" ] || [ -f "$TARGET_ROOT/usr/bin/startplasma-wayland" ]; then
        desktops+=("KDE Plasma")
    fi
    if [ -f "$TARGET_ROOT/usr/bin/startlxqt" ]; then desktops+=("LXQt"); fi
    if [ -f "$TARGET_ROOT/usr/bin/sway" ]; then desktops+=("Sway"); fi
    if [ -f "$TARGET_ROOT/usr/bin/i3" ]; then desktops+=("i3"); fi
    if [ ${#desktops[@]} -gt 0 ]; then
        echo "${desktops[*]}"
    else
        echo "None"
    fi

    echo -n "Display Manager: "
    local dms=()
    if [ -f "$TARGET_ROOT/usr/bin/lightdm" ]; then dms+=("LightDM"); fi
    if [ -f "$TARGET_ROOT/usr/bin/sddm" ]; then dms+=("SDDM"); fi
    if [ -f "$TARGET_ROOT/usr/bin/gdm" ]; then dms+=("GDM"); fi
    if [ ${#dms[@]} -gt 0 ]; then
        echo "${dms[*]}"
    else
        echo "None"
    fi

    echo -n "Display Manager service: "
    if [ -L "$TARGET_ROOT/var/service/display-manager" ]; then
        echo "Active (/var/service/display-manager)"
    else
        echo "Inactive"
    fi

    echo -n "Seat service: "
    if [ -L "$TARGET_ROOT/var/service/seatd" ]; then
        echo "Active (/var/service/seatd)"
    elif [ -x "$TARGET_ROOT/usr/bin/seatd" ]; then
        echo "Installed (not enabled)"
    else
        echo "None"
    fi
}

cmd_drivers() {
    [ "$(id -u)" -eq 0 ] || die "Driver installation requires root privileges"
    log "Scanning hardware for GPU devices..."
    local drivers=()
    read -r -a drivers <<< "$(detect_gpu_drivers)"
    log "Recommended drivers: ${drivers[*]}"
    pkg_install "${drivers[@]}"
    log "GPU drivers installed successfully."
}

cmd_install() {
    local target_de="${1:-}"
    if [ -z "$target_de" ]; then
        cmd_list
        echo
        printf "Select desktop to install (xfce/gnome/kde/lxqt/sway/i3): "
        read -r target_de
    fi

    [ "$(id -u)" -eq 0 ] || die "Desktop installation requires root privileges"

    local profile_dir
    profile_dir="$(profile_directory)"
    load_profile "$target_de" "$profile_dir"
    target_de="$NAME"

    # GNOME 51's gnome-session starts everything through
    # org.freedesktop.systemd1 (gnome-session@gnome.target) and aborts with
    # "Failed to start unit" when it is absent. There is no systemd user
    # manager or logind in this image, so refuse before downloading ~1.5 GB
    # of packages that cannot produce a desktop.
    if [ "${REQUIRES_SYSTEMD:-0}" = "1" ]; then
        die "$NAME requires the systemd user session manager (org.freedesktop.systemd1); Grintion-OS runs runit without systemd/logind and gnome-session exits before drawing"$'\n'"        install xfce, lxqt, kde or sway instead"
    fi

    # KDE's current package set is about 1.2 GiB downloaded and 3.6 GiB
    # installed. A live boot without persistence stores both the package cache
    # and the installed files in the RAM overlay, which defaults to half of
    # RAM; a 4 GiB machine therefore cannot complete the transaction. Stop
    # before downloading rather than leaving pacman to fail with ENOSPC. The
    # installer performs the same profile inside the target root, where the
    # cache and files live on the destination disk.
    if [ "$target_de" = "kde" ] && [ "$TARGET_ROOT" = "/" ] && [ -f /etc/grintion/live ]; then
        local free_mib
        free_mib=$(df -Pm / | awk 'NR == 2 { print $4 }')
        if [ "${free_mib:-0}" -lt 5200 ]; then
            die "KDE Plasma needs about 4.8 GiB for its download and installed files; the live RAM overlay has ${free_mib:-unknown} MiB."$'\n'"        Install it to a disk with: grintion-install --desktop kde"$'\n'"        or boot from a persistence partition before installing the desktop."
        fi
    fi

    local wayland=0
    case "${DISPLAY_SERVER:-}" in
        *wayland*) wayland=1 ;;
    esac
    grant_session_groups "$wayland"

    local base_pkgs=()
    local de_pkgs=()
    local dm_pkg="${DM:-}"
    local dm_bin="${DM_BIN:-}"
    local xinit_cmd="${XINITRC:-}"
    read -r -a de_pkgs <<< "${PACKAGES:-}"

    # Handle display manager override
    if [ -n "$CHOSEN_DM" ]; then
        case "$CHOSEN_DM" in
            lightdm)
                dm_pkg="lightdm lightdm-gtk-greeter"
                dm_bin="/usr/bin/lightdm"
                ;;
            sddm)
                dm_pkg="sddm"
                dm_bin="/usr/bin/sddm"
                ;;
            gdm)
                dm_pkg="gdm"
                dm_bin="/usr/bin/gdm"
                ;;
            none)
                dm_pkg=""
                dm_bin=""
                ;;
            *)
                die "Unsupported display manager: $CHOSEN_DM"
                ;;
        esac
    fi

    # A display manager talks to the D-Bus system bus, so make sure the
    # service has a daemon to talk to.
    if [ -n "$dm_bin" ] && [[ " $dm_pkg " != *" dbus "* ]]; then
        dm_pkg="$dm_pkg dbus"
    fi

    # 1. Install GPU Drivers
    if [ "$SKIP_DRIVERS" -eq 0 ]; then
        log "Detecting and preparing GPU drivers..."
        local drv_list=()
        read -r -a drv_list <<< "$(detect_gpu_drivers)"
        base_pkgs+=("${drv_list[@]}")
    fi

    # 2. Collect all packages
    local all_to_install=()
    for p in "${base_pkgs[@]}" "${de_pkgs[@]}" $dm_pkg; do
        [ -n "$p" ] && all_to_install+=("$p")
    done

    log "Starting installation of $target_de environment..."
    pkg_install "${all_to_install[@]}"

    # The package manager can exit 0 with a half-installed desktop, so check
    # the commands the profile promises before reporting success.
    local expected=()
    if [ -n "$dm_bin" ]; then
        expected+=("$dm_bin")
    fi
    if [ -n "$xinit_cmd" ]; then
        local launch="${xinit_cmd#exec }"
        launch="${launch%% *}"
        if [ -n "$launch" ]; then
            expected+=("/usr/bin/$launch")
        fi
    fi
    verify_binaries "${expected[@]}"

    install_session_desktop "$NAME"
    if [ "$NAME" = "sway" ]; then
        configure_sway_config
    fi

    # The packages just installed expect systemd-sysusers to have created their
    # service accounts; without them dbus-daemon warns on the console and the
    # daemons cannot start.
    provision_dbus_accounts
    configure_x11_security

    # Ensure mcookie exists for startx
    if [ ! -x "$TARGET_ROOT/usr/bin/mcookie" ]; then
        mkdir -p "$TARGET_ROOT/usr/bin"
        printf '#!/bin/sh\nexec openssl rand -hex 16\n' > "$TARGET_ROOT/usr/bin/mcookie"
        chmod 0755 "$TARGET_ROOT/usr/bin/mcookie"
    fi

    # Ensure Xwrapper.config exists so unprivileged console users can run startx.
    # pacman's xorg-server package does not ship this file; without it Xorg
    # refuses to start for non-root users even when needs_root_rights=yes would
    # allow it.  Write it only when xorg-server was actually installed.
    if [ -x "$TARGET_ROOT/usr/bin/Xorg" ] || [ -x "$TARGET_ROOT/usr/bin/X" ]; then
        local xwrapper_dir="$TARGET_ROOT/etc/X11"
        mkdir -p "$xwrapper_dir"
        if [ ! -f "$xwrapper_dir/Xwrapper.config" ]; then
            cat > "$xwrapper_dir/Xwrapper.config" << 'EOF'
# Xwrapper.config for Grintion-OS
# Allows unprivileged console users to launch Xorg without systemd-logind
allowed_users = console
needs_root_rights = yes
EOF
            chmod 0644 "$xwrapper_dir/Xwrapper.config"
        fi
    fi

    # 3. Configure Display Manager if applicable
    if [ -n "$dm_bin" ]; then
        enable_dm_service "$dm_bin"
        if [ "$dm_bin" = "/usr/bin/sddm" ] && [ "$wayland" -eq 1 ]; then
            configure_sddm_wayland
        fi
    fi
    if [[ "${DISPLAY_SERVER:-}" == *wayland* ]]; then
        [ -x "$TARGET_ROOT/usr/bin/seatd" ] || die "Wayland profile did not provide seatd"
        enable_wayland_seat
    fi

    # 4. Configure .xinitrc fallback from the profile

    if [ -n "$xinit_cmd" ]; then
        local skel_xinit="$TARGET_ROOT/etc/skel/.xinitrc"
        mkdir -p "$(dirname "$skel_xinit")"
        echo "$xinit_cmd" > "$skel_xinit"
        chmod 0755 "$skel_xinit"

        for udir in "$TARGET_ROOT"/home/*; do
            if [ -d "$udir" ]; then
                echo "$xinit_cmd" > "$udir/.xinitrc"
                local uname_owner
                uname_owner="$(basename "$udir")"
                chown "$uname_owner:$uname_owner" "$udir/.xinitrc" 2>/dev/null || true
                chmod 0755 "$udir/.xinitrc"
            fi
        done
        if [ -d "$TARGET_ROOT/root" ]; then
            echo "$xinit_cmd" > "$TARGET_ROOT/root/.xinitrc"
            chmod 0755 "$TARGET_ROOT/root/.xinitrc"
        fi
    fi

    if [ "$target_de" = "sway" ]; then
        log "Sway is Wayland-only; start it with 'sway', not 'startx'"
        echo "Sway config:  ~/.config/sway/config (copy /etc/sway/config first)"
    fi

    log "=============================================================="
    log "Desktop environment '$target_de' installed successfully!"
    log "=============================================================="
    local dm_running=0
    if [ -n "$dm_bin" ]; then
        if [ "$TARGET_ROOT" = "/" ]; then
            # runsvdir picks the new service up by itself; give the manager a
            # moment to settle and report the truth instead of a start command
            # that will only time out (ProblemsWhenInstalling.txt #10).
            sleep 3
            local dm_state
            dm_state="$(sv status /var/service/display-manager 2>&1 || true)"
            if printf '%s\n' "$dm_state" | grep -q '^run:'; then
                dm_running=1
            else
                warn "display-manager did not come up: $(printf '%s' "$dm_state" | tr '\n' ' ')"
                if [ -r /var/log/display-manager.log ]; then
                    warn "last lines of /var/log/display-manager.log:"
                    tail -n 20 /var/log/display-manager.log >&2 || true
                fi
            fi
        fi
        echo "Display Manager: $dm_bin (managed by runit: /var/service/display-manager)"
        if [ "$dm_running" -eq 1 ]; then
            echo "Status:          running (restart with: sudo sv restart display-manager)"
        else
            echo "To start now:    sudo sv start display-manager"
            echo "If it stops again: sudo tail -n 40 /var/log/display-manager.log"
        fi
    else
        if [ "$target_de" = "sway" ]; then
            echo "Launch command:  sway"
        else
            echo "Launch command:  $xinit_cmd (or run 'startx')"
        fi
    fi
    echo "=============================================================="
}

cmd_uninstall() {
    local target_de="${1:-}"
    [ -n "$target_de" ] || die "usage: grintion-desktop uninstall <desktop>"
    [ "$(id -u)" -eq 0 ] || die "Desktop removal requires root privileges"

    local profile_dir
    profile_dir="$(profile_directory)"
    load_profile "$target_de" "$profile_dir"

    local root_flag=()
    if [ "$TARGET_ROOT" != "/" ]; then
        root_flag=("--root" "$TARGET_ROOT")
    fi

    log "Removing $NAME packages"
    if command -v pacman >/dev/null 2>&1; then
        pacman "${root_flag[@]}" -Rns --noconfirm ${PACKAGES} || warn "pacman reported warnings"
    elif command -v garb >/dev/null 2>&1; then
        garb "${root_flag[@]}" remove --force ${PACKAGES} || warn "garb reported warnings"
    else
        die "Neither pacman nor garb package manager found"
    fi

    rm -f "$TARGET_ROOT/var/service/display-manager" "$TARGET_ROOT/etc/grintion/display-manager"
    if [ -n "${XINITRC:-}" ]; then
        for file in "$TARGET_ROOT/etc/skel/.xinitrc" "$TARGET_ROOT/root/.xinitrc" "$TARGET_ROOT"/home/*/.xinitrc; do
            [ -f "$file" ] || continue
            if [ "$(cat "$file")" = "$XINITRC" ]; then
                rm -f "$file"
            fi
        done
    fi
    log "Removed $NAME"
}

# Parse options
COMMAND=""
POSITIONAL=()

while [ $# -gt 0 ]; do
    case "$1" in
        list|drivers|status)
            COMMAND="$1"; shift ;;
        install|uninstall)
            COMMAND="$1"
            if [ $# -gt 1 ] && [[ "$2" != --* ]]; then
                POSITIONAL+=("$2")
                shift 2
            else
                shift
            fi
            ;;
        --json)
            LIST_JSON=1; shift ;;
        --dm|--display-manager)
            CHOSEN_DM="${2:-}"; shift 2 ;;
        --root)
            TARGET_ROOT="${2:-}"; shift 2 ;;
        --no-drivers)
            SKIP_DRIVERS=1; shift ;;
        -y|--noconfirm)
            NO_CONFIRM=1; shift ;;
        -h|--help)
            usage; exit 0 ;;
        *)
            if [ -z "$COMMAND" ]; then
                COMMAND="install"
                POSITIONAL+=("$1")
                shift
            else
                die "Unknown option or argument: $1"
            fi
            ;;
    esac
done

case "${COMMAND:-install}" in
    list)    cmd_list ;;
    drivers) cmd_drivers ;;
    status)  cmd_status ;;
    install) cmd_install "${POSITIONAL[0]:-}" ;;
    uninstall) cmd_uninstall "${POSITIONAL[0]:-}" ;;
    *)       usage; exit 1 ;;
esac
