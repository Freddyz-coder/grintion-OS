#!/usr/bin/env python3
"""grintion-kernel - multi-kernel manager and bootloader entry coordinator.

The source-built 6.12 kernel is the LTS/default flavor. The HWE and DKMS
flavors install Arch's current kernel from the same dated snapshot used by the
image, build a Grintion-specific initramfs, and add a separate Limine entry.
The original LTS entry is never removed, so a failed HWE boot is recoverable
from the boot menu.
"""
from __future__ import annotations

import argparse
import glob
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

FLAVORS = {
    "lts": {
        "description": "Grintion source-built Linux 6.12 LTS (default, no download)",
        "packages": [],
        "boot": False,
    },
    "hwe": {
        "description": "Arch current kernel + headers from the pinned snapshot (hardware enablement)",
        "packages": ["linux", "linux-headers", "mkinitcpio"],
        "boot": True,
    },
    "dkms": {
        "description": "HWE kernel + matching headers + DKMS module build support",
        "packages": ["linux", "linux-headers", "mkinitcpio", "dkms"],
        "boot": True,
    },
}
MKINITCPIO_CONFIG = """# Generated by grintion-kernel for the HWE flavor.
# No systemd hooks: Grintion runs runit, and mkinitcpio's udev hook uses the
# standalone systemd-udevd already present in the image.
MODULES=()
BINARIES=()
FILES=()
HOOKS=(base udev autodetect microcode modconf kms keyboard keymap consolefont block encrypt filesystems fsck)
COMPRESSION="zstd"
"""


def root_path(path: str) -> Path:
    prefix = os.environ.get("GRINTION_ROOT", "").rstrip("/")
    if prefix:
        return Path(f"{prefix}/{path.lstrip('/')}")
    return Path(path)


def run(argv: list[str], *, root: Path | None = None, check: bool = True) -> int:
    print(f"[*] {' '.join(argv)}", file=sys.stderr)
    result = subprocess.run(argv, cwd=root if root else None, check=False)
    if check and result.returncode != 0:
        raise SystemExit(result.returncode)
    return result.returncode


def list_installed_kernels(boot_dir: Path | None = None) -> list[dict]:
    boot = boot_dir or root_path("/boot")
    kernels = []
    if not boot.is_dir():
        return kernels

    limine_conf = boot / "limine.conf"
    default_entry = ""
    if limine_conf.is_file():
        content = limine_conf.read_text(encoding="utf-8")
        m = re.search(r"^\s*default_entry:\s*(\d+)", content, re.MULTILINE)
        if m:
            default_entry = m.group(1)

    kernel_files = sorted(boot.glob("vmlinuz*"))
    for idx, kf in enumerate(kernel_files):
        name = kf.name
        version_str = name.removeprefix("vmlinuz-").removeprefix("vmlinuz") or "default"
        initramfs_file = boot / f"initramfs-{version_str}.img"
        if not initramfs_file.exists():
            fallback_init = boot / "initramfs.img"
            if fallback_init.exists():
                initramfs_file = fallback_init

        is_default = (str(idx + 1) == default_entry) or (idx == 0 and not default_entry)

        kernels.append({
            "index": idx + 1,
            "name": name,
            "version": version_str,
            "path": str(kf),
            "initramfs": str(initramfs_file) if initramfs_file.exists() else None,
            "is_default": is_default,
            "size_bytes": kf.stat().st_size,
        })

    return kernels


def set_default_kernel(index: int, boot_dir: Path | None = None) -> None:
    boot = boot_dir or root_path("/boot")
    limine_conf = boot / "limine.conf"
    if not limine_conf.is_file():
        limine_conf.parent.mkdir(parents=True, exist_ok=True)
        limine_conf.write_text(f"timeout: 3\ndefault_entry: {index}\n")
        print(f"[*] created {limine_conf} with default_entry {index}")
        return

    content = limine_conf.read_text(encoding="utf-8")
    if "default_entry:" in content:
        new_content = re.sub(r"default_entry:\s*\d+", f"default_entry: {index}", content)
    else:
        new_content = f"default_entry: {index}\n" + content
    limine_conf.write_text(new_content, encoding="utf-8")
    print(f"[*] set Limine default_entry to {index}")


def flavor_report() -> list[dict]:
    pacman = shutil.which("pacman")
    report = []
    for name, meta in FLAVORS.items():
        available = True
        reason = ""
        if meta["packages"] and pacman is None:
            available = False
            reason = "pacman is not installed"
        report.append({
            "name": name,
            "description": meta["description"],
            "available": available,
            "reason": reason,
            "packages": meta["packages"],
            "installed": False,
        })
    return report


def target_version(root: Path) -> tuple[str | None, Path | None]:
    modroot = root / "usr/lib/modules"
    if not modroot.is_dir():
        return None, None
    candidates = []
    for entry in modroot.iterdir():
        if not entry.is_dir():
            continue
        image = entry / "vmlinuz"
        dep = entry / "modules.dep"
        if image.is_file() and dep.is_file() and "grintion" not in entry.name:
            candidates.append(entry)
    candidates.sort(key=lambda path: path.name, reverse=True)
    if not candidates:
        return None, None
    return candidates[0].name, candidates[0]


def configure_initramfs(root: Path) -> Path:
    conf = root / "etc/grintion/mkinitcpio.conf"
    conf.parent.mkdir(parents=True, exist_ok=True)
    conf.write_text(MKINITCPIO_CONFIG, encoding="utf-8")
    return conf


def build_initramfs(root: Path, version: str, conf: Path) -> Path:
    mkinitcpio = shutil.which("mkinitcpio")
    if mkinitcpio is None:
        raise SystemExit(
            "[-] mkinitcpio is not installed; install the 'mkinitcpio' package "
            "before selecting HWE/DKMS"
        )
    output = root / "boot/initramfs-linux.img"
    output.parent.mkdir(parents=True, exist_ok=True)
    run([mkinitcpio, "-k", version, "-c", str(conf), "-g", str(output)])
    if not output.is_file() or output.stat().st_size == 0:
        raise SystemExit(f"[-] mkinitcpio did not create {output}")
    return output


def stage_boot_files(root: Path, version: str, modules: Path) -> tuple[Path, Path]:
    image = modules / "vmlinuz"
    if not image.is_file():
        raise SystemExit(f"[-] kernel image missing from {modules}")
    boot_image = root / "boot/vmlinuz-linux"
    boot_image.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(image, boot_image)
    return boot_image, root / "boot/initramfs-linux.img"


def update_limine(root: Path, version: str, flavor: str) -> None:
    esp = root / "boot/efi"
    conf = esp / "limine.conf"
    if not conf.is_file():
        raise SystemExit(
            f"[-] Limine configuration not found: {conf}; "
            "install the bootloader before adding an HWE kernel"
        )
    content = conf.read_text(encoding="utf-8")
    cmdline = next(
        (match.group(1).strip() for match in re.finditer(r"^\s*cmdline:\s*(.+)$", content, re.MULTILINE)),
        "",
    )
    if not cmdline:
        raise SystemExit(f"[-] no kernel cmdline in {conf}; refusing to guess the root device")

    # Remove a previous generated HWE block so rerunning the command is safe.
    content = re.sub(
        r"\n?# BEGIN grintion hwe kernel.*?# END grintion hwe kernel\n?",
        "\n",
        content,
        flags=re.DOTALL,
    ).rstrip() + "\n"

    kernel_path = "/EFI/grintion/vmlinuz-linux"
    initramfs_path = "/EFI/grintion/initramfs-linux.img"
    (esp / "EFI/grintion").mkdir(parents=True, exist_ok=True)
    shutil.copy2(root / "boot/vmlinuz-linux", esp / kernel_path.lstrip("/"))
    shutil.copy2(root / "boot/initramfs-linux.img", esp / initramfs_path.lstrip("/"))

    entries = len(re.findall(r"(?m)^/", content))
    default_entry = entries + 1
    block = (
        "\n# BEGIN grintion hwe kernel\n"
        f"/Grintion-OS {flavor.upper()} (Linux {version})\n"
        "    protocol: linux\n"
        f"    kernel_path: boot():{kernel_path}\n"
        f"    cmdline: {cmdline}\n"
        f"    module_path: boot():{initramfs_path}\n"
        "# END grintion hwe kernel\n"
    )
    content += block
    if re.search(r"(?m)^\s*default_entry:", content):
        content = re.sub(r"(?m)^\s*default_entry:\s*\d+", f"default_entry: {default_entry}", content)
    else:
        content = f"default_entry: {default_entry}\n" + content
    conf.write_text(content, encoding="utf-8")
    fallback = esp / "EFI/BOOT/limine.conf"
    if fallback.parent.is_dir():
        shutil.copy2(conf, fallback)
    print(f"[+] added Limine entry {default_entry}: {flavor.upper()} (Linux {version})")


def install_flavor(flavor: str, *, dry_run: bool = False, yes: bool = False) -> int:
    meta = FLAVORS[flavor]
    root = Path(os.environ.get("GRINTION_ROOT", "/"))
    if flavor == "lts":
        print("[*] LTS is the built-in source kernel; no download is required")
        return 0
    if not dry_run and root == Path("/") and os.geteuid() != 0:
        raise SystemExit("[-] installing a kernel requires root; rerun with sudo")
    pacman = shutil.which("pacman")
    if pacman is None:
        raise SystemExit("[-] pacman is required for HWE/DKMS; use the default LTS flavor")
    packages = list(meta["packages"])
    argv = [pacman, "-Sy", "--noconfirm", "--disable-download-timeout", *packages]
    print(f"Flavor: {flavor} — {meta['description']}", file=sys.stderr)
    print(f"Packages: {' '.join(packages)}", file=sys.stderr)
    if dry_run:
        print("[*] dry-run: " + " ".join(argv), file=sys.stderr)
        return 0
    if not yes and sys.stdin.isatty():
        answer = input("Install this kernel flavor and add a Limine entry? [y/N] ")
        if answer.strip().lower() not in ("y", "yes"):
            print("aborted", file=sys.stderr)
            return 1
    mirror = shutil.which("grintion-pacman-mirror")
    if mirror:
        run([mirror, "--quiet", "--root", str(root)], check=False)
    run(argv)
    version, modules = target_version(root)
    if version is None or modules is None:
        raise SystemExit("[-] the kernel package installed no usable /usr/lib/modules tree")
    configure_initramfs(root)
    stage_boot_files(root, version, modules)
    conf = root / "etc/grintion/mkinitcpio.conf"
    build_initramfs(root, version, conf)
    update_limine(root, version, flavor)
    marker = root / "etc/grintion/kernel-flavor"
    marker.parent.mkdir(parents=True, exist_ok=True)
    marker.write_text(f"{flavor}\nlinux={version}\n", encoding="utf-8")
    if flavor == "dkms":
        dkms = shutil.which("dkms")
        if dkms:
            run([dkms, "status"], check=False)
    print(f"[+] {flavor} kernel installed: {version}")
    return 0


def main() -> None:
    parser = argparse.ArgumentParser(description="Grintion-OS multi-kernel manager")
    sub = parser.add_subparsers(dest="command")

    list_p = sub.add_parser("list", help="list installed kernels")
    list_p.add_argument("--json", action="store_true")
    list_p.add_argument("--boot", type=Path)

    set_p = sub.add_parser("set-default", help="set default boot kernel index")
    set_p.add_argument("index", type=int)
    set_p.add_argument("--boot", type=Path)

    flavors_p = sub.add_parser("flavors", help="list available kernel flavors")
    flavors_p.add_argument("--json", action="store_true")

    install_p = sub.add_parser("install", help="install HWE or DKMS kernel support")
    install_p.add_argument("flavor", choices=sorted(FLAVORS))
    install_p.add_argument("--dry-run", action="store_true")
    install_p.add_argument("--yes", "-y", action="store_true")

    args = parser.parse_args()
    cmd = args.command or "list"

    if cmd == "list":
        kernels = list_installed_kernels(args.boot)
        if getattr(args, "json", False):
            print(json.dumps(kernels, indent=2))
        else:
            print("=" * 60)
            print("Installed Grintion-OS Kernels")
            print("=" * 60)
            for k in kernels:
                def_str = " [DEFAULT]" if k["is_default"] else ""
                print(f"[{k['index']}] {k['name']}{def_str} (initramfs: {k['initramfs'] or 'MISSING'})")
            print("=" * 60)
    elif cmd == "set-default":
        set_default_kernel(args.index, args.boot)
    elif cmd == "flavors":
        report = flavor_report()
        if args.json:
            print(json.dumps({"flavors": report}, indent=2))
        else:
            for item in report:
                state = "available" if item["available"] else f"unavailable ({item['reason']})"
                print(f"{item['name']:<5} {state:<32} {item['description']}")
    elif cmd == "install":
        raise SystemExit(install_flavor(args.flavor, dry_run=args.dry_run, yes=args.yes))


if __name__ == "__main__":
    main()
