#!/usr/bin/env python3
"""garb - Grintion Atomic Reliable Builder and package manager.

Design goals for 1.0:
  * fail closed on unsigned or tampered repositories;
  * never extract a member outside the target root;
  * record a SHA-256 for every installed file;
  * resolve dependencies before changing the system;
  * stage, verify and commit package files as one transaction.
"""
from __future__ import annotations

import argparse
import fcntl
import gzip
import hashlib
import io
import json
import os
import posixpath
import re
import secrets
import shutil
import stat
import subprocess
import sys
import tarfile
import tempfile
import time
import tomllib
import urllib.parse
import urllib.request
from pathlib import Path, PurePosixPath

VERSION = "0.10.0"
SCHEMA = 1
DEFAULT_DB = "var/lib/garb/db.json"
DEFAULT_REPOS = "etc/garb/repos.d"
DEFAULT_KEYS = "etc/garb/keys"
DEFAULT_CACHE = "var/cache/garb"
DEFAULT_TMP = "var/lib/garb/tmp"
METADATA_NAME = "GARB_METADATA.json"
EXTERNAL_COMMANDS = frozenset({"update", "search", "info", "install", "remove", "verify", "upgrade"})
MUTATING_COMMANDS = frozenset({"install", "remove", "upgrade", "downgrade", "rollback-generation"})


class GarbError(Exception):
    pass


def log(message: str) -> None:
    print(f"[*] {message}")


def warn(message: str) -> None:
    print(f"[!] {message}", file=sys.stderr)


def die(message: str) -> None:
    print(f"[-] {message}", file=sys.stderr)
    raise SystemExit(1)


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for chunk in iter(lambda: handle.read(65536), b""):
            digest.update(chunk)
    return digest.hexdigest()


def epoch() -> int:
    try:
        return int(os.environ.get("SOURCE_DATE_EPOCH", "") or time.time())
    except ValueError:
        return int(time.time())


def normalise_member(name: str) -> str:
    """Return a safe relative POSIX path or raise."""
    if not name or "\x00" in name:
        raise GarbError("empty or NUL-containing archive member")
    pure = PurePosixPath(name)
    if pure.is_absolute():
        raise GarbError(f"absolute path in archive: {name}")
    parts = []
    for part in pure.parts:
        if part in ("", "."):
            continue
        if part == "..":
            raise GarbError(f"parent traversal in archive: {name}")
        parts.append(part)
    if not parts:
        raise GarbError(f"invalid archive member: {name}")
    return "/".join(parts)


def safe_symlink_target(link: str, base_dir: str = "") -> str:
    if not link or "\x00" in link or os.path.isabs(link):
        raise GarbError(f"unsafe symlink target: {link!r}")
    depth = 0
    for part in (PurePosixPath(base_dir) / link).parts:
        if part in ("", "."):
            continue
        if part == "..":
            depth -= 1
            if depth < 0:
                raise GarbError(f"symlink escapes the root: {link!r}")
        else:
            depth += 1
    return link


def parse_mode(value: object, default: int = 0o644) -> int:
    if isinstance(value, int):
        return value & 0o7777
    if isinstance(value, str):
        try:
            return int(value, 8) & 0o7777
        except ValueError:
            pass
    return default


class Paths:
    def __init__(self, root: Path) -> None:
        self.root = root.resolve()
        self.db = self.root / DEFAULT_DB
        self.repos = self.root / DEFAULT_REPOS
        self.keys = self.root / DEFAULT_KEYS
        self.cache = self.root / DEFAULT_CACHE
        self.tmp = self.root / DEFAULT_TMP
        self.lock = self.root / "var/lib/garb/lock"
        self.journal = self.root / "var/lib/garb/journal.jsonl"
        self.generations = self.root / "var/lib/garb/generations"
        self.holds = self.root / "etc/garb/holds.conf"
        self.pins = self.root / "etc/garb/pins.conf"
        self.preferences = self.root / "etc/garb/preferences.conf"

    def ensure_runtime(self) -> None:
        self.tmp.mkdir(parents=True, exist_ok=True)
        self.cache.mkdir(parents=True, exist_ok=True)
        self.db.parent.mkdir(parents=True, exist_ok=True)
        self.generations.mkdir(parents=True, exist_ok=True)

    def inside(self, rel: str) -> Path:
        rel = normalise_member(rel)
        target = (self.root / rel).resolve()
        if target != self.root and self.root not in target.parents:
            raise GarbError(f"path escapes the root: {rel}")
        return target


class Database:
    def __init__(self, paths: Paths) -> None:
        self.paths = paths
        self.data = self._load()

    def _load(self) -> dict:
        if not self.paths.db.exists():
            return {"schema": SCHEMA, "packages": {}}
        try:
            with open(self.paths.db, encoding="utf-8") as handle:
                data = json.load(handle)
        except (OSError, json.JSONDecodeError) as exc:
            # Starting empty would forget which files belong to which package
            # and let a later install overwrite them. Fail closed and point at
            # fsck instead; the database is the only ownership record.
            raise GarbError(
                f"package database is corrupt or unreadable: {self.paths.db}: {exc}; "
                "run 'garb fsck --format json' before mutating packages"
            ) from exc
        if not isinstance(data, dict) or not isinstance(data.get("packages"), dict):
            raise GarbError(
                f"package database has an unexpected structure: {self.paths.db}; "
                "run 'garb fsck --format json' before mutating packages"
            )
        return data

    def save(self) -> None:
        self.paths.db.parent.mkdir(parents=True, exist_ok=True)
        tmp = self.paths.db.with_suffix(".tmp")
        with open(tmp, "w", encoding="utf-8") as handle:
            json.dump(self.data, handle, indent=2, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp, self.paths.db)
        try:
            directory = os.open(self.paths.db.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        except OSError:
            return
        try:
            os.fsync(directory)
        finally:
            os.close(directory)

    def installed(self, name: str) -> dict | None:
        return self.data["packages"].get(name)

    def add(self, name: str, entry: dict) -> None:
        self.data["packages"][name] = entry

    def remove(self, name: str) -> None:
        self.data["packages"].pop(name, None)


class TransactionLock:
    """One mutating native transaction per target root.

    Package installation moves files into place and then updates the database.
    Two concurrent garb processes can therefore interleave ownership records.
    The lock is advisory but every native mutating path takes it, and it names
    the holder so a blocked operator can find the other process.
    """

    def __init__(self, paths: Paths, command: str) -> None:
        self.paths = paths
        self.command = command
        self.handle = None

    def __enter__(self) -> "TransactionLock":
        self.paths.lock.parent.mkdir(parents=True, exist_ok=True)
        self.handle = open(self.paths.lock, "a+", encoding="utf-8")
        try:
            fcntl.flock(self.handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            self.handle.seek(0)
            holder = self.handle.read().strip() or "unknown holder"
            self.handle.close()
            self.handle = None
            raise GarbError(
                f"another garb transaction is running ({holder}); wait for it to finish"
            )
        self.handle.seek(0)
        self.handle.truncate()
        self.handle.write(f"pid={os.getpid()} command={self.command}\n")
        self.handle.flush()
        return self

    def __exit__(self, _exc_type, _exc, _tb) -> None:
        if self.handle is None:
            return
        try:
            fcntl.flock(self.handle.fileno(), fcntl.LOCK_UN)
        finally:
            self.handle.close()
            self.handle = None


def journal_append(paths: Paths, record: dict) -> None:
    """Append one durable transaction record.

    A crash between "started" and the final record is visible to fsck. The
    journal is append-only and mode 0600; it never stores file contents.
    """
    paths.journal.parent.mkdir(parents=True, exist_ok=True)
    line = (json.dumps(record, sort_keys=True) + "\n").encode("utf-8")
    descriptor = os.open(
        paths.journal,
        os.O_WRONLY | os.O_CREAT | os.O_APPEND,
        0o600,
    )
    try:
        os.write(descriptor, line)
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def read_journal(paths: Paths) -> list[dict]:
    if not paths.journal.exists():
        return []
    records = []
    try:
        lines = paths.journal.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        warn(f"cannot read transaction journal {paths.journal}: {exc}")
        return []
    for line in lines:
        try:
            record = json.loads(line)
        except json.JSONDecodeError:
            warn(f"ignoring malformed journal line in {paths.journal}")
            continue
        if isinstance(record, dict):
            records.append(record)
    return records


def cmd_history(args: argparse.Namespace) -> None:
    records = read_journal(args.paths)
    if args.limit > 0:
        records = records[-args.limit:]
    if args.format == "json":
        print(json.dumps(records, indent=2, sort_keys=True))
        return
    if not records:
        print("[-] no transactions recorded")
        return
    for record in records:
        stamp = time.strftime(
            "%Y-%m-%dT%H:%M:%SZ",
            time.gmtime(int(record.get("time", 0) or 0)),
        )
        packages = ",".join(str(item) for item in record.get("packages", [])) or "-"
        print(
            f"  {stamp}  {record.get('status', '?'):<11} "
            f"{record.get('command', '?'):<8} {packages}"
        )


def cmd_fsck(args: argparse.Namespace) -> None:
    paths = args.paths
    issues: list[dict] = []
    raw = None
    database_error = None
    if paths.db.exists():
        try:
            raw = json.loads(paths.db.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as exc:
            database_error = f"{paths.db}: {exc}"
    if raw is not None and not (
        isinstance(raw, dict) and isinstance(raw.get("packages"), dict)
    ):
        database_error = f"{paths.db}: expected an object with a 'packages' object"
        raw = None
    if database_error:
        issues.append({"severity": "error", "kind": "database", "detail": database_error})

    packages = raw.get("packages", {}) if isinstance(raw, dict) else {}
    owners: dict[str, str] = {}
    checked = 0
    for name, entry in sorted(packages.items()):
        if not isinstance(entry, dict):
            issues.append({
                "severity": "error",
                "kind": "package",
                "detail": f"package entry for {name} is not an object",
            })
            continue
        recorded_name = entry.get("name")
        if recorded_name not in (None, name):
            issues.append({
                "severity": "warning",
                "kind": "package",
                "detail": f"database key {name} records itself as {recorded_name}",
            })
        files = entry.get("files", [])
        if not isinstance(files, list):
            issues.append({
                "severity": "error",
                "kind": "package",
                "detail": f"package {name} has a non-list file inventory",
            })
            continue
        for item in files:
            if not isinstance(item, dict) or "path" not in item:
                issues.append({
                    "severity": "error",
                    "kind": "package",
                    "detail": f"package {name} has a malformed file entry",
                })
                continue
            try:
                rel = normalise_member(str(item["path"]))
            except GarbError as exc:
                issues.append({
                    "severity": "error",
                    "kind": "path",
                    "detail": f"package {name}: {exc}",
                })
                continue
            previous = owners.get(rel)
            if previous is not None and previous != name:
                issues.append({
                    "severity": "error",
                    "kind": "duplicate",
                    "detail": f"{rel} is owned by both {previous} and {name}",
                })
            else:
                owners[rel] = name
            target = paths.root / rel
            checked += 1
            if item.get("type") == "symlink":
                if not target.is_symlink():
                    issues.append({
                        "severity": "error",
                        "kind": "missing",
                        "detail": f"{name}: missing symlink {rel}",
                    })
                elif os.readlink(target) != item.get("target"):
                    issues.append({
                        "severity": "error",
                        "kind": "symlink",
                        "detail": f"{name}: symlink target changed for {rel}",
                    })
                continue
            if not target.is_file() or target.is_symlink():
                issues.append({
                    "severity": "error",
                    "kind": "missing",
                    "detail": f"{name}: missing file {rel}",
                })
                continue
            if not args.hash:
                continue
            try:
                digest = sha256_file(target)
            except OSError as exc:
                issues.append({
                    "severity": "error",
                    "kind": "unreadable",
                    "detail": f"{name}: cannot hash {rel}: {exc}",
                })
                continue
            if digest != item.get("sha256"):
                issues.append({
                    "severity": "error",
                    "kind": "tampered",
                    "detail": f"{name}: hash mismatch for {rel}",
                })
        for dependency in entry.get("dependencies", []) or []:
            if dependency not in packages:
                issues.append({
                    "severity": "warning",
                    "kind": "dependency",
                    "detail": (
                        f"{name} depends on {dependency}, which is not tracked by the "
                        "native database (it may come from the base image)"
                    ),
                })

    latest: dict[str, dict] = {}
    for record in read_journal(paths):
        txid = record.get("txid")
        if isinstance(txid, str) and txid:
            latest[txid] = record
    for txid, record in latest.items():
        if record.get("status") == "started":
            issues.append({
                "severity": "warning",
                "kind": "journal",
                "detail": (
                    f"transaction {txid} started but recorded no result; inspect "
                    f"{paths.tmp} and run 'garb verify'"
                ),
            })

    if paths.tmp.is_dir():
        for backup in sorted(paths.tmp.glob("garb-backup-*")):
            if backup.is_dir():
                issues.append({
                    "severity": "warning",
                    "kind": "backup",
                    "detail": f"leftover rollback backup: {backup}",
                })

    errors = [item for item in issues if item["severity"] == "error"]
    warnings = [item for item in issues if item["severity"] == "warning"]
    if args.format == "json":
        print(json.dumps(
            {
                "schema": 1,
                "root": str(paths.root),
                "packages": len(packages),
                "files_checked": checked,
                "ok": not errors,
                "errors": len(errors),
                "warnings": len(warnings),
                "issues": issues,
            },
            indent=2,
            sort_keys=True,
        ))
    else:
        for issue in issues:
            label = "[BAD]" if issue["severity"] == "error" else "[WARN]"
            print(f"  {label} {issue['kind']}: {issue['detail']}")
        if errors:
            print(f"[-] fsck found {len(errors)} error(s) and {len(warnings)} warning(s)")
        else:
            print(
                f"[+] fsck passed: {len(packages)} package(s), {checked} file(s), "
                f"{len(warnings)} warning(s)"
            )
    if errors:
        raise SystemExit(1)


# ---------------------------------------------------------------- repositories
def read_repo_configs(paths: Paths) -> list[dict]:
    repos = []
    if not paths.repos.is_dir():
        return repos
    for conf in sorted(paths.repos.glob("*.conf")):
        values = {}
        for line in conf.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            if "=" in line:
                key, value = line.split("=", 1)
                values[key.strip().lower()] = value.strip().strip('"')
        if "url" not in values:
            warn(f"ignoring {conf}: no url")
            continue
        repos.append({"name": values.get("name", conf.stem), "url": values["url"], "conf": conf})
    return repos


def fetch_repo_file(url: str, name: str) -> bytes:
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme in ("", "file"):
        base = Path(parsed.path if parsed.scheme == "file" else url)
        return (base / name).read_bytes()
    with urllib.request.urlopen(f"{url.rstrip('/')}/{name}", timeout=30) as response:
        return response.read()


def validate_index(index: dict, name: str, cached: Path) -> None:
    """Reject unversioned, expired or replayed repository indexes."""
    version = index.get("index_version")
    if not isinstance(version, int) or isinstance(version, bool) or version <= 0:
        raise GarbError(
            f"{name}: index has no valid index_version; regenerate it with 'garb repo-index'"
        )
    expires = index.get("expires")
    if not isinstance(expires, int) or isinstance(expires, bool):
        raise GarbError(
            f"{name}: index has no expiry timestamp; regenerate it with 'garb repo-index'"
        )
    now = int(time.time())
    if expires <= now:
        stamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(expires))
        raise GarbError(
            f"{name}: index expired at {stamp}; regenerate it with 'garb repo-index'"
        )
    cached_index = cached / "index.json"
    if not cached_index.exists():
        return
    try:
        previous = json.loads(cached_index.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return
    previous_version = previous.get("index_version") if isinstance(previous, dict) else None
    if isinstance(previous_version, int) and not isinstance(previous_version, bool):
        if version < previous_version:
            raise GarbError(
                f"{name}: refusing a replayed index (version {version} is older "
                f"than the cached version {previous_version})"
            )


def verify_signature(index: bytes, signature: bytes, public_key: Path) -> None:
    if not public_key.exists():
        raise GarbError(f"trusted public key is missing: {public_key}")
    with tempfile.TemporaryDirectory() as scratch:
        index_path = Path(scratch) / "index.json"
        sig_path = Path(scratch) / "index.json.sig"
        index_path.write_bytes(index)
        sig_path.write_bytes(signature)
        result = subprocess.run(
            [
                "openssl", "pkeyutl", "-verify", "-pubin", "-inkey", str(public_key),
                "-rawin", "-in", str(index_path), "-sigfile", str(sig_path),
            ],
            capture_output=True,
            text=True,
            check=False,
        )
        if result.returncode != 0:
            raise GarbError(f"repository signature verification failed: {result.stderr.strip()}")


def sign_bytes(data: bytes, private_key: Path) -> bytes:
    with tempfile.TemporaryDirectory() as scratch:
        data_path = Path(scratch) / "data"
        sig_path = Path(scratch) / "data.sig"
        data_path.write_bytes(data)
        result = subprocess.run(
            ["openssl", "pkeyutl", "-sign", "-inkey", str(private_key), "-rawin",
             "-in", str(data_path), "-out", str(sig_path)],
            capture_output=True,
            text=True,
            check=False,
        )
        if result.returncode != 0:
            raise GarbError(f"signing failed: {result.stderr.strip()}")
        return sig_path.read_bytes()


def load_repo_priorities(paths: Paths) -> dict[str, int]:
    if not paths.preferences.is_file():
        return {}
    priors: dict[str, int] = {}
    for line in paths.preferences.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            k, v = line.split("=", 1)
            try:
                priors[k.strip()] = int(v.strip())
            except ValueError:
                pass
    return priors


def load_indexes(paths: Paths) -> dict:
    packages: dict = {}
    if not paths.cache.is_dir():
        return packages
    priors = load_repo_priorities(paths)
    index_files = sorted(
        paths.cache.glob("repos/*/index.json"),
        key=lambda p: priors.get(p.parent.name, 500),
        reverse=True,
    )
    for index_path in index_files:
        try:
            data = json.loads(index_path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            warn(f"ignoring unreadable index: {index_path}")
            continue
        if not isinstance(data, dict):
            warn(f"ignoring index that is not a JSON object: {index_path}")
            continue
        if data.get("schema") != SCHEMA:
            warn(f"ignoring index with unsupported schema {data.get('schema')!r}: {index_path}")
            continue
        for name, entry in data.get("packages", {}).items():
            entry = dict(entry)
            entry["_repo"] = index_path.parent.name
            packages.setdefault(name, entry)
    return packages


def cmd_version(_args: argparse.Namespace) -> None:
    print(f"garb package manager {VERSION}")
    print("Signed repository indexes, transactional installs, per-file SHA-256")
    print("Target architecture: x86_64")


def cmd_update(args: argparse.Namespace) -> None:
    paths = args.paths
    configs = read_repo_configs(paths)
    if not configs:
        warn(f"no repositories configured in {paths.repos}")
        return
    for repo in configs:
        name, url = repo["name"], repo["url"]
        log(f"updating repository {name}")
        index = fetch_repo_file(url, "index.json")
        public_key = paths.keys / f"{name}.pub"
        if args.key:
            public_key = Path(args.key)
        if args.allow_unsigned:
            warn(f"accepting unsigned repository {name}")
            signature = b""
        else:
            signature = fetch_repo_file(url, "index.json.sig")
            verify_signature(index, signature, public_key)
        parsed = json.loads(index)
        if parsed.get("schema") != SCHEMA:
            raise GarbError(f"{name}: unsupported index schema {parsed.get('schema')}")
        target = paths.cache / "repos" / name
        validate_index(parsed, name, target)
        target.mkdir(parents=True, exist_ok=True)
        (target / "index.json").write_bytes(index)
        if signature:
            (target / "index.json.sig").write_bytes(signature)
        else:
            (target / "index.json.sig").unlink(missing_ok=True)
        log(f"{name}: {len(parsed.get('packages', {}))} packages")


def cmd_search(args: argparse.Namespace) -> None:
    query = args.query.lower()
    index = load_indexes(args.paths)
    db = Database(args.paths)
    found = 0
    for name, entry in sorted(index.items()):
        text = f"{name} {entry.get('description', '')}".lower()
        if query in text:
            state = "installed" if db.installed(name) else "available"
            print(f"  {name:<24} {entry.get('version', '?')}  [{state}]  {entry.get('description', '')}")
            found += 1
    for name, entry in sorted(db.data["packages"].items()):
        if query in f"{name} {entry.get('description', '')}".lower() and name not in index:
            print(f"  {name:<24} {entry.get('version', '?')}  [installed]  {entry.get('description', '')}")
            found += 1
    if not found:
        print(f"[-] no packages matching {query!r}")


def cmd_info(args: argparse.Namespace) -> None:
    db = Database(args.paths)
    installed = db.installed(args.package)
    index = None if args.installed else load_indexes(args.paths).get(args.package)
    if not installed and not index:
        die(f"package not installed: {args.package}" if args.installed else f"package not found: {args.package}")
    entry = installed or index
    print(f"Package:      {args.package}")
    print(f"Status:       {'installed' if installed else 'available'}")
    print(f"Version:      {entry.get('version')}-{entry.get('release', 1)}")
    print(f"Description:  {entry.get('description', '')}")
    print(f"Architecture: {entry.get('arch', ['x86_64'])}")
    if entry.get("dependencies"):
        print(f"Depends:      {', '.join(entry['dependencies'])}")
    if installed:
        print(f"Files:        {len(installed.get('files', []))}")
        print(f"Archive:      {installed.get('archive_sha256', '')}")


# ---------------------------------------------------------------- package files
def read_metadata(archive: Path) -> dict:
    with tarfile.open(archive, "r:*") as tar:
        for member in tar:
            if normalise_member(member.name) == METADATA_NAME:
                handle = tar.extractfile(member)
                if handle is None:
                    raise GarbError("metadata member is not a file")
                metadata = json.loads(handle.read().decode("utf-8"))
                if not isinstance(metadata, dict):
                    raise GarbError("package metadata is not a JSON object")
                return metadata
    raise GarbError(f"missing {METADATA_NAME} in {archive}")


def verify_member(member: tarfile.TarInfo) -> None:
    rel = normalise_member(member.name)
    if member.isdir():
        return
    if member.isreg():
        return
    if member.issym():
        safe_symlink_target(member.linkname, str(PurePosixPath(rel).parent))
        return
    raise GarbError(f"unsupported archive member type: {rel}")


def extract_staged(archive: Path, staging: Path) -> tuple[dict, list[dict]]:
    metadata: dict = {}
    members: list[dict] = []
    with tarfile.open(archive, "r:*") as tar:
        for member in tar:
            if normalise_member(member.name) == METADATA_NAME:
                handle = tar.extractfile(member)
                if handle is None:
                    raise GarbError("metadata member is not a file")
                metadata = json.loads(handle.read().decode("utf-8"))
                if not isinstance(metadata, dict):
                    raise GarbError("package metadata is not a JSON object")
                continue
            verify_member(member)
            rel = normalise_member(member.name)
            dest = staging / rel
            dest.parent.mkdir(parents=True, exist_ok=True)
            if member.isdir():
                dest.mkdir(parents=True, exist_ok=True)
                continue
            if member.issym():
                if dest.exists() or dest.is_symlink():
                    dest.unlink()
                os.symlink(member.linkname, dest)
                members.append({"path": rel, "type": "symlink", "target": member.linkname})
                continue
            handle = tar.extractfile(member)
            if handle is None:
                raise GarbError(f"cannot read member: {rel}")
            with open(dest, "wb") as output:
                shutil.copyfileobj(handle, output)
            members.append({"path": rel, "type": "file"})
    if not metadata:
        raise GarbError("package metadata missing")
    if metadata.get("schema", SCHEMA) != SCHEMA:
        raise GarbError("unsupported package schema")
    return metadata, members


def verify_staged(staging: Path, metadata: dict) -> list[dict]:
    declared = metadata.get("files")
    if not isinstance(declared, list) or not declared:
        raise GarbError("package metadata has no file list")
    by_path = {}
    for item in declared:
        rel = normalise_member(item["path"])
        by_path[rel] = item
    seen = set()
    for rel, item in by_path.items():
        staged = staging / rel
        if item.get("type") == "symlink":
            if not staged.is_symlink():
                raise GarbError(f"missing symlink: {rel}")
            safe_symlink_target(item.get("target", ""), str(PurePosixPath(rel).parent))
            if os.readlink(staged) != item.get("target"):
                raise GarbError(f"symlink target mismatch: {rel}")
        else:
            if not staged.is_file() or staged.is_symlink():
                raise GarbError(f"missing file: {rel}")
            digest = sha256_file(staged)
            if digest != item.get("sha256"):
                raise GarbError(f"hash mismatch: {rel}")
            mode = parse_mode(item.get("mode"), 0o644)
            if mode & (stat.S_ISUID | stat.S_ISGID):
                raise GarbError(
                    f"package requests a setuid/setgid file: {rel} "
                    "(packages may not install privileged binaries)"
                )
        seen.add(rel)
    # Anything staged that is not declared is a malformed package.
    for path in staging.rglob("*"):
        rel = str(path.relative_to(staging))
        if rel in seen:
            continue
        if path.is_dir():
            continue
        raise GarbError(f"undeclared file in package: {rel}")
    return declared


def remove_path(path: Path) -> None:
    """Remove a file, symlink or directory tree if it exists."""
    if path.is_symlink() or path.is_file():
        path.unlink()
    elif path.is_dir():
        shutil.rmtree(path)


def reverse_dependents(db: Database, name: str, ignore: set[str] | None = None) -> list[str]:
    skip = ignore or set()
    return sorted(
        package
        for package, entry in db.data["packages"].items()
        if package != name
        and package not in skip
        and name in entry.get("dependencies", [])
    )


def file_conflicts(db: Database, name: str, files: list[dict]) -> dict[str, str]:
    owners: dict[str, str] = {}
    for package, entry in db.data["packages"].items():
        if package == name:
            continue
        for item in entry.get("files", []):
            owners.setdefault(item["path"], package)
    conflicts = {}
    for item in files:
        owner = owners.get(item["path"])
        if owner:
            conflicts[item["path"]] = owner
    return conflicts


def commit_package(paths: Paths, staging: Path, metadata: dict, archive: Path) -> dict:
    files = verify_staged(staging, metadata)
    paths.tmp.mkdir(parents=True, exist_ok=True)
    backup = Path(tempfile.mkdtemp(prefix="garb-backup-", dir=paths.tmp))
    installed: list[dict] = []
    backup_kept = False
    try:
        for item in files:
            rel = normalise_member(item["path"])
            src = staging / rel
            dst = paths.inside(rel)
            dst.parent.mkdir(parents=True, exist_ok=True)
            if dst.exists() or dst.is_symlink():
                saved = backup / rel
                saved.parent.mkdir(parents=True, exist_ok=True)
                os.replace(dst, saved)
            if item.get("type") == "symlink":
                os.symlink(item["target"], dst)
            else:
                os.replace(src, dst)
                mode = parse_mode(item.get("mode"), 0o644) & ~(stat.S_ISUID | stat.S_ISGID)
                os.chmod(dst, mode)
            installed.append(item)
    except Exception as exc:
        problems: list[str] = []
        for item in reversed(installed):
            try:
                remove_path(paths.inside(item["path"]))
            except OSError as cleanup_exc:
                problems.append(f"remove {item['path']}: {cleanup_exc}")
        for saved in sorted(backup.rglob("*"), key=lambda path: len(path.parts)):
            if not (saved.is_file() or saved.is_symlink()):
                continue
            rel = str(saved.relative_to(backup))
            dst = paths.inside(rel)
            try:
                dst.parent.mkdir(parents=True, exist_ok=True)
                # A non-empty directory at the destination used to make
                # os.replace fail, after which the backup was deleted anyway.
                remove_path(dst)
                os.replace(saved, dst)
            except OSError as restore_exc:
                problems.append(f"restore {rel}: {restore_exc}")
        if problems:
            backup_kept = True
            warn(f"rollback incomplete; backups kept in {backup}")
            for problem in problems:
                warn(f"  {problem}")
        raise GarbError(f"transaction rolled back: {exc}") from exc
    finally:
        if not backup_kept:
            shutil.rmtree(backup, ignore_errors=True)

    return {
        "name": metadata["name"],
        "version": metadata.get("version", "0"),
        "release": metadata.get("release", 1),
        "description": metadata.get("description", ""),
        "arch": metadata.get("arch", ["x86_64"]),
        "dependencies": metadata.get("dependencies", []),
        "files": files,
        "archive_sha256": sha256_file(archive),
        "installed_at": int(time.time()),
    }


def parse_dep_spec(dep: str) -> tuple[str, str, str]:
    for op in (">=", "<=", "!=", ">", "<", "="):
        if op in dep:
            parts = dep.split(op, 1)
            return parts[0].strip(), op, parts[1].strip()
    return dep.strip(), "", ""


def safe_version_tuple(val: str) -> tuple:
    parts = []
    for token in re.split(r"[._-]", str(val)):
        if token.isdigit():
            parts.append((0, int(token)))
        else:
            parts.append((1, token))
    return tuple(parts)


def match_version(actual: str, op: str, req: str) -> bool:
    if not op or not req:
        return True
    a = safe_version_tuple(actual)
    r = safe_version_tuple(req)
    if op == ">=":
        return a >= r
    elif op == "<=":
        return a <= r
    elif op == ">":
        return a > r
    elif op == "<":
        return a < r
    elif op == "=":
        return a == r
    elif op == "!=":
        return a != r
    return True


def resolve_dependencies(names: list[str], index: dict, db: Database, upgrading: bool = False) -> list[str]:
    order: list[str] = []
    visiting: set[str] = set()
    done: set[str] = set()

    def visit(name: str) -> None:
        if name in done:
            return
        if name in visiting:
            raise GarbError(f"dependency cycle involving {name}")
        entry = index.get(name)
        if entry is None:
            raise GarbError(f"package not found in any repository: {name}")
        if db.installed(name) and not upgrading:
            done.add(name)
            return

        for conf in entry.get("conflicts", []) or []:
            if db.installed(conf):
                raise GarbError(f"package {name} conflicts with installed package {conf}")

        visiting.add(name)
        for raw_dep in entry.get("dependencies", []) or []:
            dep_name, op, req_ver = parse_dep_spec(raw_dep)
            if dep_name not in index:
                for cand_name, cand_entry in index.items():
                    if dep_name in (cand_entry.get("provides") or []):
                        dep_name = cand_name
                        break
            if dep_name in index:
                cand = index[dep_name]
                if op and req_ver and not match_version(cand.get("version", "0"), op, req_ver):
                    raise GarbError(f"{name} requires {raw_dep}, but available version is {cand.get('version')}")
            visit(dep_name)
        visiting.remove(name)
        done.add(name)
        if not (db.installed(name) and not upgrading):
            order.append(name)

    for name in names:
        visit(name)
    return order


def fetch_archive(paths: Paths, name: str, entry: dict) -> Path:
    filename = entry.get("filename") or f"{name}-{entry.get('version')}-{entry.get('release', 1)}.garb"
    repo = paths.cache / "repos" / entry["_repo"]
    target = repo / filename
    if target.exists():
        if sha256_file(target) != entry.get("sha256"):
            target.unlink()
        else:
            return target
    configs = {repo["name"]: repo["url"] for repo in read_repo_configs(paths)}
    url = configs.get(entry["_repo"])
    if not url:
        raise GarbError(f"no configured URL for repository {entry['_repo']}")
    log(f"fetching {name} from {entry['_repo']}")
    data = fetch_repo_file(url, filename)
    actual = hashlib.sha256(data).hexdigest()
    if actual != entry.get("sha256"):
        raise GarbError(f"archive checksum mismatch for {name}")
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_bytes(data)
    return target


def cmd_install(args: argparse.Namespace) -> None:
    paths = args.paths
    paths.ensure_runtime()
    db = Database(paths)
    index = load_indexes(paths)
    targets: list[tuple[str, Path, dict]] = []
    for spec in args.package:
        candidate = Path(spec)
        if candidate.exists() and candidate.is_file():
            metadata = read_metadata(candidate)
            name = metadata["name"]
            targets.append((name, candidate, metadata))
        else:
            entry = index.get(spec)
            if entry is None:
                die(f"package not found in any repository: {spec}")
            targets.append((spec, Path(), entry))

    repository_names = [name for name, archive, _ in targets if archive == Path()]
    local_targets = [(name, archive, metadata) for name, archive, metadata in targets if archive != Path()]
    local_names = {name for name, _, _ in local_targets}

    # Local archives used to skip dependency resolution entirely. Resolve their
    # runtime dependencies against the indexes and the installed database too.
    local_dependencies: list[str] = []
    for name, _archive, metadata in local_targets:
        for dependency in metadata.get("dependencies", []):
            if dependency in local_names or db.installed(dependency):
                continue
            if dependency not in index:
                die(f"{name} requires {dependency}, which is not installed and not in any repository")
            local_dependencies.append(dependency)

    selected: list[str] = []
    for requested in (local_dependencies, repository_names):
        if not requested:
            continue
        for name in resolve_dependencies(requested, index, db, upgrading=args.upgrade):
            if name not in selected:
                selected.append(name)

    plan: list[tuple[str, Path, dict]] = []
    for name in selected:
        entry = index[name]
        plan.append((name, fetch_archive(paths, name, entry), entry))
    plan.extend(local_targets)

    if not plan:
        log("nothing to install")
        return

    seen: set[str] = set()
    for name, archive, entry in plan:
        if name in seen:
            continue
        seen.add(name)
        if db.installed(name) and not args.upgrade and not args.force:
            log(f"{name} is already installed (use --upgrade or --force)")
            continue
        log(f"installing {name}")
        staging = Path(tempfile.mkdtemp(prefix="garb-stage-", dir=paths.tmp))
        try:
            metadata, _members = extract_staged(archive, staging)
            if metadata.get("name") != name:
                raise GarbError(f"archive name mismatch: expected {name}, got {metadata.get('name')}")
            conflicts = file_conflicts(db, name, metadata.get("files", []))
            if conflicts and not args.force:
                owners = ", ".join(sorted(set(conflicts.values())))
                sample = ", ".join(f"{rel} ({owner})" for rel, owner in sorted(conflicts.items())[:5])
                raise GarbError(
                    f"{name} conflicts with files owned by {owners}: {sample}; "
                    "use --force to overwrite"
                )
            entry_db = commit_package(paths, staging, metadata, archive)
            db.add(name, entry_db)
            db.save()
            print(f"[+] {name} {entry_db['version']}-{entry_db['release']} installed ({len(entry_db['files'])} files)")
        finally:
            shutil.rmtree(staging, ignore_errors=True)


def cmd_remove(args: argparse.Namespace) -> None:
    paths = args.paths
    db = Database(paths)
    removing = set(args.package)
    changed = False
    for name in args.package:
        entry = db.installed(name)
        if entry is None:
            warn(f"{name} is not installed")
            continue
        dependents = reverse_dependents(db, name, ignore=removing)
        if dependents and not args.force:
            die(f"{name} is required by: {', '.join(dependents)} (use --force to remove it anyway)")
        modified = []
        for item in entry.get("files", []):
            target = paths.inside(item["path"])
            if not target.exists() and not target.is_symlink():
                continue
            if item.get("type") == "symlink":
                if not target.is_symlink():
                    modified.append(item["path"])
                continue
            if target.is_file() and sha256_file(target) != item.get("sha256"):
                modified.append(item["path"])
        if modified and not args.force:
            die(f"{name}: refusing to remove modified files: {', '.join(modified[:10])}")
        for item in reversed(entry.get("files", [])):
            target = paths.inside(item["path"])
            try:
                if target.exists() or target.is_symlink():
                    target.unlink()
            except OSError as exc:
                warn(f"could not remove {item['path']}: {exc}")
            parent = target.parent
            while parent != paths.root and parent.is_dir():
                try:
                    parent.rmdir()
                except OSError:
                    break
                parent = parent.parent
        db.remove(name)
        db.save()
        print(f"[+] removed {name}")
        changed = True
    if not changed:
        return


def cmd_verify(args: argparse.Namespace) -> None:
    paths = args.paths
    db = Database(paths)
    names = args.package or sorted(db.data["packages"])
    failures = 0
    checked = 0
    report = []
    for name in names:
        entry = db.installed(name)
        if entry is None:
            warn(f"{name} is not installed")
            failures += 1
            report.append({"package": name, "ok": False, "files": []})
            continue
        bad = 0
        files = []
        for item in entry.get("files", []):
            target = paths.inside(item["path"])
            checked += 1
            status = "ok"
            if item.get("type") == "symlink":
                if not target.is_symlink() or os.readlink(target) != item.get("target"):
                    status = "symlink-mismatch"
            elif not target.is_file() or target.is_symlink():
                status = "missing"
            elif not args.quick and sha256_file(target) != item.get("sha256"):
                status = "tampered"
            files.append({"path": item["path"], "status": status})
            if status == "ok":
                continue
            bad += 1
            if args.format == "text":
                label = {
                    "symlink-mismatch": "[BAD]",
                    "missing": "[MISSING]",
                    "tampered": "[TAMPERED]",
                }[status]
                suffix = " (symlink)" if status == "symlink-mismatch" else ""
                print(f"  {label} {name}: {item['path']}{suffix}")
        if bad:
            failures += 1
        elif args.format == "text":
            print(f"  [OK] {name} ({len(entry.get('files', []))} files)")
        report.append({"package": name, "ok": not bad, "files": files})
    if args.format == "json":
        print(json.dumps(
            {"checked": checked, "failed": failures, "packages": report},
            indent=2,
            sort_keys=True,
        ))
    if failures:
        die(f"integrity check failed for {failures} package(s), {checked} files checked")
    if args.format == "text":
        print(f"[+] integrity check passed: {checked} files checked")


def snapshot_before_upgrade(paths: Paths, args: argparse.Namespace) -> None:
    """Create a Btrfs snapshot before a system upgrade when the tool exists."""
    if getattr(args, "no_snapshot", False):
        return
    if getattr(paths, "root", Path("/")) != Path("/"):
        return
    if shutil.which("grintion-snapshot") is None:
        warn("grintion-snapshot is not installed; upgrading without a snapshot")
        return
    try:
        fstype = subprocess.check_output(
            ["findmnt", "-n", "-o", "FSTYPE", "/"], text=True, stderr=subprocess.DEVNULL
        ).strip()
    except (OSError, subprocess.CalledProcessError):
        return
    if fstype != "btrfs":
        return
    if os.geteuid() != 0:
        die("a Btrfs pre-upgrade snapshot requires root; rerun with sudo or --no-snapshot")
    log("creating a pre-upgrade Btrfs snapshot")
    result = subprocess.run(["grintion-snapshot", "create", "pre-upgrade"], check=False)
    if result.returncode != 0:
        die("the pre-upgrade snapshot failed; refusing to upgrade without a recovery point")


def load_holds(paths: Paths) -> set[str]:
    if not paths.holds.is_file():
        return set()
    holds = set()
    for line in paths.holds.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if line and not line.startswith("#"):
            holds.add(line)
    return holds


def save_holds(paths: Paths, holds: set[str]) -> None:
    paths.holds.parent.mkdir(parents=True, exist_ok=True)
    lines = ["# /etc/garb/holds.conf - Held packages"] + sorted(holds)
    paths.holds.write_text("\n".join(lines) + "\n", encoding="utf-8")


def cmd_upgrade(args: argparse.Namespace) -> None:
    paths = args.paths
    db = Database(paths)
    index = load_indexes(paths)
    holds = load_holds(paths)
    names = args.package or [name for name in db.data["packages"] if name in index]
    upgrades = []
    for name in names:
        if name in holds:
            log(f"skipping held package: {name}")
            continue
        installed = db.installed(name)
        available = index.get(name)
        if not installed or not available:
            continue
        if version_tuple(available.get("version", "0")) > version_tuple(installed.get("version", "0")):
            upgrades.append(name)
    if not upgrades:
        log("nothing to upgrade")
        return
    snapshot_before_upgrade(paths, args)
    log(f"upgrading: {', '.join(upgrades)}")
    args.package = upgrades
    args.force = False
    args.upgrade = True
    cmd_install(args)


def cmd_list(args: argparse.Namespace) -> None:
    paths = args.paths
    db = Database(paths)
    index = load_indexes(paths) if (args.available or args.upgradable) else {}
    names = sorted(index if args.available else db.data["packages"])
    printed = 0
    for name in names:
        installed = db.installed(name)
        available = index.get(name)
        if args.upgradable:
            if installed is None or available is None:
                continue
            if version_tuple(available.get("version", "0")) <= version_tuple(installed.get("version", "0")):
                continue
        entry = installed or available or {}
        state = "installed" if installed else "available"
        print(f"  {name:<24} {entry.get('version', '?')}-{entry.get('release', 1)}  [{state}]  {entry.get('description', '')}")
        printed += 1
    if not printed:
        print("[-] no packages to list")


def cmd_clean(args: argparse.Namespace) -> None:
    repositories = args.paths.cache / "repos"
    removed = 0
    if repositories.is_dir():
        for entry in repositories.iterdir():
            if entry.is_dir():
                shutil.rmtree(entry)
            else:
                entry.unlink()
            removed += 1
    print(f"[+] cleaned {removed} cached repositories; run 'garb update' to refresh")


def version_tuple(value: str) -> tuple:
    return tuple(int(part) if part.isdigit() else part for part in re.split(r"[._-]", value))


# ---------------------------------------------------------------- repository build
def read_garbfile(path: Path) -> dict:
    with open(path, "rb") as handle:
        data = tomllib.load(handle)
    package = data.get("package", {})
    if "name" not in package:
        raise GarbError(f"{path}: [package] name is required")
    deps = data.get("dependencies", {}).get("runtime", [])
    return {
        "name": package["name"],
        "version": str(package.get("version", "0")),
        "release": int(package.get("release", 1)),
        "description": package.get("description", ""),
        "license": package.get("license", ""),
        "arch": package.get("arch", ["x86_64"]),
        "dependencies": deps,
        "build": data.get("build", {}),
        "source": path,
    }


def build_package(manifest: Path, output_dir: Path) -> Path:
    meta = read_garbfile(manifest)
    source_root = manifest.parent / "root"
    files = []
    if source_root.is_dir():
        for path in sorted(source_root.rglob("*")):
            rel = str(path.relative_to(source_root))
            # Check is_symlink() before is_dir(): is_dir() follows links, so a
            # symlink to a directory used to be dropped silently.
            if path.is_symlink():
                files.append({"path": rel, "type": "symlink", "target": os.readlink(path)})
            elif path.is_dir():
                continue
            elif path.is_file():
                mode = stat.S_IMODE(path.stat().st_mode)
                if mode & (stat.S_ISUID | stat.S_ISGID):
                    raise GarbError(
                        f"{manifest}: refusing to package setuid/setgid file: {rel}"
                    )
                files.append({
                    "path": rel,
                    "type": "file",
                    "sha256": sha256_file(path),
                    "mode": f"{mode:04o}",
                })
    if meta["build"]:
        warn(f"{manifest}: [build] commands are not executed by garb 1.0; "
             "package the resulting tree under root/ instead")
    metadata = {
        "schema": SCHEMA,
        "name": meta["name"],
        "version": meta["version"],
        "release": meta["release"],
        "description": meta["description"],
        "license": meta["license"],
        "arch": meta["arch"],
        "dependencies": meta["dependencies"],
        "files": files,
    }
    output_dir.mkdir(parents=True, exist_ok=True)
    archive = output_dir / f"{meta['name']}-{meta['version']}-{meta['release']}.garb"
    stamp = epoch()
    raw = io.BytesIO()
    with gzip.GzipFile(fileobj=raw, mode="wb", compresslevel=9, mtime=0) as gz:
        with tarfile.open(fileobj=gz, mode="w") as tar:
            payload = json.dumps(metadata, indent=2, sort_keys=True).encode("utf-8") + b"\n"
            info = tarfile.TarInfo(METADATA_NAME)
            info.size = len(payload)
            info.mtime = stamp
            info.mode = 0o644
            info.uid = info.gid = 0
            info.uname = info.gname = "root"
            tar.addfile(info, io.BytesIO(payload))
            if source_root.is_dir():
                for path in sorted(source_root.rglob("*")):
                    if path.is_dir() and not path.is_symlink():
                        continue
                    rel = str(path.relative_to(source_root))
                    info = tar.gettarinfo(str(path), arcname=rel)
                    info.mtime = stamp
                    info.uid = info.gid = 0
                    info.uname = info.gname = "root"
                    if path.is_symlink():
                        tar.addfile(info)
                    else:
                        with open(path, "rb") as handle:
                            tar.addfile(info, handle)
    archive.write_bytes(raw.getvalue())
    return archive


def cmd_repo_build(args: argparse.Namespace) -> None:
    source = Path(args.directory)
    output = Path(args.output)
    manifests = sorted(source.glob("*/Garbfile"))
    if not manifests:
        die(f"no Garbfiles under {source}")
    for manifest in manifests:
        archive = build_package(manifest, output)
        print(f"[+] {archive.name}")


def cmd_build(args: argparse.Namespace) -> None:
    archive = build_package(Path(args.manifest), Path(args.output))
    print(f"[+] {archive}")
    print(f"[+] SHA-256: {sha256_file(archive)}")


def cmd_repo_index(args: argparse.Namespace) -> None:
    directory = Path(args.directory)
    archives = sorted(directory.glob("*.garb"))
    packages = {}
    for archive in archives:
        metadata = read_metadata(archive)
        name = metadata["name"]
        packages[name] = {
            "version": metadata.get("version", "0"),
            "release": metadata.get("release", 1),
            "description": metadata.get("description", ""),
            "license": metadata.get("license", ""),
            "arch": metadata.get("arch", ["x86_64"]),
            "dependencies": metadata.get("dependencies", []),
            "filename": archive.name,
            "sha256": sha256_file(archive),
            "size": archive.stat().st_size,
        }
    issued = int(time.time())
    if args.index_version is not None and args.index_version <= 0:
        die("--index-version must be positive")
    if args.valid_days <= 0:
        die("--valid-days must be positive")
    index = {
        "schema": SCHEMA,
        "generated": epoch(),
        "index_version": args.index_version if args.index_version is not None else issued,
        "expires": issued + args.valid_days * 86400,
        "packages": packages,
    }
    raw = (json.dumps(index, indent=2, sort_keys=True) + "\n").encode("utf-8")
    index_path = directory / "index.json"
    index_path.write_bytes(raw)
    print(f"[+] index: {index_path} ({len(packages)} packages)")
    if args.key:
        signature = sign_bytes(raw, Path(args.key))
        (directory / "index.json.sig").write_bytes(signature)
        print(f"[+] signature: {directory / 'index.json.sig'}")


def cmd_keygen(args: argparse.Namespace) -> None:
    directory = Path(args.directory)
    directory.mkdir(parents=True, exist_ok=True)
    private = directory / "private.pem"
    public = directory / "public.pem"
    subprocess.run(["openssl", "genpkey", "-algorithm", "ed25519", "-out", str(private)], check=True)
    subprocess.run(["openssl", "pkey", "-in", str(private), "-pubout", "-out", str(public)], check=True)
    os.chmod(private, 0o600)
    print(f"[+] private key: {private}")
    print(f"[+] public key:  {public}")


def cmd_sign_index(args: argparse.Namespace) -> None:
    index_path = Path(args.index)
    signature = sign_bytes(index_path.read_bytes(), Path(args.key))
    Path(str(index_path) + ".sig").write_bytes(signature)
    print(f"[+] signed {index_path}")


def record_generation(paths: Paths, reason: str = "") -> int:
    paths.generations.mkdir(parents=True, exist_ok=True)
    existing = []
    for f in paths.generations.glob("*.json"):
        if f.stem.isdigit():
            existing.append(int(f.stem))
    next_id = max(existing, default=0) + 1
    db = Database(paths)
    gen_data = {
        "id": next_id,
        "timestamp": int(time.time()),
        "reason": reason,
        "packages": db.data.get("packages", {}),
    }
    target = paths.generations / f"{next_id}.json"
    with open(target, "w", encoding="utf-8") as f:
        json.dump(gen_data, f, indent=2, sort_keys=True)
    current_link = paths.generations / "current"
    if current_link.is_symlink() or current_link.exists():
        current_link.unlink()
    try:
        current_link.symlink_to(f"{next_id}.json")
    except OSError:
        pass
    return next_id


def cmd_generations(args: argparse.Namespace) -> None:
    paths = args.paths
    paths.generations.mkdir(parents=True, exist_ok=True)
    gens = []
    current_link = paths.generations / "current"
    current_id = -1
    if current_link.is_symlink():
        try:
            current_id = int(os.readlink(current_link).removesuffix(".json"))
        except (ValueError, OSError):
            pass

    for f in sorted(paths.generations.glob("*.json")):
        if f.stem.isdigit():
            try:
                data = json.loads(f.read_text(encoding="utf-8"))
                gid = int(f.stem)
                gens.append({
                    "id": gid,
                    "timestamp": data.get("timestamp", 0),
                    "reason": data.get("reason", ""),
                    "package_count": len(data.get("packages", {})),
                    "is_current": (gid == current_id),
                })
            except Exception:
                pass

    if getattr(args, "format", "text") == "json":
        print(json.dumps(gens, indent=2))
    else:
        print("=" * 60)
        print("Grintion Package Generations")
        print("=" * 60)
        for g in gens:
            cur = " *" if g["is_current"] else "  "
            ts = time.strftime("%Y-%m-%d %H:%M:%S", time.gmtime(g["timestamp"]))
            print(f"{cur} Generation {g['id']:<4} | {ts} | {g['package_count']} packages | {g['reason']}")
        print("=" * 60)


def cmd_rollback_generation(args: argparse.Namespace) -> None:
    paths = args.paths
    target_id = args.generation
    gen_file = paths.generations / f"{target_id}.json"
    if not gen_file.is_file():
        die(f"generation {target_id} not found in {paths.generations}")

    target_gen = json.loads(gen_file.read_text(encoding="utf-8"))
    target_pkgs = target_gen.get("packages", {})

    db = Database(paths)
    current_pkgs = db.data.get("packages", {})

    for pkg_name, pkg_data in list(current_pkgs.items()):
        if pkg_name not in target_pkgs:
            log(f"removing package {pkg_name} (absent in generation {target_id})")
            for item in pkg_data.get("files", []):
                target_path = paths.inside(item["path"])
                if target_path.exists() or target_path.is_symlink():
                    try:
                        target_path.unlink()
                    except OSError:
                        pass

    db.data["packages"] = target_pkgs
    db.save()
    print(f"[+] rolled back system packages to generation {target_id} ({len(target_pkgs)} packages)")


def cmd_hold(args: argparse.Namespace) -> None:
    holds = load_holds(args.paths)
    for pkg in args.package:
        holds.add(pkg)
        log(f"holding package {pkg}")
    save_holds(args.paths, holds)
    print(f"[+] held {len(args.package)} package(s)")


def cmd_unhold(args: argparse.Namespace) -> None:
    holds = load_holds(args.paths)
    for pkg in args.package:
        holds.discard(pkg)
        log(f"unholding package {pkg}")
    save_holds(args.paths, holds)
    print(f"[+] unheld {len(args.package)} package(s)")


def load_pins(paths: Paths) -> dict[str, str]:
    if not paths.pins.is_file():
        return {}
    pins: dict[str, str] = {}
    for line in paths.pins.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            k, v = line.split("=", 1)
            pins[k.strip()] = v.strip().strip('"\'')
    return pins


def cmd_pin(args: argparse.Namespace) -> None:
    pins = load_pins(args.paths)
    for spec in args.package:
        if "=" in spec:
            pkg, ver = spec.split("=", 1)
            pins[pkg.strip()] = ver.strip()
            log(f"pinned {pkg.strip()} to version {ver.strip()}")
        else:
            die("pin format must be package=version (e.g. openssl=3.0.0)")
    args.paths.pins.parent.mkdir(parents=True, exist_ok=True)
    lines = ["# /etc/garb/pins.conf - Pinned package versions"] + [f"{k} = {v}" for k, v in sorted(pins.items())]
    args.paths.pins.write_text("\n".join(lines) + "\n", encoding="utf-8")
    print(f"[+] pinned {len(args.package)} package(s)")


def cmd_downgrade(args: argparse.Namespace) -> None:
    paths = args.paths
    pkg = args.package
    version = args.version
    db = Database(paths)
    installed = db.installed(pkg)
    if not installed:
        die(f"package {pkg} is not installed")
    log(f"downgrading {pkg} from {installed.get('version')} to {version}")

    archive = None
    for candidate in paths.cache.glob(f"**/{pkg}-{version}*.garb"):
        if candidate.is_file():
            archive = candidate
            break

    if not archive:
        index = load_indexes(paths)
        entry = index.get(pkg)
        if entry and str(entry.get("version")) == version:
            archive = fetch_archive(paths, pkg, entry)

    if not archive:
        die(f"archive for {pkg}={version} not found in cache or repositories")

    staging = Path(tempfile.mkdtemp(prefix="garb-stage-", dir=paths.tmp))
    try:
        metadata, _members = extract_staged(archive, staging)
        entry_db = commit_package(paths, staging, metadata, archive)
        db.add(pkg, entry_db)
        db.save()
        print(f"[+] {pkg} downgraded to {version}")
    finally:
        shutil.rmtree(staging, ignore_errors=True)


def cmd_mirror_rank(args: argparse.Namespace) -> None:
    repos = read_repo_configs(args.paths)
    results = []
    for r in repos:
        name = r.get("name", "repo")
        url = r.get("url", "")
        start = time.time()
        status = "ok"
        try:
            if url.startswith(("http://", "https://")):
                req = urllib.request.Request(url, headers={"User-Agent": f"garb/{VERSION}"})
                with urllib.request.urlopen(req, timeout=args.timeout):
                    pass
            latency_ms = round((time.time() - start) * 1000, 2)
        except Exception:
            latency_ms = 9999.0
            status = "unreachable"

        results.append({
            "name": name,
            "url": url,
            "latency_ms": latency_ms,
            "status": status,
        })

    results.sort(key=lambda x: x["latency_ms"])
    if getattr(args, "format", "text") == "json":
        print(json.dumps(results, indent=2))
    else:
        print("=" * 60)
        print("Grintion Mirror Latency Ranking")
        print("=" * 60)
        for idx, m in enumerate(results, start=1):
            print(f"[{idx}] {m['name']} ({m['url']}) - {m['latency_ms']} ms [{m['status']}]")
        print("=" * 60)


def cmd_delta_create(args: argparse.Namespace) -> None:
    old_archive = Path(args.old)
    new_archive = Path(args.new)
    out_delta = Path(args.out)
    if not old_archive.is_file() or not new_archive.is_file():
        die("old and new archives must exist")

    old_files = {}
    with tarfile.open(old_archive, "r:gz") as tar:
        for member in tar.getmembers():
            if member.isfile():
                f = tar.extractfile(member)
                if f:
                    old_files[member.name] = hashlib.sha256(f.read()).hexdigest()

    out_delta.parent.mkdir(parents=True, exist_ok=True)
    temp_dir = Path(tempfile.mkdtemp(prefix="garb-delta-"))
    try:
        delta_members = []
        with tarfile.open(new_archive, "r:gz") as new_tar:
            for member in new_tar.getmembers():
                if member.isfile():
                    f = new_tar.extractfile(member)
                    if f:
                        content = f.read()
                        h = hashlib.sha256(content).hexdigest()
                        if old_files.get(member.name) != h:
                            dest = temp_dir / member.name
                            dest.parent.mkdir(parents=True, exist_ok=True)
                            dest.write_bytes(content)
                            delta_members.append(member.name)

        deleted_members = [m for m in old_files if m not in delta_members]
        meta = {
            "format": "garb-delta-v1",
            "old_sha256": sha256_file(old_archive),
            "new_sha256": sha256_file(new_archive),
            "modified": delta_members,
            "deleted": deleted_members,
        }
        (temp_dir / "GARB_DELTA_METADATA.json").write_text(json.dumps(meta, indent=2))

        with tarfile.open(out_delta, "w:gz") as out_tar:
            for root, dirs, files in os.walk(temp_dir):
                for file in files:
                    full_p = Path(root) / file
                    rel_p = full_p.relative_to(temp_dir)
                    out_tar.add(full_p, arcname=str(rel_p))
    finally:
        shutil.rmtree(temp_dir, ignore_errors=True)

    log(f"created delta update {out_delta} ({out_delta.stat().st_size} bytes)")


def cmd_delta_apply(args: argparse.Namespace) -> None:
    old_archive = Path(args.old)
    delta_file = Path(args.delta)
    out_archive = Path(args.out)

    extract_old = Path(tempfile.mkdtemp(prefix="garb-apply-old-"))
    extract_delta = Path(tempfile.mkdtemp(prefix="garb-apply-delta-"))
    try:
        with tarfile.open(old_archive, "r:gz") as tar:
            tar.extractall(extract_old)
        with tarfile.open(delta_file, "r:gz") as tar:
            tar.extractall(extract_delta)

        meta_file = extract_delta / "GARB_DELTA_METADATA.json"
        if meta_file.is_file():
            meta = json.loads(meta_file.read_text(encoding="utf-8"))
            for d in meta.get("deleted", []):
                del_path = extract_old / d
                if del_path.exists():
                    del_path.unlink()
            meta_file.unlink()

        for root, dirs, files in os.walk(extract_delta):
            for file in files:
                src = Path(root) / file
                rel = src.relative_to(extract_delta)
                dst = extract_old / rel
                dst.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(src, dst)

        out_archive.parent.mkdir(parents=True, exist_ok=True)
        with tarfile.open(out_archive, "w:gz") as tar:
            for root, dirs, files in os.walk(extract_old):
                for file in files:
                    full_p = Path(root) / file
                    rel_p = full_p.relative_to(extract_old)
                    tar.add(full_p, arcname=str(rel_p))
    finally:
        shutil.rmtree(extract_old, ignore_errors=True)
        shutil.rmtree(extract_delta, ignore_errors=True)

    log(f"reconstructed archive {out_archive} from delta")


PACMAN_VERSION_RE = re.compile(r"Pacman v(\d+)\.(\d+)\.(\d+)", re.IGNORECASE)
APK_VERSION_RE = re.compile(r"apk-tools\s+(\d+)\.(\d+)\.(\d+)", re.IGNORECASE)
SUPPORTED_BACKEND_MAJORS = {"pacman": frozenset({6, 7}), "apk": frozenset({2, 3})}


def backend_kind(path: str) -> str:
    name = Path(path).name.lower()
    if "pacman" in name:
        return "pacman"
    if "apk" in name:
        return "apk"
    raise GarbError(f"GARB_BACKEND_BIN must point at pacman or apk, not: {path}")


def backend_version(backend: str, binary: str) -> tuple[int, int, int]:
    """Read and validate the external manager's version.

    The translator is written against pacman 6/7 and apk-tools 2/3. A future
    upstream release can keep the binary name while changing flags or database
    layout. Failing closed with an actionable message is safer than passing an
    unknown argument set to it.
    """
    try:
        result = subprocess.run(
            [binary, "--version"],
            capture_output=True,
            text=True,
            timeout=15,
            env={**os.environ, "LC_ALL": "C"},
        )
    except (OSError, subprocess.SubprocessError) as exc:
        raise GarbError(f"cannot read {backend} version from {binary}: {exc}") from exc
    text = f"{result.stdout}\n{result.stderr}"
    pattern = PACMAN_VERSION_RE if backend == "pacman" else APK_VERSION_RE
    match = pattern.search(text)
    if result.returncode != 0 or match is None:
        raise GarbError(
            f"{backend} at {binary} did not report a supported version; "
            "refusing to delegate (use --backend native after inspecting it)"
        )
    version = tuple(int(part) for part in match.groups())
    if version[0] not in SUPPORTED_BACKEND_MAJORS[backend]:
        supported = ", ".join(str(major) for major in sorted(SUPPORTED_BACKEND_MAJORS[backend]))
        raise GarbError(
            f"{backend} {version[0]}.{version[1]}.{version[2]} is outside the "
            f"verified translator range (supported major versions: {supported}); "
            "use --backend native or update garb before delegating"
        )
    return version


def external_backend_binary(requested: str) -> tuple[str, str] | None:
    """Return (backend, executable) for an explicit or auto-detected backend."""
    explicit = os.environ.get("GARB_BACKEND_BIN")
    names = [requested] if requested in ("pacman", "apk") else ["pacman", "apk"]
    if explicit:
        if not os.access(explicit, os.X_OK):
            raise GarbError(f"GARB_BACKEND_BIN is not executable: {explicit}")
        kind = backend_kind(explicit)
        if requested in ("pacman", "apk") and kind != requested:
            raise GarbError(
                f"GARB_BACKEND_BIN points at {kind}, but --backend {requested} was requested"
            )
        return kind, explicit
    for name in names:
        found = shutil.which(name)
        if found:
            return name, found
    return None


def external_argv(backend: str, binary: str, args: argparse.Namespace) -> list[str]:
    """Translate a garb command into the external manager's argument list."""
    root = Path(args.root)
    argv = [binary]
    if str(root) != "/":
        argv += ["--root", str(root)]

    command = args.command
    if backend == "pacman":
        if command == "update":
            if getattr(args, "key", None) or getattr(args, "allow_unsigned", False):
                raise GarbError("--key/--allow-unsigned are native-garb options")
            argv.append("-Sy")
        elif command == "search":
            argv += ["-Ss", args.query]
        elif command == "info":
            argv += ["-Qi" if getattr(args, "installed", False) else "-Si", args.package]
        elif command == "install":
            if args.force:
                raise GarbError("--force is not supported by the pacman backend")
            argv += ["-S", "--noconfirm", *args.package]
        elif command == "remove":
            if args.force:
                raise GarbError("--force is not supported by the pacman backend")
            argv += ["-R", "--noconfirm", *args.package]
        elif command == "verify":
            if getattr(args, "format", "text") != "text":
                raise GarbError("--format json is a native-garb option")
            argv.append("-Qk" if args.quick else "-Qkk")
            argv += args.package
        elif command == "upgrade":
            if args.package:
                argv += ["-S", "--noconfirm", *args.package]
            else:
                argv += ["-Su", "--noconfirm"]
        else:
            raise GarbError(f"pacman has no mapping for garb {command}")
        return argv

    if command == "update":
        if getattr(args, "key", None) or getattr(args, "allow_unsigned", False):
            raise GarbError("--key/--allow-unsigned are native-garb options")
        argv.append("update")
    elif command == "search":
        argv += ["search", args.query]
    elif command == "info":
        argv += ["info", args.package]
    elif command == "install":
        if args.force:
            raise GarbError("--force is not supported by the apk backend")
        argv += ["add", *args.package]
    elif command == "remove":
        if args.force:
            raise GarbError("--force is not supported by the apk backend")
        argv += ["del", *args.package]
    elif command == "verify":
        if args.quick:
            raise GarbError("--quick is not supported by the apk backend")
        if getattr(args, "format", "text") != "text":
            raise GarbError("--format json is a native-garb option")
        argv += ["audit", *args.package]
    elif command == "upgrade":
        argv += ["upgrade", *args.package]
    else:
        raise GarbError(f"apk has no mapping for garb {command}")
    return argv


PROTECTED_OVERWRITE_PATHS = (
    "/etc/passwd",
    "/etc/passwd-",
    "/etc/shadow",
    "/etc/shadow-",
    "/etc/group",
    "/etc/group-",
    "/etc/gshadow",
    "/etc/gshadow-",
    "/etc/sudoers",
    "/etc/sudoers.d/",
    "/etc/ssh/ssh_host_",
    "/boot/",
    "/usr/lib/modules/",
)
MAX_OVERWRITE_CONFLICTS = 1024


def conflict_paths(output: str) -> list[str]:
    paths = set()
    for line in output.splitlines():
        # pacman 6 prints "path exists in filesystem". pacman 7 prints
        # "package: path exists in filesystem" (or, in some builds,
        # "path: exists in filesystem"). The optional group is the package
        # prefix; the path is always the token before "exists".
        match = re.match(
            r"^\s*(?:(\S+):\s+)?(\S+)\s+exists in filesystem\b", line
        )
        if match is None:
            continue
        path = match.group(2).rstrip(":")
        paths.add(posixpath.normpath("/" + path.lstrip("/")))
    return sorted(paths)


def protected_overwrite(path: str) -> bool:
    normalized = posixpath.normpath(path)
    for protected in PROTECTED_OVERWRITE_PATHS:
        if normalized == protected or normalized.startswith(protected):
            return True
    return False


def run_streaming(argv: list[str]) -> tuple[int, str]:
    process = subprocess.Popen(
        argv,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        bufsize=1,
    )
    assert process.stdout is not None
    chunks: list[str] = []
    for line in process.stdout:
        chunks.append(line)
        print(line, end="", flush=True)
    return process.wait(), "".join(chunks)


def run_external_backend(backend: str, binary: str, args: argparse.Namespace) -> int:
    argv = external_argv(backend, binary, args)
    warn(f"using the {backend} backend; garb signature and transaction checks do not apply")
    print(f"[garb] {' '.join(argv)}", file=sys.stderr)

    # Never pass a blanket --overwrite '*'. It lets an upstream package replace
    # account, sudo, SSH host-key or boot files. Retry only the exact paths the
    # transaction reported, and refuse the security-sensitive ones outright.
    if backend != "pacman" or args.command not in ("install", "upgrade"):
        return subprocess.run(argv).returncode
    rc, output = run_streaming(argv)
    if rc == 0:
        return 0
    conflicts = conflict_paths(output)
    if not conflicts:
        return rc
    protected = [path for path in conflicts if protected_overwrite(path)]
    if protected:
        raise GarbError(
            "refusing to overwrite security-sensitive path(s): "
            + ", ".join(protected[:8])
        )
    if len(conflicts) > MAX_OVERWRITE_CONFLICTS:
        raise GarbError(
            f"{len(conflicts)} file conflicts reported; refusing a blanket overwrite. "
            "Use --backend native or remove the conflicting files first"
        )
    retry = list(argv)
    for path in conflicts:
        retry += ["--overwrite", path, "--overwrite", path.lstrip("/")]
    warn(
        f"retrying with overwrite limited to {len(conflicts)} reported conflict path(s); "
        "security-sensitive paths remain protected"
    )
    print(f"[garb] {' '.join(retry)}", file=sys.stderr)
    retry_rc, _ = run_streaming(retry)
    return retry_rc


def build_parser() -> argparse.ArgumentParser:
    default_backend = os.environ.get("GARB_BACKEND", "auto")
    if default_backend not in ("auto", "native", "pacman", "apk"):
        default_backend = "auto"
    parser = argparse.ArgumentParser(
        prog="garb",
        description="Grintion-OS package manager 1.0",
        epilog=("When pacman or apk is installed, install/remove/update/search/info/"
                "verify/upgrade are delegated to it. Use --backend native to force "
                "garb's own signed-repository implementation."),
    )
    parser.add_argument("--root", default="/", help="target filesystem root (default: /)")
    parser.add_argument(
        "--backend",
        choices=("auto", "native", "pacman", "apk"),
        default=default_backend,
        help="package backend (default: auto; GARB_BACKEND also sets it)",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("version").set_defaults(func=cmd_version)

    update = sub.add_parser("update", help="fetch and verify repository indexes")
    update.add_argument("--key", help="override the trusted public key")
    update.add_argument("--allow-unsigned", action="store_true")
    update.set_defaults(func=cmd_update)

    search = sub.add_parser("search", help="search available and installed packages")
    search.add_argument("query")
    search.set_defaults(func=cmd_search)

    info = sub.add_parser("info", help="show package details")
    info.add_argument("package")
    info.add_argument("--installed", action="store_true", help="only report installed packages")
    info.set_defaults(func=cmd_info)

    install = sub.add_parser("install", help="install packages")
    install.add_argument("package", nargs="+")
    install.add_argument("--upgrade", action="store_true")
    install.add_argument("--force", action="store_true")
    install.set_defaults(func=cmd_install)

    remove = sub.add_parser("remove", help="remove packages")
    remove.add_argument("package", nargs="+")
    remove.add_argument("--force", action="store_true")
    remove.set_defaults(func=cmd_remove)

    verify = sub.add_parser("verify", help="verify installed file hashes")
    verify.add_argument("package", nargs="*")
    verify.add_argument("--quick", action="store_true")
    verify.add_argument("--format", choices=("text", "json"), default="text", help="output format")
    verify.set_defaults(func=cmd_verify)

    upgrade = sub.add_parser("upgrade", help="upgrade installed packages")
    upgrade.add_argument("package", nargs="*")
    upgrade.add_argument("--no-snapshot", action="store_true", help="skip the Btrfs pre-upgrade snapshot")
    upgrade.set_defaults(func=cmd_upgrade)

    listing = sub.add_parser("list", help="list installed packages")
    listing_group = listing.add_mutually_exclusive_group()
    listing_group.add_argument("--upgradable", action="store_true", help="only packages with a newer index version")
    listing_group.add_argument("--available", action="store_true", help="list repository packages instead")
    listing.set_defaults(func=cmd_list)

    clean = sub.add_parser("clean", help="remove cached repository indexes and downloads")
    clean.set_defaults(func=cmd_clean)

    history = sub.add_parser("history", help="show the transaction journal")
    history.add_argument("--format", choices=("text", "json"), default="text")
    history.add_argument("--limit", type=int, default=20, help="show the last N records (0 = all)")
    history.set_defaults(func=cmd_history)

    fsck = sub.add_parser("fsck", help="check the package database and installed files")
    fsck.add_argument("--format", choices=("text", "json"), default="text")
    fsck.add_argument("--hash", action="store_true", help="re-hash every installed file")
    fsck.set_defaults(func=cmd_fsck)

    build = sub.add_parser("build", help="build one .garb from a Garbfile")
    build.add_argument("manifest")
    build.add_argument("-o", "--output", default="dist")
    build.set_defaults(func=cmd_build)

    repo_build = sub.add_parser("repo-build", help="build every Garbfile in a directory")
    repo_build.add_argument("directory")
    repo_build.add_argument("output")
    repo_build.set_defaults(func=cmd_repo_build)

    repo_index = sub.add_parser("repo-index", help="write and optionally sign a repository index")
    repo_index.add_argument("directory")
    repo_index.add_argument("--key")
    repo_index.add_argument(
        "--valid-days", type=int, default=30,
        help="days before the signed index expires (default: 30)",
    )
    repo_index.add_argument(
        "--index-version", type=int,
        help="monotonic index version (default: current Unix time)",
    )
    repo_index.set_defaults(func=cmd_repo_index)

    keygen = sub.add_parser("keygen", help="create an Ed25519 repository key pair")
    keygen.add_argument("directory")
    keygen.set_defaults(func=cmd_keygen)

    sign_index = sub.add_parser("sign-index", help="sign an existing index.json")
    sign_index.add_argument("index")
    sign_index.add_argument("--key", required=True)
    sign_index.set_defaults(func=cmd_sign_index)

    gens = sub.add_parser("generations", help="list package generations")
    gens.add_argument("--format", choices=("text", "json"), default="text")
    gens.set_defaults(func=cmd_generations)

    rb_gen = sub.add_parser("rollback-generation", help="roll back package state to a previous generation")
    rb_gen.add_argument("generation", type=int, help="generation ID to restore")
    rb_gen.set_defaults(func=cmd_rollback_generation)

    hold_p = sub.add_parser("hold", help="hold packages to prevent automatic upgrades")
    hold_p.add_argument("package", nargs="+")
    hold_p.set_defaults(func=cmd_hold)

    unhold_p = sub.add_parser("unhold", help="remove hold on packages")
    unhold_p.add_argument("package", nargs="+")
    unhold_p.set_defaults(func=cmd_unhold)

    pin_p = sub.add_parser("pin", help="pin package to specific version (e.g. openssl=3.0.0)")
    pin_p.add_argument("package", nargs="+")
    pin_p.set_defaults(func=cmd_pin)

    down_p = sub.add_parser("downgrade", help="downgrade a package to a specific version")
    down_p.add_argument("package")
    down_p.add_argument("version")
    down_p.set_defaults(func=cmd_downgrade)

    mirror_p = sub.add_parser("mirror-rank", help="measure repository mirror latencies")
    mirror_p.add_argument("--format", choices=("text", "json"), default="text")
    mirror_p.add_argument("--timeout", type=int, default=5)
    mirror_p.set_defaults(func=cmd_mirror_rank)

    dcreate_p = sub.add_parser("delta-create", help="create a delta update between two .garb packages")
    dcreate_p.add_argument("--old", required=True)
    dcreate_p.add_argument("--new", required=True)
    dcreate_p.add_argument("--out", required=True)
    dcreate_p.set_defaults(func=cmd_delta_create)

    dapply_p = sub.add_parser("delta-apply", help="apply a delta update onto an old .garb package")
    dapply_p.add_argument("--old", required=True)
    dapply_p.add_argument("--delta", required=True)
    dapply_p.add_argument("--out", required=True)
    dapply_p.set_defaults(func=cmd_delta_apply)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    try:
        backend = args.backend
        # A local .garb archive cannot be handed to pacman/apk; native garb is
        # the only implementation that understands the format.
        if args.command == "install" and any(Path(spec).is_file() for spec in args.package):
            if backend not in ("auto", "native"):
                raise GarbError("local .garb archives require the native backend")
            backend = "native"
        if args.command in EXTERNAL_COMMANDS and backend != "native":
            # Auto-detection is limited to the running system. A staging root
            # must opt in explicitly so tests and image builds never invoke the
            # host's package manager by accident.
            if backend == "auto" and Path(args.root) != Path("/"):
                backend = "native"
            if backend != "native":
                found = external_backend_binary(backend)
                if found is None:
                    if backend == "auto":
                        raise GarbError(
                            "no supported package backend found (pacman or apk); "
                            "use --backend native"
                        )
                    raise GarbError(f"{backend} backend requested but not installed")
                backend_name, binary = found
                backend_version(backend_name, binary)
                return run_external_backend(backend_name, binary, args)
        args.paths = Paths(Path(args.root))
        if args.command in MUTATING_COMMANDS:
            with TransactionLock(args.paths, args.command):
                txid = f"{int(time.time())}-{os.getpid()}-{secrets.token_hex(4)}"
                base = {
                    "schema": 1,
                    "txid": txid,
                    "time": int(time.time()),
                    "root": str(args.paths.root),
                    "command": args.command,
                    "packages": list(getattr(args, "package", []) or []),
                    "garb_version": VERSION,
                }
                journal_append(args.paths, {**base, "status": "started"})
                try:
                    args.func(args)
                except BaseException as exc:
                    journal_append(args.paths, {
                        **base,
                        "status": "rolled-back",
                        "error": f"{type(exc).__name__}: {exc}",
                    })
                    raise
                else:
                    journal_append(args.paths, {**base, "status": "committed"})
                    pkg_str = " ".join(getattr(args, "package", []) or []) if isinstance(getattr(args, "package", None), list) else str(getattr(args, "package", "") or "")
                    record_generation(args.paths, f"{args.command} {pkg_str}".strip())
        else:
            args.func(args)
    except GarbError as exc:
        die(str(exc))
    except (OSError, ValueError, KeyError, tarfile.TarError, subprocess.CalledProcessError) as exc:
        die(str(exc))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
