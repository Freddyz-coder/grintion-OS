def cmd_history(args: argparse.Namespace) -> None:
    records = read_journal(args.paths)
    if args.limit > 0:
        records = records[-args.limit:]
    if args.format == "json":
        print(json.dumps(records, indent=2, sort_keys=True))
        return
    if not records:
        print("[-] no transactions recorded")
        return
    for record in records:
        stamp = time.strftime(
            "%Y-%m-%dT%H:%M:%SZ",
            time.gmtime(int(record.get("time", 0) or 0)),
        )
        packages = ",".join(str(item) for item in record.get("packages", [])) or "-"
        print(
            f"  {stamp}  {record.get('status', '?'):<11} "
            f"{record.get('command', '?'):<8} {packages}"
        )


def cmd_fsck(args: argparse.Namespace) -> None:
    paths = args.paths
    issues: list[dict] = []
    raw = None
    database_error = None
    if paths.db.exists():
        try:
            raw = json.loads(paths.db.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as exc:
            database_error = f"{paths.db}: {exc}"
    if raw is not None and not (
        isinstance(raw, dict) and isinstance(raw.get("packages"), dict)
    ):
        database_error = f"{paths.db}: expected an object with a 'packages' object"
        raw = None
    if database_error:
        issues.append({"severity": "error", "kind": "database", "detail": database_error})

    packages = raw.get("packages", {}) if isinstance(raw, dict) else {}
    owners: dict[str, str] = {}
    checked = 0
    for name, entry in sorted(packages.items()):
        if not isinstance(entry, dict):
            issues.append({
                "severity": "error",
                "kind": "package",
                "detail": f"package entry for {name} is not an object",
            })
            continue
        recorded_name = entry.get("name")
        if recorded_name not in (None, name):
            issues.append({
                "severity": "warning",
                "kind": "package",
                "detail": f"database key {name} records itself as {recorded_name}",
            })
        files = entry.get("files", [])
        if not isinstance(files, list):
            issues.append({
                "severity": "error",
                "kind": "package",
                "detail": f"package {name} has a non-list file inventory",
            })
            continue
        for item in files:
            if not isinstance(item, dict) or "path" not in item:
                issues.append({
                    "severity": "error",
                    "kind": "package",
                    "detail": f"package {name} has a malformed file entry",
                })
                continue
            try:
                rel = normalise_member(str(item["path"]))
            except GarbError as exc:
                issues.append({
                    "severity": "error",
                    "kind": "path",
                    "detail": f"package {name}: {exc}",
                })
                continue
            previous = owners.get(rel)
            if previous is not None and previous != name:
                issues.append({
                    "severity": "error",
                    "kind": "duplicate",
                    "detail": f"{rel} is owned by both {previous} and {name}",
                })
            else:
                owners[rel] = name
            target = paths.root / rel
            checked += 1
            if item.get("type") == "symlink":
                if not target.is_symlink():
                    issues.append({
                        "severity": "error",
                        "kind": "missing",
                        "detail": f"{name}: missing symlink {rel}",
                    })
                elif os.readlink(target) != item.get("target"):
                    issues.append({
                        "severity": "error",
                        "kind": "symlink",
                        "detail": f"{name}: symlink target changed for {rel}",
                    })
                continue
            if not target.is_file() or target.is_symlink():
                issues.append({
                    "severity": "error",
                    "kind": "missing",
                    "detail": f"{name}: missing file {rel}",
                })
                continue
            if not args.hash:
                continue
            try:
                digest = sha256_file(target)
            except OSError as exc:
                issues.append({
                    "severity": "error",
                    "kind": "unreadable",
                    "detail": f"{name}: cannot hash {rel}: {exc}",
                })
                continue
            if digest != item.get("sha256"):
                issues.append({
                    "severity": "error",
                    "kind": "tampered",
                    "detail": f"{name}: hash mismatch for {rel}",
                })
        for dependency in entry.get("dependencies", []) or []:
            if dependency not in packages:
                issues.append({
                    "severity": "warning",
                    "kind": "dependency",
                    "detail": (
                        f"{name} depends on {dependency}, which is not tracked by the "
                        "native database (it may come from the base image)"
                    ),
                })

    latest: dict[str, dict] = {}
    for record in read_journal(paths):
        txid = record.get("txid")
        if isinstance(txid, str) and txid:
            latest[txid] = record
    for txid, record in latest.items():
        if record.get("status") == "started":
            issues.append({
                "severity": "warning",
                "kind": "journal",
                "detail": (
                    f"transaction {txid} started but recorded no result; inspect "
                    f"{paths.tmp} and run 'garb verify'"
                ),
            })

    if paths.tmp.is_dir():
        for backup in sorted(paths.tmp.glob("garb-backup-*")):
            if backup.is_dir():
                issues.append({
                    "severity": "warning",
                    "kind": "backup",
                    "detail": f"leftover rollback backup: {backup}",
                })

    errors = [item for item in issues if item["severity"] == "error"]
    warnings = [item for item in issues if item["severity"] == "warning"]
    if args.format == "json":
        print(json.dumps(
            {
                "schema": 1,
                "root": str(paths.root),
                "packages": len(packages),
                "files_checked": checked,
                "ok": not errors,
                "errors": len(errors),
                "warnings": len(warnings),
                "issues": issues,
            },
            indent=2,
            sort_keys=True,
        ))
    else:
        for issue in issues:
            label = "[BAD]" if issue["severity"] == "error" else "[WARN]"
            print(f"  {label} {issue['kind']}: {issue['detail']}")
        if errors:
            print(f"[-] fsck found {len(errors)} error(s) and {len(warnings)} warning(s)")
        else:
            print(
                f"[+] fsck passed: {len(packages)} package(s), {checked} file(s), "
                f"{len(warnings)} warning(s)"
            )
    if errors:
        raise SystemExit(1)


# ---------------------------------------------------------------- repositories














def cmd_version(_args: argparse.Namespace) -> None:
    print(f"garb package manager {VERSION}")
    print("Signed repository indexes, transactional installs, per-file SHA-256")
    print("Target architecture: x86_64")


def cmd_update(args: argparse.Namespace) -> None:
    paths = args.paths
    configs = read_repo_configs(paths)
    if not configs:
        warn(f"no repositories configured in {paths.repos}")
        return
    if Path(args.root).resolve() == Path("/") and os.geteuid() != 0:
        raise GarbError("refreshing the system repository cache requires root")
    with TransactionLock(paths, "update"):
        for repo in configs:
            name, url = repo["name"], repo["url"]
            log(f"updating repository {name}")
            index = fetch_repo_file(url, "index.json", max_bytes=MAX_REPO_INDEX_BYTES)
            public_key = paths.keys / f"{name}.pub"
            if args.key:
                public_key = Path(args.key)
            if args.allow_unsigned:
                warn(f"accepting unsigned repository {name}")
                signature = b""
            else:
                signature = fetch_repo_file(
                    url, "index.json.sig", max_bytes=MAX_REPO_SIGNATURE_BYTES
                )
                verify_signature(index, signature, public_key)
            try:
                parsed = json.loads(index)
            except (UnicodeDecodeError, json.JSONDecodeError) as exc:
                raise GarbError(f"{name}: index is not valid JSON: {exc}") from exc
            if not isinstance(parsed, dict):
                raise GarbError(f"{name}: index is not a JSON object")
            if parsed.get("schema") != SCHEMA:
                raise GarbError(f"{name}: unsupported index schema {parsed.get('schema')}")
            target = paths.cache / "repos" / name
            validate_index(parsed, name, target)
            target.mkdir(parents=True, exist_ok=True)
            atomic_write_bytes(target / "index.json", index)
            if signature:
                atomic_write_bytes(target / "index.json.sig", signature)
            else:
                (target / "index.json.sig").unlink(missing_ok=True)
            log(f"{name}: {len(parsed.get('packages', {}))} packages")


def cmd_search(args: argparse.Namespace) -> None:
    query = args.query.lower()
    index = load_indexes(args.paths)
    db = Database(args.paths)
    found = 0
    for name, entry in sorted(index.items()):
        text = f"{name} {entry.get('description', '')}".lower()
        if query in text:
            state = "installed" if db.installed(name) else "available"
            print(f"  {name:<24} {entry.get('version', '?')}  [{state}]  {entry.get('description', '')}")
            found += 1
    for name, entry in sorted(db.data["packages"].items()):
        if query in f"{name} {entry.get('description', '')}".lower() and name not in index:
            print(f"  {name:<24} {entry.get('version', '?')}  [installed]  {entry.get('description', '')}")
            found += 1
    if not found:
        print(f"[-] no packages matching {query!r}")


def cmd_info(args: argparse.Namespace) -> None:
    db = Database(args.paths)
    installed = db.installed(args.package)
    index = None if args.installed else load_indexes(args.paths).get(args.package)
    if not installed and not index:
        die(f"package not installed: {args.package}" if args.installed else f"package not found: {args.package}")
    entry = installed or index
    print(f"Package:      {args.package}")
    print(f"Status:       {'installed' if installed else 'available'}")
    print(f"Version:      {entry.get('version')}-{entry.get('release', 1)}")
    print(f"Description:  {entry.get('description', '')}")
    print(f"Architecture: {entry.get('arch', ['x86_64'])}")
    if entry.get("dependencies"):
        print(f"Depends:      {', '.join(entry['dependencies'])}")
    if installed:
        print(f"Files:        {len(installed.get('files', []))}")
        print(f"Archive:      {installed.get('archive_sha256', '')}")


# ---------------------------------------------------------------- package files
























def fetch_archive(paths: Paths, name: str, entry: dict) -> Path:
    filename = entry.get("filename") or f"{name}-{entry.get('version')}-{entry.get('release', 1)}.garb"
    filename = str(filename)
    try:
        rel = normalise_member(filename)
    except GarbError as exc:
        raise GarbError(f"unsafe archive filename in index for {name}: {exc}") from exc
    repo = paths.cache / "repos" / entry["_repo"]
    target = repo / rel
    if target.is_symlink():
        target.unlink()
    if target.exists():
        if not target.is_file():
            raise GarbError(f"cached archive is not a regular file: {target}")
        if sha256_file(target) != entry.get("sha256"):
            target.unlink()
        else:
            return target
    configs = {repo["name"]: repo["url"] for repo in read_repo_configs(paths)}
    url = configs.get(entry["_repo"])
    if not url:
        raise GarbError(f"no configured URL for repository {entry['_repo']}")
    declared_size = entry.get("size")
    if not isinstance(declared_size, int) or isinstance(declared_size, bool) or declared_size <= 0:
        declared_size = None
    if declared_size is not None and declared_size > MAX_PACKAGE_BYTES:
        raise GarbError(
            f"{name}: declared archive size {declared_size} exceeds the "
            f"{MAX_PACKAGE_BYTES}-byte limit"
        )
    limit = declared_size or MAX_PACKAGE_BYTES
    log(f"fetching {name} from {entry['_repo']}")
    try:
        actual, size = fetch_repo_file_to(url, filename, target, max_bytes=limit)
    except GarbError as exc:
        if declared_size is not None and "exceeds" in str(exc):
            target.unlink(missing_ok=True)
            raise GarbError(
                f"archive size mismatch for {name}: index says {declared_size} "
                "bytes; the download exceeded that bound, so its checksum cannot match"
            ) from exc
        raise
    if declared_size is not None and size != declared_size:
        target.unlink(missing_ok=True)
        raise GarbError(
            f"archive size mismatch for {name}: index says {declared_size}, got {size}"
        )
    if actual != entry.get("sha256"):
        target.unlink(missing_ok=True)
        raise GarbError(f"archive checksum mismatch for {name}")
    return target


def cmd_install(args: argparse.Namespace) -> None:
    paths = args.paths
    paths.ensure_runtime()
    db = Database(paths)
    index = load_indexes(paths)
    targets: list[tuple[str, Path, dict]] = []
    for spec in args.package:
        candidate = Path(spec)
        if candidate.exists() and candidate.is_file():
            metadata = read_metadata(candidate)
            name = metadata["name"]
            targets.append((name, candidate, metadata))
        else:
            entry = index.get(spec)
            if entry is None:
                die(f"package not found in any repository: {spec}")
            targets.append((spec, Path(), entry))

    repository_names = [name for name, archive, _ in targets if archive == Path()]
    local_targets = [(name, archive, metadata) for name, archive, metadata in targets if archive != Path()]
    local_names = {name for name, _, _ in local_targets}

    # Local archives used to skip dependency resolution entirely. Resolve their
    # runtime dependencies against the indexes and the installed database too.
    local_dependencies: list[str] = []
    for name, _archive, metadata in local_targets:
        for dependency in metadata.get("dependencies", []):
            if dependency in local_names or db.installed(dependency):
                continue
            if dependency not in index:
                die(f"{name} requires {dependency}, which is not installed and not in any repository")
            local_dependencies.append(dependency)

    selected: list[str] = []
    for requested in (local_dependencies, repository_names):
        if not requested:
            continue
        for name in resolve_dependencies(requested, index, db, upgrading=args.upgrade):
            if name not in selected:
                selected.append(name)

    plan: list[tuple[str, Path, dict]] = []
    for name in selected:
        entry = index[name]
        plan.append((name, fetch_archive(paths, name, entry), entry))
    plan.extend(local_targets)

    if not plan:
        log("nothing to install")
        return

    seen: set[str] = set()
    for name, archive, entry in plan:
        if name in seen:
            continue
        seen.add(name)
        if db.installed(name) and not args.upgrade and not args.force:
            log(f"{name} is already installed (use --upgrade or --force)")
            continue
        log(f"installing {name}")
        staging = Path(tempfile.mkdtemp(prefix="garb-stage-", dir=paths.tmp))
        try:
            metadata, _members = extract_staged(archive, staging)
            if metadata.get("name") != name:
                raise GarbError(f"archive name mismatch: expected {name}, got {metadata.get('name')}")
            conflicts = file_conflicts(db, name, metadata.get("files", []))
            if conflicts and not args.force:
                owners = ", ".join(sorted(set(conflicts.values())))
                sample = ", ".join(f"{rel} ({owner})" for rel, owner in sorted(conflicts.items())[:5])
                raise GarbError(
                    f"{name} conflicts with files owned by {owners}: {sample}; "
                    "use --force to overwrite"
                )
            entry_db = commit_package(paths, staging, metadata, archive)
            db.add(name, entry_db)
            db.save()
            print(f"[+] {name} {entry_db['version']}-{entry_db['release']} installed ({len(entry_db['files'])} files)")
        finally:
            shutil.rmtree(staging, ignore_errors=True)


def cmd_remove(args: argparse.Namespace) -> None:
    paths = args.paths
    db = Database(paths)
    removing = set(args.package)
    changed = False
    for name in args.package:
        entry = db.installed(name)
        if entry is None:
            warn(f"{name} is not installed")
            continue
        dependents = reverse_dependents(db, name, ignore=removing)
        if dependents and not args.force:
            die(f"{name} is required by: {', '.join(dependents)} (use --force to remove it anyway)")
        modified = []
        for item in entry.get("files", []):
            target = paths.inside(item["path"])
            if not target.exists() and not target.is_symlink():
                continue
            if item.get("type") == "symlink":
                if not target.is_symlink():
                    modified.append(item["path"])
                continue
            if target.is_file() and sha256_file(target) != item.get("sha256"):
                modified.append(item["path"])
        if modified and not args.force:
            die(f"{name}: refusing to remove modified files: {', '.join(modified[:10])}")
        for item in reversed(entry.get("files", [])):
            target = paths.inside(item["path"])
            try:
                if target.exists() or target.is_symlink():
                    target.unlink()
            except OSError as exc:
                warn(f"could not remove {item['path']}: {exc}")
            parent = target.parent
            while parent != paths.root and parent.is_dir():
                try:
                    parent.rmdir()
                except OSError:
                    break
                parent = parent.parent
        db.remove(name)
        db.save()
        print(f"[+] removed {name}")
        changed = True
    if not changed:
        return


def cmd_verify(args: argparse.Namespace) -> None:
    paths = args.paths
    db = Database(paths)
    names = args.package or sorted(db.data["packages"])
    failures = 0
    checked = 0
    report = []
    for name in names:
        entry = db.installed(name)
        if entry is None:
            warn(f"{name} is not installed")
            failures += 1
            report.append({"package": name, "ok": False, "files": []})
            continue
        bad = 0
        files = []
        for item in entry.get("files", []):
            target = paths.inside(item["path"])
            checked += 1
            status = "ok"
            if item.get("type") == "symlink":
                if not target.is_symlink() or os.readlink(target) != item.get("target"):
                    status = "symlink-mismatch"
            elif not target.is_file() or target.is_symlink():
                status = "missing"
            elif not args.quick and sha256_file(target) != item.get("sha256"):
                status = "tampered"
            files.append({"path": item["path"], "status": status})
            if status == "ok":
                continue
            bad += 1
            if args.format == "text":
                label = {
                    "symlink-mismatch": "[BAD]",
                    "missing": "[MISSING]",
                    "tampered": "[TAMPERED]",
                }[status]
                suffix = " (symlink)" if status == "symlink-mismatch" else ""
                print(f"  {label} {name}: {item['path']}{suffix}")
        if bad:
            failures += 1
        elif args.format == "text":
            print(f"  [OK] {name} ({len(entry.get('files', []))} files)")
        report.append({"package": name, "ok": not bad, "files": files})
    if args.format == "json":
        print(json.dumps(
            {"checked": checked, "failed": failures, "packages": report},
            indent=2,
            sort_keys=True,
        ))
    if failures:
        die(f"integrity check failed for {failures} package(s), {checked} files checked")
    if args.format == "text":
        print(f"[+] integrity check passed: {checked} files checked")


def snapshot_before_upgrade(paths: Paths, args: argparse.Namespace) -> None:
    """Create a Btrfs snapshot before a system upgrade when the tool exists."""
    if getattr(args, "no_snapshot", False):
        return
    if getattr(paths, "root", Path("/")) != Path("/"):
        return
    if shutil.which("grintion-snapshot") is None:
        warn("grintion-snapshot is not installed; upgrading without a snapshot")
        return
    try:
        fstype = subprocess.check_output(
            ["findmnt", "-n", "-o", "FSTYPE", "/"], text=True, stderr=subprocess.DEVNULL
        ).strip()
    except (OSError, subprocess.CalledProcessError):
        return
    if fstype != "btrfs":
        return
    if os.geteuid() != 0:
        die("a Btrfs pre-upgrade snapshot requires root; rerun with sudo or --no-snapshot")
    log("creating a pre-upgrade Btrfs snapshot")
    result = subprocess.run(["grintion-snapshot", "create", "pre-upgrade"], check=False)
    if result.returncode != 0:
        die("the pre-upgrade snapshot failed; refusing to upgrade without a recovery point")


def load_holds(paths: Paths) -> set[str]:
    if not paths.holds.is_file():
        return set()
    holds = set()
    for line in paths.holds.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if line and not line.startswith("#"):
            holds.add(line)
    return holds


def save_holds(paths: Paths, holds: set[str]) -> None:
    paths.holds.parent.mkdir(parents=True, exist_ok=True)
    lines = ["# /etc/garb/holds.conf - Held packages"] + sorted(holds)
    paths.holds.write_text("\n".join(lines) + "\n", encoding="utf-8")


def cmd_upgrade(args: argparse.Namespace) -> None:
    paths = args.paths
    db = Database(paths)
    index = load_indexes(paths)
    holds = load_holds(paths)
    names = args.package or [name for name in db.data["packages"] if name in index]
    upgrades = []
    for name in names:
        if name in holds:
            log(f"skipping held package: {name}")
            continue
        installed = db.installed(name)
        available = index.get(name)
        if not installed or not available:
            continue
        if version_tuple(available.get("version", "0")) > version_tuple(installed.get("version", "0")):
            upgrades.append(name)
    if not upgrades:
        log("nothing to upgrade")
        return
    snapshot_before_upgrade(paths, args)
    log(f"upgrading: {', '.join(upgrades)}")
    args.package = upgrades
    args.force = False
    args.upgrade = True
    cmd_install(args)


def cmd_list(args: argparse.Namespace) -> None:
    paths = args.paths
    db = Database(paths)
    index = load_indexes(paths) if (args.available or args.upgradable) else {}
    names = sorted(index if args.available else db.data["packages"])
    printed = 0
    for name in names:
        installed = db.installed(name)
        available = index.get(name)
        if args.upgradable:
            if installed is None or available is None:
                continue
            if version_tuple(available.get("version", "0")) <= version_tuple(installed.get("version", "0")):
                continue
        entry = installed or available or {}
        state = "installed" if installed else "available"
        print(f"  {name:<24} {entry.get('version', '?')}-{entry.get('release', 1)}  [{state}]  {entry.get('description', '')}")
        printed += 1
    if not printed:
        print("[-] no packages to list")


def cmd_clean(args: argparse.Namespace) -> None:
    repositories = args.paths.cache / "repos"
    removed = 0
    if repositories.is_dir():
        for entry in repositories.iterdir():
            if entry.is_dir():
                shutil.rmtree(entry)
            else:
                entry.unlink()
            removed += 1
    print(f"[+] cleaned {removed} cached repositories; run 'garb update' to refresh")




# ---------------------------------------------------------------- repository build




def cmd_repo_build(args: argparse.Namespace) -> None:
    source = Path(args.directory)
    output = Path(args.output)
    manifests = sorted(source.glob("*/Garbfile"))
    if not manifests:
        die(f"no Garbfiles under {source}")
    for manifest in manifests:
        archive = build_package(manifest, output)
        print(f"[+] {archive.name}")


def cmd_build(args: argparse.Namespace) -> None:
    archive = build_package(Path(args.manifest), Path(args.output))
    print(f"[+] {archive}")
    print(f"[+] SHA-256: {sha256_file(archive)}")


def cmd_repo_index(args: argparse.Namespace) -> None:
    directory = Path(args.directory)
    archives = sorted(directory.glob("*.garb"))
    packages = {}
    for archive in archives:
        metadata = read_metadata(archive)
        name = metadata["name"]
        packages[name] = {
            "version": metadata.get("version", "0"),
            "release": metadata.get("release", 1),
            "description": metadata.get("description", ""),
            "license": metadata.get("license", ""),
            "arch": metadata.get("arch", ["x86_64"]),
            "dependencies": metadata.get("dependencies", []),
            "filename": archive.name,
            "sha256": sha256_file(archive),
            "size": archive.stat().st_size,
        }
    issued = int(time.time())
    if args.index_version is not None and args.index_version <= 0:
        die("--index-version must be positive")
    if args.valid_days <= 0:
        die("--valid-days must be positive")
    if args.valid_days * 86400 > MAX_INDEX_LIFETIME:
        die(
            f"--valid-days cannot exceed {MAX_INDEX_LIFETIME // 86400}; "
            "short-lived indexes limit replay and key-compromise windows"
        )
    index = {
        "schema": SCHEMA,
        "generated": epoch(),
        "index_version": args.index_version if args.index_version is not None else issued,
        "expires": issued + args.valid_days * 86400,
        "packages": packages,
    }
    raw = (json.dumps(index, indent=2, sort_keys=True) + "\n").encode("utf-8")
    index_path = directory / "index.json"
    atomic_write_bytes(index_path, raw)
    print(f"[+] index: {index_path} ({len(packages)} packages)")
    if args.key:
        signature = sign_bytes(raw, Path(args.key))
        atomic_write_bytes(directory / "index.json.sig", signature)
        print(f"[+] signature: {directory / 'index.json.sig'}")


def cmd_keygen(args: argparse.Namespace) -> None:
    directory = Path(args.directory)
    directory.mkdir(parents=True, exist_ok=True)
    private = directory / "private.pem"
    public = directory / "public.pem"
    subprocess.run(["openssl", "genpkey", "-algorithm", "ed25519", "-out", str(private)], check=True)
    subprocess.run(["openssl", "pkey", "-in", str(private), "-pubout", "-out", str(public)], check=True)
    os.chmod(private, 0o600)
    print(f"[+] private key: {private}")
    print(f"[+] public key:  {public}")


def cmd_sign_index(args: argparse.Namespace) -> None:
    index_path = Path(args.index)
    signature = sign_bytes(index_path.read_bytes(), Path(args.key))
    atomic_write_bytes(Path(str(index_path) + ".sig"), signature)
    print(f"[+] signed {index_path}")


def record_generation(paths: Paths, reason: str = "") -> int:
    paths.generations.mkdir(parents=True, exist_ok=True)
    existing = []
    for f in paths.generations.glob("*.json"):
        if f.stem.isdigit():
            existing.append(int(f.stem))
    next_id = max(existing, default=0) + 1
    db = Database(paths)
    gen_data = {
        "id": next_id,
        "timestamp": int(time.time()),
        "reason": reason,
        "packages": db.data.get("packages", {}),
    }
    target = paths.generations / f"{next_id}.json"
    with open(target, "w", encoding="utf-8") as f:
        json.dump(gen_data, f, indent=2, sort_keys=True)
    current_link = paths.generations / "current"
    if current_link.is_symlink() or current_link.exists():
        current_link.unlink()
    try:
        current_link.symlink_to(f"{next_id}.json")
    except OSError:
        pass
    return next_id


def cmd_generations(args: argparse.Namespace) -> None:
    paths = args.paths
    paths.generations.mkdir(parents=True, exist_ok=True)
    gens = []
    current_link = paths.generations / "current"
    current_id = -1
    if current_link.is_symlink():
        try:
            current_id = int(os.readlink(current_link).removesuffix(".json"))
        except (ValueError, OSError):
            pass

    for f in sorted(paths.generations.glob("*.json")):
        if f.stem.isdigit():
            try:
                data = json.loads(f.read_text(encoding="utf-8"))
                gid = int(f.stem)
                gens.append({
                    "id": gid,
                    "timestamp": data.get("timestamp", 0),
                    "reason": data.get("reason", ""),
                    "package_count": len(data.get("packages", {})),
                    "is_current": (gid == current_id),
                })
            except Exception:
                pass

    if getattr(args, "format", "text") == "json":
        print(json.dumps(gens, indent=2))
    else:
        print("=" * 60)
        print("Grintion Package Generations")
        print("=" * 60)
        for g in gens:
            cur = " *" if g["is_current"] else "  "
            ts = time.strftime("%Y-%m-%d %H:%M:%S", time.gmtime(g["timestamp"]))
            print(f"{cur} Generation {g['id']:<4} | {ts} | {g['package_count']} packages | {g['reason']}")
        print("=" * 60)


def cmd_rollback_generation(args: argparse.Namespace) -> None:
    paths = args.paths
    target_id = args.generation
    gen_file = paths.generations / f"{target_id}.json"
    if not gen_file.is_file():
        die(f"generation {target_id} not found in {paths.generations}")

    target_gen = json.loads(gen_file.read_text(encoding="utf-8"))
    target_pkgs = target_gen.get("packages", {})

    db = Database(paths)
    current_pkgs = db.data.get("packages", {})

    for pkg_name, pkg_data in list(current_pkgs.items()):
        if pkg_name not in target_pkgs:
            log(f"removing package {pkg_name} (absent in generation {target_id})")
            for item in pkg_data.get("files", []):
                target_path = paths.inside(item["path"])
                if target_path.exists() or target_path.is_symlink():
                    try:
                        target_path.unlink()
                    except OSError:
                        pass

    db.data["packages"] = target_pkgs
    db.save()
    print(f"[+] rolled back system packages to generation {target_id} ({len(target_pkgs)} packages)")


def cmd_hold(args: argparse.Namespace) -> None:
    holds = load_holds(args.paths)
    for pkg in args.package:
        holds.add(pkg)
        log(f"holding package {pkg}")
    save_holds(args.paths, holds)
    print(f"[+] held {len(args.package)} package(s)")


def cmd_unhold(args: argparse.Namespace) -> None:
    holds = load_holds(args.paths)
    for pkg in args.package:
        holds.discard(pkg)
        log(f"unholding package {pkg}")
    save_holds(args.paths, holds)
    print(f"[+] unheld {len(args.package)} package(s)")


def load_pins(paths: Paths) -> dict[str, str]:
    if not paths.pins.is_file():
        return {}
    pins: dict[str, str] = {}
    for line in paths.pins.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            k, v = line.split("=", 1)
            pins[k.strip()] = v.strip().strip('"\'')
    return pins


def cmd_pin(args: argparse.Namespace) -> None:
    pins = load_pins(args.paths)
    for spec in args.package:
        if "=" in spec:
            pkg, ver = spec.split("=", 1)
            pins[pkg.strip()] = ver.strip()
            log(f"pinned {pkg.strip()} to version {ver.strip()}")
        else:
            die("pin format must be package=version (e.g. openssl=3.0.0)")
    args.paths.pins.parent.mkdir(parents=True, exist_ok=True)
    lines = ["# /etc/garb/pins.conf - Pinned package versions"] + [f"{k} = {v}" for k, v in sorted(pins.items())]
    args.paths.pins.write_text("\n".join(lines) + "\n", encoding="utf-8")
    print(f"[+] pinned {len(args.package)} package(s)")


def cmd_downgrade(args: argparse.Namespace) -> None:
    paths = args.paths
    pkg = args.package
    version = args.version
    db = Database(paths)
    installed = db.installed(pkg)
    if not installed:
        die(f"package {pkg} is not installed")
    log(f"downgrading {pkg} from {installed.get('version')} to {version}")

    archive = None
    for candidate in paths.cache.glob(f"**/{pkg}-{version}*.garb"):
        if candidate.is_file():
            archive = candidate
            break

    if not archive:
        index = load_indexes(paths)
        entry = index.get(pkg)
        if entry and str(entry.get("version")) == version:
            archive = fetch_archive(paths, pkg, entry)

    if not archive:
        die(f"archive for {pkg}={version} not found in cache or repositories")

    staging = Path(tempfile.mkdtemp(prefix="garb-stage-", dir=paths.tmp))
    try:
        metadata, _members = extract_staged(archive, staging)
        entry_db = commit_package(paths, staging, metadata, archive)
        db.add(pkg, entry_db)
        db.save()
        print(f"[+] {pkg} downgraded to {version}")
    finally:
        shutil.rmtree(staging, ignore_errors=True)


def cmd_mirror_rank(args: argparse.Namespace) -> None:
    repos = read_repo_configs(args.paths)
    results = []
    for r in repos:
        name = r.get("name", "repo")
        url = r.get("url", "")
        start = time.time()
        status = "ok"
        try:
            if url.startswith(("http://", "https://")):
                req = urllib.request.Request(url, headers={"User-Agent": f"garb/{VERSION}"})
                with urllib.request.urlopen(req, timeout=args.timeout):
                    pass
            latency_ms = round((time.time() - start) * 1000, 2)
        except Exception:
            latency_ms = 9999.0
            status = "unreachable"

        results.append({
            "name": name,
            "url": url,
            "latency_ms": latency_ms,
            "status": status,
        })

    results.sort(key=lambda x: x["latency_ms"])
    if getattr(args, "format", "text") == "json":
        print(json.dumps(results, indent=2))
    else:
        print("=" * 60)
        print("Grintion Mirror Latency Ranking")
        print("=" * 60)
        for idx, m in enumerate(results, start=1):
            print(f"[{idx}] {m['name']} ({m['url']}) - {m['latency_ms']} ms [{m['status']}]")
        print("=" * 60)




































def build_parser() -> argparse.ArgumentParser:
    default_backend = os.environ.get("GARB_BACKEND", "auto")
    if default_backend not in ("auto", "native", "pacman", "apk"):
        default_backend = "auto"
    parser = argparse.ArgumentParser(
        prog="garb",
        description="Grintion-OS package manager 1.0",
        epilog=("When pacman or apk is installed, install/remove/update/search/info/"
                "verify/upgrade are delegated to it. Use --backend native to force "
                "garb's own signed-repository implementation."),
    )
    parser.add_argument("--root", default="/", help="target filesystem root (default: /)")
    parser.add_argument(
        "--backend",
        choices=("auto", "native", "pacman", "apk"),
        default=default_backend,
        help="package backend (default: auto; GARB_BACKEND also sets it)",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("version").set_defaults(func=cmd_version)

    update = sub.add_parser("update", help="fetch and verify repository indexes")
    update.add_argument("--key", help="override the trusted public key")
    update.add_argument("--allow-unsigned", action="store_true")
    update.set_defaults(func=cmd_update)

    search = sub.add_parser("search", help="search available and installed packages")
    search.add_argument("query")
    search.set_defaults(func=cmd_search)

    info = sub.add_parser("info", help="show package details")
    info.add_argument("package")
    info.add_argument("--installed", action="store_true", help="only report installed packages")
    info.set_defaults(func=cmd_info)

    install = sub.add_parser("install", help="install packages")
    install.add_argument("package", nargs="+")
    install.add_argument("--upgrade", action="store_true")
    install.add_argument("--force", action="store_true")
    install.set_defaults(func=cmd_install)

    remove = sub.add_parser("remove", help="remove packages")
    remove.add_argument("package", nargs="+")
    remove.add_argument("--force", action="store_true")
    remove.set_defaults(func=cmd_remove)

    verify = sub.add_parser("verify", help="verify installed file hashes")
    verify.add_argument("package", nargs="*")
    verify.add_argument("--quick", action="store_true")
    verify.add_argument("--format", choices=("text", "json"), default="text", help="output format")
    verify.set_defaults(func=cmd_verify)

    upgrade = sub.add_parser("upgrade", help="upgrade installed packages")
    upgrade.add_argument("package", nargs="*")
    upgrade.add_argument("--no-snapshot", action="store_true", help="skip the Btrfs pre-upgrade snapshot")
    upgrade.set_defaults(func=cmd_upgrade)

    listing = sub.add_parser("list", help="list installed packages")
    listing_group = listing.add_mutually_exclusive_group()
    listing_group.add_argument("--upgradable", action="store_true", help="only packages with a newer index version")
    listing_group.add_argument("--available", action="store_true", help="list repository packages instead")
    listing.set_defaults(func=cmd_list)

    clean = sub.add_parser("clean", help="remove cached repository indexes and downloads")
    clean.set_defaults(func=cmd_clean)

    history = sub.add_parser("history", help="show the transaction journal")
    history.add_argument("--format", choices=("text", "json"), default="text")
    history.add_argument("--limit", type=int, default=20, help="show the last N records (0 = all)")
    history.set_defaults(func=cmd_history)

    fsck = sub.add_parser("fsck", help="check the package database and installed files")
    fsck.add_argument("--format", choices=("text", "json"), default="text")
    fsck.add_argument("--hash", action="store_true", help="re-hash every installed file")
    fsck.set_defaults(func=cmd_fsck)

    build = sub.add_parser("build", help="build one .garb from a Garbfile")
    build.add_argument("manifest")
    build.add_argument("-o", "--output", default="dist")
    build.set_defaults(func=cmd_build)

    repo_build = sub.add_parser("repo-build", help="build every Garbfile in a directory")
    repo_build.add_argument("directory")
    repo_build.add_argument("output")
    repo_build.set_defaults(func=cmd_repo_build)

    repo_index = sub.add_parser("repo-index", help="write and optionally sign a repository index")
    repo_index.add_argument("directory")
    repo_index.add_argument("--key")
    repo_index.add_argument(
        "--valid-days", type=int, default=30,
        help="days before the signed index expires (default: 30; maximum: 90)",
    )
    repo_index.add_argument(
        "--index-version", type=int,
        help="monotonic index version (default: current Unix time)",
    )
    repo_index.set_defaults(func=cmd_repo_index)

    keygen = sub.add_parser("keygen", help="create an Ed25519 repository key pair")
    keygen.add_argument("directory")
    keygen.set_defaults(func=cmd_keygen)

    sign_index = sub.add_parser("sign-index", help="sign an existing index.json")
    sign_index.add_argument("index")
    sign_index.add_argument("--key", required=True)
    sign_index.set_defaults(func=cmd_sign_index)

    gens = sub.add_parser("generations", help="list package generations")
    gens.add_argument("--format", choices=("text", "json"), default="text")
    gens.set_defaults(func=cmd_generations)

    rb_gen = sub.add_parser("rollback-generation", help="roll back package state to a previous generation")
    rb_gen.add_argument("generation", type=int, help="generation ID to restore")
    rb_gen.set_defaults(func=cmd_rollback_generation)

    hold_p = sub.add_parser("hold", help="hold packages to prevent automatic upgrades")
    hold_p.add_argument("package", nargs="+")
    hold_p.set_defaults(func=cmd_hold)

    unhold_p = sub.add_parser("unhold", help="remove hold on packages")
    unhold_p.add_argument("package", nargs="+")
    unhold_p.set_defaults(func=cmd_unhold)

    pin_p = sub.add_parser("pin", help="pin package to specific version (e.g. openssl=3.0.0)")
    pin_p.add_argument("package", nargs="+")
    pin_p.set_defaults(func=cmd_pin)

    down_p = sub.add_parser("downgrade", help="downgrade a package to a specific version")
    down_p.add_argument("package")
    down_p.add_argument("version")
    down_p.set_defaults(func=cmd_downgrade)

    mirror_p = sub.add_parser("mirror-rank", help="measure repository mirror latencies")
    mirror_p.add_argument("--format", choices=("text", "json"), default="text")
    mirror_p.add_argument("--timeout", type=int, default=5)
    mirror_p.set_defaults(func=cmd_mirror_rank)

    dcreate_p = sub.add_parser("delta-create", help="create a delta update between two .garb packages")
    dcreate_p.add_argument("--old", required=True)
    dcreate_p.add_argument("--new", required=True)
    dcreate_p.add_argument("--out", required=True)
    dcreate_p.set_defaults(func=cmd_delta_create)

    dapply_p = sub.add_parser("delta-apply", help="apply a delta update onto an old .garb package")
    dapply_p.add_argument("--old", required=True)
    dapply_p.add_argument("--delta", required=True)
    dapply_p.add_argument("--out", required=True)
    dapply_p.add_argument("--index", required=True, help="signed repository index.json")
    dapply_p.add_argument("--key", required=True, help="trusted Ed25519 public key (PEM)")
    dapply_p.add_argument("--package", help="package name (default: from delta metadata)")
    dapply_p.set_defaults(func=cmd_delta_apply)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    try:
        backend = args.backend
        # A local .garb archive cannot be handed to pacman/apk; native garb is
        # the only implementation that understands the format.
        if args.command == "install" and any(Path(spec).is_file() for spec in args.package):
            if backend not in ("auto", "native"):
                raise GarbError("local .garb archives require the native backend")
            backend = "native"
        if args.command in EXTERNAL_COMMANDS and backend != "native":
            # Auto-detection is limited to the running system. A staging root
            # must opt in explicitly so tests and image builds never invoke the
            # host's package manager by accident.
            if backend == "auto" and Path(args.root) != Path("/"):
                backend = "native"
            if backend != "native":
                found = external_backend_binary(backend)
                if found is None:
                    if backend == "auto":
                        raise GarbError(
                            "no supported package backend found (pacman or apk); "
                            "use --backend native"
                        )
                    raise GarbError(f"{backend} backend requested but not installed")
                backend_name, binary = found
                backend_version(backend_name, binary)
                return run_external_backend(backend_name, binary, args)
        args.paths = Paths(Path(args.root))
        if args.command in MUTATING_COMMANDS:
            with TransactionLock(args.paths, args.command):
                txid = f"{int(time.time())}-{os.getpid()}-{secrets.token_hex(4)}"
                base = {
                    "schema": 1,
                    "txid": txid,
                    "time": int(time.time()),
                    "root": str(args.paths.root),
                    "command": args.command,
                    "packages": list(getattr(args, "package", []) or []),
                    "garb_version": VERSION,
                }
                journal_append(args.paths, {**base, "status": "started"})
                try:
                    args.func(args)
                except BaseException as exc:
                    journal_append(args.paths, {
                        **base,
                        "status": "rolled-back",
                        "error": f"{type(exc).__name__}: {exc}",
                    })
                    raise
                else:
                    journal_append(args.paths, {**base, "status": "committed"})
                    pkg_str = " ".join(getattr(args, "package", []) or []) if isinstance(getattr(args, "package", None), list) else str(getattr(args, "package", "") or "")
                    record_generation(args.paths, f"{args.command} {pkg_str}".strip())
        else:
            args.func(args)
    except GarbError as exc:
        die(str(exc))
    except (OSError, ValueError, KeyError, tarfile.TarError, subprocess.CalledProcessError) as exc:
        die(str(exc))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
