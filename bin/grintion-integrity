#!/usr/bin/env python3
"""grintion-integrity - file integrity checker and baseline manager.

The baseline records mode, ownership and size in addition to SHA-256. Hash-only
checking misses privilege escalation through a new setuid bit on an otherwise
unchanged binary, which is exactly the change a rootkit wants to hide.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import stat
import sys
import tempfile
from pathlib import Path

DEFAULT_DB = Path(os.environ.get("GRINTION_INTEGRITY_DB", "/var/lib/aide/integrity-baseline.json"))
MONITORED_PATHS = [
    Path("/bin"),
    Path("/sbin"),
    Path("/usr/bin"),
    Path("/usr/sbin"),
    Path("/etc/grintion"),
    Path("/etc/pam.d"),
    Path("/etc/security"),
    Path("/etc/apparmor.d"),
    Path("/etc/garb/keys"),
    Path("/etc/sudoers"),
    Path("/etc/sudoers.d"),
    Path("/etc/shadow"),
    Path("/etc/passwd"),
    Path("/etc/group"),
    Path("/etc/nftables.conf"),
    Path("/boot"),
]
SUID_BITS = stat.S_ISUID | stat.S_ISGID


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    try:
        with path.open("rb") as handle:
            while chunk := handle.read(65536):
                digest.update(chunk)
        return digest.hexdigest()
    except OSError:
        return ""


def mode_bits(value: object) -> int | None:
    """Accept the old ``0o100644`` form and the compact ``0644`` form."""
    if isinstance(value, int):
        return stat.S_IMODE(value)
    if not isinstance(value, str) or not value:
        return None
    try:
        return stat.S_IMODE(int(value, 8))
    except ValueError:
        return None


def entry_for(path: Path) -> dict:
    info = path.lstat()
    digest = sha256_file(path)
    return {
        "hash": digest,
        "size": info.st_size,
        "mode": f"{stat.S_IMODE(info.st_mode):04o}",
        "uid": info.st_uid,
        "gid": info.st_gid,
        "mtime": info.st_mtime,
    }


def scan_paths(roots: list[Path]) -> dict[str, dict]:
    entries: dict[str, dict] = {}
    seen_roots: set[Path] = set()
    for root in roots:
        try:
            resolved = root.resolve(strict=True)
        except OSError:
            continue
        if resolved in seen_roots:
            continue
        seen_roots.add(resolved)
        if resolved.is_file() and not resolved.is_symlink():
            entries[str(resolved)] = entry_for(resolved)
        elif resolved.is_dir():
            for item in sorted(resolved.rglob("*")):
                if item.is_symlink() or not item.is_file():
                    continue
                try:
                    entries[str(item)] = entry_for(item)
                except OSError:
                    entries[str(item)] = {
                        "hash": "",
                        "size": -1,
                        "mode": "",
                        "uid": -1,
                        "gid": -1,
                        "mtime": 0,
                    }
    return entries


def atomic_write_baseline(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(path.parent, 0o700)
    except OSError:
        pass
    descriptor, temporary = tempfile.mkstemp(
        prefix=f".{path.name}.", suffix=".tmp", dir=path.parent
    )
    temporary_path = Path(temporary)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(data, handle, indent=2, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary_path, 0o600)
        os.replace(temporary_path, path)
    except BaseException:
        temporary_path.unlink(missing_ok=True)
        raise


def cmd_init(db_path: Path, paths: list[Path]) -> int:
    entries = scan_paths(paths)
    unreadable = sorted(path for path, meta in entries.items() if not meta["hash"])
    if unreadable:
        print(
            "Error: cannot hash every monitored file; refusing an incomplete baseline:",
            file=sys.stderr,
        )
        for path in unreadable[:20]:
            print(f"  {path}", file=sys.stderr)
        return 1
    data = {
        "schema": 2,
        "created": os.uname().nodename,
        "paths": [str(path) for path in paths],
        "entries": entries,
    }
    atomic_write_baseline(db_path, data)
    print(f"Integrity baseline initialized with {len(entries)} file records at {db_path}")
    return 0


def cmd_check(db_path: Path, paths: list[Path]) -> tuple[int, dict]:
    if not db_path.is_file():
        print(f"Error: Integrity baseline not found at {db_path}. Run 'init' first.", file=sys.stderr)
        return 2, {"status": "missing_db"}

    try:
        baseline = json.loads(db_path.read_text(encoding="utf-8"))
        if not isinstance(baseline, dict) or baseline.get("schema") not in (1, 2):
            raise ValueError("unsupported baseline schema")
        entries = baseline.get("entries")
        if not isinstance(entries, dict):
            raise ValueError("baseline has no entries object")
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        print(f"Error reading baseline database: {exc}", file=sys.stderr)
        return 2, {"status": "corrupt_db"}

    current = scan_paths(paths)

    added: list[str] = []
    removed: list[str] = []
    modified: list[str] = []
    mode_changed: list[str] = []
    privilege_changed: list[str] = []
    size_changed: list[str] = []

    for path, meta in current.items():
        previous = entries.get(path)
        if previous is None:
            added.append(path)
            current_mode = mode_bits(meta.get("mode"))
            if current_mode is not None and current_mode & SUID_BITS:
                privilege_changed.append(path)
            continue
        if meta.get("hash") != previous.get("hash"):
            modified.append(path)
        if meta.get("size") != previous.get("size"):
            size_changed.append(path)
        expected_mode = mode_bits(previous.get("mode"))
        actual_mode = mode_bits(meta.get("mode"))
        if expected_mode is not None and actual_mode is not None:
            if actual_mode != expected_mode:
                mode_changed.append(path)
            if actual_mode & SUID_BITS and not expected_mode & SUID_BITS:
                privilege_changed.append(path)

    for path in entries:
        if path not in current:
            removed.append(path)

    changed = bool(
        added or removed or modified or mode_changed or privilege_changed or size_changed
    )
    report = {
        "status": "tampered" if changed else "clean",
        "added": sorted(added),
        "removed": sorted(removed),
        "modified": sorted(modified),
        "mode_changed": sorted(mode_changed),
        "privilege_changed": sorted(set(privilege_changed)),
        "size_changed": sorted(size_changed),
        "total_monitored": len(current),
    }
    return (1 if changed else 0), report


def main() -> int:
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--db", help="Path to baseline database file")
    common.add_argument("--path", action="append", help="Custom path to monitor (can repeat)")
    common.add_argument("--json", action="store_true", help="Output results in JSON")

    parser = argparse.ArgumentParser(
        prog="grintion-integrity",
        parents=[common],
        description="Verify system binary integrity and detect file tampering.",
    )
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("init", parents=[common], help="Create new cryptographic file integrity baseline")
    sub.add_parser("check", parents=[common], help="Verify current files against integrity baseline")
    sub.add_parser("update", parents=[common], help="Update integrity baseline with current files")

    args = parser.parse_args()

    db_path = Path(args.db) if getattr(args, "db", None) else DEFAULT_DB
    paths = [Path(p) for p in args.path] if getattr(args, "path", None) else MONITORED_PATHS

    if args.command in ("init", "update"):
        return cmd_init(db_path, paths)

    if args.command == "check":
        code, report = cmd_check(db_path, paths)
        if getattr(args, "json", False):
            print(json.dumps(report, indent=2))
        else:
            if code == 0:
                print(f"[ ok ] All {report['total_monitored']} monitored files match baseline.")
            else:
                print("[FAIL] System integrity check failed! Modifications detected:")
                for path in report.get("modified", []):
                    print(f"  [MODIFIED] {path}")
                for path in report.get("mode_changed", []):
                    print(f"  [MODE]     {path}")
                for path in report.get("privilege_changed", []):
                    print(f"  [PRIVILEGE]{path}")
                for path in report.get("added", []):
                    print(f"  [ADDED]    {path}")
                for path in report.get("removed", []):
                    print(f"  [REMOVED]  {path}")
        return code

    parser.print_help()
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
