#!/bin/sh
# limine-deploy - install Limine on an already-mounted target ESP.
# grintion-install is the supported path; this helper exists for manual setups.

set -eu

EFI_DIR=""
DISK_DEV=""
ROOT_UUID=""

while [ $# -gt 0 ]; do
    case "$1" in
        --efi)       EFI_DIR=${2:-}; shift 2 ;;
        --disk)      DISK_DEV=${2:-}; shift 2 ;;
        --root-uuid) ROOT_UUID=${2:-}; shift 2 ;;
        -h|--help)
            echo "Usage: limine-deploy --efi <esp> [--disk <dev>] [--root-uuid <uuid>]"
            exit 0
            ;;
        *) echo "unknown option: $1" >&2; exit 1 ;;
    esac
done

[ -n "$EFI_DIR" ] || { echo "[-] --efi is required" >&2; exit 1; }
[ -d "$EFI_DIR" ] || { echo "[-] not a directory: $EFI_DIR" >&2; exit 1; }
[ -n "$ROOT_UUID" ] || { echo "[-] --root-uuid is required" >&2; exit 1; }

mkdir -p "$EFI_DIR/EFI/BOOT" "$EFI_DIR/EFI/grintion"
for asset in limine-bios.sys BOOTX64.EFI BOOTAA64.EFI; do
    [ -f "/usr/share/limine/$asset" ] || { echo "[-] missing asset: $asset" >&2; exit 1; }
    cp "/usr/share/limine/$asset" "$EFI_DIR/EFI/BOOT/$asset"
done
mv "$EFI_DIR/EFI/BOOT/limine-bios.sys" "$EFI_DIR/limine-bios.sys"

cat > "$EFI_DIR/limine.conf" <<EOF
timeout: 5
interface_branding: Grintion-OS

/Grintion-OS
    protocol: linux
    kernel_path: boot():/EFI/grintion/vmlinuz-grintion
    cmdline: root=UUID=$ROOT_UUID rw quiet console=tty0 console=ttyS0,115200 grintion.serial=1
    module_path: boot():/EFI/grintion/initramfs-install.img
EOF
cp "$EFI_DIR/limine.conf" "$EFI_DIR/EFI/BOOT/limine.conf"

if [ -n "$DISK_DEV" ] && [ -b "$DISK_DEV" ]; then
    [ -x /usr/share/limine/limine ] || { echo "[-] limine binary missing" >&2; exit 1; }
    /usr/share/limine/limine bios-install "$DISK_DEV"
fi

echo "[+] Limine deployed to $EFI_DIR"
