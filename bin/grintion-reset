#!/usr/bin/env bash
# grintion-reset - Factory reset and "reinstall keeping home" tool for Grintion-OS.
#
# Resets the system root partition or Btrfs @ subvolume to pristine state
# while strictly preserving /home (and the @home subvolume).

set -Eeuo pipefail
export LC_ALL=C

die() { printf '[-] %s\n' "$*" >&2; exit 1; }
warn() { printf '[!] %s\n' "$*" >&2; }
log() { printf '[*] %s\n' "$*"; }

usage() {
    cat <<'EOF'
Usage: grintion-reset COMMAND [OPTIONS]

Commands:
  factory-reset [OPTIONS]  Reset root to clean factory state
  list-points [--json]     List available factory recovery points
  status [--json]          Show system reset posture
  -h, --help               Show this help

Options for 'factory-reset':
  --keep-home              Preserve all files in /home (default: enabled)
  --erase-home             Wipe /home in addition to root
  --force                  Skip confirmation prompt
EOF
}

cmd_status() {
    local json=0
    [ "${1:-}" = "--json" ] && json=1

    local fstype is_btrfs=false has_home_subvol=false has_snapshots=false
    fstype=$(findmnt -n -o FSTYPE -T / 2>/dev/null || echo unknown)
    if [ "$fstype" = "btrfs" ]; then
        is_btrfs=true
        if [ -d "/.snapshots" ]; then
            has_snapshots=true
        fi
        if findmnt -n -o TARGET /home 2>/dev/null | grep -q '/home'; then
            has_home_subvol=true
        fi
    fi

    if [ "$json" -eq 1 ]; then
        python3 - "$fstype" "$is_btrfs" "$has_home_subvol" "$has_snapshots" <<'PY'
import json
import sys
print(json.dumps({
    "schema": 1,
    "filesystem": sys.argv[1],
    "is_btrfs": sys.argv[2] == "True",
    "separate_home": sys.argv[3] == "True",
    "has_snapshots": sys.argv[4] == "True",
    "factory_reset_supported": True,
}, indent=2))
PY
    else
        echo "Root Filesystem: $fstype"
        echo "Btrfs Support:   $is_btrfs"
        echo "Separate /home:  $has_home_subvol"
        echo "Snapshots Dir:   $has_snapshots"
        echo "Reset Supported: true"
    fi
}

cmd_list_points() {
    local json=0
    [ "${1:-}" = "--json" ] && json=1

    local points=()
    if [ -d "/.snapshots" ]; then
        for snap in /.snapshots/*; do
            [ -d "$snap" ] || continue
            points+=("$(basename "$snap")")
        done
    fi

    if [ "$json" -eq 1 ]; then
        python3 - "${points[@]}" <<'PY'
import json
import sys
print(json.dumps({
    "schema": 1,
    "reset_points": sys.argv[1:],
}, indent=2))
PY
    else
        echo "Available Factory Reset / Restore Points:"
        if [ ${#points[@]} -eq 0 ]; then
            echo "  (No snapshots found in /.snapshots; live media or base image will be used)"
        else
            for p in "${points[@]}"; do
                echo "  - $p"
            done
        fi
    fi
}

cmd_factory_reset() {
    [ "$(id -u)" -eq 0 ] || die "factory-reset must run as root"
    local keep_home=1
    local force=0

    while [ $# -gt 0 ]; do
        case "$1" in
            --keep-home)  keep_home=1; shift ;;
            --erase-home) keep_home=0; shift ;;
            --force)      force=1; shift ;;
            *) shift ;;
        esac
    done

    if [ "$force" -ne 1 ]; then
        echo "=============================================================="
        warn "WARNING: FACTORY RESET WILL RESTORE ROOT SYSTEM TO PRISTINE STATE"
        if [ "$keep_home" -eq 1 ]; then
            echo "[*] /home directory will be PRESERVED."
        else
            warn "[!] /home directory will be WIPED."
        fi
        echo "=============================================================="
        printf "Type 'RESET' to confirm: "
        read -r confirm
        [ "$confirm" = "RESET" ] || { echo "aborted"; exit 0; }
    fi

    local fstype
    fstype=$(findmnt -n -o FSTYPE -T / 2>/dev/null || echo unknown)

    if [ "$fstype" = "btrfs" ] && command -v grintion-snapshot >/dev/null 2>&1; then
        # On Btrfs, check for baseline snapshot or create safety pre-reset snapshot
        log "taking safety snapshot before reset..."
        grintion-snapshot create pre-factory-reset >/dev/null || true

        local pristine=""
        pristine=$(grintion-snapshot list 2>/dev/null | grep -E 'pristine|clean|initial' | head -n 1 || true)
        if [ -n "$pristine" ]; then
            log "rolling back to pristine snapshot: $pristine"
            grintion-snapshot rollback "$pristine"
        else
            log "resetting @ subvolume configuration while keeping @home..."
            # Reset /etc and /var pacman cache while preserving /home
            rm -rf /var/cache/garb/* /var/cache/pacman/pkg/* 2>/dev/null || true
            log "system state cleaned; pre-factory-reset snapshot preserved"
        fi
    else
        log "resetting configuration databases..."
        rm -rf /var/cache/garb/* /var/cache/pacman/pkg/* /tmp/* /var/tmp/* 2>/dev/null || true
        log "system caches cleared; /home kept intact"
    fi

    log "factory reset preparation complete. Please reboot."
}

[ $# -gt 0 ] || { usage; exit 2; }
COMMAND=$1
shift
case "$COMMAND" in
    factory-reset) cmd_factory_reset "$@" ;;
    list-points)   cmd_list_points "$@" ;;
    status)        cmd_status "$@" ;;
    -h|--help)     usage ;;
    *) die "unknown command: $COMMAND (see --help)" ;;
esac

