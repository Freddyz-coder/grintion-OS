#!/usr/bin/env python3
"""Keep virtual-machine pointer devices from fighting over the cursor.

QEMU, libvirt and VirtualBox can expose both a relative PS/2 mouse and an
absolute USB tablet. Xorg/XFCE and KWin then receive two pointer streams: the
relative device accelerates and drifts while the absolute tablet jumps to the
host position. The result is the classic "two cursors" or desynchronised mouse
behaviour in a VM.

When an absolute pointer is present, write a small udev rule that marks every
relative pointer with LIBINPUT_IGNORE_DEVICE=1. libinput, Xorg's libinput
driver, KWin and wlroots compositors all honour that property, so only the
absolute tablet remains. When no absolute pointer exists, remove the rule and
leave the relative mouse alone.
"""
from __future__ import annotations

import argparse
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

DEVICES = Path(os.environ.get("GRINTION_INPUT_DEVICES", "/proc/bus/input/devices"))
RULES_DIR = Path(os.environ.get("GRINTION_UDEV_RULES_DIR", "/run/udev/rules.d"))
RULE_NAME = "99-grintion-pointer-sync.rules"
MARKER = Path(os.environ.get("GRINTION_POINTER_MARKER", "/run/grintion/absolute-pointer"))


def parse_devices(text: str) -> list[dict[str, object]]:
    devices: list[dict[str, object]] = []
    current: dict[str, object] | None = None
    for line in text.splitlines():
        if line.startswith("I: "):
            if current is not None:
                devices.append(current)
            current = {"name": "", "event": "", "key": False, "rel": False, "abs": False}
            continue
        if current is None:
            continue
        if line.startswith("N: Name="):
            current["name"] = line.split("=", 1)[1].strip().strip('"')
        elif line.startswith("H: Handlers="):
            for token in line.split("=", 1)[1].split():
                if re.fullmatch(r"event\d+", token):
                    current["event"] = token
        elif line.startswith("B: KEY="):
            current["key"] = bool(re.search(r"=(?!0+\s*$)[0-9a-fA-F]+", line))
        elif line.startswith("B: REL="):
            current["rel"] = bool(re.search(r"=(?!0+\s*$)[0-9a-fA-F]+", line))
        elif line.startswith("B: ABS="):
            current["abs"] = bool(re.search(r"=(?!0+\s*$)[0-9a-fA-F]+", line))
    if current is not None:
        devices.append(current)
    return [device for device in devices if device["event"]]


def udev_escape(value: str) -> str:
    return value.replace("\\", "\\\\").replace('"', '\\"')


def render_rule(relative_names: list[str]) -> str:
    lines = [
        "# Generated by grintion-pointer-sync. Do not edit by hand.",
        "# A VM absolute tablet is present; ignore the duplicate relative mouse.",
    ]
    for name in sorted(set(relative_names)):
        lines.append(
            'ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", '
            f'ATTRS{{name}}=="{udev_escape(name)}", '
            'ENV{LIBINPUT_IGNORE_DEVICE}="1"'
        )
    return "\n".join(lines) + "\n"


def write_rule(rule_text: str | None) -> Path:
    RULES_DIR.mkdir(parents=True, exist_ok=True)
    target = RULES_DIR / RULE_NAME
    if rule_text is None:
        target.unlink(missing_ok=True)
        MARKER.unlink(missing_ok=True)
        return target
    temporary = target.with_name(target.name + ".tmp")
    temporary.write_text(rule_text, encoding="utf-8")
    temporary.chmod(0o644)
    temporary.replace(target)
    MARKER.parent.mkdir(parents=True, exist_ok=True)
    MARKER.write_text("absolute pointer present\n", encoding="utf-8")
    return target


def reload_udev() -> None:
    udevadm = shutil.which("udevadm")
    if udevadm is None:
        return
    for argv in (
        [udevadm, "control", "--reload-rules"],
        [udevadm, "trigger", "--subsystem-match=input", "--action=change"],
    ):
        subprocess.run(argv, check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main() -> int:
    parser = argparse.ArgumentParser(description="Align VM pointer devices for libinput")
    parser.add_argument("--dry-run", action="store_true", help="print the rule without writing it")
    parser.add_argument("--no-reload", action="store_true", help="write the rule but do not trigger udev")
    args = parser.parse_args()

    try:
        text = DEVICES.read_text(encoding="utf-8", errors="replace")
    except OSError as exc:
        print(f"[-] cannot read {DEVICES}: {exc}", file=sys.stderr)
        return 1

    devices = parse_devices(text)
    # A mouse also has KEY bits for its buttons, so KEY cannot be used to
    # identify a keyboard. A pointer is a device with relative or absolute
    # axes; keyboards have neither.
    absolute = [d for d in devices if d["abs"]]
    relative = [d for d in devices if d["rel"] and not d["abs"]]
    if absolute:
        rule: str | None = render_rule([str(d["name"]) for d in relative])
        print(
            f"[+] absolute pointer present ({absolute[0]['name']}); "
            f"ignoring {len(relative)} relative pointer(s)"
        )
    else:
        rule = None
        if relative:
            names = ", ".join(str(d["name"]) for d in relative)
            print(f"[-] no absolute pointer; keeping relative pointer(s): {names}")
        else:
            print("[-] no pointer device found")

    if args.dry_run:
        if rule:
            sys.stdout.write(rule)
        else:
            print("(no rule)")
        return 0

    target = write_rule(rule)
    if not args.no_reload:
        reload_udev()
    print(f"[+] pointer rule: {target}" if rule else "[+] pointer rule removed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
