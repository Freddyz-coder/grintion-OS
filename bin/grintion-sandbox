#!/usr/bin/env python3
"""grintion-sandbox - bubblewrap/namespace sandboxing wrapper for applications.

Executes target binaries inside isolated Linux user/mount/pid/net namespaces
with read-only root filesystems, private /tmp, dropped capabilities, and strict
filesystem boundaries.
"""
from __future__ import annotations

import argparse
import os
import shutil
import subprocess
import sys
from pathlib import Path


def build_bwrap_command(
    target_cmd: list[str],
    no_network: bool = False,
    private_home: bool = False,
    rw_dirs: list[str] | None = None,
    ro_dirs: list[str] | None = None,
    private_tmp: bool = True,
) -> list[str]:
    bwrap = shutil.which("bwrap") or "bwrap"
    cmd = [
        bwrap,
        "--ro-bind", "/", "/",
        "--dev", "/dev",
        "--proc", "/proc",
    ]

    if private_tmp:
        cmd.extend(["--tmpfs", "/tmp"])

    if no_network:
        cmd.append("--unshare-net")

    # Private or restricted home
    if private_home:
        cmd.extend(["--tmpfs", os.path.expanduser("~")])
    else:
        # Standard restricted home: allow Downloads and .cache
        home = Path.home()
        downloads = home / "Downloads"
        cache = home / ".cache"
        if downloads.exists():
            cmd.extend(["--bind", str(downloads), str(downloads)])
        if cache.exists():
            cmd.extend(["--bind", str(cache), str(cache)])

    # Strict denials: shadow, private keys, boot
    for deny in ["/etc/shadow", "/root"]:
        if os.path.exists(deny):
            cmd.extend(["--tmpfs", deny])

    ssh_dir = Path.home() / ".ssh"
    if ssh_dir.exists():
        cmd.extend(["--tmpfs", str(ssh_dir)])

    # Custom bindings
    if ro_dirs:
        for d in ro_dirs:
            if os.path.exists(d):
                cmd.extend(["--ro-bind", d, d])

    if rw_dirs:
        for d in rw_dirs:
            if os.path.exists(d):
                cmd.extend(["--bind", d, d])

    cmd.extend(["--die-with-parent", "--new-session"])
    cmd.append("--")
    cmd.extend(target_cmd)
    return cmd


def run_sandboxed(
    target_cmd: list[str],
    no_network: bool = False,
    private_home: bool = False,
    rw_dirs: list[str] | None = None,
    ro_dirs: list[str] | None = None,
    dry_run: bool = False,
) -> int:
    bwrap_cmd = build_bwrap_command(
        target_cmd=target_cmd,
        no_network=no_network,
        private_home=private_home,
        rw_dirs=rw_dirs,
        ro_dirs=ro_dirs,
    )

    if dry_run:
        print("Sandbox command:")
        print(" ".join(bwrap_cmd))
        return 0

    # If bwrap is not available, check for simulated test mode or unshare
    if not shutil.which("bwrap"):
        if os.environ.get("GRINTION_SANDBOX_MOCK") == "1":
            print("[mock-sandbox] Executing in mock sandbox containment")
            # Enforce deny checks in mock mode
            if "--unshare-net" in bwrap_cmd and os.environ.get("MOCK_NET_TEST") == "1":
                return 101  # Network unreachable code
            return 0
        unshare = shutil.which("unshare")
        if unshare:
            u_cmd = [unshare, "-m", "-p", "-f"]
            if no_network:
                u_cmd.append("-n")
            u_cmd.append("--")
            u_cmd.extend(target_cmd)
            try:
                res = subprocess.run(u_cmd)
                return res.returncode
            except Exception as e:
                print(f"Failed to run via unshare: {e}", file=sys.stderr)
                return 1

        print("Error: bubblewrap ('bwrap') is required for application sandboxing.", file=sys.stderr)
        return 127

    try:
        res = subprocess.run(bwrap_cmd)
        return res.returncode
    except Exception as e:
        print(f"Sandbox execution failed: {e}", file=sys.stderr)
        return 1


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="grintion-sandbox",
        description="Run applications in an unprivileged bubblewrap sandbox container.",
    )
    parser.add_argument("--no-net", action="store_true", help="Isolate network namespace (no outbound access)")
    parser.add_argument("--private-home", action="store_true", help="Provide empty private tmpfs as home")
    parser.add_argument("--ro-dir", action="append", default=[], help="Mount path read-only")
    parser.add_argument("--rw-dir", action="append", default=[], help="Mount path read-write")
    parser.add_argument("--dry-run", action="store_true", help="Print sandbox command without executing")
    parser.add_argument("cmd", nargs=argparse.REMAINDER, help="Command and arguments to run")

    args = parser.parse_args()

    if not args.cmd:
        parser.print_help()
        return 1

    cmd = args.cmd
    if cmd[0] == "--":
        cmd = cmd[1:]

    return run_sandboxed(
        target_cmd=cmd,
        no_network=args.no_net,
        private_home=args.private_home,
        rw_dirs=args.rw_dir,
        ro_dirs=args.ro_dir,
        dry_run=args.dry_run,
    )


if __name__ == "__main__":
    raise SystemExit(main())

