#!/usr/bin/env python3
"""grintion-firewall - additive deny rules on top of the Grintion firewall.

The security profiles own the main ruleset. This tool manages a separate
`inet grintion_blocklist` table that can only add drops, so it never weakens a
profile. Rules are stored as JSON, rendered to nftables syntax, validated with
`nft -c` and loaded with `nft -f`.

Subcommands:
  status    live table, rendered file, service state and entry count
  list      configured block entries
  block     drop a port or address in one or both directions
  unblock   remove an entry by id or by its target
  flush     remove every entry
  apply     render, validate and load the table now
  test      validate the rendered rules without loading them
  logs      show the firewall service log

Specs accepted by block:
  23            TCP+UDP port 23
  23/tcp        TCP port 23
  10.0.0.0/8    IPv4 source/destination
  2001:db8::/32 IPv6 source/destination
"""
from __future__ import annotations

import argparse
import ipaddress
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

TABLE = "inet grintion_blocklist"


def root_path(path: str) -> Path:
    prefix = os.environ.get("GRINTION_ROOT", "").rstrip("/")
    if prefix:
        return Path(f"{prefix}/{path.lstrip('/')}")
    return Path(path)


def state_file() -> Path:
    override = os.environ.get("GRINTION_FIREWALL_STATE")
    return Path(override) if override else root_path("/etc/grintion/firewall.blocklist.json")


def rules_file() -> Path:
    override = os.environ.get("GRINTION_FIREWALL_RULES")
    return Path(override) if override else root_path("/etc/grintion/firewall.blocklist.nft")


def log_file() -> Path:
    override = os.environ.get("GRINTION_FIREWALL_LOG")
    return Path(override) if override else root_path("/var/log/firewall.log")


def run(cmd: list[str], timeout: int = 20) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, check=False)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return subprocess.CompletedProcess(cmd, 127, "", str(exc))


def require_root(action: str, dry_run: bool) -> bool:
    if dry_run or os.environ.get("GRINTION_ROOT") or os.environ.get("GRINTION_FIREWALL_STATE"):
        return True
    if hasattr(os, "geteuid") and os.geteuid() == 0:
        return True
    print(f"grintion-firewall: {action} requires root; rerun with sudo", file=sys.stderr)
    return False


def load_state() -> dict:
    path = state_file()
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        entries = data.get("entries", [])
        if not isinstance(entries, list):
            raise ValueError("entries is not a list")
        return {"schema": 1, "entries": entries}
    except FileNotFoundError:
        return {"schema": 1, "entries": []}
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        print(f"grintion-firewall: cannot read {path}: {exc}", file=sys.stderr)
        raise SystemExit(2)


def save_state(state: dict) -> None:
    path = state_file()
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + ".tmp")
    temporary.write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")
    os.chmod(temporary, 0o644)
    os.replace(temporary, path)


def parse_spec(spec: str, proto_option: str | None) -> dict:
    text = spec.strip()
    protocol = proto_option or "any"
    if "/" in text and text.rsplit("/", 1)[1].lower() in ("tcp", "udp"):
        text, _, protocol = text.rpartition("/")
    if re.match(r"^\d+$", text):
        port = int(text)
        if not 1 <= port <= 65535:
            raise ValueError(f"port out of range: {port}")
        return {"kind": "port", "value": str(port), "protocol": protocol}
    try:
        network = ipaddress.ip_network(text, strict=False)
    except ValueError as exc:
        raise ValueError(f"{spec!r} is neither a port nor an address/CIDR") from exc
    return {"kind": "address", "value": str(network),
            "family": "ip" if network.version == 4 else "ip6",
            "protocol": "any"}


def render(state: dict) -> str:
    lines = [
        "# Generated by grintion-firewall. Do not edit; use the CLI.\n",
        f"table {TABLE} {{\n",
    ]
    for direction, hook in (("in", "input"), ("out", "output")):
        chosen = [entry for entry in state["entries"]
                  if entry["direction"] in (direction, "both")]
        lines.append(f"  chain {hook} {{\n")
        lines.append(f"    type filter hook {hook} priority 10; policy accept;\n")
        for entry in chosen:
            if entry["kind"] == "port":
                if entry["protocol"] in ("tcp", "udp"):
                    lines.append(f"    {entry['protocol']} dport {entry['value']} drop\n")
                else:
                    lines.append(f"    tcp dport {entry['value']} drop\n")
                    lines.append(f"    udp dport {entry['value']} drop\n")
            else:
                lines.append(f"    {entry.get('family', 'ip')} "
                             f"{'saddr' if direction == 'in' else 'daddr'} "
                             f"{entry['value']} drop\n")
        lines.append("  }\n")
    lines.append("}\n")
    return "".join(lines)


def write_rules(text: str) -> None:
    path = rules_file()
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + ".tmp")
    temporary.write_text(text, encoding="utf-8")
    os.chmod(temporary, 0o644)
    os.replace(temporary, path)


def nft_binary() -> str | None:
    return shutil.which("nft")


def validate(text: str) -> tuple[bool, str]:
    nft = nft_binary()
    if not nft:
        return False, "nft is not installed"
    path = rules_file()
    path.parent.mkdir(parents=True, exist_ok=True)
    probe = path.with_name(path.name + ".check")
    probe.write_text(text, encoding="utf-8")
    try:
        result = run([nft, "-c", "-f", str(probe)], timeout=30)
    finally:
        probe.unlink(missing_ok=True)
    detail = (result.stderr or result.stdout).strip()
    return result.returncode == 0, detail


def load_rules(text: str) -> tuple[bool, str]:
    nft = nft_binary()
    if not nft:
        return False, "nft is not installed"
    path = rules_file()
    write_rules(text)
    # A reload must replace the previous chains. Deleting the table first keeps
    # the load idempotent; an absent table is not an error.
    run([nft, "delete", "table", TABLE], timeout=15)
    result = run([nft, "-f", str(path)], timeout=30)
    return result.returncode == 0, (result.stderr or result.stdout).strip()


def table_loaded() -> bool | None:
    nft = nft_binary()
    if not nft:
        return None
    result = run([nft, "list", "table", TABLE], timeout=15)
    if result.returncode != 0 and "permitted" in (result.stderr or "").lower():
        return None
    return result.returncode == 0


def service_enabled() -> bool:
    path = root_path("/var/service/firewall")
    return path.exists() or path.is_symlink()


def cmd_status(args: argparse.Namespace) -> int:
    state = load_state()
    loaded = table_loaded()
    payload = {
        "schema": 1,
        "entries": len(state["entries"]),
        "nft_available": nft_binary() is not None,
        "table_loaded": loaded,
        "table": TABLE,
        "rules_file": str(rules_file()),
        "rules_file_present": rules_file().is_file(),
        "state_file": str(state_file()),
        "service_enabled": service_enabled(),
        "log_file": str(log_file()),
    }
    if args.json:
        print(json.dumps(payload, indent=2))
        return 0
    print(f"blocklist entries: {payload['entries']}")
    print(f"table {TABLE}: "
          + ("loaded" if loaded else "not loaded" if loaded is False else "unknown (nft missing)"))
    print(f"rendered rules:    {payload['rules_file']} "
          f"({'present' if payload['rules_file_present'] else 'missing'})")
    print(f"firewall service:  {'enabled' if payload['service_enabled'] else 'disabled'}")
    return 0


def cmd_list(args: argparse.Namespace) -> int:
    state = load_state()
    if args.json:
        print(json.dumps({"schema": 1, "entries": state["entries"]}, indent=2))
        return 0
    if not state["entries"]:
        print("no blocklist entries")
        return 0
    print(f"{'ID':>4}  {'DIRECTION':<9} {'PROTO':<5} {'TARGET':<28} COMMENT")
    for entry in state["entries"]:
        print(f"{entry['id']:>4}  {entry['direction']:<9} {entry['protocol']:<5} "
              f"{entry['kind'] + ':' + entry['value']:<28} {entry.get('comment', '')}")
    return 0


def apply_state(state: dict, quiet: bool, dry_run: bool) -> int:
    text = render(state)
    if dry_run:
        if not quiet:
            sys.stdout.write(text)
        return 0
    write_rules(text)
    ok, detail = validate(text)
    if not ok:
        print(f"grintion-firewall: rendered rules failed validation: {detail}",
              file=sys.stderr)
        return 1
    loaded, detail = load_rules(text)
    if not loaded:
        if nft_binary() is None:
            if not quiet:
                print("grintion-firewall: nft is not installed; rules rendered only")
            return 0
        print(f"grintion-firewall: loading rules failed: {detail}", file=sys.stderr)
        return 1
    if not quiet:
        print(f"applied {len(state['entries'])} blocklist entr"
              f"{'y' if len(state['entries']) == 1 else 'ies'}")
    return 0


def cmd_block(args: argparse.Namespace) -> int:
    try:
        parsed = parse_spec(args.spec, args.proto)
    except ValueError as exc:
        print(f"grintion-firewall: {exc}", file=sys.stderr)
        return 2
    if args.direction not in ("in", "out", "both"):
        print("grintion-firewall: direction must be in, out or both", file=sys.stderr)
        return 2
    if not require_root("blocking traffic", args.dry_run):
        return 2
    state = load_state()
    duplicate = next((
        entry for entry in state["entries"]
        if entry["kind"] == parsed["kind"]
        and entry["value"] == parsed["value"]
        and entry["protocol"] == parsed["protocol"]
        and entry["direction"] == args.direction
    ), None)
    if duplicate:
        print(f"grintion-firewall: entry {duplicate['id']} already blocks that",
              file=sys.stderr)
        return 1
    entry = {
        "id": max((item["id"] for item in state["entries"]), default=0) + 1,
        "kind": parsed["kind"],
        "value": parsed["value"],
        "protocol": parsed["protocol"],
        "direction": args.direction,
        "comment": args.comment or "",
        "created": int(time.time()),
    }
    if parsed.get("family"):
        entry["family"] = parsed["family"]
    state["entries"].append(entry)
    quiet = args.quiet or (args.json and args.dry_run)
    status = apply_state(state, quiet, args.dry_run)
    if status != 0:
        return status
    if not args.dry_run:
        save_state(state)
    if args.json:
        payload = {"schema": 1, "entry": entry}
        if args.dry_run:
            payload["dry_run"] = True
            payload["rules"] = render(state)
        print(json.dumps(payload, indent=2))
    elif not args.quiet:
        print(f"blocked {parsed['kind']} {parsed['value']} "
              f"({entry['protocol']}, direction {entry['direction']}) as id {entry['id']}")
    return 0


def cmd_unblock(args: argparse.Namespace) -> int:
    if not require_root("unblocking traffic", args.dry_run):
        return 2
    state = load_state()
    match = None
    if args.id_or_spec.isdigit():
        match = next((entry for entry in state["entries"]
                      if entry["id"] == int(args.id_or_spec)), None)
    if match is None:
        try:
            parsed = parse_spec(args.id_or_spec, None)
        except ValueError:
            parsed = None
        if parsed:
            match = next((entry for entry in state["entries"]
                          if entry["kind"] == parsed["kind"]
                          and entry["value"] == parsed["value"]), None)
    if match is None:
        print(f"grintion-firewall: no entry matches {args.id_or_spec!r}", file=sys.stderr)
        return 1
    state["entries"] = [entry for entry in state["entries"] if entry["id"] != match["id"]]
    quiet = args.quiet or (args.json and args.dry_run)
    status = apply_state(state, quiet, args.dry_run)
    if status != 0:
        return status
    if not args.dry_run:
        save_state(state)
    if args.json:
        print(json.dumps({"schema": 1, "removed": match}, indent=2))
    elif not args.quiet:
        print(f"removed entry {match['id']} ({match['kind']} {match['value']})")
    return 0


def cmd_flush(args: argparse.Namespace) -> int:
    if not require_root("flushing blocklist rules", args.dry_run):
        return 2
    state = load_state()
    count = len(state["entries"])
    state["entries"] = []
    quiet = args.quiet or (args.json and args.dry_run)
    status = apply_state(state, quiet, args.dry_run)
    if status != 0:
        return status
    if not args.dry_run:
        save_state(state)
    if args.json:
        print(json.dumps({"schema": 1, "removed": count}, indent=2))
    elif not args.quiet:
        print(f"removed {count} blocklist entr{'y' if count == 1 else 'ies'}")
    return 0


def cmd_apply(args: argparse.Namespace) -> int:
    if not require_root("applying firewall rules", args.dry_run):
        return 2
    state = load_state()
    quiet = args.quiet or (args.json and args.dry_run)
    status = apply_state(state, quiet, args.dry_run)
    if status == 0 and args.json:
        print(json.dumps({"schema": 1, "applied": not args.dry_run,
                          "entries": len(state["entries"])}, indent=2))
    return status


def cmd_test(args: argparse.Namespace) -> int:
    state = load_state()
    text = render(state)
    ok, detail = validate(text)
    if args.json:
        print(json.dumps({"schema": 1, "valid": ok, "detail": detail}, indent=2))
    elif ok:
        print(f"rendered rules are valid ({len(state['entries'])} entries)")
    else:
        print(f"validation failed: {detail}", file=sys.stderr)
    return 0 if ok else 1


def cmd_logs(args: argparse.Namespace) -> int:
    path = log_file()
    if not path.is_file():
        print(f"grintion-firewall: no firewall log at {path}", file=sys.stderr)
        return 1
    lines = path.read_text(encoding="utf-8", errors="replace").splitlines()[-args.lines:]
    if args.json:
        print(json.dumps({"schema": 1, "path": str(path), "lines": lines}, indent=2))
    else:
        for line in lines:
            print(line)
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="grintion-firewall",
        description="Additive deny rules for the runit firewall.",
    )
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", help="machine-readable output")
    common.add_argument("--dry-run", action="store_true", help="render without loading")
    common.add_argument("--quiet", action="store_true", help="suppress success output")
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("status", parents=[common], help="firewall overlay state"
                   ).set_defaults(func=cmd_status)
    sub.add_parser("list", parents=[common], help="list block entries"
                   ).set_defaults(func=cmd_list)

    p_block = sub.add_parser("block", parents=[common], help="drop a port or address")
    p_block.add_argument("spec")
    p_block.add_argument("--proto", choices=("tcp", "udp", "any"), default="any")
    p_block.add_argument("--direction", choices=("in", "out", "both"), default="in")
    p_block.add_argument("--comment", help="why this rule exists")
    p_block.set_defaults(func=cmd_block)

    p_unblock = sub.add_parser("unblock", parents=[common], help="remove an entry")
    p_unblock.add_argument("id_or_spec")
    p_unblock.set_defaults(func=cmd_unblock)

    p_flush = sub.add_parser("flush", parents=[common], help="remove all entries")
    p_flush.set_defaults(func=cmd_flush)

    p_apply = sub.add_parser("apply", parents=[common], help="load the current rules")
    p_apply.set_defaults(func=cmd_apply)

    p_test = sub.add_parser("test", parents=[common], help="validate rendered rules")
    p_test.set_defaults(func=cmd_test)

    p_logs = sub.add_parser("logs", parents=[common], help="show the firewall log")
    p_logs.add_argument("--lines", type=int, default=40)
    p_logs.set_defaults(func=cmd_logs)

    args = parser.parse_args()
    if not getattr(args, "command", None):
        parser.print_help()
        return 2
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
