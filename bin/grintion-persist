#!/bin/sh
# grintion-persist - create a persistent overlay partition for the live image.
# The live init looks for LABEL=GRINTION_PERSIST and mounts upper/work there.

set -eu

cat <<'EOF'
   .----------------.
  /  .------------.  \
 |  /  .--------.  \  |
 | |  /  .----.  \  | |
 | | |  /    \  | | |
 | | | |  /\  | | | |
 | | |  \____/  | | |
 | |  \________/  | |
 |  \____________/  |
  \________________/
    G R I N T I O N

==============================================================
       Grintion-OS Persistent Live Storage Creator
==============================================================
EOF

echo ""
echo "This tool formats a partition as the live overlay upper layer."
echo "Changes to the entire live root survive reboots when it is present."
echo ""
echo "Available storage partitions:"
lsblk -o NAME,SIZE,TYPE,FSTYPE,LABEL,MOUNTPOINT | grep -E 'part|disk' || true
echo ""

printf "Target partition (e.g. /dev/sda3 or /dev/nvme0n1p3): "
read -r TARGET_PART

[ -b "$TARGET_PART" ] || { echo "[-] not a block device: $TARGET_PART" >&2; exit 1; }

PART_SIZE="$(blockdev --getsize64 "$TARGET_PART" 2>/dev/null || echo 0)"
if [ "$PART_SIZE" -lt 1073741824 ]; then
    echo ""
    echo "[!] Warning: partition is smaller than 1 GiB ($((PART_SIZE / 1048576)) MiB)."
    printf "Continue anyway? (y/N): "
    read -r SMALL_CONFIRM
    [ "$SMALL_CONFIRM" = "y" ] || exit 0
fi

echo ""
echo "WARNING: all data on $TARGET_PART will be destroyed."
printf "Type YES to format it as GRINTION_PERSIST: "
read -r CONFIRM
[ "$CONFIRM" = "YES" ] || { echo "aborted"; exit 0; }

echo "[1/3] formatting $TARGET_PART"
mkfs.ext4 -F -L GRINTION_PERSIST "$TARGET_PART"

echo "[2/3] creating the overlay upper and work directories"
TEMP_MOUNT=/mnt/persist_tmp
mkdir -p "$TEMP_MOUNT"
cleanup() { umount "$TEMP_MOUNT" 2>/dev/null || true; rmdir "$TEMP_MOUNT" 2>/dev/null || true; }
trap cleanup EXIT
mount "$TARGET_PART" "$TEMP_MOUNT"
mkdir -p "$TEMP_MOUNT/upper" "$TEMP_MOUNT/work"
chmod 0700 "$TEMP_MOUNT/upper" "$TEMP_MOUNT/work"
sync
umount "$TEMP_MOUNT"
rmdir "$TEMP_MOUNT" 2>/dev/null || true
trap - EXIT

echo "[3/3] done"
echo ""
echo "=============================================================="
echo "[+] Persistence enabled on $TARGET_PART"
echo "=============================================================="
echo "Grintion-OS will detect LABEL=GRINTION_PERSIST at boot and keep"
echo "all changes to the live root across reboots."
echo "=============================================================="
