#!/usr/bin/env python3
"""grintion-cgroup - cgroup v2 resource limits and service dependency manager.

Configures memory, CPU, and PID limits under /sys/fs/cgroup/grintion/,
and manages service dependency ordering for runit services.
"""
from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path


def root_path(path: str) -> Path:
    prefix = os.environ.get("GRINTION_ROOT", "").rstrip("/")
    if prefix:
        return Path(f"{prefix}/{path.lstrip('/')}")
    return Path(path)


def get_cgroup_root() -> Path:
    custom = os.environ.get("GRINTION_CGROUP_ROOT")
    if custom:
        return Path(custom)
    return Path("/sys/fs/cgroup/grintion")


def write_val(path: Path, val: str) -> bool:
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(val.strip() + "\n", encoding="utf-8")
        return True
    except OSError:
        return False


def read_val(path: Path, default: str = "") -> str:
    try:
        return path.read_text(encoding="utf-8").strip()
    except OSError:
        return default


def apply_limits(service: str, memory: str | None, cpu: str | None, pids: str | None) -> None:
    cgroup_dir = get_cgroup_root() / service
    cgroup_dir.mkdir(parents=True, exist_ok=True)

    applied = []
    if memory:
        if write_val(cgroup_dir / "memory.max", memory):
            applied.append(f"memory.max={memory}")
    if cpu:
        if write_val(cgroup_dir / "cpu.max", cpu):
            applied.append(f"cpu.max={cpu}")
    if pids:
        if write_val(cgroup_dir / "pids.max", pids):
            applied.append(f"pids.max={pids}")

    print(f"[*] cgroup limits configured for {service}: {', '.join(applied) if applied else 'none'}")


def get_status() -> dict:
    cg_root = get_cgroup_root()
    services = []
    if cg_root.is_dir():
        for sdir in sorted(cg_root.iterdir()):
            if sdir.is_dir():
                mem = read_val(sdir / "memory.max", "max")
                cpu = read_val(sdir / "cpu.max", "max")
                pids = read_val(sdir / "pids.max", "max")
                services.append({
                    "service": sdir.name,
                    "memory_max": mem,
                    "cpu_max": cpu,
                    "pids_max": pids,
                })
    return {
        "cgroup_version": "v2",
        "cgroup_root": str(cg_root),
        "slices": services,
    }


def wait_for_service(service: str, timeout: int = 15) -> int:
    print(f"[*] waiting for prerequisite service '{service}' (timeout {timeout}s)...")
    start = time.time()
    mock_active = os.environ.get("GRINTION_SERVICE_ACTIVE_MOCK")
    if mock_active:
        return 0

    sv_bin = shutil.which("sv")
    while time.time() - start < timeout:
        if sv_bin:
            res = subprocess.run([sv_bin, "status", service], capture_output=True, text=True)
            if res.returncode == 0 and res.stdout.startswith("run: "):
                print(f"[ ok ] service '{service}' is active")
                return 0
        else:
            # Check supervise pid
            pid_file = root_path(f"/var/service/{service}/supervise/pid")
            if pid_file.is_file():
                try:
                    pid = int(pid_file.read_text().strip())
                    os.kill(pid, 0)
                    print(f"[ ok ] service '{service}' is active (pid {pid})")
                    return 0
                except (ValueError, OSError):
                    pass
        time.sleep(0.5)

    print(f"[-] timed out waiting for prerequisite service '{service}'", file=sys.stderr)
    return 1


def main() -> None:
    parser = argparse.ArgumentParser(description="Grintion-OS cgroup v2 Resource and Dependency Manager")
    sub = parser.add_subparsers(dest="command")

    status_p = sub.add_parser("status", help="show cgroup limits")
    status_p.add_argument("--json", action="store_true")

    apply_p = sub.add_parser("apply", help="apply resource limits to a service slice")
    apply_p.add_argument("service")
    apply_p.add_argument("--memory", help="maximum memory limit (e.g. 512M, 1G, max)")
    apply_p.add_argument("--cpu", help="cpu quota limit (e.g. '50000 100000', max)")
    apply_p.add_argument("--pids", help="maximum process count limit (e.g. 100, max)")

    wait_p = sub.add_parser("wait-for", help="wait for dependent service to become ready")
    wait_p.add_argument("service")
    wait_p.add_argument("--timeout", type=int, default=15)

    args = parser.parse_args()
    cmd = args.command or "status"

    if cmd == "status":
        info = get_status()
        if getattr(args, "json", False):
            print(json.dumps(info, indent=2))
        else:
            print("=" * 50)
            print("Grintion cgroup v2 Status")
            print("=" * 50)
            print(f"Root: {info['cgroup_root']}")
            for s in info["slices"]:
                print(f"Slice {s['service']}: mem={s['memory_max']}, cpu={s['cpu_max']}, pids={s['pids_max']}")
            print("=" * 50)
    elif cmd == "apply":
        apply_limits(args.service, args.memory, args.cpu, args.pids)
    elif cmd == "wait-for":
        sys.exit(wait_for_service(args.service, args.timeout))


if __name__ == "__main__":
    main()

