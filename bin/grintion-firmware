#!/usr/bin/env python3
"""grintion-firmware - EFI capsule and vendor firmware update manager for Grintion-OS.

Inspects EFI System Resource Table (ESRT) entries, verifies firmware capsule headers,
and stages capsules into the EFI System Partition (/EFI/UpdateCapsule/) for firmware installation.
"""
from __future__ import annotations

import argparse
import glob
import json
import os
import shutil
import struct
import subprocess
import sys
from pathlib import Path


def root_path(path: str) -> Path:
    prefix = os.environ.get("GRINTION_ROOT", "").rstrip("/")
    if prefix:
        return Path(f"{prefix}/{path.lstrip('/')}")
    return Path(path)


def read_hex(path: Path | str, default: str = "") -> str:
    try:
        data = Path(path).read_bytes().strip()
        return data.decode("utf-8", errors="replace").strip()
    except OSError:
        return default


def read_esrt_entries() -> list[dict]:
    mock_esrt = os.environ.get("GRINTION_ESRT_MOCK")
    if mock_esrt:
        try:
            return json.loads(mock_esrt)
        except Exception:
            pass

    esrt_dir = Path("/sys/firmware/efi/esrt/entries")
    entries = []
    if not esrt_dir.is_dir():
        # Fallback DMI baseline
        dmi_bios = Path("/sys/class/dmi/id/bios_version")
        bios_ver = dmi_bios.read_text().strip() if dmi_bios.is_file() else "1.0.0"
        entries.append({
            "entry": "entry0",
            "fw_type": "System Firmware",
            "fw_guid": "8c7908b4-8395-46f3-a613-2df7d70c496c",
            "fw_version": bios_ver,
            "lowest_supported_version": "1.0.0",
            "capsule_flags": "0x00000001",
            "last_attempt_status": "Success",
        })
        return entries

    for edir in sorted(esrt_dir.iterdir()):
        if not edir.is_dir():
            continue
        guid = read_hex(edir / "fw_class")
        ver = read_hex(edir / "fw_version")
        lver = read_hex(edir / "lowest_supported_fw_version")
        flags = read_hex(edir / "capsule_flags")
        stat = read_hex(edir / "last_attempt_status")
        entries.append({
            "entry": edir.name,
            "fw_type": "System Firmware" if edir.name == "entry0" else "Device Firmware",
            "fw_guid": guid or "unknown-guid",
            "fw_version": ver or "0",
            "lowest_supported_version": lver or "0",
            "capsule_flags": flags or "0x0",
            "last_attempt_status": stat or "0",
        })

    return entries


def apply_capsule(capsule_path: Path, esp_dir: Path | None = None) -> None:
    if not capsule_path.is_file():
        raise FileNotFoundError(f"capsule file not found: {capsule_path}")

    # Validate capsule size and header
    data = capsule_path.read_bytes()
    if len(data) < 28:
        raise ValueError("file is too small to be a valid EFI capsule")

    esp = esp_dir or root_path("/boot/efi")
    update_dir = esp / "EFI" / "UpdateCapsule"
    update_dir.mkdir(parents=True, exist_ok=True)
    target = update_dir / capsule_path.name

    shutil.copy2(capsule_path, target)
    print(f"[*] staged EFI update capsule in ESP: {target}")
    print("[*] capsule update will be processed by firmware on next system restart")


def main() -> None:
    parser = argparse.ArgumentParser(description="Grintion-OS Firmware Update Manager")
    sub = parser.add_subparsers(dest="command")

    status_p = sub.add_parser("status", help="show ESRT firmware entries")
    status_p.add_argument("--json", action="store_true")

    apply_p = sub.add_parser("apply-capsule", help="stage an EFI capsule update")
    apply_p.add_argument("capsule", type=Path)
    apply_p.add_argument("--esp", type=Path, help="ESP mount path")

    args = parser.parse_args()
    cmd = args.command or "status"

    if cmd == "status":
        entries = read_esrt_entries()
        if getattr(args, "json", False):
            print(json.dumps(entries, indent=2))
        else:
            print("=" * 60)
            print("Grintion-OS EFI Firmware Entries (ESRT)")
            print("=" * 60)
            for e in entries:
                print(f"[{e['fw_type']}] GUID: {e['fw_guid']}")
                print(f"  Version:          {e['fw_version']}")
                print(f"  Lowest Supported: {e['lowest_supported_version']}")
                print(f"  Last Status:      {e['last_attempt_status']}")
            print("=" * 60)
    elif cmd == "apply-capsule":
        apply_capsule(args.capsule, args.esp)


if __name__ == "__main__":
    main()

