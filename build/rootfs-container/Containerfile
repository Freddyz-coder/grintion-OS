# Build the live rootfs inside a userland pinned to a dated Arch Linux Archive
# snapshot. The image tag is only a bootstrap; every installed package is
# resolved from archive.archlinux.org for ALA_DATE.
FROM archlinux:base-devel

ARG ALA_DATE=2026/11/01

RUN printf '[core]\nServer = https://archive.archlinux.org/repos/%s/$repo/os/$arch\n[extra]\nServer = https://archive.archlinux.org/repos/%s/$repo/os/$arch\n' \
        "$ALA_DATE" "$ALA_DATE" > /etc/pacman.d/mirrorlist \
 && pacman -Syyuu --noconfirm --needed \
        archlinux-keyring base-devel git shellcheck python-pytest python \
        bash coreutils util-linux e2fsprogs btrfs-progs dosfstools parted \
        cryptsetup lvm2 procps-ng psmisc lsof pciutils usbutils kmod file \
        which nano vim less ncurses grep sed gawk findutils diffutils \
        tar gzip bzip2 xz unzip cpio \
        openssh openssl gnupg pacman dbus seatd systemd glib2 \
        fastfetch htop wget nftables rsync iw wpa_supplicant wireless_tools bind \
        iproute2 net-tools iputils openbsd-netcat shadow sudo pam apparmor \
        conntrack-tools \
 && pacman -Scc --noconfirm

WORKDIR /src
