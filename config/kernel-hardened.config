# Grintion-OS x86_64 kernel configuration contract
#
# This fragment is merged over `make x86_64_defconfig`. Every assignment in
# this file is enforced by build/check-kernel-config.sh: if a dependency
# changes a value, the build fails instead of silently shipping a weaker
# kernel. Keep boot-critical drivers built in (=y); the live initramfs does
# not load modules before the overlay root exists.

# ---------------------------------------------------------------------------
# Boot, initramfs and pseudo-filesystems
# ---------------------------------------------------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_OVERLAY_FS=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_CUSTOM_SSDT_OVERLAYS=n
CONFIG_EFIVAR_FS=y
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FB_VESA=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y
CONFIG_SERIAL_8250_NR_UARTS=8
CONFIG_SERIAL_CORE=y
CONFIG_VGA_CONSOLE=y
CONFIG_DUMMY_CONSOLE=y

# ---------------------------------------------------------------------------
# Storage and partitioning (built in so the installer and initramfs work
# without udev or a module loader)
# ---------------------------------------------------------------------------
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_UTF8=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_NVME=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_PCI=y
CONFIG_SCSI_VIRTIO=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y
CONFIG_BLK_DEV_LOOP=m
CONFIG_BTRFS_FS=m
CONFIG_XFS_FS=m
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m

# ---------------------------------------------------------------------------
# Input and USB (keyboard must work in the initramfs recovery shell)
# ---------------------------------------------------------------------------
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_USB_HID=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y

# ---------------------------------------------------------------------------
# Networking and firewall
# ---------------------------------------------------------------------------
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_R8169=y
CONFIG_VIRTIO_NET=y
CONFIG_USB_USBNET=m
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_TABLES=y
CONFIG_NF_CONNTRACK=y
CONFIG_NFT_CT=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_NAT=y
CONFIG_BRIDGE=m
CONFIG_VETH=m
CONFIG_TUN=m

# ---------------------------------------------------------------------------
# Graphics: virtual machines and basic framebuffers built in; real GPUs as
# modules so a missing firmware file only costs acceleration, not the console.
# ---------------------------------------------------------------------------
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_I915=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_QXL=m
CONFIG_DRM_VMWGFX=m
CONFIG_DRM_VBOXVIDEO=m
CONFIG_DRM_CIRRUS_QEMU=m
CONFIG_DRM_VKMS=m

# ---------------------------------------------------------------------------
# Container and process isolation primitives
# ---------------------------------------------------------------------------
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_SCHED=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# ---------------------------------------------------------------------------
# Hardening
# ---------------------------------------------------------------------------
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_DEBUG_WX=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y
CONFIG_X86_UMIP=y
CONFIG_LEGACY_VSYSCALL_NONE=y
CONFIG_SECURITY=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_SECURITYFS=y
CONFIG_KEYS=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_SIG=n
CONFIG_MODULE_FORCE_UNLOAD=n
CONFIG_KEXEC=n
CONFIG_HIBERNATION=n
CONFIG_MAGIC_SYSRQ=n
CONFIG_DEVMEM=n
CONFIG_PROC_KCORE=n
CONFIG_STATIC_USERMODEHELPER=n
CONFIG_UEVENT_HELPER=n
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=n

# ---------------------------------------------------------------------------
# Runtime, power and identification
# ---------------------------------------------------------------------------
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_SUSPEND=y
CONFIG_ACPI=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_PRINTK_TIME=y
CONFIG_PANIC_TIMEOUT=10
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_DEBUG_KERNEL=n
CONFIG_LOCALVERSION="-grintion"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_DEFAULT_HOSTNAME="grintion"
CONFIG_BUILD_SALT="grintion"
