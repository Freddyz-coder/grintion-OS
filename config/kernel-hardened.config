# Grintion-OS x86_64 kernel configuration contract
#
# This fragment is merged over `make x86_64_defconfig`. Every assignment in
# this file is enforced by build/check-kernel-config.sh: if a dependency
# changes a value, the build fails instead of silently shipping a weaker
# kernel. Keep boot-critical drivers built in (=y); the live initramfs does
# not load modules before the overlay root exists.

# ---------------------------------------------------------------------------
# Boot, initramfs and pseudo-filesystems
# ---------------------------------------------------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_OVERLAY_FS=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_CUSTOM_SSDT_OVERLAYS=n
CONFIG_EFIVAR_FS=y
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FB_VESA=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y
CONFIG_SERIAL_8250_NR_UARTS=8
CONFIG_SERIAL_CORE=y
CONFIG_VGA_CONSOLE=y
CONFIG_DUMMY_CONSOLE=y

# ---------------------------------------------------------------------------
# Storage and partitioning (built in so the installer and initramfs work
# without a udev daemon or a module loader in the initramfs)
# ---------------------------------------------------------------------------
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_UTF8=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_NVME=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_PCI=y
CONFIG_SCSI_VIRTIO=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y
CONFIG_BLK_DEV_LOOP=m
# LUKS2 root and swap need device-mapper and XTS in the installed initramfs.
# They are built in so the initramfs needs no module loader before unlock.
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_SHA256=y
CONFIG_BTRFS_FS=y
CONFIG_XFS_FS=m
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m

# ---------------------------------------------------------------------------
# Input and USB (keyboard must work in the initramfs recovery shell)
# ---------------------------------------------------------------------------
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_USB_HID=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y

# ---------------------------------------------------------------------------
# Networking and firewall
# ---------------------------------------------------------------------------
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_8139CP=y
CONFIG_8139TOO=y
CONFIG_PCNET32=y
CONFIG_R8169=y
CONFIG_VIRTIO_NET=y
CONFIG_USB_USBNET=m
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_MAC80211_MESH=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_IWLWIFI=m
CONFIG_IWLDVM=m
CONFIG_IWLMVM=m
CONFIG_RTW88=m
CONFIG_RTW88_CORE=m
CONFIG_RTW88_PCI=m
CONFIG_RTW88_8822BE=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW88_8821CE=m
CONFIG_RTW89=m
CONFIG_RTW89_CORE=m
CONFIG_RTW89_PCI=m
CONFIG_RTW89_8852AE=m
CONFIG_RTW89_8852BE=m
CONFIG_RTW89_8852CE=m
CONFIG_MT76_CORE=m
CONFIG_MT76_USB=m
CONFIG_MT7921E=m
CONFIG_MT7921U=m
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_ATH12K=m
CONFIG_BRCMFMAC=m
CONFIG_RTL8XXXU=m
CONFIG_RFKILL=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_TABLES=y
CONFIG_NF_CONNTRACK=y
CONFIG_NFT_CT=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_NAT=y
CONFIG_BRIDGE=m
CONFIG_VETH=m
CONFIG_TUN=m

# ---------------------------------------------------------------------------
# Graphics: virtual machines and basic framebuffers built in; real GPUs as
# modules so a missing firmware file only costs acceleration, not the console.
# ---------------------------------------------------------------------------
CONFIG_DRM=y
# fbcon must be able to bind after a KMS driver takes over the VGA device.
# Without fbdev emulation the live screen goes black once bochs-drm/simpledrm
# deactivate vgacon, while tty1 and the serial console keep working.
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_I915=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_QXL=m
CONFIG_DRM_VMWGFX=m
CONFIG_DRM_VBOXVIDEO=m
CONFIG_DRM_CIRRUS_QEMU=m
CONFIG_DRM_VKMS=m

# ---------------------------------------------------------------------------
# Audio: built in because mdev does not autoload PCI/USB modules. The HDA
# controller without codec parsers produces no card at all; USB audio covers
# headsets and USB speakers.
# ---------------------------------------------------------------------------
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCI=y
CONFIG_SND_HDA=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_ANALOG=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_HDA_CODEC_CIRRUS=y
CONFIG_SND_HDA_CODEC_CONEXANT=y
CONFIG_SND_HDA_CODEC_SIGMATEL=y
CONFIG_SND_HDA_CODEC_VIA=y
CONFIG_SND_HDA_CODEC_CA0110=y
CONFIG_SND_HDA_CODEC_CA0132=y
CONFIG_SND_HDA_CODEC_CMEDIA=y
CONFIG_SND_HDA_CODEC_SI3054=y
CONFIG_SND_USB_AUDIO=y
CONFIG_SND_DYNAMIC_MINORS=y

# ---------------------------------------------------------------------------
# Container and process isolation primitives
# ---------------------------------------------------------------------------
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_SCHED=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# ---------------------------------------------------------------------------
# Hardening
# ---------------------------------------------------------------------------
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_DEBUG_WX=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y
CONFIG_X86_UMIP=y
CONFIG_LEGACY_VSYSCALL_NONE=y
CONFIG_SECURITY=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_SECURITYFS=y
# AppArmor is the image's mandatory access control implementation. The
# profiles in /etc/apparmor.d are loaded by /etc/sv/apparmor at boot; without
# these symbols they would ship but never confine anything.
CONFIG_SECURITY_APPARMOR=y
# 64-bit machines may run 32-bit software. A 32-bit-only CPU cannot run this
# image at all; grintion-arch enforces that before installation.
CONFIG_IA32_EMULATION=y
# Kernel audit is the backing store for auditd, which now ships its userspace.
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y
CONFIG_KEYS=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# Only modules signed by this build are loadable. MODULE_SIG_ALL signs every
# module during `make modules`; MODULE_SIG_FORCE rejects anything else.
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_SHA512=y
CONFIG_MODULE_FORCE_UNLOAD=n
CONFIG_KEXEC=n
CONFIG_HIBERNATION=n
# Reduce the kernel attack surface: no binary-format handlers. io_uring is
# disabled at runtime by /etc/sysctl.d/99-grintion.conf instead of at build
# time: CONFIG_IO_URING is only user-selectable with CONFIG_EXPERT, and EXPERT
# selects CONFIG_DEBUG_KERNEL, which this contract deliberately keeps off.
CONFIG_BINFMT_MISC=n
CONFIG_MAGIC_SYSRQ=n
CONFIG_DEVMEM=n
CONFIG_PROC_KCORE=n
CONFIG_STATIC_USERMODEHELPER=n
CONFIG_UEVENT_HELPER=n
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=n

# ---------------------------------------------------------------------------
# Runtime, power and identification
# ---------------------------------------------------------------------------
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_SUSPEND=y
CONFIG_ACPI=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
# Compressed RAM swap. The zram runit service is enabled in the live and
# installed images; without these symbols it would silently do nothing.
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZSMALLOC=m
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_PRINTK_TIME=y
CONFIG_PANIC_TIMEOUT=10
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_DEBUG_KERNEL=n
CONFIG_LOCALVERSION="-grintion"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_DEFAULT_HOSTNAME="grintion"
CONFIG_BUILD_SALT="grintion"
