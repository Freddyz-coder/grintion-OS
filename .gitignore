# Grintion linux .gitignore
build/work/
build/cache/
output/
None/
*.tmp
__pycache__/
*.pyc
.pytest_cache/

# Downloaded and compiled third-party build tools. `make tools` recreates
# these from config/tools.sha256; the Limine assets remain tracked.
tools/src/
tools/bin/busybox
tools/bin/bc

.venv/

# local planning documents (not part of the public source tree)
featureAdding.md
handoff.md
nexthandoff.md

# Local architecture questionnaire for the expansion planning session.
# if temporary2.txt is missing, this line should be removed from the .gitignore file.
temporary2.txt

ProblemsWhenInstalling.txt
SecurityProblems.txt

# Local machine-readable system dump; not part of the public source tree.
info.txt

# If temporary.txt is missing, this line should be removed from the .gitignore file.
Temporary.txt
